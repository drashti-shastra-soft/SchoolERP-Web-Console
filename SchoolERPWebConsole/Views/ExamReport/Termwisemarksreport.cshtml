@*
    ======================================================================
    VIEW: Academics / TermWiseMarksReport.cshtml
    PURPOSE: Filter panel + print-preview viewer for the CCE Exam Term wise
             Marks Report (Report Card). Mirrors the "Voucher Type" view's
             conventions (Permissions gating, section Scripts block, etc).
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.ExamTermReportPageViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Term wise Marks Report";
    var p = Model.Permissions;
}

<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">CCE Exam Term wise Marks Report</h6>
    </div>
</div>

<div id="reportPageNotice"></div>

<div class="row g-2">

    <!-- ───────────────────────── Report Viewer (left) ───────────────────────── -->
    <div class="col-xl-9">
        <div class="card shadow-tbl-outer h-100">
            <div class="card-body p-2">

                <!-- Viewer toolbar -->
                <div class="d-flex align-items-center flex-wrap gap-2 border-bottom pb-2 mb-2">
                    @if (p.CanPrint)
                    {
                        <button class="btn btn-sm btn-outline-secondary" id="btnPrint" onclick="printReport()" disabled>
                            <i class="ti ti-printer me-1"></i>Print
                        </button>
                    }
                    @if (p.CanExport)
                    {
                        <button class="btn btn-sm btn-outline-secondary" id="btnSave" onclick="saveReportPdf()" disabled>
                            <i class="ti ti-device-floppy me-1"></i>Save
                        </button>
                    }

                    <div class="vr d-none d-md-block"></div>

                    <div class="d-flex align-items-center gap-1">
                        <button class="btn btn-sm btn-light" id="btnFirst" onclick="gotoPage(1)" disabled title="First page">
                            <i class="ti ti-chevrons-left"></i>
                        </button>
                        <button class="btn btn-sm btn-light" id="btnPrev" onclick="gotoPage(currentPage-1)" disabled title="Previous page">
                            <i class="ti ti-chevron-left"></i>
                        </button>
                        <input type="number" id="txtPageNo" class="form-control form-control-sm text-center" style="width:56px;" value="1" min="1" onchange="gotoPage(parseInt(this.value||'1'))" disabled />
                        <span class="text-muted small">of <span id="lblTotalPages">0</span></span>
                        <button class="btn btn-sm btn-light" id="btnNext" onclick="gotoPage(currentPage+1)" disabled title="Next page">
                            <i class="ti ti-chevron-right"></i>
                        </button>
                        <button class="btn btn-sm btn-light" id="btnLast" onclick="gotoPage(totalPages)" disabled title="Last page">
                            <i class="ti ti-chevrons-right"></i>
                        </button>
                    </div>

                    <div class="vr d-none d-md-block"></div>

                    <div class="d-flex align-items-center gap-1">
                        <i class="ti ti-zoom-in text-muted"></i>
                        <select id="ddlZoom" class="form-select form-select-sm" style="width:90px;" onchange="setZoom(this.value)">
                            <option value="0.5">50%</option>
                            <option value="0.65">65%</option>
                            <option value="0.8" selected>80%</option>
                            <option value="1">100%</option>
                            <option value="1.25">125%</option>
                            <option value="1.5">150%</option>
                        </select>
                    </div>

                    <button class="btn btn-sm btn-light" id="btnOnePage" onclick="fitOnePage()">
                        <i class="ti ti-file me-1"></i>One Page
                    </button>
                </div>

                <!-- Report canvas -->
                <div id="reportViewerScroll" style="overflow:auto; background:#e9ecef; border-radius:.25rem; min-height:70vh; max-height:78vh;">
                    <div id="reportViewerArea" class="p-4 d-flex justify-content-center">
                        <div class="text-muted text-center py-5" id="reportPlaceholder">
                            <i class="ti ti-file-report" style="font-size:2rem;"></i>
                            <div class="mt-2">Choose Class / Section / Exam Group and click <strong>Show Report</strong>.</div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- ───────────────────────── Report Filters + Student list (right) ───────────────────────── -->
    <div class="col-xl-3">
        <div class="card shadow-tbl-outer">
            <div class="card-body p-3">
                <h6 class="fw-bold mb-3">Report Filters</h6>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Class:<span class="text-danger">*</span></label>
                    <div class="d-flex gap-1">
                        <select id="ddlClass" class="form-select form-select-sm" onchange="onClassChange()">
                            <option value="">-- Select --</option>
                            @foreach (var c in Model.ClassList)
                            {
                                <option value="@c.ClassID">@c.ClassName</option>
                            }
                        </select>
                        <select id="ddlSection" class="form-select form-select-sm" disabled>
                            <option value="">Select</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Exam Group:<span class="text-danger">*</span></label>
                    <select id="ddlExam" class="form-select form-select-sm" disabled>
                        <option value="">Select</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small d-block">Report Card:</label>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reportCardType" id="rbSummarised" value="summarised">
                        <label class="form-check-label small" for="rbSummarised">Summarised Marksheet</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reportCardType" id="rbDetailed" value="detailed">
                        <label class="form-check-label small" for="rbDetailed">Detailed Marksheet</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reportCardType" id="rbTerm" value="term" checked>
                        <label class="form-check-label small" for="rbTerm">Term Report card</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reportCardType" id="rbRank" value="rank">
                        <label class="form-check-label small" for="rbRank">Rank Report</label>
                    </div>
                </div>

                <div class="text-end">
                    <button type="button" class="btn btn-primary btn-sm" id="btnShowReport" onclick="showReport()">
                        Show Report
                    </button>
                </div>
            </div>
        </div>

        <!-- Student list: populated after a successful Show Report; click a row to jump the viewer to that student -->
        <div class="card shadow-tbl-outer mt-2" id="studentListCard" style="display:none;">
            <div class="card-body p-2">
                <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                    <h6 class="fw-bold small mb-0"><i class="ti ti-users me-1"></i>Students</h6>
                    <span class="badge bg-secondary" id="studentCountBadge">0</span>
                </div>
                <div id="studentListContainer" style="max-height:340px; overflow-auto;"></div>
            </div>
        </div>
    </div>

</div>

@section Styles {
    <style>
        .tr-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .tr-table th, .tr-table td {
                border: 1px solid #333;
                padding: 4px 6px;
            }

            .tr-table thead th {
                background: #fff;
                font-weight: 700;
            }

        /* Student info block: plain text layout, no visible borders (matches report card) */
        .student-info-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .student-info-table td {
                border: none;
                padding: 2px 6px;
                vertical-align: top;
            }

        .subject-name-cell {
            color: #1a237e;
        }

        .report-page {
            display: inline-block;
        }

        .student-list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: .5rem;
            padding: 6px 8px;
            border-radius: .25rem;
            cursor: pointer;
            font-size: 13px;
        }

            .student-list-item:hover {
                background: #f1f3f5;
            }

            .student-list-item.active {
                background: #e7f1ff;
                font-weight: 600;
            }

        @@media print {
            body * {
                visibility: hidden;
            }

            .report-page, .report-page * {
                visibility: visible;
            }

            .report-page {
                position: absolute;
                top: 0;
                left: 0;
                transform: none !important;
                box-shadow: none !important;
            }
        }

        #studentListContainer{
            max-height: 340px;
            overflow: auto !important;
        }

        .report-watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 60%;
            max-height: 60%;
            opacity: 0.12; /* increase for a stronger watermark */
            pointer-events: none;
            user-select: none;
            z-index: 1;
        }
        @@media print {
            .report-watermark

        {
            opacity: 0.12;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        }
    </style>
}

@section Scripts {
    <script>
        window.canPrint = @JsonSerializer.Serialize(p.CanPrint);
        window.canExport = @JsonSerializer.Serialize(p.CanExport);
        window.companyId = @Model.CompanyID;
        window.sessionId = @Model.SessionID;
        // Whatever the server already loaded on first hit (may be empty if no class/exam was pre-selected)
        window.initialReportData = @Html.Raw(JsonSerializer.Serialize(Model.ExamTermReportCard,
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }));
    </script>

    <script src="~/assets/js/TermWiseMarksReport.js"></script>
}
