@model SchoolERPWebConsole.Domain.FeeCategoryAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Fees Category";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditatFeeCategory == null ? "Add Fees Category" : "Edit Fees Category")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/FeeCategory/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditatFeeCategory?.FeeCategoryId">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditatFeeCategory?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditatFeeCategory?.SessionID">

                    <div class="row row-gap-3">
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Category Group<span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlCategoryGroup" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.CategoryGroups != null)
                                {
                                    @foreach (var rt in Model.CategoryGroups)
                                    {
                                        <option value="@rt.Id" selected="@(Model.EditatFeeCategory?.CategoryGroupId == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="ErrorddlCategoryGroup">Category group is required.</div>
                        </div>

                        <!-- Account Type Name -->
                        <div class="col-md-4">
                            <label class="form-label">Fees Category Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName"
                                   value="@Model.EditatFeeCategory?.FeeCategoryName" placeholder="Enter Fees Category Name">
                            <div class="text-danger small mt-1 d-none" id="nameError">Fees Category Name is required.</div>
                        </div>

                        <!-- Title / Display Label -->
                        <div class="col-md-4">
                            <label class="form-label">Display Name</label>
                            <input type="text" class="form-control" id="txtDisplayName"
                                   value="@Model.EditatFeeCategory?.DisplayLabel" placeholder="Enter Display Name">
                        </div>


                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditatFeeCategory?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>



                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/FeeCategory.js"></script>
}