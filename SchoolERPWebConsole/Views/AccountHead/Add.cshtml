@model SchoolERPWebConsole.Domain.AddAccountHeadPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Account Head";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditAccountHead == null ? "Add Account Head" : "Edit Account Head")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button type="button" onclick="resetForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <a href="/AccountHead/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="accountHeadForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>Account Head</strong>
                </div>
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditAccountHead?.AccountID">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditAccountHead?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditAccountHead?.SessionID">

                    <div class="row row-gap-3">

                        <!-- Account ID (read-only / auto) + Block -->
                        <div class="col-md-4">
                            <label class="form-label">Account ID:</label>
                            <div class="d-flex align-items-center gap-3">
                                <input type="text" class="form-control" id="txtAccountId" readonly
                                       value="@(Model.EditAccountHead?.AccountID.ToString() ?? "Auto")">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkBlock"
                                    @(Model.EditAccountHead?.IsBlocked ?? false ? "checked" : "")>
                                    <label class="form-check-label" for="chkBlock">Block</label>
                                </div>
                            </div>
                        </div>

                        <!-- Account Name -->
                        <div class="col-md-4">
                            <label class="form-label">Account Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtAccountName"
                                   value="@Model.EditAccountHead?.AccountName" placeholder="Enter account name">
                            <div class="text-danger small mt-1 d-none" id="nameError">Account name is required.</div>
                        </div>

                        <!-- Account Type ID (readonly, derived) -->
                        <div class="col-md-4">
                            <label class="form-label">Account Type ID:</label>
                            <input type="text" class="form-control" id="txtAccountTypeId" readonly
                                   value="@Model.EditAccountHead?.AccountTypeID">
                        </div>

                        <!-- Under Account (parent-child) -->
                        <div class="col-md-4">
                            <label class="form-label">Under Account:</label>
                            <select class="form-select" id="ddlUnderAccount">
                                <option value="">-- None (Top Level) --</option>
                                @if (Model.ParentAccountList != null)
                                {
                                    foreach (var item in Model.ParentAccountList)
                                    {
                                        // Skip the record currently being edited so it can't be its own parent.
                                        if (Model.EditAccountHead != null && item.Id == Model.EditAccountHead.AccountID)
                                        {
                                            continue;
                                        }
                                        var isSelected = (Model.EditAccountHead?.ParentAccountID == item.Id) ? "selected" : "";
                                        <option value="@item.Id" selected="@isSelected">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Account Type Name -->
                        <div class="col-md-4">
                            <label class="form-label">Account Type Name <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlAccountType">
                                <option value="">Select</option>
                                @if (Model.AccountTypeList != null)
                                {
                                    foreach (var item in Model.AccountTypeList)
                                    {
                                        var isSelected = (Model.EditAccountHead?.AccountTypeID == item.AccountTypeId) ? "selected" : "";
                                        <option value="@item.AccountTypeId" selected="@isSelected">@item.AccountTypeName</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="typeError">Account type is required.</div>
                        </div>

                        <!-- Account No -->
                        <div class="col-md-4">
                            <label class="form-label">Account No:</label>
                            <input type="text" class="form-control" id="txtAccountNo"
                                   value="@Model.EditAccountHead?.AccountNo" placeholder="Enter account no">
                        </div>

                        <!-- Represented By -->
                        <div class="col-md-4">
                            <label class="form-label">Represented By:</label>
                            <input type="text" class="form-control" id="txtRepresentedBy"
                                   value="@Model.EditAccountHead?.RepresentedBy">
                        </div>

                        <!-- Cost Center -->
                        <div class="col-md-4">
                            <label class="form-label">Cost Center:</label>
                            <select class="form-select" id="ddlCostCenter">
                                <option value="">Select</option>
                                @if (Model.CostCenterList != null)
                                {
                                    foreach (var item in Model.CostCenterList)
                                    {
                                        var isSelected = (Model.EditAccountHead?.CostCenterID == item.CostCenterId) ? "selected" : "";
                                        <option value="@item.CostCenterId" selected="@isSelected">@item.CostCenter</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Payee Name -->
                        <div class="col-md-4">
                            <label class="form-label">Payee Name:</label>
                            <input type="text" class="form-control" id="txtPayeeName"
                                   value="@Model.EditAccountHead?.PayeeName">
                        </div>

                        <!-- Area -->
                        <div class="col-md-4">
                            <label class="form-label">Area:</label>
                            <select class="form-select" id="ddlArea">
                                <option value="">Select</option>
                                @if (Model.AreaList != null)
                                {
                                    foreach (var item in Model.AreaList)
                                    {
                                        var isSelected = (Model.EditAccountHead?.AreaID == item.Id) ? "selected" : "";
                                        <option value="@item.Id" selected="@isSelected">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Address -->
                        <div class="col-md-4">
                            <label class="form-label">Address:</label>
                            <textarea class="form-control" id="txtAddress" rows="1">@Model.EditAccountHead?.Address</textarea>
                        </div>

                        <!-- City -->
                        <div class="col-md-4 position-relative">
                            <label class="form-label fw-bold">Pin Code</label>
                            <input type="text" value="@Model.EditAccountHead?.PostalCode" class="form-control" id="txtPinCode" autocomplete="off" />
                            <ul id="pinCodeSuggestions" class="pincode-dropdown list-group">
                            </ul>
                        </div>
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Country Name</label>
                            <select class="form-select select2" id="ddlCountry" style="width: 100%;">
                                <option value="">-- Select --</option>
                                @if (Model.Country != null)
                                {
                                    @foreach (var rt in Model.Country)
                                    {
                                        <option value="@rt.CountryId" selected="@(Model.EditAccountHead?.CountryId == rt.CountryId)">@rt.CountryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-block col-md-4">
                            <input type="hidden" id="hdnSelectedStateId" value="@Model.EditAccountHead?.StateId" />
                            <input type="hidden" id="hdnSelectedCityId" value="@Model.EditAccountHead?.CityId" />
                            <label class="form-label fw-bold">State Name</label>
                            <select class="form-select select2" id="ddlState" style="width: 100%;">
                                <option value="">-- Select Country First --</option>
                            </select>
                        </div>

                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">City Name</label>
                            <select class="form-select select2" id="ddlCity" style="width: 100%;">
                                <option value="">-- Select Country First --</option>
                            </select>
                        </div>

                        <!-- Phone No (Off) -->
                        <div class="col-md-4">
                            <label class="form-label">Phone No.(Off.):</label>
                            <input type="text" class="form-control" id="txtPhoneOff"
                                   value="@Model.EditAccountHead?.PhoneOff">
                        </div>

                        <!-- Phone No (Res) -->
                        <div class="col-md-4">
                            <label class="form-label">Phone No.(Res.):</label>
                            <input type="text" class="form-control" id="txtPhoneRes"
                                   value="@Model.EditAccountHead?.PhoneRes">
                        </div>

                        <!-- Email -->
                        <div class="col-md-4">
                            <label class="form-label">Email:</label>
                            <input type="email" class="form-control" id="txtEmail"
                                   value="@Model.EditAccountHead?.Email">
                        </div>

                        <!-- Mobile No -->
                        <div class="col-md-4">
                            <label class="form-label">Mobile No:</label>
                            <input type="text" class="form-control" id="txtMobileNo"
                                   value="@Model.EditAccountHead?.MobileNo">
                        </div>

                        <!-- Credit Days / Credit Limit -->
                        <div class="col-md-4">
                            <label class="form-label">Credit Days:</label>
                            <input type="number" class="form-control" id="txtCreditDays"
                                   value="@(Model.EditAccountHead?.CreditDays ?? 0)">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Credit Limit:</label>
                            <input type="number" step="0.01" class="form-control" id="txtCreditLimit"
                                   value="@(Model.EditAccountHead?.CreditLimit ?? 0)">
                        </div>

                        <!-- Fax -->
                        <div class="col-md-4">
                            <label class="form-label">Fax:</label>
                            <input type="text" class="form-control" id="txtFax"
                                   value="@Model.EditAccountHead?.Fax">
                        </div>

                        <!-- Opening Balance / Opening Bal Type -->
                        <div class="col-md-4">
                            <label class="form-label">Opening Balance:</label>
                            <input type="number" step="0.01" class="form-control" id="txtOpeningBalance"
                                   value="@(Model.EditAccountHead?.OpeningBalance ?? 0)">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Opening Bal Type:</label>
                            <select class="form-select" id="ddlOpeningBalType">
                                <option value="DEBIT" selected="@((Model.EditAccountHead?.OpeningBalType ?? "DEBIT") == "DEBIT" ? "selected" : null)">DEBIT</option>
                                <option value="CREDIT" selected="@(Model.EditAccountHead?.OpeningBalType == "CREDIT" ? "selected" : null)">CREDIT</option>
                            </select>
                        </div>

                        <!-- Opening Date -->
                        <div class="col-md-4">
                            <label class="form-label">Opening Date:</label>
                            <input type="datetime-local" class="form-control" id="txtOpeningDate"
                                   value="@(Model.EditAccountHead?.OpeningDate?.ToString("yyyy-MM-ddTHH:mm"))">
                        </div>

                        <!-- Tax identifiers -->
                        <div class="col-md-4">
                            <label class="form-label">Tin No.:</label>
                            <input type="text" class="form-control" id="txtTinNo" value="@Model.EditAccountHead?.TinNo">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">PAN No.:</label>
                            <input type="text" class="form-control" id="txtPANNo" value="@Model.EditAccountHead?.PANNo">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">STT No.:</label>
                            <input type="text" class="form-control" id="txtSTTNo" value="@Model.EditAccountHead?.STTNo">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Service Tax No.:</label>
                            <input type="text" class="form-control" id="txtServiceTaxNo" value="@Model.EditAccountHead?.ServiceTaxNo">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CST No.:</label>
                            <input type="text" class="form-control" id="txtCSTNo" value="@Model.EditAccountHead?.CSTNo">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ECC No.:</label>
                            <input type="text" class="form-control" id="txtECCNo" value="@Model.EditAccountHead?.ECCNo">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Attachment</label>
                            <input type="file" class="form-control" id="attachmentFile" name="fileAttachment">
                            <small class="text-muted" id="fileInfo"></small>

                            @if (!string.IsNullOrEmpty(@Model.EditAccountHead?.AttachDocName))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@Model.EditAccountHead?.AttachDoc" target="_blank" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@Model.EditAccountHead?.AttachDocName
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                            <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                            <input type="hidden" id="hdnExistingFile" name="ExistingFileName" value="@Model.EditAccountHead?.AttachDocName">
                            <input type="hidden" id="hdnRemoveFile" name="RemoveAttachment" value="false">
                        </div>
                        <!-- Active -->
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditAccountHead?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/AccountHead.js"></script>
}
