@model SchoolERPWebConsole.Domain.FeeHeadAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Fees Head";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    bool isEdit = Model.EditFeeHead != null;
    // adding needs CanAdd, editing needs CanEdit
    bool canSave = isEdit ? p.CanEdit : p.CanAdd;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit Fees Head" : "Add Fees Head")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (canSave)
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/FeeHead/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditFeeHead?.FeeHeadId">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditFeeHead?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditFeeHead?.SessionID">

                    <div class="row row-gap-3">

                        <!-- Fee Type (list comes from Model.FeeCategory, saved as FeeTypeId) -->
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold" for="ddlFeeType">Fee Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlFeeType" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.FeeCategory != null)
                                {
                                    @foreach (var rt in Model.FeeCategory)
                                    {
                                        <option value="@rt.Id" selected="@(Model.EditFeeHead?.FeeTypeId == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="ErrorddlFeeType">Fee type is required.</div>
                        </div>

                        <!-- Account Type (saved as AccountId) -->
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold" for="ddlAccountType">Account Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlAccountType" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.AccountType != null)
                                {
                                    @foreach (var rt in Model.AccountType)
                                    {
                                        <option value="@rt.Id" selected="@(Model.EditFeeHead?.AccountId == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="ErrorddlAccountType">Account type is required.</div>
                        </div>

                        <!-- Fee Head Name -->
                        <div class="col-md-4">
                            <label class="form-label" for="txtName">Fees Head Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" maxlength="500"
                                   value="@Model.EditFeeHead?.FeeHeadName" placeholder="Enter Fees Head Name">
                            <div class="text-danger small mt-1 d-none" id="nameError">Fee head name is required.</div>
                        </div>

                        <!-- Display Label -->
                        <div class="col-md-4">
                            <label class="form-label" for="txtDisplayName">Display Name</label>
                            <input type="text" class="form-control" id="txtDisplayName" maxlength="200"
                                   value="@Model.EditFeeHead?.DisplayLabel" placeholder="Enter Display Name">
                            <div class="text-danger small mt-1 d-none" id="displayNameError"></div>
                        </div>

                        <!-- Is Refunded -->
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="chkIsRefunded"
                                @(Model.EditFeeHead?.IsRefunded == true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsRefunded">Is Refunded</label>
                            </div>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditFeeHead?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/FeeHead.js"></script>
}
