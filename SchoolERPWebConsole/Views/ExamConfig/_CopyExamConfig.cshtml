@*
    ======================================================================
    PARTIAL: Shared/_CopyExamGradeModal.cshtml
    PURPOSE: "Copy Exam Grade to another Session/Class" modal.
             Scoped by Session + Class. CompanyID comes from the logged-in
             context (window.getCompanyId()) and is never chosen here.

             Paired 1:1 with wwwroot/js/copyExamGradeModal.js.

             "To Class" is a MULTI select (select2) — its values are joined
             into a comma string ("5,4,1") and posted as ToClassIDs.

             Do NOT rename these IDs without updating copyExamGradeModal.js:
               fromSessionGrade, fromClassGrade,
               toSessionGrade, toClassGrade,
               validationBoxGrade, tableSectionGrade,
               tblGradeCopy, gradeTbody, btnCopyGrade

             fromSessionGrade / toSessionGrade onchange call
             onFromSessionChangeGrade() / onToSessionChangeGrade(), which
             re-fetch that side's CLASS list (session-scoped) and then call
             validateCopyExamGrade() themselves.
    ======================================================================
*@
<style>
    #copyExamGradeModal span.select2 {
        margin-bottom: .5rem !important;
    }
</style>

<div class="modal fade" id="copyExamGradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-xl">

            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="ti ti-copy"></i> Copy Exam Grade
                </h5>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnCopyGrade" onclick="handleCopyExamGrade()" disabled>
                        <i class="ti ti-copy me-1"></i>Copy
                    </button>
                </div>
            </div>

            <div class="modal-body p-4">

                <div class="row align-items-start g-3">

                    <!-- ── Source ── -->
                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Source (From)</p>
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromSessionGrade"
                                onchange="onFromSessionChangeGrade()">
                            <option value="">From session</option>
                        </select>
                        <!-- starts disabled; enabled once a session's class list is loaded -->
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromClassGrade"
                                onchange="validateCopyExamGrade()" disabled>
                            <option value="">Loading...</option>
                        </select>
                    </div>

                    <div class="col-2 d-flex justify-content-center" style="padding-top:42px">
                        <div class="d-flex align-items-center text-primary">
                            <i class="ti ti-arrow-left fs-18"></i>
                            <div style="width:20px;height:2px;background:currentColor"></div>
                            <i class="ti ti-arrow-right fs-18"></i>
                        </div>
                    </div>

                    <!-- ── Destination ── -->
                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Destination (To)</p>
                        <select class="form-select form-select-sm mb-2 mt-2" id="toSessionGrade"
                                style="cursor:pointer" onchange="onToSessionChangeGrade()">
                            <option value="">To session</option>
                        </select>
                        <!-- MULTI: values joined -> "5,4,1" -->
                        <select class="form-select form-select-sm mb-2 mt-2" id="toClassGrade"
                                multiple onchange="validateCopyExamGrade()">
                        </select>
                        <small class="text-muted d-block">You can select multiple destination classes.</small>
                    </div>
                </div>

                <!-- Shown when destination session == source session AND the
                     only selected class is the source class -->
                <div id="validationBoxGrade" class="d-none border-top mt-4 pt-3 text-center">
                    <i class="ti ti-alert-triangle text-danger" style="font-size:40px"></i>
                    <p class="text-danger fw-semibold mt-1 mb-0">Cannot Copy to the Same Session &amp; Class</p>
                </div>

                <!-- Preview only — no selection column -->
                <div id="tableSectionGrade" class="d-none border-top mt-3 pt-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small">
                            <i class="ti ti-list me-1"></i>Exam Grades to copy
                        </span>
                    </div>

                    <div class="border rounded" style="max-height:220px;overflow-y:auto">
                        <table class="table table-sm table-hover mb-0" id="tblGradeCopy">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width:50px">#</th>
                                    <th>Exam Name</th>
                                    <th>Exam Group Name</th>
                                    <th>Marge Exam</th>
                                    <th>Percentage</th>
                                    <th>Sequence</th>
                                </tr>
                            </thead>
                            <tbody id="gradeTbody"></tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-1 mb-0">
                        <i class="ti ti-info-circle me-1"></i>
                        All records shown above will be copied to every selected destination class.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>