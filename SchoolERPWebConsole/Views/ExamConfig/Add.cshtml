@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.ExamConfigAddViewModel
@{
    ViewData["Title"] = "Add Exam Config";
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditExam == null ? "Add Exam Config" : "Edit Exam Config")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/ExamConfig/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">

            <div class="card-body">
                <form id="itemForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditExam?.ExamConfigID ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(Model.EditExam?.CreatedBy ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditExam?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditExam?.SessionID ?? 0)">
                    @* <input type="hidden" id="txtItemId" value="0"> *@
                    <div class="row">                        
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Class <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlClass" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.Classes != null)
                                {
                                    @foreach (var rt in Model.Classes)
                                    {
                                        <option value="@rt.ClassID" selected="@(Model.EditExam?.ClassID == rt.ClassID)">@rt.ClassName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errDdlClass">
                                Class is required.
                            </div>
                        </div>
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Exam Group <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlExamGroup" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.ExamGroup != null)
                                {
                                    @foreach (var rt in Model.ExamGroup)
                                    {
                                        <option value="@rt.ExamGroupId" selected="@(Model.EditExam?.ExamGroupID == rt.ExamGroupId)">@rt.ExamGroupName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errDdlExamGroup">
                                Exam group is required.
                            </div>
                        </div>
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Exam  <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlExam" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.Exam != null)
                                {
                                    @foreach (var rt in Model.Exam)
                                    {
                                        <option value="@rt.ExamId" selected="@(Model.EditExam?.ExamID == rt.ExamId)">[@rt.ExamId] @rt.ExamName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errDdlExam">
                                Exam is required.
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label fw-semibold">Marge Exam <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlSubjectType">
                                <option value="">Select Type</option>
                                <option value="A" selected="@(Model.EditExam?.MargeExam == "A")">A</option>
                                <option value="B" selected="@(Model.EditExam?.MargeExam == "B")">B</option>
                                <option value="C" selected="@(Model.EditExam?.MargeExam == "C")">C</option>
                                <option value="D" selected="@(Model.EditExam?.MargeExam == "D")">D</option>
                                <option value="E" selected="@(Model.EditExam?.MargeExam == "E")">E</option>

                            </select>
                            <div class="invalid-feedback" id="errDdlSubjectType"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Percentage(%) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" value="@Model.EditExam?.Percentage" id="txtPercentage" placeholder="e.g. 10" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtPercentage"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Sequence</label>
                            <input type="number" class="form-control" value="@Model.EditExam?.Sequence" id="txtSequence" placeholder="e.g. 1" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtSequence"></div>
                        </div>                        
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(Model.EditExam?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/ExamConfig.js"></script>
}