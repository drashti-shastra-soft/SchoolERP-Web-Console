@model SchoolERPWebConsole.Domain.ItemStockAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Item Stock";

    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    var isEdit = Model.EditItemStock != null;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit Item Stock" : "Add Item Stock")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if ((isEdit && p.CanEdit) || (!isEdit && p.CanAdd))
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/ItemStock/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div id="pageNotice"></div>

<form id="itemStockForm" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">

                    <!-- IMPORTANT: this must be ItemStockId, not ItemCategoryId -->
                    <input type="hidden" id="recordId" value="@(Model.EditItemStock?.ItemStockId ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditItemStock?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditItemStock?.SessionID ?? 0)">

                    <div class="row row-gap-3">

                        <!-- Item Category -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Item Category<span class="text-danger">*</span></label>
                            <select id="ddlItemCategory" class="form-select form-control">
                                <option value="">Select Item Category</option>
                                @foreach (var c in Model.ItemCategory)
                                {
                                    <option value="@c.Id" selected="@(Model.EditItemStock?.ItemCategoryId == c.Id)">@c.Name</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlItemCategory">Item Category is required.</div>
                        </div>

                        <!-- Item (cascades from Category) -->
                        <div class="col-md-4 mb-3">
                            <input type="hidden" id="hdnItemId" value="@(Model.EditItemStock?.ItemId ?? 0)" />
                            <label class="form-label">Item<span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlItem" style="width:100%;" disabled>
                                <option value="">-- Select Item Category First --</option>
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlItem">Item is required.</div>
                        </div>

                        <!-- Item Supplier -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Item Supplier</label>
                            <select id="ddlItemSupplier" class="form-select form-control">
                                <option value="">Select Item Supplier</option>
                                @foreach (var c in Model.ItemSupplier)
                                {
                                    <option value="@c.Id" selected="@(Model.EditItemStock?.ItemSupplierId == c.Id)">@c.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Item Store -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Item Store</label>
                            <select id="ddlItemStore" class="form-select form-control">
                                <option value="">Select Item Store</option>
                                @foreach (var c in Model.ItemStore)
                                {
                                    <option value="@c.Id" selected="@(Model.EditItemStock?.ItemStoreId == c.Id)">@c.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Quantity: unit multiplier + count, matching the target UI's "+ ∨ | 1000" stepper -->
                        <div class="col-md-4">
                            <label class="form-label" id="qtyLabel">
                                Quantity<span class="text-danger">*</span>
                                <span class="text-muted small" id="qtyUnit"></span>
                                <span id="qtyMultiplierHint" class="text-muted small"></span>
                            </label>
                            <div class="input-group">
                                <select id="ddlQtyUnit" class="form-select" style="max-width:110px;">
                                    <option value="1" selected>+</option>
                                    <option value="0">-</option>
                                </select>
                                <input type="number" min="1" step="1" class="form-control" id="txtQtyCount"
                                       value="@(Model.EditItemStock?.Quantity)" placeholder="Enter quantity">
                            </div>
                            <!-- Actual quantity sent to the server (count × multiplier) -->
                            <input type="hidden" id="txtQuantity" value="@(Model.EditItemStock?.Quantity)">
                            <div class="text-danger small mt-1 d-none" id="errQuantity">Quantity must be greater than zero.</div>
                        </div>

                        <!-- Purchase Price -->
                        <div class="col-md-4">
                            <label class="form-label">Purchase Price (@Model.CurrencySymbol)<span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">@Model.CurrencySymbol</span>
                                <input type="number" min="0" step="0.01" class="form-control" id="txtPurchasePrice"
                                       value="@(Model.EditItemStock?.PurchasePrice)" placeholder="Enter purchase price">
                            </div>
                            <div class="text-danger small mt-1 d-none" id="errPurchasePrice">Purchase price is required.</div>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtDate" required
                                   value="@(Model.EditItemStock?.PurchaseDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div class="text-danger small mt-1 d-none" id="errDate">Date is required.</div>
                        </div>

                        <!-- Attachment -->
                        <div class="col-md-6">
                            <label class="form-label">Attach Document</label>
                            <input type="file" class="form-control" id="attachmentFile" name="attachmentFile"
                                   accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                            <small class="text-muted" id="fileInfo"></small>

                            @if (!string.IsNullOrEmpty(Model.EditItemStock?.Attachment))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@Model.EditItemStock.Attachment" target="_blank" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@Model.EditItemStock.FileName
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                            <input type="hidden" id="hdnExistingFile" value="@Model.EditItemStock?.FileName">
                            <input type="hidden" id="hdnRemoveFile" value="false">
                        </div>

                        <!-- Description -->
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" id="txtDescription" rows="3"
                                      placeholder="Enter description">@Model.EditItemStock?.Description</textarea>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditItemStock == null || Model.EditItemStock.IsActive ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        // Pre-selected values for edit mode, so the Item dropdown can be
        // re-populated and re-selected after the category cascade loads.
        window.editItemId = @(Model.EditItemStock?.ItemId ?? 0);
    </script>

    <script src="~/assets/js/ItemStock.js"></script>
}
