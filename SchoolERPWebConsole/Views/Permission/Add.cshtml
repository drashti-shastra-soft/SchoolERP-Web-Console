@model SchoolERPWebConsole.Domain.MstUserManagementAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Currency";
    var p = Model.Permissions;
    var c = Model.EditPermissions;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(c == null ? "Add Permission" : "Edit Permission")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" id="btnSave" onclick="saveItem()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Permission/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- General / server-side notice -->
<div id="currencyModalNotice" class="alert alert-danger d-none" role="alert"></div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="itemForm" class="row">
                    <input type="hidden" id="txtItemId" value="@(c?.PermissionID ?? 0)">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Permission Name (Standard Action) <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtPermissionName"
                               value="@(c?.PermissionName)"
                        placeholder="e.g. View / Add / Export" autocomplete="off">
                        <div class="invalid-feedback" id="errTxtPermissionName"></div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Display Label <span class="text-danger">*</span></label>
                        <input type="text" class="form-control"
                               value="@(c?.DisplayLabel)"
                        id="txtDisplayLabel" placeholder="e.g. View Records" autocomplete="off">
                        <div class="invalid-feedback" id="errTxtDisplayLabel"></div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="isActive" checked="@(c == null || c.IsActive)">
                            <label class="form-check-label fw-bold" for="isActive">Active</label>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/Permission.js"></script>
}
