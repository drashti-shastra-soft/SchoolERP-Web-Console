@model SchoolERPWebConsole.Domain.RemarksFeedingAddViewModel
@{
    ViewData["Title"] = "Remarks Feeding";
    Layout = "_Layout"; // adjust to your shared layout
    var p = Model.Permissions;
}

@* =========================================================
   Remarks Feeding
   Assumptions (adjust to match your actual project):
   - No Subject/Co-Scholastic dimension on this tab - only Class/Section/Exam
     (matches the screenshot: Class + Exam + Section filters, no subject dropdown).
   - Exams for Class: GET /ExamConfig/GetGradePreview?companyId=&sessionId=&classId=
   - Grid (students + existing remark) for Class/Section/Exam:
     GET /RemarksFeeding/GetGridData?classId=&sectionId=&examId=
   - Save: POST /RemarksFeeding/SaveRemarksFeeding (RemarksFeedingRequest)
   - Delete (checked rows only): POST /RemarksFeeding/DeleteRemarksFeeding (List<int>)
   - Sections come from /Academics/GetSectionsByClass/{classId}, same as the
     other Marks/Co-Scholastic/Attendance Feeding screens.
   - Bootstrap + jQuery-free vanilla JS + SweetAlert2 (Swal), matching the
     rest of the admin panel.
   ========================================================= *@

<div class="rf-wrapper">

    <div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
        <div></div>
        <div class="d-flex align-items-center flex-wrap gap-1">
            @if (p.CanEdit)
            {
                <button class="btn btn-warning top-btn" id="btnEdit">
                    <i class="ti ti-edit me-1"></i> EDIT
                </button>
            }
            @if (p.CanAdd || p.CanEdit)
            {
                <button class="btn btn-secondary top-btn" id="btnSave" disabled>
                    <i class="ti ti-device-floppy me-1"></i> SAVE
                </button>
            }
            @if (p.CanDelete)
            {
                <button class="btn btn-danger top-btn" id="btnDelete">
                    <i class="ti ti-trash me-1"></i> DELETE
                </button>
            }
            <button class="btn btn-dark top-btn" id="btnReset">
                <i class="ti ti-refresh me-1"></i> RESET
            </button>
        </div>
    </div>

    <div class="rf-panel">
        <div class="rf-panel-header">Remarks Feeding</div>

        <!-- Filters -->
        <div class="rf-filters">
            <div class="rf-filter">
                <label>Class:<span class="text-danger">*</span></label>
                <select id="ddlClass" class="form-control form-control-sm" onchange="onClassChange()">
                    <option value="">-- Select --</option>
                    @foreach (var c in Model.Class)
                    {
                        <option value="@c.ClassID">@c.ClassName</option>
                    }
                </select>
            </div>
            <div class="rf-filter">
                <label>Section:<span class="text-danger">*</span></label>
                <select id="ddlSection" class="form-control form-control-sm" onchange="onSectionChange()">
                    <option value="">-- Select --</option>
                </select>
            </div>
            <div class="rf-filter">
                <label>Exam:<span class="text-danger">*</span></label>
                <select id="ddlExam" class="form-control form-control-sm" onchange="onExamChange()">
                    <option value="">-- Select --</option>
                </select>
            </div>
        </div>

        <!-- Grid -->
        <div class="rf-grid-scroll">
            <table class="table rf-table" id="tblRemarksFeeding">
                <thead>
                    <tr>
                        <th style="width:36px;"><input type="checkbox" id="chkSelectAll" /></th>
                        <th style="width:70px;">Roll No.</th>
                        <th style="width:120px;">SR Code</th>
                        <th style="width:110px;">Student ID</th>
                        <th>Father Name</th>
                        <th>Student Name</th>
                        <th>Remark</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr>
                        <td colspan="7" class="text-center text-muted">
                            Select Class, Section and Exam to load students.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="rf-footer">
            T.ST. : <span id="totalStudents">0</span>
        </div>
    </div>
</div>

<style>
    .rf-panel {
        border: 1px solid #ccd6e5;
    }

    .rf-panel-header {
        background: #2b4a8b;
        color: #fff;
        padding: 6px 12px;
        font-weight: 600;
    }

    .rf-filters {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        padding: 12px;
    }

    .rf-filter {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .rf-filter label {
            margin: 0;
            white-space: nowrap;
            font-weight: 600;
        }

        .rf-filter select {
            min-width: 150px;
        }

    .rf-grid-scroll {
        max-height: 480px;
        overflow-y: auto;
    }

    .rf-table {
        margin: 0;
    }

        .rf-table th, .rf-table td {
            text-align: center;
            vertical-align: middle;
        }

            .rf-table td:nth-child(4),
            .rf-table td:nth-child(5) {
                text-align: left;
            }

            .rf-table td:nth-child(5) {
                font-weight: 600;
            }

        .rf-table input[type="text"].remarkInput {
            width: 100%;
            min-width: 220px;
            text-align: left;
            border: 1px solid #ccc;
            border-radius: 3px;
            padding: 4px 6px;
        }

        .rf-table input:disabled {
            background: #eee;
            color: #666;
        }

    .rf-footer {
        background: #2b4a8b;
        color: #fff;
        padding: 8px 12px;
        font-weight: 700;
    }
</style>

<script src="~/assets/js/RemarksFeeding.js">
</script>
