@model SchoolERPWebConsole.Domain.CurrencyAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Currency";
    var p = Model.Permissions;
    var c = Model.EditCurrency;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(c == null ? "Add Currency" : "Edit Currency")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" id="btnSave" onclick="saveItem()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Currencies/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<!-- General / server-side notice -->
<div id="currencyModalNotice" class="alert alert-danger d-none" role="alert"></div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="itemForm">
                    <input type="hidden" id="txtItemId" value="@(c?.CurrencyId ?? 0)">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Currency Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCurrencyTitle"
                                   value="@(c?.CurrencyTitle)"
                                   placeholder="e.g. US Dollar" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtCurrencyTitle"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Currency Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCurrencyCode"
                                   value="@(c?.CurrencyCode)"
                                   placeholder="e.g. USD" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtCurrencyCode"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Currency Symbol <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCurrencySymbol"
                                   value="@(c?.CurrencySymbol)"
                                   placeholder="e.g. $" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtCurrencySymbol"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Conversion Rate <span class="text-danger">*</span></label>
                            <input type="number" step="0.0001" class="form-control" id="txtCurrencyConvRate"
                                   value="@(c != null ? c.CurrencyConvRate.ToString("0.####") : "")"
                                   placeholder="e.g. 1.0000">
                            <div class="invalid-feedback" id="errTxtCurrencyConvRate"></div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-5">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkCurrencyBase"
                                       checked="@(c?.CurrencyBase == true)">
                                <label class="form-check-label" for="chkCurrencyBase">Base Currency</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                       checked="@(c == null || c.IsActive)">
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                    @*  <div class="form-text mt-2 text-info">
                        <i class="fas fa-info-circle me-1"></i>Setting a currency as <strong>Base</strong> will unset existing base currency.
                    </div> *@
                </form>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/Currency.js"></script>
}
