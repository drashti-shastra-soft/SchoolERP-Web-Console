@model SchoolERPWebConsole.Domain.CommunicationLogPageViewModel
@functions {
    string Tick(bool v) => v ? "<i class=\"ti ti-checkbox text-primary\"></i>" : "";
    string Fmt(DateTime? d) => d.HasValue ? d.Value.ToString("dd-MM-yyyy hh:mm tt").ToLower() : "";
}
@{
    var isSchedule = Model.IsSchedule;
    var colCount = isSchedule ? 10 : 8;
    var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
    var from = Model.TotalRecords == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    var to = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords);

    // header helper: key = SortColumn value understood by the API
    Func<string, string, Microsoft.AspNetCore.Html.IHtmlContent> Th = (key, text) =>
    {
        var sorted = string.Equals(Model.SortColumn, key, StringComparison.OrdinalIgnoreCase);
        var icon = !sorted ? "ti-selector" : (Model.SortDir == "ASC" ? "ti-chevron-up" : "ti-chevron-down");
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<th class=\"sortable {(sorted ? "sorted" : "")}\" data-sort=\"{key}\">{text}<i class=\"ti {icon} sort-ico\"></i></th>");
    };
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="CommunicationLogTable">
                <thead class="table-light">
                    <tr>
                        @Th("TITLE", "Title")
                        @Th("DESCRIPTION", isSchedule ? "Message" : "Description")
                        @Th("DATE", "Date")
                        @if (isSchedule)
                        {
                            @Th("SCHEDULEDATE", "Schedule Date")
                        }
                        @Th("EMAIL", "Email")
                        @Th("SMS", "SMS")
                        @Th("GROUP", "Group")
                        @Th("INDIVIDUAL", "Individual")
                        @Th("CLASS", "Class")
                        @if (isSchedule)
                        {
                            <th class="no-export text-center">Action</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs != null && Model.Logs.Any())
                    {
                        foreach (var l in Model.Logs)
                        {
                            <tr data-id="@l.CommunicationId">
                                <td>@l.Title</td>
                                <td>@l.Description</td>
                                <td>@Fmt(l.Date)</td>
                                @if (isSchedule)
                                {
                                    <td>@Fmt(l.ScheduleDate)</td>
                                }
                                <td class="text-center">@Html.Raw(Tick(l.Email))</td>
                                <td class="text-center">@Html.Raw(Tick(l.SMS))</td>
                                <td class="text-center">@Html.Raw(Tick(l.Group))</td>
                                <td class="text-center">@Html.Raw(Tick(l.Individual))</td>
                                <td class="text-center">@Html.Raw(Tick(l.Class))</td>
                                @if (isSchedule)
                                {
                                    <td class="text-center text-nowrap">
                                        <a href="javascript:void(0)" class="text-dark me-2 btn-view-log" data-id="@l.CommunicationId" title="Details">
                                            <i class="ti ti-menu-2"></i>
                                        </a>
                                        <a href="javascript:void(0)" class="text-danger btn-delete-schedule" data-id="@l.CommunicationId" title="Delete">
                                            <i class="ti ti-trash"></i>
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        @* No colspan'd row: DataTables rejects it. Empty body renders its own empty state. *@
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Logs == null || !Model.Logs.Any())
        {
            <div class="text-center text-muted py-4">No records found.</div>
        }

        <div class="d-flex justify-content-between align-items-center mt-2 px-1">
            <small class="text-muted">Records: @from to @to of @Model.TotalRecords</small>

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm justify-content-end mb-0">
                        @for (int pg = 1; pg <= totalPages; pg++)
                        {
                            <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", "CommunicationLog", new {
                                       logType = Model.LogType, pageNumber = pg, pageSize = Model.PageSize,
                                       searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId,
                                       fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"),
                                       sortColumn = Model.SortColumn, sortDir = Model.SortDir })">@pg</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
