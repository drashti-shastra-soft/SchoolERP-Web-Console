@*
    VIEW: CommunicationLog / Index.cshtml
    PURPOSE: Email / SMS Log (logType=LOG) and Schedule Email SMS Log (logType=SCHEDULE)
*@
@model SchoolERPWebConsole.Domain.CommunicationLogPageViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    var title = Model.IsSchedule ? "Schedule Email SMS Log" : "Email / SMS Log";
    ViewData["Title"] = title;
    var p = Model.Permissions;
}

<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@title</h6>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()
<div id="reportPageNotice"></div>

<div class="row">
    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" id="txtSearchInput" value="@Model.SearchTerm"
                               class="form-control border-0 ps-2 search-input-responsive"
                               placeholder="Search by Title, Description..." />
                    </div>

                    <!-- Hidden form for filter submission -->
                    <form method="get" id="frmSearch" style="display:none;">
                        <input type="hidden" name="logType" id="hdnLogType" value="@Model.LogType" />
                        <input type="hidden" name="pageNumber" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                        <input type="hidden" name="searchTerm" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="sessionId" id="hdnSessionID" value="@Model.SessionId" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value="@Model.CompanyId" />
                        <input type="hidden" name="fromDate" id="hdnFromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="toDate" id="hdnToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="sortColumn" id="hdnSortColumn" value="@Model.SortColumn" />
                        <input type="hidden" name="sortDir" id="hdnSortDir" value="@Model.SortDir" />
                    </form>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown">
                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn text-primary" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="button" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none" id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="filter-body pb-2">
                                <div class="row g-2 p-2">

                                 @*    @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                               {
                                   Companies = Model.Companies,
                                   Sessions = Model.Sessions,
                                   CompanyId = Model.CompanyId,
                                   SessionId = Model.SessionId
                               }) *@

                                    <div class="col-md-12 mb-3">
                                        <label class="form-label mb-1">Company</label>
                                        <select class="form-select form-control select2"
                                                id="@Model.CompanyId"
                                                data-role="filter-company"
                                                data-placeholder="Select company">
                                            <option value="">All</option>
                                            @foreach (var c in Model.Companies ?? new())
                                            {
                                                <option value="@c.CompanyId" selected="@(Model.CompanyId == c.CompanyId)">@c.SchoolName</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">From Date</label>
                                        <input type="date" id="dtFilterFrom" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">To Date</label>
                                        <input type="date" id="dtFilterTo" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="CommunicationLogTableContainer">
        @await Html.PartialAsync("_CommunicationLogTablePartial", Model)
    </div>
</div>

@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }

        th.sortable {
            cursor: pointer;
            white-space: nowrap;
            user-select: none;
        }

            th.sortable .sort-ico {
                font-size: 10px;
                opacity: .4;
                margin-left: 2px;
            }

            th.sortable.sorted .sort-ico {
                opacity: 1;
            }
    </style>
}

@section Scripts {
    <script>
        window.canExport = @JsonSerializer.Serialize(p.CanExport);
        window.canPrint = @JsonSerializer.Serialize(p.CanPrint);
        window.commLogType = @JsonSerializer.Serialize(Model.LogType);
        window.commLogTitle = @JsonSerializer.Serialize(title);
    </script>
    <script src="~/assets/js/CommunicationLog.js"></script>
}
