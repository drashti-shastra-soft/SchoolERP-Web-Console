@model SchoolERPWebConsole.Domain.LessonPlanPageViewModel
@using System.Security.Claims
@using System.Text.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Lesson Plan";    
    var p = Model.Permissions;
}


<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Lesson Plan</h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        @if (p.CanAdd)
        {
            <a href="/LessonPlan/Add" class="btn btn-primary top-btn"><i class="ti ti-plus"></i> Add</a>
        }
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="editSelected()">
                <i class="ti ti-pencil me-1"></i>Edit
            </button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()">
                <i class="ti ti-trash me-1"></i>Delete
            </button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning d-inline-flex align-items-center dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
        @if (ViewBag.IsStudent == true)
        {
            <a href="/DailyAssignment/index" class="btn btn-primary top-btn">Daily Assignment</a>
        }
    </div>

</div>
<!-- End Page Header -->

<div id="pageNotice"></div>

<!-- start row -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">
                    <!-- ── Search box (name="search" so form submits it) ── -->
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text"
                               name="search"
                               id="txtSearchInput"
                               value="@Model.SearchTerm"
                               class="form-control border-0 ps-2 search-input-responsive"
                               placeholder="Search by Subject Name, Class ..." />
                    </div>

                    <!-- Hidden form for filter submission — outside Bootstrap dropdown -->
                    <form method="get" asp-action="Index" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="sessionID" id="hdnSessionID" value=@Model.SessionId />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value=@Model.CompanyId />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                        <input type="hidden" id="hdnClassID" name="classID" value="@Model.ClassID" />
                        <input type="hidden" id="hdnSectionID" name="sectionId" value="@Model.SectionID" />
                        <input type="hidden" id="hdnSubjectGroupID" name="subjectGroupId" value="@Model.SubjectGroupID" />
                        <input type="hidden" id="hdnSubjectID" name="subjectId" value="@Model.SubjectID" />
                    </form>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl"
                             id="filter-dropdown">

                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn text-primary"
                                            onclick="resetAllFilters()" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="submit" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                            id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="filter-body pb-0">
                                <div class="row">
                                    @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                               {
                                   Companies = Model.Companies,
                                   Sessions = Model.Sessions,
                                   CompanyId = Model.CompanyId,
                                   SessionId = Model.SessionId
                               })
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Classes <span class="text-danger">*</span></label>
                                        <select class="form-select form-control select2"
                                                id="ddlClass" onchange="loadSections(this.value)"
                                                data-placeholder="Select Classes">
                                            <option value="">All</option>
                                            @if (Model.Classes != null)
                                            {
                                                @foreach (var ut in Model.Classes)
                                                {
                                                    <option value="@ut.ClassID" selected="@(Model.ClassID == ut.ClassID)">
                                                        @ut.ClassName
                                                    </option>
                                                }
                                            }

                                        </select>
                                        <div class="invalid-feedback" id="errDdlClasses"></div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Section <span class="text-danger">*</span></label>
                                        <select id="ddlSection" class="form-select form-control" onchange="loadSubjectGroups();">
                                            <option value="">Select Section</option>
                                        </select>
                                        <div class="invalid-feedback" id="errDdlSection"></div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Subject Group <span class="text-danger">*</span></label>
                                        <select id="ddlSubjectGroup" class="form-select form-control" onchange="loadSubjects(this.value);">
                                            <option value="">Select Group</option>
                                        </select>
                                        <div class="invalid-feedback" id="errDdlSubjectGroup"></div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Subject <span class="text-danger">*</span></label>
                                        <select id="ddlSubject" class="form-select form-control">
                                            <option value="">Select Subject</option>
                                        </select>
                                        <div class="invalid-feedback" id="errDdlSubject"></div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="lessonPlanTableContainer">
        @await Html.PartialAsync("_LessonPlanTablePartial", Model)
    </div>
    
    
</div>


@section Styles {
    <style>
        /* =====================================================================
           Lesson Plan table — card-style row UI (matches reference design)
           Drop-in stylesheet. Reuses your EXISTING classes / markup.
           ===================================================================== */

        

        /* ── Table shell ──────────────────────────────────────────────────── */
        #homeworkTable {
            min-width: 1080px; /* keeps columns readable on desktop */
            border-collapse: separate;
            border-spacing: 0;
        }

            #homeworkTable thead th {
                white-space: nowrap;
                background: #f8fafc;
                color: #64748b;
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                font-weight: 700;
                border-bottom: 1px solid #e6e9ef;
                padding: .8rem 1rem;
                position: sticky;
                top: 0;
            }

            #homeworkTable tbody td {
                padding: .7rem 1rem;
                border-bottom: 1px solid #f1f3f7;
                vertical-align: middle;
                color: #334155;
                font-size: .875rem;
            }

           /*  #homeworkTable tbody tr:last-child td {
                border-bottom: none;
            } */

        /* Row states */
        .item-row {
            cursor: pointer;
            
        }

            .item-row:hover {
                background-color: #f8fafc;
            }

            .item-row.bg-light-primary,
            .item-row.selected {
                background-color: rgba(99, 102, 241, .07);
                box-shadow: inset 3px 0 0 #6366f1;
            }

        /* Checkbox accent */
        #homeworkTable .form-check-input:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }

        #homeworkTable .form-check-input:focus {
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .15);
            border-color: #6366f1;
        }

        /* ── Generic chip base ───────────────────────────────────────────── */
        .chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .76rem;
            font-weight: 600;
            padding: 4px 11px;
            border-radius: 20px;
            white-space: nowrap;
            line-height: 1.4;
        }

        /* ── Class / Section cell ─────────────────────────────────────────── */
        .class-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .class-icon {
            flex: 0 0 auto;
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: #eaf2ff;
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }

        .class-text {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

        .class-name {
            font-weight: 700;
            color: #0f172a;
            font-size: .875rem;
        }

        .section-name {
            color: #94a3b8;
            font-size: .76rem;
        }

        /* ── Group chip ───────────────────────────────────────────────────── */
        .chip-group {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e6e9ef;
        }

        /* ── Subject / Teacher cell ──────────────────────────────────────── */
        .teacher-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar-circle {
            flex: 0 0 auto;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .72rem;
            font-weight: 700;
        }

        .avatar-c0 {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .avatar-c1 {
            background: #fee2e2;
            color: #dc2626;
        }

        .avatar-c2 {
            background: #dcfce7;
            color: #15803d;
        }

        .avatar-c3 {
            background: #ede9fe;
            color: #6d28d9;
        }

        .avatar-c4 {
            background: #ffedd5;
            color: #c2410c;
        }

        .teacher-text {
            display: flex;
            flex-direction: column;
            gap: 3px;
            align-items: flex-start;
        }

        .chip-subject {
            padding: 2px 10px;
            font-size: .7rem;
        }

        .chip-subject-c0 {
            background: #f3e8ff;
            color: #7c3aed;
        }

        .chip-subject-c1 {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .chip-subject-c2 {
            background: #dcfce7;
            color: #15803d;
        }

        .chip-subject-c3 {
            background: #ffedd5;
            color: #c2410c;
        }

        .chip-subject-c4 {
            background: #ffe4e6;
            color: #be123c;
        }

        .teacher-name {
            font-weight: 600;
            color: #1e293b;
            font-size: .82rem;
        }

        /* ── Lesson description cell ─────────────────────────────────────── */
        .lesson-desc {
            color: #334155;
            font-size: .84rem;
            line-height: 1.4;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* ── Chapters / tags column ──────────────────────────────────────── */
        .chapter-tags {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        .chip-tag {
            background: #fff;
            color: #334155;
            border: 1px solid #e6e9ef;
            font-weight: 500;
        }

            .chip-tag i {
                color: #94a3b8;
            }

        .extra-tags {
            display: none;
            flex-direction: column;
            gap: 6px;
        }

            .extra-tags.expanded {
                display: flex;
            }

        .more-tags-toggle {
            font-size: .76rem;
            font-weight: 600;
            color: #6366f1;
            text-decoration: none;
            cursor: pointer;
        }

            .more-tags-toggle:hover {
                text-decoration: underline;
            }

        /* ── Created by cell ──────────────────────────────────────────────── */
        .created-by {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            color: #64748b;
            font-size: .82rem;
        }

            .created-by i {
                color: #94a3b8;
            }

        /* ── Status switch ────────────────────────────────────────────────── */
        .section-status-switch {
            width: 2.4em !important;
            height: 1.25em;
            cursor: pointer;
        }

            .section-status-switch:checked {
                background-color: #4f46e5;
                border-color: #4f46e5;
            }

            .section-status-switch:focus {
                box-shadow: 0 0 0 3px rgba(79, 70, 229, .15);
            }

        /* ── Filter dropdown ──────────────────────────────────────────────── */
        .filter-dropdown.dropdown-lg {
            width: min(560px, 92vw);
        }

        .filter-header {
            padding: .9rem 1.1rem;
        }

        .filter-body {
            padding: 1.1rem 1.1rem 0;
        }

        /* ── Pagination ───────────────────────────────────────────────────── */
        .pagination .page-link {
            color: #475569;
            border-color: #e6e9ef;
            min-width: 34px;
            text-align: center;
            border-radius: 8px !important;
            margin: 0 2px;
            transition: all .12s ease;
        }

        .pagination .page-item.active .page-link {
            background: #6366f1;
            border-color: #6366f1;
            color: #fff;
        }

        .pagination .page-link:hover {
            background: #eef2ff;
            color: #4338ca;
            border-color: #c7d2fe;
        }

        .pagination .page-item.disabled .page-link {
            color: #cbd5e1;
            background: #fff;
        }

        /* Hide DataTables default chrome if present */
        .dt-buttons {
            display: none !important;
        }

        #homeworkTable_filter {
            display: none;
        }

        /* =====================================================================
           RESPONSIVE — turn the table into stacked cards below 768px.
           No horizontal scroll, no sticky columns, labels injected via data-label.
           ===================================================================== */
        

        @@media (max-width: 575.98px) {
            h6.fw-bold {
                font-size: 1rem;
            }

            .card-body.p-3 {
                padding: .75rem !important;
            }

            .class-icon,
            .avatar-circle {
                width: 30px;
                height: 30px;
            }
        }
    </style>
}

@section Scripts {

    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);

        // Expands/collapses the hidden chapter chips behind the "+N more" link.
        function toggleExtraTags(linkEl) {
            var container = linkEl.closest('.chapter-tags');
            if (!container) return;
            var extra = container.querySelector('.extra-tags');
            if (!extra) return;
            var isExpanded = extra.classList.toggle('expanded');
            var remaining = extra.querySelectorAll('.chip-tag').length;
            linkEl.textContent = isExpanded ? 'Show less' : ('+' + remaining + ' more');
        }
    </script>

    <script src="~/assets/js/LessonPlan.js"></script>
}
