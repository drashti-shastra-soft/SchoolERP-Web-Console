@model SchoolERPWebConsole.Domain.MarksFeedingAddViewModel
@{
    ViewData["Title"] = "Marks Feeding";
    Layout = "_Layout"; // adjust to your shared layout
    var p = Model.Permissions;
}

@* =========================================================
   Marks Feeding
   Assumptions (adjust to match your actual project):
   - Subjects for Class/Section: GET /MarksFeeding/GetSubjectByClassandSectionId?classId=&sectionId=
   - Exams (with Theory/Practical Max/Min) for Class/Subject:
     GET /MarksFeeding/GetAllExamBySubjectIdList?classId=&subjectId=
   - Grid (students + existing marks) for Class/Section/Subject/Exam:
     GET /MarksFeeding/GetGridData?classId=&sectionId=&subjectId=&examId=
   - Save: POST /MarksFeeding/SaveMarksFeeding  (MarksFeedingRequest)
   - Delete (clears marks for the whole selection): POST /MarksFeeding/DeleteMarksFeeding (MarksFeedingGetRequest)
   - Sections come from /Academics/GetSectionsByClass/{classId}, same as
     the Paper Marks Details screen.
   - Bootstrap + jQuery-free vanilla JS + SweetAlert2 (Swal), matching the
     rest of the admin panel.
   ========================================================= *@

<div class="mf-wrapper">

    <div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
        <div></div>
        <div class="d-flex align-items-center flex-wrap gap-1">
            @if (p.CanEdit)
            {
                <button class="btn btn-warning top-btn" id="btnEdit">
                    <i class="ti ti-edit me-1"></i> EDIT
                </button>
            }
            @if (p.CanAdd || p.CanEdit)
            {
                <button class="btn btn-secondary top-btn" id="btnSave" disabled>
                    <i class="ti ti-device-floppy me-1"></i> SAVE
                </button>
            }
            @if (p.CanDelete)
            {
                <button class="btn btn-danger top-btn" id="btnDelete">
                    <i class="ti ti-trash me-1"></i> DELETE
                </button>
            }
            <button class="btn btn-dark top-btn" id="btnReset">
                <i class="ti ti-refresh me-1"></i> RESET
            </button>
        </div>
    </div>

    <div class="mf-panel">
        <div class="mf-panel-header">Marks Feeding</div>

        <!-- Filters + Max/Min summary -->
        <div class="mf-filters">
            <div class="mf-filter-col">
                <div class="mf-filter">
                    <label>Class:<span class="text-danger">*</span></label>
                    <select id="ddlClass" class="form-control form-control-sm" onchange="onClassChange()">
                        <option value="">-- Select --</option>
                        @foreach (var c in Model.Class)
                        {
                            <option value="@c.ClassID">@c.ClassName</option>
                        }
                    </select>
                </div>
                <div class="mf-filter">
                    <label>Section:<span class="text-danger">*</span></label>
                    <select id="ddlSection" class="form-control form-control-sm" onchange="onSectionChange()">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="mf-filter">
                    <label>Subject:<span class="text-danger">*</span></label>
                    <select id="ddlSubject" class="form-control form-control-sm" onchange="onSubjectChange()">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                <div class="mf-filter">
                    <label>Exam:<span class="text-danger">*</span></label>
                    <select id="ddlExam" class="form-control form-control-sm" onchange="onExamChange()">
                        <option value="">-- Select --</option>
                    </select>
                </div>
            </div>

            <div class="mf-summary" id="mfSummary" style="display:none;">
                <div class="mf-summary-row">
                    <span class="mf-summary-label theory">Theory Max M:<b id="sumTheoryMax">0</b></span>
                    <span class="mf-summary-label">Min M: <b id="sumTheoryMin">0</b></span>
                </div>
                <div class="mf-summary-row">
                    <span class="mf-summary-label practical">Practical Max M:<b id="sumPracticalMax">0</b></span>
                    <span class="mf-summary-label">Min M: <b id="sumPracticalMin">0</b></span>
                </div>
                <div class="mf-summary-legend">
                    <b>Practical Marks</b> &nbsp; -1 = ML, &nbsp; -2 = Absent, &nbsp; -3 = Exempted
                </div>
            </div>
        </div>

        <!-- Grid -->
        <div class="mf-grid-scroll">
            <table class="table mf-table" id="tblMarksFeeding">
                <thead>
                    <tr>
                        <th style="width:36px;"><input type="checkbox" id="chkSelectAll" /></th>
                        <th style="width:70px;">RollNo</th>
                        <th style="width:120px;">SR Code</th>
                        <th style="width:110px;">Student ID</th>
                        <th>Father Name</th>
                        <th>Student Name</th>
                        <th style="width:70px;">Present</th>
                        <th style="width:70px;">Absent</th>
                        <th style="width:60px;">ML</th>
                        <th style="width:80px;">Exempted</th>
                        <th style="width:110px;" id="thPracticalMarks" style="display:none;">Practical</th>
                        <th style="width:110px;">Marks</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr>
                        <td colspan="11" class="text-center text-muted">
                            Select Class, Section, Subject and Exam to load students.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mf-footer">
            T.ST. : <span id="totalStudents">0</span>
        </div>
    </div>
</div>

<style>
    .mf-panel {
        border: 1px solid #ccd6e5;
    }

    .mf-panel-header {
        background: #2b4a8b;
        color: #fff;
        padding: 6px 12px;
        font-weight: 600;
    }

    .mf-filters {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 16px;
        padding: 12px;
    }

    .mf-filter-col {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .mf-filter {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .mf-filter label {
            margin: 0;
            white-space: nowrap;
            font-weight: 600;
        }

        .mf-filter select {
            min-width: 150px;
        }

    .mf-summary {
        text-align: right;
        font-size: 0.85rem;
    }

    .mf-summary-row {
        display: flex;
        gap: 14px;
        justify-content: flex-end;
        margin-bottom: 2px;
    }

    .mf-summary-label {
        white-space: nowrap;
    }

        .mf-summary-label.theory {
            color: #c62828;
            font-weight: 700;
        }

        .mf-summary-label.practical {
            color: #ef6c00;
            font-weight: 700;
        }

    .mf-summary-legend {
        color: #2b4a8b;
        font-weight: 700;
        margin-top: 4px;
    }

    .mf-grid-scroll {
        max-height: 480px;
        overflow-y: auto;
    }

    .mf-table {
        margin: 0;
    }

        .mf-table th, .mf-table td {
            text-align: center;
            vertical-align: middle;
        }

            .mf-table td:nth-child(4),
            .mf-table td:nth-child(5) {
                text-align: left;
            }

            .mf-table td:nth-child(5) {
                font-weight: 600;
            }

        .mf-table input[type="number"] {
            width: 90px;
            text-align: center;
            border: 1px solid #ccc;
            border-radius: 3px;
            padding: 2px 4px;
        }

        .mf-table input:disabled {
            background: #eee;
            color: #666;
        }

        .mf-table input[type="radio"] {
            width: 16px;
            height: 16px;
        }

    .mf-footer {
        background: #2b4a8b;
        color: #fff;
        padding: 8px 12px;
        font-weight: 700;
    }
</style>

<script src="~/assets/js/MarksFeeding.js">
</script>
