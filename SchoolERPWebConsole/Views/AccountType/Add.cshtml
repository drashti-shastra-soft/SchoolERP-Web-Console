@model SchoolERPWebConsole.Domain.AccountTypeAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Account Type";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

    // Only true admins/backend users should ever see the "System Type" toggle.
    // Adjust the role name / permission flag to whatever your app actually uses.
    var userTypeName = User.FindFirst("UserTypeName")?.Value;

    bool canManageSystemTypes = userTypeName == "Admin" || userTypeName == "SuperAdmin";
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditAccountType == null ? "Add Account Type" : "Edit Account Type")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/AccountType/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditAccountType?.AccountTypeId">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditAccountType?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditAccountType?.SessionID">

                    <div class="row row-gap-3">

                        <!-- Account Type Name -->
                        <div class="col-md-4">
                            <label class="form-label">Account Type <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName"
                                   value="@Model.EditAccountType?.AccountTypeName" placeholder="Enter Account Type">
                            <div class="text-danger small mt-1 d-none" id="nameError">Account Type is required.</div>
                        </div>

                        <!-- Title / Display Label -->
                        <div class="col-md-4">
                            <label class="form-label">Title</label>
                            <input type="text" class="form-control" id="txtDisplayName"
                                   value="@Model.EditAccountType?.DisplayLabel" placeholder="Enter title">
                        </div>

                        <!-- Print Order -->
                        <div class="col-md-4">
                            <label class="form-label">Print Order</label>
                            <input type="number" class="form-control" id="txtPrintOrder"
                                   value="@Model.EditAccountType?.PrintOrder" placeholder="Enter print order">
                        </div>

                        <!-- Message -->
                        <div class="col-md-6">
                            <label class="form-label">Message</label>
                            <input type="text" class="form-control" id="txtMessage"
                                   value="@Model.EditAccountType?.Message" placeholder="Enter message">
                        </div>

                        <!-- Closes To (self-reference dropdown) 
                        <div class="col-md-3">
                            <label class="form-label">Closes To</label>
                            <select class="form-select" id="ddlClosesTo">
                                <option value="">-- None --</option>
                                // if (Model.ClosesToList != null)
                                // {
                                //     foreach (var item in Model.ClosesToList)
                                //     {
                                //         Skip the record currently being edited so it can't close to itself
                                //         if (Model.EditAccountType != null && item.Id == Model.EditAccountType.ClosesTo)
                                //         {
                                //             continue;
                                //         }

                                //         var isSelected = (Model.EditAccountType?.ClosesTo == item.Id) ? "selected" : "";
                                //         <option value="item.Id" selected="isSelected">item.Name</option>
                                //     }
                                // }
                            </select>
                        </div>-->
                        <!-- Closes To (self-reference dropdown) -->
                        <div class="col-md-3">
                            <label class="form-label">Closes To</label>
                            <select class="form-select" id="ddlClosesTo" name="ClosesTo">
                                <option value="">-- None --</option>
                                @if (Model.ClosesToList != null)
                                {
                                    foreach (var item in Model.ClosesToList)
                                    {
                                        if (Model.EditAccountType != null && item.Id == Model.EditAccountType.AccountTypeId)
                                        {
                                            continue;
                                        }

                                        <option value="@item.Id"
                                                selected="@(Model.EditAccountType?.ClosesTo == item.Id)">
                                            @item.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <!-- Control Narration -->
                        <div class="col-md-3">
                            <label class="form-label">Control Narration</label>
                            <input type="text" class="form-control" id="txtControlNarration" value="@Model.EditAccountType?.ControlNarration" placeholder="Enter narration">
                        </div>

                        <!-- Control -->
                        <div class="col-md-3">
                            <label class="form-label">Control</label>
                            <select class="form-select" id="ddlControl">
                                <option value="true" selected="@((Model.EditAccountType?.Control ?? false) ? "selected" : null)">YES</option>
                                <option value="false" selected="@((!(Model.EditAccountType?.Control ?? false)) ? "selected" : null)">NO</option>
                            </select>
                        </div>

                        <!-- Summarize -->
                        <div class="col-md-3">
                            <label class="form-label">Summarize</label>
                            <select class="form-select" id="ddlSummarize">
                                <option value="true" selected="@((Model.EditAccountType?.Summarize ?? false) ? "selected" : null)">YES</option>
                                <option value="false" selected="@((!(Model.EditAccountType?.Summarize ?? false)) ? "selected" : null)">NO</option>
                            </select>
                        </div>

                        <!-- Personal -->
                        <div class="col-md-3">
                            <label class="form-label">Personal</label>
                            <select class="form-select" id="ddlPersonal">
                                <option value="true" selected="@((Model.EditAccountType?.Personal ?? false) ? "selected" : null)">YES</option>
                                <option value="false" selected="@((!(Model.EditAccountType?.Personal ?? false)) ? "selected" : null)">NO</option>
                            </select>
                        </div>

                        <!-- CD Flag -->
                        <div class="col-md-3">
                            <label class="form-label">CD Flag</label>
                            <select class="form-select" id="ddlCDFlag">
                                <option value="">-- Select --</option>
                                <option value="DEBIT" selected="@(Model.EditAccountType?.CDFlag == "DEBIT" ? "selected" : null)">DEBIT</option>
                                <option value="CREDIT" selected="@(Model.EditAccountType?.CDFlag == "CREDIT" ? "selected" : null)">CREDIT</option>
                            </select>
                        </div>

                        <!-- Active -->
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditAccountType?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                        <!-- System Type — ADMIN ONLY -->
                        @if (canManageSystemTypes)
                        {
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkIsSystem"
                                    @(Model.EditAccountType?.IsSystem ?? false ? "checked" : "")
                                    @(Model.EditAccountType != null && Model.EditAccountType.AccountTypeId > 0 ? "disabled" : "")>
                                    <label class="form-check-label" for="chkIsSystem">
                                        System Default Type (reserved ID 1-100)
                                    </label>
                                </div>
                                <div class="text-muted small mt-1">
                                    Only check this for backend-managed defaults. Cannot be changed once saved.
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.canManageSystemTypes = @JsonSerializer.Serialize(canManageSystemTypes);
    </script>
    <script src="~/assets/js/AccountType.js"></script>
}