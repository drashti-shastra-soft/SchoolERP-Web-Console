@{
    ViewData["Title"] = "Fee Opening Balance";
}
<style>
    .info-val {
        font-weight: 600;
        color: #2e6f86;
    }

        .info-val.name {
            color: #0d6efd;
        }

    .ob-entry td {
        background: #f7f7f7;
        vertical-align: middle;
    }

    .table-scroll {
        max-height: 380px;
        overflow: auto;
    }
</style>

<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div><h6 class="fw-bold mb-0">Fee Opening Balance</h6></div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        <button type="button" class="d-none btn top-btn text-white" style="background:#f57c00" id="btnObEdit" disabled>
            <i class="ti ti-edit me-1"></i> Edit
        </button>
        <button type="button" class="d-none btn btn-danger top-btn" id="btnObDelete" disabled>
            <i class="ti ti-trash me-1"></i> Delete
        </button>
        <button type="button" class="btn btn-success top-btn" id="btnObSave" disabled>
            <i class="ti ti-device-floppy me-1"></i> Save
        </button>
        <button type="button" class="btn btn-secondary top-btn" id="btnObReset" disabled>
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
    </div>
</div>

<!-- Student info -->
<div class="card shadow-tbl-outer">    
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-10">
                <div class="row g-3">
                    <div class="col-md-6" style="position:relative;">
                        <label class="form-label fw-semibold">Student ID <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtStudentID" placeholder="Search student id / name" autocomplete="off">
                        <ul id="pinStudentSuggestions" class="pincode-dropdown list-group"></ul>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Admission Session</label>
                        <div class="info-val pt-1" id="lblAdmSession">-</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Name</label>
                        <div class="info-val name" id="lblName">-</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Gender</label>
                        <div class="info-val" id="lblGender">-</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Father Name</label>
                        <div class="info-val" id="lblFather">-</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Mother Name</label>
                        <div class="info-val" id="lblMother">-</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Course Name</label>
                        <div class="info-val" id="lblCourse">-</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Current Branch</label>
                        <div class="info-val" id="lblBranch">-</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Admission Type</label>
                        <div class="info-val" id="lblAdmType">-</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 text-center">
                <img id="imgStudent" src="/assets/img/doctors/doctor-01.jpg" class="rounded"
                     style="width:110px;height:130px;object-fit:cover;" alt="">
            </div>
        </div>
    </div>
</div>

<!-- Opening balance grid -->
<div class="card shadow-tbl-outer mt-2">
    <div class="card-body p-0">
        <div class="table-scroll table-responsive">
            <table class="table mb-0" id="tblOpening">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px" class="text-center">Edit</th>
                        <th style="width:70px">S. No.</th>
                        <th style="width:220px">Opening Month</th>
                        <th>Fee Head</th>
                        <th style="width:140px">Cr./Dr.</th>
                        <th style="width:180px" class="text-end">Amount</th>
                        <th style="width:100px" class="text-center">Add/Delete</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- entry row -->
                    <tr class="ob-entry">
                        <td></td>
                        <td></td>
                        <td>
                            <select class="form-select form-select-sm" id="ddlObMonth" disabled>
                                <option value="">Select</option>
                            </select>
                        </td>
                        <td>
                            <select class="form-select form-select-sm" id="ddlObHead" disabled>
                                <option value="">Select</option>
                            </select>
                        </td>
                        <td>
                            <select class="form-select form-select-sm" id="ddlObDrCr" disabled>
                                <option value="Dr">Debit</option>
                                <option value="Cr">Credit</option>
                            </select>
                        </td>
                        <td>
                            <input type="number" step="0.01" min="0" class="form-control form-control-sm text-end" id="txtObAmount" disabled>
                        </td>
                        <td class="text-center">
                            <i class="ti ti-square-plus text-success" id="btnObAddRow" role="button" title="Add row"
                               style="font-size:1.3rem;pointer-events:none;opacity:.4;"></i>
                        </td>
                    </tr>
                </tbody>
                <tbody id="obBody">
                    <tr><td colspan="7" class="text-center text-muted py-3">Search and select a student</td></tr>
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="4" class="text-end">Total Debit / Credit</td>
                        <td class="text-end" id="footDebit">0.00</td>
                        <td class="text-end" id="footCredit">0.00</td>
                        <td></td>
                    </tr>
                    <tr>
                        <td colspan="5" class="text-end">Net Opening Balance (Dr - Cr)</td>
                        <td class="text-end" id="footNet">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/FeeOpeningBalance.js"></script>
}
