@model SchoolERPWebConsole.Domain.CBSESignOffAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "CBSE SignO ff";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

    // Only true admins/backend users should ever see the "System Type" toggle.
    // Adjust the role name / permission flag to whatever your app actually uses.
    var userTypeName = User.FindFirst("UserTypeName")?.Value;

    bool canManageSystemTypes =
        userTypeName == "Admin" ||
        userTypeName == "SuperAdmin";
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditCBSESignOff == null ? "Add CBSE Sign Off" : "Edit CBSE Sign Off")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/CBSESignOff/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditCBSESignOff?.SignOffID">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditCBSESignOff?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditCBSESignOff?.SessionID">

                    <div class="row row-gap-3">
                        <div class="col-md-3">
                            <label class="form-label">Class</label>
                            <select class="form-select" id="ddlClass">
                                <option value="">-- None --</option>
                                @if (Model.ClassList != null)
                                {
                                    foreach (var item in Model.ClassList)
                                    {
                                        // Skip the record currently being edited so it can't close to itself
                                        if (Model.EditCBSESignOff != null && item.ClassID == Model.EditCBSESignOff?.ClassID)
                                        {
                                            continue;
                                        }

                                        var isSelected = (Model.EditCBSESignOff?.ClassID == item.ClassID) ? "selected" : "";
                                        <option value="@item.ClassID" selected="@isSelected">@item.ClassName</option>
                                    }
                                }
                            </select>
                        </div>
                        <!-- Account Type Name -->
                        <div class="col-md-4">
                            <label class="form-label">Sign Of Teacher</label>
                            <input type="text" class="form-control" id="txtSignOfTeacher"
                                   value="@Model.EditCBSESignOff?.SignOfTeacher" placeholder="Enter sign of teacher">
                        </div>

                        <!-- Title / Display Label -->
                        <div class="col-md-4">
                            <label class="form-label">Sign Of Parents</label>
                            <input type="text" class="form-control" id="txtSignOfParents"
                                   value="@Model.EditCBSESignOff?.SignOfParents" placeholder="Enter sign of parents">
                        </div>

                        <!-- Print Order -->
                        <div class="col-md-4">
                            <label class="form-label">Sign Of Principal</label>
                            <input type="text" class="form-control" id="txtSignOfPrincipal"
                                   value="@Model.EditCBSESignOff?.SignOfPrincipal" placeholder="Enter sign of principal">
                        </div>

                        <!-- Active -->
                        <div class="col-md-6 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditCBSESignOff?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.canManageSystemTypes = @JsonSerializer.Serialize(canManageSystemTypes);
    </script>
    <script src="~/assets/js/CBSESignOff.js"></script>
}