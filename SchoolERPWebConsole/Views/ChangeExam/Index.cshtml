@model SchoolERPWebConsole.Domain.ChangeExamAddViewModel
@{
    ViewData["Title"] = "Change Exam";
    Layout = "_Layout"; // adjust to your shared layout
    var p = Model.Permissions;
}

@* =========================================================
   Change / Update Exam
   Layout copied from the screenshots:
     Row 1: Mark Type | Class | Section
     Row 2: Exam      | New Exam
     Buttons: SAVE (green) / RESET (dark)
     Footer bar: "Showing N Record(s)"
   Mark Type values match tbl_mst_ChangeExamMarkType (1..5).
   All events are bound in ChangeExam.js (no inline handlers).
   Model needs: Permissions (CanAdd / CanEdit) and Class (ClassID, ClassName),
   same shape as StudentReExamAddViewModel.
   ========================================================= *@

<div class="ce-wrapper">
        
    <div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
        <div></div>
        <div class="d-flex align-items-center flex-wrap gap-1">           
            @if (p.CanAdd || p.CanEdit)
            {
                <button class="btn btn-secondary top-btn" id="btnSave" disabled>
                    <i class="ti ti-device-floppy me-1"></i> SAVE
                </button>
            }
            <button class="btn btn-dark top-btn" id="btnReset">
                <i class="ti ti-refresh me-1"></i> RESET
            </button>
        </div>
    </div>
    <div id="changeExamNotice"></div>

    <div class="ce-panel">
        <div class="ce-panel-header">Change/Update Exam</div>

        <div class="ce-filters">
            <div class="ce-filter">
                <label>Mark Type <span class="text-danger">*</span></label>
                <select id="ddlMarkType" class="form-control form-control-sm">
                    <option value="">Select</option>
                    <option value="1">Mark Feeding</option>
                    <option value="2">CoScholastic Mark Feeding</option>
                    <option value="3">Remark Feeding</option>
                    <option value="4">Attendance Feeding</option>
                    <option value="5">PTM Attendance Feeding</option>
                </select>
            </div>

            <div class="ce-filter">
                <label>Class:<span class="text-danger">*</span></label>
                <select id="ddlClass" class="form-control form-control-sm">
                    <option value="">Select</option>
                    @foreach (var c in Model.Class)
                    {
                        <option value="@c.ClassID">@c.ClassName</option>
                    }
                </select>
            </div>

            <div class="ce-filter">
                <label>Section:<span class="text-danger">*</span></label>
                <select id="ddlSection" class="form-control form-control-sm" disabled>
                    <option value="">Choose a Section...</option>
                </select>
            </div>

            <div class="ce-filter">
                <label>Exam:<span class="text-danger">*</span></label>
                <select id="ddlExam" class="form-control form-control-sm" disabled>
                    <option value="">Select</option>
                </select>
            </div>

            <div class="ce-filter">
                <label>New Exam:<span class="text-danger">*</span></label>
                <select id="ddlNewExam" class="form-control form-control-sm" disabled>
                    <option value="">Select a exam.</option>
                </select>
            </div>
        </div>

        <div class="ce-grid-scroll">
            <table class="table ce-table" id="tblChangeExam">
                <thead>
                    <tr>
                        <th style="width:70px;">Roll No.</th>
                        <th style="width:130px;">Student ID</th>
                        <th>Student Name</th>
                        <th>Father Name</th>
                        <th style="width:110px;">Total Subject Count</th>
                    </tr>
                </thead>
                <tbody id="tblBody">
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            Select Mark Type, Class, Section and Exam to preview records.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="ce-footer">
            Showing <span id="recordCount">0</span> Record(s)
        </div>
    </div>
</div>

<style>
    .ce-panel {
        border: 1px solid #ccd6e5;
    }

    .ce-panel-header {
        background: #3d4f8f;
        color: #fff;
        padding: 6px 8px;
        font-weight: 700;
    }

    .ce-filters {
        display: grid;
        grid-template-columns: repeat(3, minmax(260px, 1fr));
        gap: 8px 20px;
        padding: 10px 12px;
    }

    .ce-filter {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .ce-filter label {
            margin: 0;
            min-width: 90px;
            text-align: right;
            white-space: nowrap;
        }

        .ce-filter select {
            flex: 1;
        }

    .ce-grid-scroll {
        max-height: 480px;
        overflow-y: auto;
    }

    .ce-table {
        margin: 0;
    }

        .ce-table th, .ce-table td {           
            vertical-align: middle;
        }

            .ce-table td:nth-child(3),
            .ce-table td:nth-child(4) {
                text-align: left;
            }

    .ce-footer {
        background: #3d4f8f;
        color: #fff;
        padding: 6px 8px;
        font-weight: 700;
        text-align: right;
    }
</style>

<script src="~/assets/js/ChangeExam.js"></script>
