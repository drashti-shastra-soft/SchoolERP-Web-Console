@*
    ======================================================================
    VIEW: Academics / Class.cshtml
    PURPOSE: User interface for managing Classes and their Section mappings.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.SharedLinkViewPageModel
@using System.Security.Claims
@using System.Text.Json
@{
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
    var p = Model.Permissions;
}
<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body">
            <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table" id="tblContentType">
                        <thead>
                            <tr class="bg-light">
                                <th class="ps-4" style="width: 50px;">Select</th>
                                <th>Title</th>
                                <th>Share URL</th>
                                <th>Share Date</th>
                                <th>Valid Upto</th>
                                <th>Shared By</th>
                                <th>Created On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null)
                            {
                               
                                    @foreach (var item in Model.Items)
                                    {
                                        var publicUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Public/SharedContent?token={item.ShareToken}";

                                        <tr onclick="selectRow(@item.SharedLinkID, this)" style="cursor:pointer">
                                            <td class="ps-3">
                                                <input type="checkbox" name="rowSelect" class="form-check-input student-checkbox" value="@item.SharedLinkID">
                                            </td>
                                            <td>@item.Title</td>
                                            <td>
                                                <div class="input-group input-group-sm border" style="width: 300px;" onclick="event.stopPropagation()">
                                                    <input type="text" class="form-control border-0" value="@publicUrl" readonly id="url_@item.SharedLinkID">
                                                    <button class="btn btn-light" onclick="copyUrl('@item.SharedLinkID', event)"><i class="ti ti-copy"></i></button>
                                                </div>
                                            </td>
                                            <td>@(item.ShareDate.HasValue ? item.ShareDate.Value.ToString("dd-MM-yyyy") : "N/A")</td>
                                            <td>
                                                @if (item.ValidUpto.HasValue)
                                                {
                                                    @item.ValidUpto.Value.ToString("dd-MM-yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-success">Permanent</span>
                                                }
                                            </td>
                                            <td>@item.SharedBy</td>
                                            <td>@item.CreatedOn.ToString("dd-MM-yyyy HH:mm")</td>
                                        </tr>
                                    }
                                

                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <span class="text-muted">No records found.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                            <!-- Record info -->
                            <div class="text-muted small">
                                Showing
                                <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                –
                                <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                of
                                <strong>@Model.TotalRecords</strong> users
                            </div>

                            <nav aria-label="Subject pagination">
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- First -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyID">
                                            <i class="ti ti-chevrons-left"></i>
                                        </a>
                                    </li>

                                    <!-- Prev -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyID">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Page numbers — show 5 around current -->
                                    @{
                                        int start = Math.Max(1, Model.PageNumber - 2);
                                        int end = Math.Min(totalPages, start + 4);
                                        start = Math.Max(1, end - 4);
                                    }
                                    @for (int pg = start; pg <= end; pg++)
                                    {
                                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyID">@pg</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyID">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Last -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyID">
                                            <i class="ti ti-chevrons-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>