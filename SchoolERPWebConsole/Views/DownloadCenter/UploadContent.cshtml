@model SchoolERPWebConsole.Domain.SharedLinkPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Upload & Share Content";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Upload & Share Content</h6>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">
       
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger d-inline-flex align-items-center top-btn" disabled onclick="deleteSelected()">
                <i class="ti ti-trash me-1"></i>Delete Selected
            </button>
        }
        @if (p.CanAdd)
        {
            <button class="btn btn-primary d-inline-flex align-items-center top-btn" onclick="goToShareUrl()">
                <i class="ti ti-link me-1"></i>Share URL
            </button>
            <button class="btn btn-primary d-inline-flex align-items-center top-btn" onclick="goToGenerateUrl()">
                <i class="ti ti-link me-1"></i>Generate URL
            </button>
            <a href="/DownloadCenter/AddUploadContent" class="btn btn-dark d-inline-flex align-items-center top-btn">
                <i class="ti ti-cloud-upload me-1"></i>Upload Content
            </a>
        }
    </div>
</div>

<!-- start row -->
<div class="row">
    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <!-- ── Search box (name="search" so form submits it) ── -->
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" name="search" id="txtSearchInput" value="@Model.SearchTerm" class="form-control border-0 ps-2 search-input-responsive" placeholder="Search by Document/Link Type..." />
                    </div>
                    <form method="get" asp-action="Index" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="sessionID" id="hdnSessionID" value="" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value="" />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                    </form>
                    <div class="bg-white border border-muted rounded px-1 py-1 text-center d-flex align-items-center justify-content-center">
                        <a href="#list-v" id="list-view-btn" class="btn rounded d-flex align-items-center justify-content-center active">
                            <i class="ti ti-list fs-14 text-body"></i>
                        </a>
                        <a href="#card-v" id="card-view-btn" class="btn rounded d-flex align-items-center justify-content-center">
                            <i class="ti ti-layout-grid fs-14 text-body"></i>
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>
   
    <div id="uploadContentContainer">
        @await Html.PartialAsync("_UploadContentTablePartial", Model)
    </div>
</div>



<!-- Generate URL Modal -->
<div class="modal fade" id="genModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title">Generate Shareable URL</h5>
                <div>
                    <button class="btn btn-success btn-sm" onclick="generateLink()">
                        <i class="ti ti-link me-1"></i>Generate
                    </button>
                    <button class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i>Close
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div class="row row-gap-3">
                    <div class="col-md-12">
                        <label class="form-label">Share Title <span class="text-danger">*</span></label>
                        <input type="text" id="genTitle" class="form-control" required placeholder="e.g., Weekly Assignments">
                        <span class="text-danger small d-none" id="err-genTitle">Share title is required.</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Share Date</label>
                        <input type="date" id="genDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Valid Upto</label>
                        <input type="date" id="genValid" class="form-control">
                    </div>
                    <div class="col-md-12">
                        <label class="form-label mb-2">Selected Documents (<span id="selCount">0</span>)</label>
                        <div id="selList" class="rounded p-2 bg-light" style="max-height:150px; overflow-y:auto;">
                            <span class="text-muted small">No documents selected.</span>
                        </div>
                    </div>
                    <div id="resultBox" class="col-md-12 d-none">
                        <label class="form-label text-success fw-bold">Generated Link:</label>
                        <div class="input-group">
                            <input type="text" id="genResult" class="form-control bg-white" readonly>
                            <button class="btn btn-outline-primary" onclick="copyResult()">Copy</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/UploadContent.js"></script>
}
