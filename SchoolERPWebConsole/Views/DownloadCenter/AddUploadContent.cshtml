@model SchoolERPWebConsole.Domain.AddSharedLinkViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Upload New Content";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditItems == null ? "Upload New Content" : "Edit Content")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveUpload()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/DownloadCenter/VideoTutorial" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>


<form id="uploadForm" enctype="multipart/form-data">

    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="hdnId" value="@Model.EditItems?.SharedLinkID" />
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditItems?.CompanyID">
                    <div class="row row-gap-3">
                        <div class="col-md-6">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <input type="text" id="upTitle" value="@Model.EditItems?.Title" class="form-control" required placeholder="Enter content title">
                            <span class="text-danger small d-none" id="err-upTitle">Title is required.</span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Content Type <span class="text-danger">*</span></label>
                            <select id="upType" class="form-select form-control" required>
                                <option value="">Select Type</option>
                                @foreach (var t in Model.ContentType)
                                {
                                    <option value="@t.ContentTypeID">@t.TypeName</option>
                                }
                            </select>
                            <span class="text-danger small d-none" id="err-upType">Please select a content type.</span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Upload Video File</label>
                            <input type="file" id="upFile" class="form-control" accept="video/mp4,video/quicktime,video/x-msvideo,video/x-ms-wmv,video/webm,video/x-matroska,.mp4,.mov,.avi,.wmv,.webm,.mkv" onchange="clearLink()">
                            <span class="text-danger small d-none" id="err-upFileType">Only video files are allowed.</span>
                        </div>
                        <div class="col-md-2 text-center my-1 mt-4">
                            <span class="badge bg-light text-dark px-3 border">OR</span>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Youtube / Video Link</label>
                            <input type="url" id="upLink" value="@Model.EditItems?.ShareToken" class="form-control" placeholder="https://..." oninput="clearFile()">
                            <span class="text-danger small d-none" id="err-upFile">Please upload a file or provide a link.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/UploadContent.js"></script>
}
