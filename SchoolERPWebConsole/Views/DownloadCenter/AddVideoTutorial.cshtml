@model SchoolERPWebConsole.Domain.AddVideoTutorialViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Video Tutorial";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditItems == null ? "Add Video Tutorial" : "Edit Video Tutorial")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveData()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/DownloadCenter/VideoTutorial" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>


<form id="upsertForm">

    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="hdnId" value="@Model.EditItems?.VideoID" />
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditItems?.CompanyId">
                    <div class="row row-gap-3">
                        <div class="col-md-6">
                            <label class="form-label">Class <span class="text-danger">*</span></label>
                            <select id="ddlClass" class="form-select form-control" required onchange="onClassChange('ddlClass', 'ddlSection')">
                                <option value="">Select Class</option>
                                @foreach (var c in Model.Classes)
                                {
                                    <option value="@c.ClassID" selected="@(Model.EditItems?.ClassID == c.ClassID)">@c.ClassName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Section <span class="text-danger">*</span></label>
                            <select id="ddlSection" class="form-select form-control" required>
                                <option value="">Select Section</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <input type="text" id="txtTitle" value="@Model.EditItems?.Title" class="form-control" required placeholder="Enter video title">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Video Link <span class="text-danger">*</span></label>
                            <input type="url" id="txtLink" value="@Model.EditItems?.VideoLink" class="form-control" required placeholder="https://www.youtube.com/watch?v=...">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Description</label>
                            <textarea id="txtDescription" class="form-control" rows="3" placeholder="Optional description">@Model.EditItems?.Description</textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(Model.EditItems?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);

       
        document.addEventListener('DOMContentLoaded', function () {
            onClassChange('ddlClass', 'ddlSection', false, @Model.EditItems?.SectionID);
        });
    
    </script>

    <script src="~/assets/js/VideoTutorial.js"></script>
}
