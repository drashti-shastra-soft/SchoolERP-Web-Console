@model SchoolERPWebConsole.Domain.AddSharedLinkViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Generate Shareable URL";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Generate Shareable URL</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" onclick="generateLink()" class="btn btn-success top-btn">
                <i class="ti ti-link me-1"></i> Generate
            </button>
        }
        <a href="/DownloadCenter/UploadContent" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <div class="row row-gap-3">
                    <div class="col-md-6">
                        <label class="form-label">Share Title <span class="text-danger">*</span></label>
                        <input type="text" id="genTitle" class="form-control" required placeholder="e.g., Weekly Assignments">
                        <span class="text-danger small d-none" id="err-genTitle">Share title is required.</span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Share Date <span class="text-danger">*</span></label>
                        <input type="date" id="genDate" class="form-control" required value="@DateTime.Now.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Valid Upto <span class="text-danger">*</span></label>
                        <input type="date" id="genValid" class="form-control" required>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label mb-2">Selected Documents (<span id="selCount">0</span>)</label>
                        <div id="selList" class="rounded p-2 bg-light" style="max-height:220px; overflow-y:auto;">
                            <span class="text-muted small">No documents selected.</span>
                        </div>
                    </div>

                    <div id="resultBox" class="col-md-12 d-none">
                        <label class="form-label text-success fw-bold">Generated Link:</label>
                        <div class="input-group">
                            <input type="text" id="genResult" class="form-control bg-white" readonly>
                            <button class="btn btn-outline-primary" type="button" onclick="copyResult()">Copy</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/GenerateUrl.js"></script>
}