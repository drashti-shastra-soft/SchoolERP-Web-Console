@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.StudentDetailsViewModel
@{
    ViewData["Title"] = "Add Class";
    var p = Model.Permissions;

    string GetDocIcon(string fileTypeOrName)
    {
        if (string.IsNullOrWhiteSpace(fileTypeOrName)) return "ti ti-file";

        // Extract extension whether given "pdf", ".pdf", or a full filename "report.pdf"
        var ext = fileTypeOrName.Contains('.')
            ? fileTypeOrName.Substring(fileTypeOrName.LastIndexOf('.') + 1).ToLower()
            : fileTypeOrName.ToLower().TrimStart('.');

        return ext switch
        {
            "pdf" => "ti ti-file-type-pdf",
            "doc" or "docx" => "ti ti-file-type-doc",
            "xls" or "xlsx" => "ti ti-file-type-xls",
            "ppt" or "pptx" => "ti ti-file-type-ppt",
            "jpg" or "jpeg" or "png" or "gif" or "webp" => "ti ti-file-type-jpg",
            "zip" or "rar" or "7z" => "ti ti-file-zip",
            "txt" => "ti ti-file-text",
            "csv" => "ti ti-file-spreadsheet",
            _ => "ti ti-file"
        };
    }
    string GetDocIconBg(string fileTypeOrName)
    {
        if (string.IsNullOrWhiteSpace(fileTypeOrName)) return "bg-light";

        var ext = fileTypeOrName.Contains('.')
            ? fileTypeOrName.Substring(fileTypeOrName.LastIndexOf('.') + 1).ToLower()
            : fileTypeOrName.ToLower().TrimStart('.');

        return ext switch
        {
            "pdf" => "bg-danger-subtle text-danger",
            "doc" or "docx" => "bg-primary-subtle text-primary",
            "xls" or "xlsx" => "bg-success-subtle text-success",
            "ppt" or "pptx" => "bg-warning-subtle text-warning",
            "jpg" or "jpeg" or "png" or "gif" or "webp" => "bg-info-subtle text-info",
            _ => "bg-secondary-subtle text-secondary"
        };
    }
}

