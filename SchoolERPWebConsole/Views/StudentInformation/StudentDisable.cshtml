@using System.Security.Claims
@model SchoolERPWebConsole.Domain.StudentDisablePageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Student Disable ";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditStudentDisable == null ? "Student Disable" : "Student Enable ")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveRecord()">
                <i class="ti ti-device-floppy me-1"></i> Save 
            </button>
        }
        <a href="/StudentInformation/studentDetails/@Model.EditStudentDisable?.StudentID" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-header">
            </div>
            <div class="card-body">
                <form id="entryForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditStudentDisable?.StudentID ?? 0)">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Reason <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlPurpose" name="PurposeID">
                                <option value="">Select</option>
                                @foreach (var p in Model.Items)
                                {
                                    <option value="@p.DisableReasonID" selected="@(Model.EditStudentDisable?.DisableReasonID == p.DisableReasonID)">@p.DisableReasonTitle</option>
                                }
                            </select>
                            <div id="errPurpose" class="invalid-feedback" style="display: none;">Purpose is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtDate" required
                                   value="@((Model.EditStudentDisable != null && Model.EditStudentDisable.DisableDate > DateTime.MinValue)
                        ? Model.EditStudentDisable.DisableDate.ToString("yyyy-MM-dd")
                        : DateTime.Now.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div id="errDate" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Note</label>
                            <textarea type="text"
                                   class="form-control" rows="3"
                                      id="txtName">@Model.EditStudentDisable?.DisableNote</textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" id="txtDescription" rows="3" placeholder="Enter description (optional)"></textarea>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/StudentDisable.js"></script>
}
