@model StudentListPageViewModel
@{
    ViewData["Title"] = "Bulk Delete Students";
    var p = Model.Permissions;
}

@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }
    </style>
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Bulk Delete</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        @if (p.CanDelete)
        {
            <button id="btnBulkDelete" class="btn btn-danger d-inline-flex align-items-center top-btn" onclick="processBulkDelete()" disabled>
                <i class="ti ti-trash me-1"></i>Delete Selected
            </button>
        }
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>
<!-- End Page Header -->

<div class="row">

    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <!-- Hidden search form — synced by submitForm() before every reload -->
                <form id="frmSearch" onsubmit="return false;">
                    <input type="hidden" id="hdnPageIndex" name="page" value="@Model.PageNumber" />
                    <input type="hidden" id="hdnPageSize" name="pageSize" value="@(Model.PageSize > 0 ? Model.PageSize : 20)" />
                    <input type="hidden" id="hdnSearch" name="search" value="@Model.SearchTerm" />
                    <input type="hidden" id="hdnClassId" name="classId" value="@Model.SelectedClassId" />
                    <input type="hidden" id="hdnSectionId" name="sectionId" value="@Model.SelectedSectionId" />
                    <input type="hidden" id="hdnViewType" name="viewType" value="@Model.ViewType" />
                </form>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 filter-toolbar">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text"
                               class="form-control border-0 ps-2 search-input-responsive"
                               id="txtSearchInput" value="@Model.SearchTerm" style="min-width: 220px;"
                               placeholder="Search by name, roll, admission..." />
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0">
                        <div class="dropdown">
                            <a href="#" id="btnFilterToggle"
                               class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                               data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                            </a>

                            <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown" style="max-width: calc(100vw - 2rem);">

                                <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                    <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                    <div class="d-flex align-items-center justify-content-end">

                                        <button type="button" class="btn text-primary"
                                                onclick="resetAllFilters()" id="btnResetFilters">
                                            <i class="ti ti-refresh me-1"></i>Reset
                                        </button>
                                        <button type="button" class="btn text-primary" onclick="applyFilters()" id="btnApplyFilters">
                                            <i class="ti ti-filter me-1"></i>Apply
                                        </button>
                                        <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                                id="btnCloseFilter" aria-label="Close">
                                            <i class="ti ti-x"></i>
                                        </button>

                                    </div>
                                </div>

                                <div class="filter-body pb-0">
                                    <div class="row">

                                        <div class="mb-3">
                                            <label class="form-label mb-1">Class</label>
                                            <select id="ddlClass" class="form-select form-control select2">
                                                <option value="">Select Class</option>
                                                @foreach (var c in ViewBag.Classes)
                                                {
                                                    <option value="@c.ClassID" selected="@(Model.SelectedClassId == c.ClassID)">@c.ClassName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label mb-1">Section</label>
                                            <select id="ddlSection" class="form-select form-control select2">
                                                <option value="">Select Section</option>
                                                @if (ViewBag.Sections != null)
                                                {
                                                    @foreach (var s in ViewBag.Sections)
                                                    {
                                                        <option value="@s.SectionID" selected="@(Model.SelectedSectionId == s.SectionID)">@s.SectionName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2"><i class="ti ti-filter-check me-1"></i>Active Filters:</span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none" id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="bulkDeleteTableContainer">
        @await Html.PartialAsync("_BulkDeleteTablePartial", Model)
    </div>

</div>

@section Scripts {
    <script src="~/assets/plugins/sweetalert/sweetalert2.all.min.js"></script>
    <script src="~/assets/js/BulkDeleteStudents.js"></script>
}