@model MultiClassStudentsPageViewModel
@{
    ViewData["Title"] = "Multi Class Students";
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Multi Class Students</h6>
    </div>
</div>
<!-- End Page Header -->

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body">
                <!-- Hidden search form — synced by submitForm() before every reload -->
                <form id="frmSearch" onsubmit="return false;">
                    <input type="hidden" id="hdnPageIndex" name="page" value="@Model.PageNumber" />
                    <input type="hidden" id="hdnPageSize" name="pageSize" value="@(Model.PageSize > 0 ? Model.PageSize : 10)" />
                    <input type="hidden" id="hdnSearch" name="search" value="@Model.SearchTerm" />
                    <input type="hidden" id="hdnClassId" name="classId" value="@Model.SelectedClassId" />
                    <input type="hidden" id="hdnSectionId" name="sectionId" value="@Model.SelectedSectionId" />
                </form>

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 filter-toolbar">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" class="form-control border-0 ps-2 search-input-responsive"
                               id="txtSearchInput" value="@Model.SearchTerm" placeholder="Search by name or roll no..." />
                    </div>

                    <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0 filter-actions-wrap">
                        <div class="dropdown">
                            <a href="#" id="btnFilterToggle" class="btn btn-white border rounded btn-md text-dark fs-14 d-flex align-items-center fw-normal" data-bs-toggle="dropdown">
                                <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                            </a>
                            <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown">
                                <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                    <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                    <div class="d-flex align-items-center justify-content-end">
                                        <button type="button" class="btn btn-light btn-md me-2 fw-medium" id="btnResetFilters">Reset</button>
                                        <button type="button" class="btn text-primary fs-6 fw-medium" id="btnApplyFilters">
                                            <i class="ti ti-filter me-1"></i>Apply
                                        </button>
                                        <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none" id="btnCloseFilter" aria-label="Close">
                                            <i class="ti ti-x"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="filter-body pb-0 p-3">
                                    <div class="mb-3">
                                        <label class="form-label mb-1">Class</label>
                                        <select id="ddlFilterClass" class="form-select form-control select2">
                                            <option value="">All Classes</option>
                                            @foreach (var c in Model.Classes)
                                            {
                                                <option value="@c.ClassID" selected="@(Model.SelectedClassId == c.ClassID)">@c.ClassName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label mb-1">Section</label>
                                        <select id="ddlFilterSection" class="form-select form-control select2">
                                            <option value="">All Sections</option>
                                            @foreach (var s in Model.Sections)
                                            {
                                                <option value="@s.SectionID" selected="@(Model.SelectedSectionId == s.SectionID)">@s.SectionName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2"><i class="ti ti-filter-check me-1"></i>Active Filters:</span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none" id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="multiClassStudentsContainer" class="row">
        @await Html.PartialAsync("_MultiClassStudentsPartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        const canAdd = @Model.CanAdd.ToString().ToLower();
        const canEdit = @Model.CanEdit.ToString().ToLower();
        const canDelete = @Model.CanDelete.ToString().ToLower();
    </script>
    <script src="~/assets/js/MultiClassStudents.js"></script>
}