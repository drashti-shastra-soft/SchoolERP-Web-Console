@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.StudentDisableReasonAddViewModel
@{
    ViewData["Title"] = "Add Disable Reason";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditStudentDisableReason == null ? "Add Disable Reason" : "Edit Disable Reason")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveRecord()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/StudentInformation/DisableReason" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditStudentDisableReason?.DisableReasonID ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(Model.EditStudentDisableReason?.CreatedBY ?? 0)">
                    <input type="hidden" id="hdnDisableReasonID" value="@(Model.EditStudentDisableReason?.DisableReasonID ?? 0)" />
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditStudentDisableReason?.CompanyID ?? 0)" />
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditStudentDisableReason?.SessionID ?? 0)" />
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Reason Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtTitle" value="@Model.EditStudentDisableReason?.DisableReasonTitle"
                                   required maxlength="200" placeholder="Enter disable reason title">
                            <div class="invalid-feedback">Reason is required.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Display Label </label>
                            <input type="text" class="form-control" id="txtDisplayLabel" value="@Model.EditStudentDisableReason?.DisplayLabel"
                                   maxlength="200" placeholder="Enter disable reason title">
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/DisableReason.js"></script>
}
