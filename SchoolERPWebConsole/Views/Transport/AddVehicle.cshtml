@using System.Text.Json
@model SchoolERPWebConsole.Domain.VehiclePageViewModel

@{
    ViewData["Title"] = "Vehicle Management";
    var p = Model.Permissions;
    var edit = Model.EditVehicle;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(edit == null ? "Add Vehicle" : "Edit Vehicle")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">

        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveRecord()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/Transport/Vehicles" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm" enctype="multipart/form-data">
                    <input type="hidden" id="hdnVehicleID" value="@(edit?.VehicleID ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)">

                    <div class="row">
                        <!-- Vehicle Details -->
                        <div class="col-md-8">
                            <h6 class="fw-bold mb-3 border-bottom pb-2">Vehicle Information</h6>
                            <div class="row row-gap-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Vehicle Number <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtVehicleNumber" required maxlength="50"
                                           value="@edit?.VehicleNumber">
                                    <div class="invalid-feedback">Vehicle number is required</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Model <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtVehicleModel" maxlength="100" value="@edit?.VehicleModel">
                                    <div class="invalid-feedback">Model is required.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Year Made <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="txtYearMade" maxlength="10" value="@edit?.VehicleYearMade">
                                    <div class="invalid-feedback">Year Made is required.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Registration No <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtRegNo" maxlength="50" value="@edit?.VehicleRegNo">
                                    <div class="invalid-feedback">Registration No is required.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Chasis No <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtChasisNo" maxlength="50" value="@edit?.VehicleChasisNo">
                                    <div class="invalid-feedback">Chasis No is required.</div>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Max Capacity <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control" id="txtCapacity" value="@edit?.VehicleMaxCapicity">
                                    <div class="invalid-feedback">Max Capacity is required.</div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="chkActive"
                                               checked="@(edit == null ? true : edit.IsActive)">
                                        <label class="form-check-label" for="chkActive">Active Status</label>
                                    </div>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-3 border-bottom pb-2 mt-4">Driver Information</h6>
                            <div class="row row-gap-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-bold">Driver Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtDriverName" maxlength="200" value="@edit?.VehicleDriverName">
                                    <div class="invalid-feedback">Driver Name is required.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Driver Contact <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtDriverContact" maxlength="10" pattern="\d{10}"
                                           title="Driver contact must be exactly 10 digits" value="@edit?.VehicleDriverContact"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, ''); clearError('txtDriverContact');">
                                    <div class="invalid-feedback">Driver contact must be exactly 10 digits</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Driver License No <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="txtDriverLicense" maxlength="100" value="@edit?.VehicleDriverLicense">
                                    <div class="invalid-feedback">Driver License No is required.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Side Bar for Photo & Notes -->
                        <div class="col-md-4 border-start">
                            <h6 class="fw-bold mb-3 border-bottom pb-2">Driver Photo</h6>
                            <div class="text-center mb-3">
                                <img id="imgPreview" src="@(!string.IsNullOrEmpty(edit?.VehicleDriverPhotoName) ? edit.VehicleDriverPhotoType : "/assets/images/default-user.png")"
                                     class="img-thumbnail rounded" style="width: 150px; height: 150px; object-fit: cover;">
                            </div>
                            <div class="mb-3">
                                <input type="file" class="form-control form-control-sm" id="filePhoto" accept="image/*" onchange="previewImage(this)">
                            </div>

                            <textarea class="form-control" id="txtNote" rows="4" placeholder="Additional notes...">@edit?.VehicleNote</textarea>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function clearError(id) {
            $("#" + id).removeClass("is-invalid");
        }

        $(".form-control").on("input change", function () {
            $(this).removeClass("is-invalid");
        });

        $("#txtDriverName").on("input", function () {
            this.value = this.value.replace(/[^a-zA-Z\s]/g, "");
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $("#imgPreview").attr("src", e.target.result);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        window.saveRecord = function () {
            // Remove previous validation
            $(".form-control").removeClass("is-invalid");

            var isValid = true;
            var firstInvalid = null;

            function requiredField(id, message) {
                var value = $("#" + id).val().trim();

                if (!value) {
                    $("#" + id).addClass("is-invalid").next(".invalid-feedback").text(message);
                    if (!firstInvalid) { firstInvalid = $("#" + id); }
                    isValid = false;
                    return false;
                }
                return true;
            }

            requiredField("txtVehicleNumber", "Vehicle Number is required.");
            requiredField("txtVehicleModel", "Model is required.");
            requiredField("txtYearMade", "Year Made is required.");
            requiredField("txtRegNo", "Registration No is required.");
            requiredField("txtChasisNo", "Chasis No is required.");
            requiredField("txtCapacity", "Max Capacity is required.");

            var yearMade = $("#txtYearMade").val().trim();

            if (yearMade) {
                var year = parseInt(yearMade);

                if (isNaN(year) || year < 1900 || year > new Date().getFullYear()) {
                    $("#txtYearMade").addClass("is-invalid").next(".invalid-feedback").text("Please enter a valid year.");

                    if (!firstInvalid) {
                        firstInvalid = $("#txtYearMade");
                    }

                    isValid = false;
                }
            }

            var capacity = $("#txtCapacity").val().trim();
            if (capacity) {
                var maxCapacity = parseInt(capacity);

                if (isNaN(maxCapacity) || maxCapacity <= 0) {
                    $("#txtCapacity").addClass("is-invalid").next(".invalid-feedback").text("Max Capacity must be greater than 0.");
                    if (!firstInvalid) { firstInvalid = $("#txtCapacity"); }
                    isValid = false;
                }
            }
            requiredField("txtDriverName", "Driver Name is required.");
            requiredField("txtDriverContact", "Driver Contact is required.");
            requiredField("txtDriverLicense", "Driver License No is required.");

            var driverContact = $("#txtDriverContact").val().trim();

            if (driverContact && driverContact.length !== 10) {
                $("#txtDriverContact").addClass("is-invalid").next(".invalid-feedback").text("Driver Contact must be exactly 10 digits.");
                if (!firstInvalid) { firstInvalid = $("#txtDriverContact"); }
                isValid = false;
            }

            if (!isValid) {
                if (firstInvalid) {
                    firstInvalid.focus();
                }
                return;
            }

            var formData = new FormData();

            formData.append("VehicleID", parseInt($("#hdnVehicleID").val()) || 0);
            formData.append("VehicleNumber", $("#txtVehicleNumber").val().trim());
            formData.append("VehicleModel", $("#txtVehicleModel").val().trim());
            formData.append("VehicleYearMade", $("#txtYearMade").val().trim());
            formData.append("VehicleRegNo", $("#txtRegNo").val().trim());
            formData.append("VehicleChasisNo", $("#txtChasisNo").val().trim());
            formData.append("VehicleMaxCapicity", parseInt($("#txtCapacity").val()) || 0);
            formData.append("IsActive", $("#chkActive").is(":checked"));
            formData.append("companyID", $("#hdnCompanyID").val().trim());
            formData.append("sessionID", $("#hdnSessionID").val().trim());
            formData.append("VehicleDriverName", $("#txtDriverName").val().trim());
            formData.append("VehicleDriverContact", driverContact);
            formData.append("VehicleDriverLicense", $("#txtDriverLicense").val().trim());
            formData.append("VehicleNote", $("#txtNote").val().trim());
            var fileInput = $("#filePhoto")[0];

            if (fileInput && fileInput.files.length > 0) {
                formData.append("DriverPhoto", fileInput.files[0]);
            }

            $.ajax({
                url: "/Transport/UpsertVehicle",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,

                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            title: "Saved!",
                            text: "Vehicle has been saved successfully.",
                            icon: "success",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-success",
                            },
                            buttonsStyling: false,
                        }).then(() => {
                            window.location.href = "/Transport/Vehicles";
                        });
                    } else {
                        Swal.fire({
                            title: "Error!",
                            text: resp.message || "Failed to save Vehicle.",
                            icon: "error",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-danger",
                            },
                            buttonsStyling: false,
                        });
                    }
                },

                error: function (xhr) {
                    console.log("Status:", xhr.status);
                    console.log("Response:", xhr.responseText);

                    Swal.fire({
                        title: "Error!",
                        text: "An unexpected error occurred while saving.",
                        icon: "error",
                        confirmButtonText: "OK",
                        customClass: {
                            confirmButton: "btn btn-danger",
                        },
                        buttonsStyling: false,
                    });
                },
            });
        };
    </script>
}

