@using System.Text.Json
@model SchoolERPWebConsole.Domain.RoutePickupPointPageViewModel
@{
    ViewData["Title"] = "Add Route Pickup Point";
    var p = Model.Permissions;
    var edit = Model.EditRoutePickupPoint;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(edit == null ? "Add Route Pickup Point" : "Edit Route Pickup Point")
        </h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveRecord()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/Transport/RoutePickupPoints" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm">
                    <input type="hidden" id="hdnRPPID" value="@(edit?.RoutePickupPointID ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)">
                    <div class="row row-gap-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Select Route <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlRoute" required>
                                <option value="">-- Select Route --</option>
                                @foreach (var r in Model.Routes)
                                {
                                    <option value="@r.RouteID" selected="@(edit != null && edit.RouteID == r.RouteID)">@r.RouteName</option>
                                }
                            </select>
                            <div class="invalid-feedback">Route is required</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Select Pickup Point <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlPoint" required>
                                <option value="">-- Select Point --</option>
                                @foreach (var pp in Model.PickupPoints)
                                {
                                    <option value="@pp.PickupPointID" selected="@(edit != null && edit.PickupPointID == pp.PickupPointID)">@pp.PickupPointName</option>
                                }
                            </select>
                            <div class="invalid-feedback">Pickup Point is required</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Distance (KM)</label>
                            <input type="number" step="0.01" class="form-control" id="txtDistance" placeholder="0.00" value="@edit?.Distance">
                            <div class="invalid-feedback">Distance must be 0 or greater</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Pickup Time</label>
                            <input type="time" class="form-control" id="txtTime" placeholder="07:30 AM" value="@edit?.PickupTime">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Monthly Fees</label>
                            <input type="text" class="form-control" id="txtFees" placeholder="0.00" value="@edit?.MonthlyFees" oninput="clearError('txtFees')">
                            <div class="invalid-feedback">Monthly Fees must be 0 or greater</div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkActive"
                                       checked="@(edit == null ? true : edit.IsActive)">
                                <label class="form-check-label fw-bold" for="chkActive">Enable this point</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/assets/js/routepickuppoint.js")"></script>
}