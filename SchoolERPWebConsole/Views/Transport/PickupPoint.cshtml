@model SchoolERPWebConsole.Domain.PickupPointPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Pickup Point Management";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}
@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }
    </style>
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Pickup Point List</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <a href="/Transport/AddPickupPoint" class="btn btn-primary top-btn"><i class="ti ti-plus me-1"></i>Add</a>
        }
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="editSelected()">
                <i class="ti ti-pencil me-1"></i> Edit
            </button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()">
                <i class="ti ti-trash me-1"></i> Delete
            </button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<div class="row">
    <!-- Filters -->
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 ">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" class="form-control border-0 ps-2" id="txtSearchInput"
                               placeholder="Search by name..." style="min-width: 220px;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-12">
        <div class="card shadow-tbl">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0" id="tblPickupPoint">
                        <thead>
                            <tr>
                                <th style="width: 50px;">SELECT</th>
                                <th>PICKUP POINT NAME</th>
                                <th>LATITUDE</th>
                                <th>LONGITUDE</th>
                                <th style="width: 80px;" class="text-center">MAP</th>
                                <th style="width: 100px;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var validItems = (Model.Items ?? Enumerable.Empty<PickupPointViewModel>())
                                .Where(x => !string.IsNullOrWhiteSpace(x.PickupPointName))
                                .ToList();
                            }

                            @foreach (var item in validItems)
                            {
                                <tr class="item-row"
                                    onclick="selectItem(@item.PickupPointID, this)"
                                    style="cursor: pointer;">

                                    <td class="ps-3">
                                        <input type="checkbox"
                                               name="selectedItem"
                                               class="form-check-input pickPoint-checkbox"
                                               value="@item.PickupPointID">
                                    </td>

                                    <td>
                                        @item.PickupPointName
                                    </td>

                                    <td>
                                        @(item.PickupPointLatitude?.ToString("F6") ?? "-")
                                    </td>

                                    <td>
                                        @(item.PickupPointLongitude?.ToString("F6") ?? "-")
                                    </td>

                                    <td class="text-center">
                                        @if (item.PickupPointLatitude.HasValue &&
                                                                            item.PickupPointLongitude.HasValue)
                                        {
                                            <button type="button"
                                                    class="btn btn-light"
                                                    onclick="event.stopPropagation(); openMap(@item.PickupPointLatitude, @item.PickupPointLongitude)"
                                                    title="View on Map">
                                                <i class="ti ti-map-pin text-success fs-14"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="form-check form-switch"
                                             onclick="event.stopPropagation()">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   onchange="toggleStatus(@item.PickupPointID, this.checked)"
                                                   @(item.IsActive ? "checked" : "")
                                                   @(p.CanEdit ? "" : "disabled")>
                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Map Modal -->
<div class="modal fade" id="mapModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title">View Location</h5>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i> Close
                </button>
            </div>
            <div class="modal-body p-0">
                <iframe id="mapFrame" width="100%" height="450" frameborder="0" style="border:0" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.currentUserId = @JsonSerializer.Serialize(currentUserId);
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="@Url.Content("~/assets/js/PickUpPoint.js")"></script>
}