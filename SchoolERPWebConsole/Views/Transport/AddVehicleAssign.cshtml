@using System.Text.Json
@model SchoolERPWebConsole.Domain.VehicleAssignPageViewModel

@{
    ViewData["Title"] = "Add Vehicle Assignment";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(Model.EditVehicleAssign == null ? "Add Vehicle Assignment" : "Edit Vehicle Assignment")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">

        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button"
                    class="btn btn-success top-btn"
                    onclick="saveRecord()">
                <i class="ti ti-device-floppy me-1"></i>Save
            </button>
        }

        <a href="/Transport/VehicleAssign"
           class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i>Back
        </a>

    </div>
</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">

                <form id="entryForm">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditVehicleAssign?.CompanyID ?? 0)" />
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditVehicleAssign?.SessionID ?? 0)" />
                    <input type="hidden" id="hdnOldRouteID" value="@(Model.EditVehicleAssign?.RouteID ?? 0)" />
                    <input type="hidden" id="hdnVehicleAssignIDs" value="@(Model.EditVehicleAssign != null ? string.Join(",", Model.EditVehicleAssignIDs ?? new List<int>()) : "")" />

                    <div class="row row-gap-3">

                        <!-- Route -->
                        <div class="col-md-12">

                            <label class="form-label fw-bold">
                                Select Route
                                <span class="text-danger">*</span>
                            </label>

                            <select class="form-select"
                                    id="ddlRoute"
                                    required>

                                <option value="">
                                    -- Select Route --
                                </option>

                                @foreach (var route in Model.Routes)
                                {
                                    <option value="@route.RouteID"
                                            selected="@(Model.EditVehicleAssign?.RouteID == route.RouteID ? "selected" : null)">
                                        @route.RouteName
                                    </option>
                                }

                            </select>

                            <div class="invalid-feedback" id="errRoute">
                                Please select a Route.
                            </div>

                        </div>


                        <!-- Vehicles -->
                        <div class="col-md-12">

                            <label class="form-label fw-bold">
                                Select Vehicles
                                <span class="text-danger">*</span>
                            </label>

                            <div class="border rounded p-3"
                                 id="vehicleListWrapper"
                                 style="max-height: 200px; overflow-y: auto;">

                                @if (Model.Vehicles != null && Model.Vehicles.Any())
                                {
                                    @foreach (var vehicle in Model.Vehicles)
                                    {
                                        <div class="form-check mb-2">

                                            <input class="form-check-input vehicle-chk"
                                                   type="checkbox"
                                                   value="@vehicle.VehicleID"
                                                   id="chkVeh_@vehicle.VehicleID" />

                                            <label class="form-check-label"
                                                   for="chkVeh_@vehicle.VehicleID">

                                                @vehicle.VehicleNumber
                                                (@vehicle.VehicleModel)

                                            </label>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted">
                                        No vehicles found.
                                    </div>
                                }

                            </div>

                            <div class="text-danger small mt-1"
                                 id="errVehicle"
                                 style="display:none;">
                                Please select at least one Vehicle.
                            </div>

                        </div>

                    </div>

                </form>

            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        const canEdit = @p.CanEdit.ToString().ToLower();
        const canDelete = @p.CanDelete.ToString().ToLower();

        // ============================================================
        // Save Vehicle Assign
        // ============================================================

        window.saveRecord = function () {

            var routeId = $('#ddlRoute').val();

            var companyID = parseInt($('#hdnCompanyID').val()) || 0;

            var sessionID = parseInt($('#hdnSessionID').val()) || 0;

            // ========================================================
            // OLD ROUTE ID
            // ========================================================

            var oldRouteId = parseInt($('#hdnOldRouteID').val()) || 0;
            var vehicleAssignIds = [];
            var existingIds = $('#hdnVehicleAssignIDs').val();

            if (existingIds) {
                existingIds.split(',').forEach(function (value) {
                    var id = parseInt(value, 10);
                    if (!isNaN(id) && id > 0) {
                        vehicleAssignIds.push(id);
                    }
                });
            }

            console.log('Old Route ID:', oldRouteId);
            console.log('Existing VehicleAssign IDs:', vehicleAssignIds);


            // ========================================================
            // Get selected Vehicle IDs
            // ========================================================

            var vehicleIds = [];

            $('.vehicle-chk:checked').each(function () {
                var vehicleId = parseInt($(this).val());
                if (!isNaN(vehicleId) && vehicleId > 0) {
                    vehicleIds.push(vehicleId);
                }
            });

            console.log('Selected Vehicle IDs:', vehicleIds);


            // ========================================================
            // Clear previous validation
            // ========================================================

            $('#ddlRoute').removeClass('is-invalid');
            $('#vehicleListWrapper').removeClass('border-danger');
            $('#errVehicle').hide();

            // ========================================================
            // Request data
            // ========================================================

            var data = {
                vehicleAssignIDs: vehicleAssignIds,
                oldRouteID: oldRouteId,
                routeID: parseInt(routeId) || 0,
                vehicleIDs: vehicleIds,
                isActive: true,
                companyID: companyID,
                sessionID: sessionID
            };
            
            console.log('Vehicle Assignment Request:',data);
            // ========================================================
            // Validation
            // ========================================================

            var isValid = true;
            var firstInvalidEl = null;

            // ========================================================
            // Route validation
            // ========================================================

            if (!data.routeID) {
                $('#ddlRoute').addClass('is-invalid');
                firstInvalidEl = $('#ddlRoute');
                isValid = false;
            }
            // ========================================================
            // Vehicle validation
            // ========================================================

            if(!data.vehicleIDs || data.vehicleIDs.length === 0) 
            {
                $('#vehicleListWrapper').addClass('border-danger');
                $('#errVehicle').show();

                if (!firstInvalidEl) {
                    firstInvalidEl = $('.vehicle-chk').first();
                }
                isValid = false;
            }
            // ========================================================
            // Stop if validation failed
            // ========================================================

            if (!isValid) {
                if (firstInvalidEl && firstInvalidEl.length) 
                {
                    firstInvalidEl.focus();
                }
                return;
            }

            // ========================================================
            // AJAX Save
            // ========================================================

            $.ajax({
                url: '/Transport/UpsertAssignments',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            title: 'Saved!',
                             text: data.vehicleAssignIDs > 0 ? "Vehicle Assign has been Updated successfully." : "Vehicle Assign has been Added successfully.",
                            icon: 'success',
                            confirmButtonText: 'OK',
                            customClass: {
                                confirmButton:'btn btn-success'
                            },
                            buttonsStyling: false
                        }).then(function () {
                            window.location.href = '/Transport/VehicleAssign';
                        });
                    }
                    else {
                        Swal.fire({
                            title: 'Error!',
                            text: resp.message || 'Failed to save Vehicle Assignment.',
                            icon: 'error',
                            confirmButtonText: 'OK',
                            customClass: {
                                confirmButton:
                                    'btn btn-danger'
                            },
                            buttonsStyling: false
                        });
                    }
                },


                error: function (xhr) {

                    console.error(
                        'Vehicle Assignment Save Error:',
                        xhr.status,
                        xhr.responseText
                    );


                    Swal.fire({

                        title: 'Error!',

                        text:
                            'An unexpected error occurred while saving.',

                        icon: 'error',

                        confirmButtonText: 'OK',

                        customClass: {
                            confirmButton:
                                'btn btn-danger'
                        },

                        buttonsStyling: false

                    });

                }

            });

        };


        // ============================================================
        // Edit Mode
        // ============================================================

        $(document).ready(function () {

            @if (Model.EditVehicleAssign != null)
            {
                            <text>

                            // ----------------------------------------------------
                            // Set Existing Route
                            // ----------------------------------------------------

                            $('#ddlRoute')
                                .val('@Model.EditVehicleAssign.RouteID')
                                .trigger('change');


                            // ----------------------------------------------------
                            // Existing Vehicle IDs
                            // IMPORTANT:
                            // These are VehicleID values.
                            // ----------------------------------------------------

                            var editVehicleIds =
                                @Html.Raw(JsonSerializer.Serialize(
                                    Model.EditVehicleIDs ?? new List<int>()
                                                                        ));


            console.log(
                'Existing Vehicle IDs:',
                editVehicleIds
            );


            // ----------------------------------------------------
            // Check Existing Vehicles
            // ----------------------------------------------------

            editVehicleIds.forEach(function (vehicleId) {

                var checkbox =
                    $('#chkVeh_' + vehicleId);

                if (checkbox.length) {

                    checkbox.prop(
                        'checked',
                        true
                    );

                }

            });


            // ----------------------------------------------------
            // Debug
            // ----------------------------------------------------

            console.log(
                'Checked Vehicles:',
                $('.vehicle-chk:checked')
                    .map(function () {

                        return $(this).val();

                    })
                    .get()
            );

            </text>
                        }

        });


        // ============================================================
        // Remove Vehicle Validation Error
        // ============================================================

        $(document).on(
            'change',
            '.vehicle-chk',
            function () {

                if (
                    $('.vehicle-chk:checked').length > 0
                ) {

                    $('#vehicleListWrapper')
                        .removeClass('border-danger');

                    $('#errVehicle').hide();

                }

            }
        );


        // ============================================================
        // Remove Route Validation Error
        // ============================================================

        $('#ddlRoute').on(
            'change',
            function () {

                if ($(this).val()) {

                    $(this)
                        .removeClass('is-invalid');

                }

            }
        );

    </script>

}