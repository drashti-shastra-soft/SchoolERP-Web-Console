@model SchoolERPWebConsole.Domain.PickupPointPageViewModel

@{
    ViewData["Title"] = "Add Pickup Point";
    var p = Model.Permissions;
    var edit = Model.EditPickupPoint;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(edit == null ? "Add Pickup Point" : "Edit Pickup Point")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveRecord()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/Transport/PickupPoint" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm">
                    <input type="hidden" id="hdnPickupPointID" value="@(edit?.PickupPointID ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)">
                    <div class="row row-gap-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Pickup Point Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" required maxlength="200"
                                   value="@edit?.PickupPointName" oninput="clearError('txtName')">
                            <div class="invalid-feedback">Pickup Point is required</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Latitude <span class="text-danger">*</span></label>
                            <input type="text" step="0.000001" class="form-control" id="txtLatitude" required maxlength="10"
                                   value="@edit?.PickupPointLatitude" oninput="clearError('txtLatitude')">
                            <div class="invalid-feedback">Latitude is required</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Longitude <span class="text-danger">*</span></label>
                            <input type="text" step="0.000001" class="form-control" id="txtLongitude" required maxlength="11"
                                   value="@edit?.PickupPointLongitude" oninput="clearError('txtLongitude')">
                            <div class="invalid-feedback">Longitude is required</div>
                        </div>
                        <div class="col-md-12 mt-2">
                            <button type="button" class="btn btn-info btn-sm text-white" onclick="previewMap()">
                                <i class="ti ti-map-pin me-1"></i> Preview Location
                            </button>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkActive"
                                       checked="@(edit == null ? true : edit.IsActive)">
                                <label class="form-check-label" for="chkActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearError(id) {
            $("#" + id).removeClass("is-invalid");
        }

        function maskCoordinateInput(e, min, max, maxIntegerDigits) {
            let val = e.target.value;

            // Step 1: strip anything that isn't a digit, minus, or dot
            val = val.replace(/[^0-9.\-]/g, "");

            // Step 2: allow only one leading minus sign
            val = val.replace(/(?!^)-/g, "");

            // Step 3: allow only one decimal point
            let parts = val.split(".");
            if (parts.length > 2) {
                val = parts[0] + "." + parts.slice(1).join("");
                parts = val.split(".");
            }

            // Step 4: limit integer part length (excluding the minus sign)
            let intPart = parts[0].replace("-", "");
            if (intPart.length > maxIntegerDigits) {
                intPart = intPart.substring(0, maxIntegerDigits);
            }
            const sign = parts[0].startsWith("-") ? "-" : "";
            parts[0] = sign + intPart;

            // Step 5: limit decimal part to 6 digits
            if (parts[1] !== undefined && parts[1].length > 6) {
                parts[1] = parts[1].substring(0, 6);
            }

            val = parts.length > 1 ? parts[0] + "." + parts[1] : parts[0];

            // Step 6: live range clamp — skip while value is a partial/incomplete state
            const isPartial = val === "" || val === "-" || val === "." || val === "-." || val.endsWith(".");

            if (!isPartial) {
                const num = parseFloat(val);
                if (!isNaN(num)) {
                    if (num > max) val = String(max);
                    else if (num < min) val = String(min);
                }
            }

            e.target.value = val;
        }

        $("#txtLatitude").on("input", function (e) {
            maskCoordinateInput(e, -90, 90, 2); // max 2 integer digits (90)
            clearError(this.id);
        });

        $("#txtLongitude").on("input", function (e) {
            maskCoordinateInput(e, -180, 180, 3); // max 3 integer digits (180)
            clearError(this.id);
        });

        // ===== Range Validation (on blur) =====
        function validateLatitude() {
            const $el = $("#txtLatitude");
            const val = parseFloat($el.val());

            if ($el.val() === "") return true; // required check handled separately on save

            if (isNaN(val) || val < -90 || val > 90) {
                $el.addClass("is-invalid");
                $el.next(".invalid-feedback").text("Latitude must be between -90 and 90");
                return false;
            }

            $el.removeClass("is-invalid");
            $el.next(".invalid-feedback").text("Latitude is required");
            return true;
        }

        function validateLongitude() {
            const $el = $("#txtLongitude");
            const val = parseFloat($el.val());

            if ($el.val() === "") return true;

            if (isNaN(val) || val < -180 || val > 180) {
                $el.addClass("is-invalid");
                $el.next(".invalid-feedback").text("Longitude must be between -180 and 180");
                return false;
            }

            $el.removeClass("is-invalid");
            $el.next(".invalid-feedback").text("Longitude is required");
            return true;
        }

        $("#txtLatitude").on("blur", validateLatitude);
        $("#txtLongitude").on("blur", validateLongitude);

        window.saveRecord = function () {
            var data = {
                pickupPointID: parseInt($("#hdnPickupPointID").val()) || 0,
                pickupPointName: $("#txtName").val().trim(),
                pickupPointLatitude: parseFloat($("#txtLatitude").val()),
                pickupPointLongitude: parseFloat($("#txtLongitude").val()),
                isActive: $("#chkActive").is(":checked"),
                companyID: parseInt($("#hdnCompanyID").val()) || 0,
                sessionID: parseInt($("#hdnSessionID").val()) || 0,
            };

            var missing = [];

            $("#txtName, #txtLatitude, #txtLongitude").removeClass("is-invalid");

            if (!data.pickupPointName) {
                missing.push("Pickup Point Name");
                $("#txtName").addClass("is-invalid");
            }

            if (!$("#txtLatitude").val()) {
                missing.push("Latitude");
                $("#txtLatitude").addClass("is-invalid");
            } else if (!validateLatitude()) {
                // Field has a value but it's outside -90..90
                missing.push("Latitude (must be between -90 and 90)");
            }

            if (!$("#txtLongitude").val()) {
                missing.push("Longitude");
                $("#txtLongitude").addClass("is-invalid");
            } else if (!validateLongitude()) {
                // Field has a value but it's outside -180..180
                missing.push("Longitude (must be between -180 and 180)");
            }

            if (missing.length > 0) {
                $(".is-invalid").first().focus();
                return;
            }

            $.ajax({
                url: "/Transport/UpsertPickupPoint",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (resp) {
                    console.log("Response:", resp);
                    if (resp.success) {
                        Swal.fire({
                            title: "Saved!",
                            text: data.pickupPointID > 0 ? "Pickup Point has been Updated successfully." : "Pickup Point has been Added successfully.",
                            icon: "success",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-success",
                            },
                            buttonsStyling: false,
                        }).then(function () {
                            window.location.href = "/Transport/PickupPoint";
                        });
                    } else {
                        Swal.fire({
                            title: "Error!",
                            text: resp.message || "Failed to save Pickup Point.",
                            icon: "error",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-danger",
                            },
                            buttonsStyling: false,
                        });
                    }
                },
                error: function (xhr) {
                    console.log("Error:", xhr.responseText);
                    Swal.fire({
                        title: "Error!",
                        text: "An unexpected error occurred while saving.",
                        icon: "error",
                        confirmButtonText: "OK",
                        customClass: {
                            confirmButton: "btn btn-danger",
                        },
                        buttonsStyling: false,
                    });
                },
            });
        };

        function previewMap() {
            var lat = $("#txtLatitude").val();
            var lng = $("#txtLongitude").val();
            if (!lat || !lng) {
                Swal.fire("Missing coordinates", "Please enter both Latitude and Longitude first.", "warning");
                return;
            }
            window.open("https://www.google.com/maps?q=" + lat + "," + lng, "_blank");
        }
    </script>

}

