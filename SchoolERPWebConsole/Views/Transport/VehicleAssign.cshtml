@model SchoolERPWebConsole.Domain.VehicleAssignPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Vehicle Assignment";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }
</style>

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Vehicle Assignment List</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <a href="/Transport/AddVehicleAssign" class="btn btn-primary top-btn"><i class="ti ti-plus me-1"></i>Add</a>
        }
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="editSelected()">
                <i class="ti ti-pencil me-1"></i> Edit
            </button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()">
                <i class="ti ti-trash me-1"></i> Delete
            </button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center shadow-sm top-btn" onclick="triggerExport('print')">
                <i class="ti ti-printer me-1"></i> Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-block">
                <button class="btn btn-warning dropdown-toggle d-inline-flex align-items-center shadow-sm top-btn" type="button" data-bs-toggle="dropdown">
                    <i class="ti ti-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport('copy')"><i class="ti ti-copy me-2"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport('csv')"><i class="ti ti-file-text me-2"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport('excel')"><i class="ti ti-file-spreadsheet me-2"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport('pdf')"><i class="ti ti-file-description me-2"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<div class="row">
    <!-- Filters -->
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 ">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" class="form-control border-0 ps-2" id="txtSearchInput"
                               placeholder="Search by route,vehicle.." style="min-width: 220px;">
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="col-xl-12">
        <div class="card shadow-tbl">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0" id="tblAssignments">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 50px;">SELECT</th>
                                <th>ROUTE</th>
                                <th>VEHICLE</th>
                                <th style="width: 100px;">STATUS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var validItems = (Model.Items ?? Enumerable.Empty<VehicleAssignViewModel>())
                                .Where(x =>
                                !string.IsNullOrWhiteSpace(x.RouteName) &&
                                !string.IsNullOrWhiteSpace(x.VehicleNumber))
                                .ToList();
                            }

                            @foreach (var routeGroup in validItems.GroupBy(i => i.RouteID))
                            {
                                var first = routeGroup.First();

                                var assignmentIds = string.Join(",",
                                routeGroup.Select(i => i.VehicleAssignID));

                                var vehicleIds = string.Join(",",
                                routeGroup.Select(i => i.VehicleID));

                                <tr class="item-row" data-route-id="@first.RouteID" onclick="selectRoute(@first.RouteID, this)" style="cursor: pointer;">

                                    <td class="ps-3" onclick="event.stopPropagation()">
                                        <input type="checkbox"
                                               name="selectedItem"
                                               class="form-check-input vehicleAssign-checkbox"
                                               value="@assignmentIds">
                                    </td>

                                    <td>
                                        @first.RouteName
                                    </td>

                                    <td>
                                        @foreach (var item in routeGroup)
                                        {
                                            <div class="mb-1">
                                                @item.VehicleNumber.ToLower()
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="form-check form-switch"
                                             onclick="event.stopPropagation()">

                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   onchange="toggleStatus(@first.VehicleAssignID, this.checked)"
                                                   @(first.IsActive ? "checked" : "")
                                                   @(p.CanEdit ? "" : "disabled")>
                                        </div>
                                    </td>

                                </tr>
                            }

                            @if (!validItems.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        @if (ViewBag.ErrorMessage != null)
                                        {
                                            <div class="text-danger">
                                                Error: @ViewBag.ErrorMessage
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No records found.
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script>
        window.currentUserId = @JsonSerializer.Serialize(currentUserId);
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.canPrint = @JsonSerializer.Serialize(p.CanPrint);
        window.canExport = @JsonSerializer.Serialize(p.CanExport);
    </script>

    <script src="@Url.Content("~/assets/js/VehicleAssign.js")"></script>
}