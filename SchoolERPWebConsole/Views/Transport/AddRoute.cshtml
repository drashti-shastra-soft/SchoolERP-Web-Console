@using System.Text.Json
@model SchoolERPWebConsole.Domain.RoutePageViewModel
@{
    ViewData["Title"] = "Add Route";
    var p = Model.Permissions;
    var edit = Model.EditRoute;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(edit == null ? "Add Route" : "Edit Route")
        </h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveRecord()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/Transport/Routes" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm">
                    <input type="hidden" id="hdnRouteID" value="@(edit?.RouteID ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)">
                    <div class="row row-gap-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Route Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtRouteName" required maxlength="200"
                                   value="@edit?.RouteName" oninput="clearError('txtRouteName')">
                            <div class="invalid-feedback">Route is required</div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkActive"
                                       checked="@(edit == null ? true : edit.IsActive)">
                                <label class="form-check-label" for="chkActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearError(id) {
            $("#" + id).removeClass("is-invalid");
        }

        window.saveRecord = function () {
            var routeID = parseInt($("#hdnRouteID").val()) || 0;

            var data = {
                routeID: routeID,
                routeName: $("#txtRouteName").val().trim(),
                isActive: $("#chkActive").is(":checked"),
                companyID: parseInt($("#hdnCompanyID").val()) || 0,
                sessionID: parseInt($("#hdnSessionID").val()) || 0,
            };

            var missing = [];

            $("#txtRouteName").removeClass("is-invalid");

            if (!data.routeName) {
                missing.push("Route Name");
                $("#txtRouteName").addClass("is-invalid");
            }

            if (missing.length > 0) {
                $(".is-invalid").first().focus();
                return;
            }

            $.ajax({
                url: "/Transport/UpsertRoute",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(data),
                success: function (resp) {
                    if (resp.success) {
                        // Add = RouteID 0
                        // Edit = RouteID greater than 0
                        var message =
                            routeID === 0 ? "Routes has been Added successfully." : "Routes has been Updated successfully.";

                        Swal.fire({
                            title: "Saved!",
                            text: message,
                            icon: "success",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-success",
                            },
                            buttonsStyling: false,
                        }).then(() => {
                            window.location.href = "/Transport/Routes";
                        });
                    } else {
                        Swal.fire({
                            title: "Error!",
                            text: resp.message || "Failed to save Route.",
                            icon: "error",
                            confirmButtonText: "OK",
                            customClass: {
                                confirmButton: "btn btn-danger",
                            },
                            buttonsStyling: false,
                        });
                    }
                },

                error: function () {
                    Swal.fire({
                        title: "Error!",
                        text: "An unexpected error occurred while saving.",
                        icon: "error",
                        confirmButtonText: "OK",
                        customClass: {
                            confirmButton: "btn btn-danger",
                        },
                        buttonsStyling: false,
                    });
                },
            });
        };
    </script>

}