@*
    ======================================================================
    VIEW: CBSE Marksheet Download  ->  "Exam MarkSheet Download Permission"
    Layout: _Layout   |   Script: ~/assets/js/CbseMarksheetDownload.js
    ======================================================================
*@
@using System.Security.Claims
@model SchoolERPWebConsole.Domain.PermissionAddViewModel
@{
    ViewData["Title"] = "CBSE Marksheet Download";
    Layout = "_Layout";

    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }


    var canAdd = Model.Permissions.CanAdd;
    var canEdit = Model.Permissions.CanEdit;
    var canDelete = Model.Permissions.CanDelete;
}

<style>
    .perm-grid th, .perm-grid td {
        vertical-align: middle;
        white-space: nowrap;
    }

    .perm-grid thead th {
        background: var(--bs-tertiary-bg, #f5f6f8);
    }

    .perm-grid .filter-cell .select2-container {
        min-width: 170px;
    }

    .perm-check {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

        .perm-check .badge {
            font-weight: 500;
        }

    .perm-grid tr.row-editing td {
        background: var(--bs-warning-bg-subtle, #fff8e1);
    }

    .perm-pager .page-link {
        cursor: pointer;
    }
    /* select2 hides the real <select>, so mirror the invalid state onto its box */
    select.is-invalid + .select2-container .select2-selection {
        border-color: var(--bs-form-invalid-border-color, #dc3545) !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <h6 class="fw-bold mb-0">Exam MarkSheet Download Permission</h6>

    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (canAdd)
        {
            <button type="button" id="btnAddNew" class="btn btn-primary top-btn d-none">
                <i class="ti ti-plus me-1"></i> Add New
            </button>
        }
        @if (canAdd || canEdit)
        {
            <button type="button" id="btnSave" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
            <button type="button" id="btnCopyFrom" class="btn btn-warning top-btn">
                <i class="ti ti-copy me-1"></i> Copy From
            </button>
        }
        @if (canEdit)
        {
            <button type="button" id="btnAllowMarksheet" class="btn btn-outline-success top-btn">
                <i class="ti ti-check me-1"></i> Allow MarkSheet
            </button>
            <button type="button" id="btnDisallowMarksheet" class="btn btn-outline-danger top-btn">
                <i class="ti ti-ban me-1"></i> Disallow MarkSheet
            </button>
            <button type="button" id="btnAllowStripsheet" class="btn btn-outline-success top-btn">
                <i class="ti ti-check me-1"></i> Allow StripSheet
            </button>
            <button type="button" id="btnDisallowStripsheet" class="btn btn-outline-danger top-btn">
                <i class="ti ti-ban me-1"></i> Disallow StripSheet
            </button>
        }
        <button type="button" id="btnReset" class="btn btn-secondary top-btn d-none">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
    </div>
</div>

<div id="permPageNotice"></div>

<!-- Entry form -->
<div class="card shadow-tbl-outer mb-3">
    <div class="card-body">
        <input type="hidden" id="txtPermissionId" value="0" />

        <div class="d-flex align-items-center justify-content-between mb-3">
            <span class="fw-semibold" id="lblFormMode">Add permission</span>
            <span class="badge bg-warning-subtle text-warning d-none" id="badgeEditing">Editing</span>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label" for="txtSession">Session</label>
                <input type="text" id="txtSession" class="form-control" value="" disabled />
            </div>

            <div class="col-md-3">
                <label class="form-label">Class:<span class="text-danger">*</span></label>
                <select id="ddlClass" class="form-select select2" style="width:100%;" onchange="onClassChange()">
                    <option value="">-- Select --</option>
                    @foreach (var c in Model.Class)
                    {
                        <option value="@c.ClassID">@c.ClassName</option>
                    }
                </select>
                <div class="invalid-feedback" id="errClass"></div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="ddlExamGroup">Exam Group <span class="text-danger">*</span></label>
                <select id="ddlExamGroup" class="form-select select2" style="width:100%;">
                    <option value="">Select</option>
                </select>
                <div class="invalid-feedback" id="errExamGroup"></div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="ddlDueMonth">Due Month <span class="text-danger">*</span></label>
                <select id="ddlDueMonth" class="form-select select2" style="width:100%;">
                    <option value="">Select</option>
                </select>
                <div class="invalid-feedback" id="errDueMonth"></div>
            </div>

            <div class="col-md-3">
                <label class="form-label" for="txtMaxBalance">Max Balance <span class="text-danger">*</span></label>
                <input type="number" id="txtMaxBalance" class="form-control" value="0" min="0" step="0.01" />
                <div class="invalid-feedback" id="errMaxBalance"></div>
                <div class="form-text">Students owing more than this cannot download.</div>
            </div>
        </div>
    </div>
</div>

<!-- Grid -->
<div class="card shadow-tbl-outer">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-bordered mb-0 perm-grid" id="tblPermission">
                <thead>
                    <tr>
                        <th style="width:60px;" class="text-center">S. No.</th>
                        <th class="text-center">
                            <label class="perm-check mb-0">
                                <input type="checkbox" class="form-check-input" id="chkAllMarksheet" /> MarkSheet
                            </label>
                        </th>
                        <th class="text-center">
                            <label class="perm-check mb-0">
                                <input type="checkbox" class="form-check-input" id="chkAllStripsheet" /> StripSheet
                            </label>
                        </th>
                        <th class="filter-cell d-none">
                            <select id="ddlFilterClass" class="form-select select2" style="width:100%;">
                                <option value="">Class</option>
                            </select>

                        </th>
                        <th>Class</th>
                        <th>Exam Group</th>
                        <th>Due Month UpTo</th>
                        <th class="text-end">Max Balance</th>
                        <th class="filter-cell d-none">
                            <select id="ddlFilterExamGroup" class="form-select select2" style="width:100%;">
                                <option value="">Exam Group</option>
                            </select>
                        </th>
                        <th>Created Date</th>
                        <th class="text-center" style="width:70px;">Edit</th>
                        <th class="text-center" style="width:70px;">Delete</th>
                    </tr>
                </thead>
                <tbody id="tblPermissionBody">
                    <tr><td colspan="10" class="text-center text-muted py-4">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-footer d-flex align-items-center justify-content-between flex-wrap gap-2">
        <span class="small text-muted" id="pagerInfo">Displaying 0-0 of 0 records</span>
        <nav class="perm-pager"><ul class="pagination pagination-sm mb-0" id="pager"></ul></nav>
    </div>
</div>

<!-- Copy From modal -->
<div class="modal fade" id="copyFromModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Copy permissions from another session</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="ddlCopyFromSession">Copy from session <span class="text-danger">*</span></label>
                <select id="ddlCopyFromSession" class="form-select" style="width:100%;">
                    <option value="">Select</option>
                </select>
                <div class="invalid-feedback" id="errCopyFrom"></div>
                <div class="form-text mt-2">
                    Records already present in the current session are skipped.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="btnConfirmCopy">
                    <i class="ti ti-copy me-1"></i> Copy
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd    = @Json.Serialize(canAdd);
        window.canEdit   = @Json.Serialize(canEdit);
        window.canDelete = @Json.Serialize(canDelete);
    </script>
    <script src="~/assets/js/CBSEMarksheetDownload.js" asp-append-version="true"></script>
}
