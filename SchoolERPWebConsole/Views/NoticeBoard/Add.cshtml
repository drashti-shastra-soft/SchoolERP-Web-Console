@*
    ======================================================================
    VIEW: NoticeBoard / Add.cshtml   (Add + Edit)
    Layout follows the "Compose New Message" screen:
      left  : Title, Notice Date, Publish On, Attachment (drag & drop), Message editor
      right : Message To (role check boxes)
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.NoticeBoardAddViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Notice Board";
    var p = Model.Permissions;
    var edit = Model.EditNoticeBoardModel;
    var isEdit = edit != null && edit.NoticeBoardId > 0;
    var canSave = isEdit ? p.CanEdit : p.CanAdd;
    var isActive = edit?.IsActive ?? true;
    var selectedRoles = edit?.RoleIdList ?? new List<int>();
    long maxMb = ViewBag.MaxFileSizeMB is long m ? m : 5;
    string D(DateTime? d) => d.HasValue ? d.Value.ToString("yyyy-MM-dd") : "";
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Notice Board</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (canSave)
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/NoticeBoard/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div id="noticeFormNotice"></div>

<form id="noticeBoardForm" onsubmit="return false;" novalidate>
    <input type="hidden" id="recordId" value="@(edit?.NoticeBoardId ?? 0)">
    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
    <input type="hidden" id="hdnSessionId" value="@(edit?.SessionId ?? 0)">
    <input type="hidden" id="hdnRemoveFile" value="false">

    <div class="card shadow-tbl-outer">
        <div class="card-header bg-white">
            <h6 class="mb-0 fw-normal">@(isEdit ? "Edit Message" : "Compose New Message")</h6>
        </div>
        <div class="card-body">
            <div class="row">

                <!-- ============ LEFT : form ============ -->
                <div class="col-lg-9">
                    <div class="row row-gap-3">

                        <!-- Title -->
                        <div class="col-12">
                            <label class="form-label" for="txtTitle">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtTitle" maxlength="500"
                                   value="@edit?.Title">
                            <div class="invalid-feedback" id="errTitle">Title is required.</div>
                        </div>

                        <!-- Dates -->
                        <div class="col-md-6">
                            <label class="form-label" for="dtNoticeDate">Notice Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dtNoticeDate" value="@D(edit?.NoticeDate)">
                            <div class="invalid-feedback" id="errNoticeDate">Notice date is required.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="dtPublishDate">Publish On <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dtPublishDate" value="@D(edit?.PublishDate)">
                            <div class="invalid-feedback" id="errPublishDate">Publish date is required.</div>
                        </div>

                        <!-- Attachment -->
                        <div class="col-12">
                            <label class="form-label">Attachment</label>

                            <div id="dropZone" class="drop-zone" tabindex="0" role="button">
                                <i class="ti ti-cloud-upload me-1"></i>
                                <span>Drag and drop a file here or click</span>
                            </div>
                            <input type="file" id="attachmentFile" class="d-none"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.txt">

                            <div class="text-danger small mt-1 d-none" id="errAttachment"></div>
                            <div class="small text-muted mt-1">Max @maxMb MB. PDF, Word, Excel, PowerPoint, images, text.</div>

                            <!-- newly chosen file -->
                            <div id="fileInfo" class="mt-1 d-none align-items-center gap-2">
                                <i class="ti ti-file"></i>
                                <span id="fileInfoName" class="small"></span>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" id="btnClearFile" title="Remove">
                                    <i class="ti ti-x"></i>
                                </button>
                            </div>

                            <!-- saved file (edit) -->
                            @if (!string.IsNullOrEmpty(edit?.Attachment))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@edit.Attachment" target="_blank" rel="noopener" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@(string.IsNullOrEmpty(edit.AttachmentName) ? "Attachment" : edit.AttachmentName)
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()" title="Remove">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Message -->
                        <div class="col-12">
                            <label class="form-label">Message <span class="text-danger">*</span></label>

                            <div class="editor-wrap" id="editorWrap">
                                <div class="editor-toolbar" id="editorToolbar">

                                    <div class="btn-group me-2">
                                        <button type="button" class="btn btn-light border dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="ti ti-letter-a me-1"></i><span id="formatLabel">Normal text</span>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item" href="javascript:void(0)" data-format="p">Normal text</a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0)" data-format="h1"><b>Heading 1</b></a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0)" data-format="h2"><b>Heading 2</b></a></li>
                                            <li><a class="dropdown-item" href="javascript:void(0)" data-format="h3"><b>Heading 3</b></a></li>
                                        </ul>
                                    </div>

                                    <div class="btn-group me-2">
                                        <button type="button" class="btn btn-light border fw-bold" data-cmd="bold">Bold</button>
                                        <button type="button" class="btn btn-light border fst-italic" data-cmd="italic">Italic</button>
                                        <button type="button" class="btn btn-light border text-decoration-underline" data-cmd="underline">Underline</button>
                                        <button type="button" class="btn btn-light border" data-cmd="small">Small</button>
                                    </div>

                                    <div class="btn-group me-2">
                                        <button type="button" class="btn btn-light border" data-cmd="quote" title="Quote"><i class="ti ti-quote"></i></button>
                                    </div>

                                    <div class="btn-group me-2">
                                        <button type="button" class="btn btn-light border" data-cmd="insertUnorderedList" title="Bullet list"><i class="ti ti-list"></i></button>
                                        <button type="button" class="btn btn-light border" data-cmd="insertOrderedList" title="Numbered list"><i class="ti ti-list-numbers"></i></button>
                                        <button type="button" class="btn btn-light border" data-cmd="outdent" title="Outdent"><i class="ti ti-indent-decrease"></i></button>
                                        <button type="button" class="btn btn-light border" data-cmd="indent" title="Indent"><i class="ti ti-indent-increase"></i></button>
                                    </div>

                                    <div class="btn-group">
                                        <button type="button" class="btn btn-light border" data-cmd="link" title="Insert link"><i class="ti ti-link"></i></button>
                                        <button type="button" class="btn btn-light border" data-cmd="image" title="Insert image"><i class="ti ti-photo"></i></button>
                                    </div>
                                    <input type="file" id="editorImageFile" class="d-none" accept="image/png,image/jpeg,image/gif,image/webp">
                                </div>

                                <div id="editor" class="editor-area" contenteditable="true" spellcheck="true"></div>
                            </div>
                            <div class="text-danger small mt-1 d-none" id="errMessage">Message is required.</div>

                            @* original html goes in an encoded textarea; JS sanitises it before it enters the editor *@
                            <textarea id="hdnMessageHtml" class="d-none">@edit?.NoticeMessage</textarea>
                        </div>

                        <!-- Active -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive" @(isActive ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ============ RIGHT : Message To ============ -->
                <div class="col-lg-3 mt-3 mt-lg-0">
                    <label class="form-label">Message To <span class="text-danger">*</span></label>
                    <div class="roles-panel" id="rolesPanel">
                        @if (Model.RoleList != null && Model.RoleList.Any())
                        {
                            foreach (var item in Model.RoleList)
                            {
                                <div class="form-check mb-2">
                                    <input class="form-check-input role-checkbox" type="checkbox"
                                           value="@item.RoleID" id="role_@item.RoleID"
                                    @(selectedRoles.Contains(item.RoleID) ? "checked" : "")>
                                    <label class="form-check-label fw-semibold" for="role_@item.RoleID">@item.RoleName</label>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">No roles found.</span>
                        }
                    </div>
                    <div class="text-danger small mt-1 d-none" id="errRoles">Select at least one role.</div>
                </div>

            </div>
        </div>
    </div>
</form>

@section Styles {
    <style>
        .drop-zone {
            border: 1px solid #ced4da;
            border-radius: .375rem;
            padding: .5rem 1rem;
            text-align: center;
            color: #6c757d;
            cursor: pointer;
            background: #fff;
            transition: background .15s, border-color .15s;
        }

            .drop-zone:hover, .drop-zone:focus, .drop-zone.dragover {
                background: #f1f5ff;
                border-color: #0d6efd;
                outline: 0;
            }

        .editor-wrap {
            border: 1px solid #ced4da;
            border-radius: .375rem;
            background: #fff;
        }

            .editor-wrap.is-invalid {
                border-color: #dc3545;
            }

        .editor-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: .25rem;
            padding: .5rem;
            border-bottom: 1px solid #e9ecef;
        }

        .editor-area {
            min-height: 260px;
            padding: .75rem;
            outline: 0;
            overflow-y: auto;
        }

            .editor-area:empty:before {
                content: 'Write your message here...';
                color: #adb5bd;
            }

            .editor-area blockquote {
                border-left: 3px solid #ced4da;
                padding-left: .75rem;
                color: #6c757d;
                margin: .5rem 0;
            }

            .editor-area img {
                max-width: 100%;
                height: auto;
            }

        .roles-panel {
            max-height: 420px;
            overflow-y: auto;
            padding-top: .25rem;
            padding:5px;
        }
    </style>
}

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.maxFileSizeMB = @maxMb;
    </script>
    <script src="~/assets/js/Noticeboard.js"></script>
}
