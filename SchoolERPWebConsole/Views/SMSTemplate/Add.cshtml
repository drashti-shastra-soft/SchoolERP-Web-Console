@model SchoolERPWebConsole.Domain.SMSTemplateAddViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "SMS Template";
    var p = Model.Permissions;
    var edit = Model.EditSMSTemplate;
    var isEdit = edit != null && edit.SMSTemplateId > 0;
    var canSave = isEdit ? p.CanEdit : p.CanAdd;
    var isActive = edit?.IsActive ?? true;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit SMS Template" : "Add SMS Template")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (canSave)
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/SMSTemplate/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form id="smsTemplateForm" onsubmit="return false;" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@edit?.SMSTemplateId">
                    <input type="hidden" id="hdnCompanyID" value="@edit?.CompanyID">

                    <div class="row row-gap-3">

                        <!-- Title -->
                        <div class="col-md-6">
                            <label class="form-label" for="txtName">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" maxlength="500"
                                   value="@edit?.Title" placeholder="Enter SMS title">
                            <div class="text-danger small mt-1 d-none" id="titleError">SMS title is required.</div>
                        </div>

                        <!-- Display Label -->
                        <div class="col-md-6">
                            <label class="form-label" for="txtDisplayName">Display Name</label>
                            <input type="text" class="form-control" id="txtDisplayName" maxlength="500"
                                   value="@edit?.DisplayLabel" placeholder="Enter display name (defaults to title)">
                        </div>

                        <!-- Message -->
                        <div class="col-md-12">
                            <label class="form-label" for="txtMessage">Message <span class="text-danger">*</span></label>
                            <textarea rows="4" class="form-control" id="txtMessage" placeholder="Enter SMS message">@edit?.Message</textarea>
                            <div class="d-flex justify-content-between mt-1">
                                <div class="text-danger small d-none" id="messageError">SMS message is required.</div>
                                <small class="text-muted ms-auto" id="msgCounter"></small>
                            </div>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive" @(isActive ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/SMSTemplate.js"></script>
}
