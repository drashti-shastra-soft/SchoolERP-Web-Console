@model SchoolERPWebConsole.Domain.CategoryGroupAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Category Group";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditatCegoryGroup == null ? "Add Category Group" : "Edit Category Group")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/CategoryGroup/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditatCegoryGroup?.CategoryGroupId">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditatCegoryGroup?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditatCegoryGroup?.SessionID">

                    <div class="row row-gap-3">

                        <!-- Account Type Name -->
                        <div class="col-md-6">
                            <label class="form-label">Category Group Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" value="@Model.EditatCegoryGroup?.CategoryName" placeholder="Enter Category Group Name">
                            <div class="text-danger small mt-1 d-none" id="nameError">Category Group Name is required.</div>
                        </div>

                        <!-- Title / Display Label -->
                        <div class="col-md-6">
                            <label class="form-label">Display Name</label>
                            <input type="text" class="form-control" id="txtDisplayName" value="@Model.EditatCegoryGroup?.DisplayLabel" placeholder="Enter Display Name">
                        </div>

                       
                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditatCegoryGroup?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/CategoryGroup.js"></script>
}