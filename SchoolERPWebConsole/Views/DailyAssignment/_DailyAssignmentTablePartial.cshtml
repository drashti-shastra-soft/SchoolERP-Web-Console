@model SchoolERPWebConsole.Domain.DailyAssignmentPageViewModel
@using System.Security.Claims
@using System.Text.Json

@{   
    var p = Model.Permissions;
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
}
<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body p-0">
            <div class="sticky-table">
            <div class="table-responsive">
                <table class="table" id="homeworkTable">
                    <thead>
                            <tr class="bg-light">
                            @if (ViewBag.IsStudent == true)
                            {
                                <th>Select</th>
                                <th>Subject</th>
                                <th>Teacher Name</th>
                                <th>Title</th>
                                @* <th>Description</th> *@
                                <th>Remark</th>
                                <th>Submission Date</th>
                                <th>Evaluation Date</th>
                                <th>Evaluated By</th>
                                <th>Action</th>
                            }
                            else
                            {

                                <th>Student Name</th>
                                <th>Class (Section)</th>
                                <th>Subject</th>
                                <th>Teacher Name</th>
                                <th>Title</th>
                                <th>Submission Date</th>
                                <th>Evaluation Date</th>
                                <th>Evaluated By</th>
                                <th>Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DailyAssignment != null && Model.DailyAssignment.Count() > 0)
                        {
                            foreach (var h in Model.DailyAssignment)
                            {
                                bool isEvaluated = h.EvaluationDate.HasValue;
                                @if (ViewBag.IsStudent == true)
                                {
                                    <tr class="student-row" data-assignment-id="@h.AssignmentID" data-evaluated="@isEvaluated.ToString().ToLower()">
                                        <td>
                                            <input type="checkbox"
                                                   class="row-checkbox"
                                                   value="@h.AssignmentID"
                                                   data-evaluated="@isEvaluated.ToString().ToLower()"
                                            @(isEvaluated ? "disabled" : "") />
                                        </td>
                                        <td>
                                            @h.SubjectName
                                        </td>
                                        <td>
                                            @h.CLASSTEACHERNAME
                                        </td>
                                        <td class="wrap-cell">@h.Title</td>
                                        @* <td class="wrap-cell">@h.Description</td> *@
                                        <td class="wrap-cell">@h.Remark</td>
                                        <td>@h.CreatedOn?.ToString("dd MMM yyyy")</td>
                                        <td>@h.EvaluationDate?.ToString("dd MMM yyyy")</td>
                                        <td>@h.EVALUATEDBYNAME</td>
                                        <td>
                                            <i class="fa fa-eye view-attachment-btn"
                                               style="cursor:pointer;"
                                               data-attachments='@Html.Raw(h.AttachmentsJson)'
                                               data-bs-toggle="modal"
                                               data-bs-target="#attachmentModal">
                                            </i>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="item-row" data-active="@h.IsActive" style="cursor: pointer;">

                                        <td>@h.StudentName</td>
                                        <td>
                                            <span>@h.ClassName</span> (@h.SectionName)
                                        </td>
                                        <td>@h.SubjectName</td>
                                        <td>@h.CLASSTEACHERNAME</td>
                                        <td class="wrap-cell">@h.Title</td>
                                        <td>@h.CreatedOn?.ToString("dd MMM yyyy")</td>
                                        <td>@h.EvaluationDate?.ToString("dd MMM yyyy")</td>
                                        <td>@h.EVALUATEDBYNAME</td>
                                        <td>
                                            <i class="fa fa-eye view-attachment-btn"
                                               style="cursor:pointer;"
                                               data-attachments='@Html.Raw(h.AttachmentsJson)'
                                               data-bs-toggle="modal"
                                               data-bs-target="#attachmentModal">
                                            </i>
                                            <a href="/dailyAssignment/Add/@h.AssignmentID"><i class="fa fa-newspaper"></i></a>
                                        </td>
                                    </tr>
                                }

                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-center py-4 text-muted" colspan="8">No matching records found</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- ── Pagination ─────────────────────────────────────────────── -->
                @if (totalPages > 1)
                {
                    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                        <!-- Record info -->
                        <div class="text-muted small">
                            Showing
                            <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                            –
                            <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                            of
                            <strong>@Model.TotalRecords</strong> users
                        </div>

                        <nav aria-label="Subject pagination">
                            <ul class="pagination pagination-sm mb-0">

                                <!-- First -->
                                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevrons-left"></i>
                                    </a>
                                </li>

                                <!-- Prev -->
                                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Page numbers — show 5 around current -->
                                @{
                                    int start = Math.Max(1, Model.PageNumber - 2);
                                    int end = Math.Min(totalPages, start + 4);
                                    start = Math.Max(1, end - 4);
                                }
                                @for (int pg = start; pg <= end; pg++)
                                {
                                    <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">@pg</a>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                                <!-- Last -->
                                <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevrons-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                }
            
            </div>
            </div>
        </div>
    </div>
</div>