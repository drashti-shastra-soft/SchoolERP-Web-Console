@model SchoolERPWebConsole.Domain.VoucherTypeFieldAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Voucher Type Field";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    var f = Model.EditVoucherTypeField;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(f == null ? "Add Voucher Type Field" : "Edit Voucher Type Field")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button type="button" onclick="resetForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <a href="/VoucherTypeField/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div id="voucherFieldPageNotice"></div>

<form id="accountHeadForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>Voucher Type Field</strong>
                </div>
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@f?.FieldID">

                    <div class="row row-gap-3">

                        <!-- Parent + identity -->
                        <div class="col-md-4">
                            <label class="form-label">Voucher Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlVoucherType" style="width: 100%;">
                                <option value="0">--Select--</option>
                                @foreach (var rt in Model.VoucherType)
                                {
                                    <option value="@rt.Id" selected="@(f?.VoucherId == rt.Id)">@rt.Name</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errVoucherType">Please select a voucher type.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Field Label <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldLabel" placeholder="e.g. Cash Book"
                                   value="@f?.FieldLabel" oninput="autoFillKey()">
                            <div class="text-danger small mt-1 d-none" id="errLabel">Field label is required.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Field Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldCode" placeholder="e.g. CASH_BOOK_ID"
                                   value="@f?.FieldCode" style="font-family:Consolas,monospace;">
                            <div class="text-danger small mt-1 d-none" id="errCode">Field code is required and must be unique for this voucher type.</div>
                        </div>

                        <!-- Rendering behavior -->
                        <div class="col-md-3">
                            <label class="form-label">Field Type <span class="text-danger">*</span></label>
                            <select id="fldType" class="form-select select2">
                                @{
                                    var ft = f?.FieldType ?? "TEXT";
                                }
                                <option value="TEXT" selected="@(ft == "TEXT")">Text</option>
                                <option value="NUMBER" selected="@(ft == "NUMBER")">Number</option>
                                <option value="DATE" selected="@(ft == "DATE")">Date</option>
                                <option value="DROPDOWN" selected="@(ft == "DROPDOWN")">Dropdown</option>
                                <option value="CHECKBOX" selected="@(ft == "CHECKBOX")">Checkbox</option>
                                <option value="RADIO" selected="@(ft == "RADIO")">Radio</option>
                                <option value="TEXTAREA" selected="@(ft == "TEXTAREA")">Text Area</option>
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errFieldType">Field type is required.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Section <span class="text-danger">*</span></label>
                            <select id="ddlSection" class="form-select select2">
                                @{
                                    var sec = f?.Section ?? "HEADER";
                                }
                                <option value="HEADER" selected="@(sec == "HEADER")">Header</option>
                                <option value="DETAIL" selected="@(sec == "GRID")">Grid</option>
                                <option value="FOOTER" selected="@(sec == "FOOTER")">Footer</option>
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errSection">Section is required.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Display Order</label>
                            <input type="text" class="form-control" id="txtDisplayOrder"
                                   value="@(f?.DisplayOrder ?? 0)">
                            <div class="text-danger small mt-1 d-none" id="errDisplayOrder">Display order must be a whole number.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max Length</label>
                            <input type="text" class="form-control" id="txtMaxLength"
                                   placeholder="optional" value="@f?.MaxLength">
                            <div class="text-danger small mt-1 d-none" id="errMaxLength">Max length must be a whole number.</div>
                        </div>

                        <!-- Number-specific / default -->
                        <div class="col-md-3">
                            <label class="form-label">Decimal Places</label>
                            <input type="text" class="form-control" id="txtDecimalPlaces"
                                   placeholder="e.g. 2 (for Amount fields)" value="@f?.DecimalPlaces">
                            <div class="text-danger small mt-1 d-none" id="errDecimalPlaces">Decimal places must be a whole number.</div>
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Default Value</label>
                            <input type="text" class="form-control" id="txtDefaultValue"
                                   placeholder="optional" value="@f?.DefaultValue">
                        </div>

                        <!-- Dropdown / lookup source (used when Field Type = Dropdown) -->
                        <div class="col-md-4">
                            <label class="form-label">Source Type</label>
                            <select id="ddlSourceType" class="form-select select2">
                                @{
                                    var st = f?.SourceType ?? "";
                                }
                                <option value="" selected="@(string.IsNullOrEmpty(st))">--None--</option>
                                <option value="STATIC" selected="@(st == "STATIC")">Static (fixed options)</option>
                                <option value="MASTER_TABLE" selected="@(st == "MASTER_TABLE")">Master Table</option>
                                <option value="QUERY" selected="@(st == "QUERY")">Custom Query</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Source Table</label>
                            <select id="txtSourceTable" class="form-select select2">
                                @{
                                    var sourcet = f?.SourceTable ?? "";
                                }
                                <option value="" selected="@(string.IsNullOrEmpty(sourcet))">--None--</option>
                                <option value="vw_ACC_AccountHead_Options" selected="@(sourcet == "vw_ACC_AccountHead_Options")">Account Head</option>
                                <option value="tbl_mst_Acc_BudgetHead" selected="@(sourcet == "tbl_mst_Acc_BudgetHead")">Budget Head</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Value Column</label>
                            <select id="txtSourceValueCol" class="form-select select2">
                                @{
                                    var vc = f?.SourceValueCol ?? "";
                                }
                                <option value="" selected="@(string.IsNullOrEmpty(vc))">--None--</option>
                                <option value="AccountID" selected="@(vc == "AccountID")">Account ID</option>
                                <option value="BudgetHeadId" selected="@(vc == "BudgetHeadId")">Budget Head Id</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Text Column</label>
                            <select id="txtSourceTextCol" class="form-select select2">
                                @{
                                    var tc = f?.SourceTextCol ?? "";
                                }
                                <option value="" selected="@(string.IsNullOrEmpty(tc))">--None--</option>
                                <option value="AccountDisplayName" selected="@(tc == "AccountDisplayName")">Account Name</option>
                                <option value="BudgetName" selected="@(tc == "BudgetName")">Budget Name</option>
                            </select>
                        </div>
                       
                        <div class="col-md-6" id="grpSourceFilter">
                            <label class="form-label">Source Filter</label>
                            <input type="text" class="form-control" id="txtSourceFilter"
                                   placeholder="e.g. IsActive=1" value="@f?.SourceFilter">
                        </div>

                        <!-- Flags -->
                        <div class="col-md-2 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="fldRequired"
                                @(f?.IsRequired ?? false ? "checked" : "")>
                                <label class="form-check-label" for="fldRequired">Required</label>
                            </div>
                        </div>

                        <div class="col-md-2 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="fldReadOnly"
                                @(f?.IsReadOnly ?? false ? "checked" : "")>
                                <label class="form-check-label" for="fldReadOnly">Read Only</label>
                            </div>
                        </div>

                        <div class="col-md-2 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(f?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/VoucherTypeField.js"></script>
}
