@model SchoolERPWebConsole.Domain.StudentAttendancePageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Attendance Report";
    var p = Model.Permissions;
    int totalPages = Model.PageSize > 0
                  ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                  : 0;
}

<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Attendance Report</h6>       
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">     
        <button class="btn btn-secondary d-inline-flex align-items-center top-btn d-none" onclick="triggerExport(4)">
            <i class="ti ti-printer me-1"></i>Print
        </button>
    </div>
</div>

<div class="row">

    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <!-- ── Search box (name="search" so form submits it) ── -->
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" name="search" id="txtSearchInput" value="@Model.SearchTerm" class="form-control border-0 ps-2 search-input-responsive" placeholder="Search by Student Name, Admission No..." />
                    </div>

                    <!-- Hidden form for filter submission — outside Bootstrap dropdown -->
                    <form method="get" asp-action="Report" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="classId" id="hdnClassId" value=@Model.ClassId />
                        <input type="hidden" id="hdnBackDateCount" value="@Model.BackDateCount" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value=@Model.CompanyId />
                        <input type="hidden" name="sectionId" id="hdnSectionID" value=@Model.SectionID />
                        <input type="hidden" name="studentId" id="hdnStudentId" value=@Model.StudentId />
                        <input type="hidden" name="date" id="hdnAttendanceDate" value=@Model.AttendanceDate />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                    </form>


                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown" style="max-width: calc(100vw - 2rem);">

                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">

                                    <button type="button" class="btn text-primary"
                                            onclick="resetAllFilters()" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="button" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                            id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>

                                </div>
                            </div>

                            <div class="filter-body pb-0">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Company <span class="text-danger">*</span></label>
                                        <select class="form-select form-control select2"
                                                id="ddlFilterCompany"
                                                data-placeholder="Select company">
                                            <option value="">All</option>
                                            @foreach (var c in Model.Companies ?? new List<SchoolERPWebConsole.Domain.MstCompanyViewModel>())
                                            {
                                                <option value="@c.CompanyId" selected="@(Model.CompanyId == c.CompanyId)">
                                                    @c.SchoolName
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Attendance Date <span class="text-danger">*</span></label>
                                        <input type="date" id="attendanceDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">
                                            Class <span class="text-danger">*</span>
                                        </label>
                                        <select id="classSelect" class="form-select form-control select2" required onchange="loadSections(this.value,'sectionSelect')">
                                            <option value="">Select Class</option>
                                            @if (Model.Classes != null)
                                            {
                                                foreach (var c in Model.Classes)
                                                {
                                                    <option value="@c.ClassID">@c.ClassName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">
                                            Section <span class="text-danger">*</span>
                                        </label>
                                        <select id="sectionSelect" class="form-select form-control select2" onchange="loadStudents()" required>
                                            <option value="">Select Section</option>
                                        </select>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label mb-1">
                                            Student
                                        </label>
                                        <select id="sectionStudent" class="form-select form-control select2" required>
                                            <option value="">Select Student</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>



    <div id="reportTableContainer">
        @await Html.PartialAsync("_ReportTablePartial", Model)
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/AttendanceReport.js"></script>
}
