@model SchoolERPWebConsole.Domain.AssignClassTeacherPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Class Teachers";
    var currentUserId = int.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? User.FindFirst("UserId")?.Value, out var id) ? id : 0;

    var p = Model.Permissions;
    var groupedAssignments = Model.Assignments ?? new List<ClassTeacherViewModel>();

    int totalPages = Model.PageSize > 0
               ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
               : 0;
}

<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Assign Class Teacher</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        @if (p.CanAdd)
        {
            <a href="/Academics/AddAssignClassTeacher" class="btn btn-primary top-btn"><i class="ti ti-plus me-1"></i> Add</a>
        }
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="editSelected()"><i class="ti ti-pencil me-1"></i>Edit</button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()"><i class="ti ti-trash me-1"></i>Delete</button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn d-none" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn d-none" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex position-relative">
                <button class="btn btn-warning dropdown-toggle top-btn"
                        type="button"
                        data-bs-toggle="dropdown"
                        data-bs-display="static"
                        aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<!-- start row -->
<div class="row">
    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <!-- ── Search box (name="search" so form submits it) ── -->
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text"
                               name="search"
                               id="txtSearchInput"
                               value="@Model.SearchTerm"
                               class="form-control border-0 ps-2 search-input-responsive"
                               placeholder="Search by class, section..." />
                    </div>

                    <!-- Hidden form for filter submission — outside Bootstrap dropdown -->
                    <form method="get" asp-action="AssignClassTeacher" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="sessionID" id="hdnSessionID" value="" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value="" />
                        <input type="hidden" name="sectionID" id="hdnSectionID" value="" />
                        <input type="hidden" name="classId" id="hdnClassID" value="" />
                        <input type="hidden" name="staffID" id="hdnStaffID" value="" />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                    </form>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl"
                             id="filter-dropdown">

                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn text-primary"
                                            onclick="resetAllFilters()" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="button" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                            id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>                                    
                                </div>
                            </div>

                            <div class="filter-body pb-3">
                                <div class="row">
                                    @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                               {
                                   Companies = Model.Companies,
                                   Sessions = Model.Sessions,
                                   CompanyId = Model.CompanyId,
                                   SessionId = Model.SessionId
                               })
                                    <div class="col-md-6">
                                        <label class="form-label">Class</label>
                                        <select id="ddlFilterClassID" class="form-select form-control" onchange="onClassChange()">
                                            <option value="">Select</option>
                                            @if (Model.Classes != null)
                                            {
                                                @foreach (var item in Model.Classes)
                                                {
                                                    <option value="@item.ClassID">@item.ClassName</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Section</label>
                                        <select id="ddlFilterSectionID" class="form-select form-control">
                                            <option value="">Select</option>
                                        </select>
                                    </div>
                                    @* <div class="col-md-12">
                                        <label class="form-label">Class Teacher <span class="text-danger">*</span></label>
                                        <select class="form-control" id="ddlFilterStaff" multiple>
                                            @if (Model.Staff != null)
                                            {
                                                @foreach (var s in Model.Staff)
                                                {
                                                    <option value="@s.StaffID">@s.FirstName @s.LastName (@s.StaffCode)</option>
                                                }
                                            }

                                        </select>
                                    </div> *@
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="subjectTableContainer">
        @await Html.PartialAsync("_AssignClassTeacherTablePartial", Model)
    </div>

</div>


@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }
    </style>
}

@section Scripts {
    <script>


                const IV = {
            clearMap: (map) => Object.keys(map).forEach(k => {
                document.getElementById(k)?.classList.remove('is-invalid');
                const err = document.getElementById(map[k]); if (err) err.textContent = '';
            }),
            setFieldError: (id, errId, msg) => {
                document.getElementById(id)?.classList.add('is-invalid');
                const err = document.getElementById(errId); if (err) err.textContent = msg;
            },
            setNotice: (id, msg, type = 'danger') => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = `<div class="alert alert-${type} alert-dismissible fade show" role="alert">${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
            },
            clearNotice: (id) => { const el = document.getElementById(id); if (el) el.innerHTML = ''; },
            bindAutoClear: (map) => Object.keys(map).forEach(k => document.getElementById(k)?.addEventListener('input', () => {
                document.getElementById(k)?.classList.remove('is-invalid');
                const err = document.getElementById(map[k]); if (err) err.textContent = '';
            }))
        };
                function loadAssignClassTeacherPartial(queryString) {
                    const container = document.getElementById('subjectTableContainer');
                    if (!container) return;

                    container.style.opacity = '0.5';

                    fetch(`/Academics/GetAssignClassTeacherPartial?${queryString}`, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(res => {
                            if (!res.ok) throw new Error('Failed to load subjects');
                            return res.text();
                        })
                        .then(html => {
                            container.innerHTML = html;
                            container.style.opacity = '1';

                            if ($.fn.DataTable.isDataTable('#assignmentsTable')) {
                                $('#assignmentsTable').DataTable().destroy();
                            }
                            var companyname = localStorage.getItem("comName");
                            exportTable = $('#assignmentsTable').DataTable({
                                dom: 'Bfrtip',
                                buttons: [
                                           { extend: 'copy',title: `Assign Class Teacher- ${companyname}`, exportOptions: { columns: [1, 2, 3, 4], rows: ':visible' } },
                                    { extend: 'csv',title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4], rows: ':visible' } },
                                    { extend: 'excel',title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4], rows: ':visible' } },
                                    { extend: 'pdf',title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4], rows: ':visible' } },
                                    { extend: 'print',title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4], rows: ':visible' } }
                                ],
                                searching: false,
                                paging: false,
                                info: false,
                                ordering: false
                            });

                            updateButtonStates();
                        })
                        .catch(err => {
                            console.error(err);
                            container.style.opacity = '1';
                            if (window.toast) window.toast.error('Could not refresh the list.');
                        });
                }
                        // ✅ NEW — pagination click interception, scoped to the subject container
                document.addEventListener('click', function (e) {
                    const link = e.target.closest('#subjectTableContainer .page-link');
                    if (!link || link.closest('.disabled')) return;

                    e.preventDefault();
                    const href = link.getAttribute('href');
                    if (!href || href === '#') return;

                    const query = href.split('?')[1] || '';
                    loadAssignClassTeacherPartial(query);
                    history.replaceState(null, '', href);
                });

                 function onClassChange() {
                    const classId = $('#ddlFilterClassID').val();
                    const filterSelect =$("#ddlFilterSectionID");
                    filterSelect.empty().append('<option value="">Select</option>');

                    if (classId) {
                        $.get('/Academics/GetSectionsByClass/' + classId, function (res) {
                            if (res.success) {
                                res.data.forEach(s => {
                                    filterSelect.append(`<option value="${s.sectionID}">${s.sectionName}</option>`);
                                });
                            }
                        });
                    }
                }

                function triggerExport(index) {
                    if ($.fn.DataTable.isDataTable('#assignmentsTable')) {
                        const table = $('#assignmentsTable').DataTable();
                        table.button(index).trigger();
                    }
                }
                // ========================================
                // Filter badges — sessionStorage persistence
                // ========================================
                const FILTER_KEY = 'appliedFilters_assignments';
                let appliedFilters = {};
                try {
                    const stored = sessionStorage.getItem(FILTER_KEY);
                    if (stored) appliedFilters = JSON.parse(stored);
                } catch (e) { appliedFilters = {}; }

                function saveAppliedFilters() {
                    try { sessionStorage.setItem(FILTER_KEY, JSON.stringify(appliedFilters)); }
                    catch (e) { console.warn('sessionStorage unavailable'); }
                }

                function clearAppliedFilters() {
                    appliedFilters = {};
                    try { sessionStorage.removeItem(FILTER_KEY); } catch (e) { }
                }

                function submitForm() {
                    // Sync hidden form fields from dropdowns before submit
                    const sessionEl = document.getElementById('ddlFilterSessions');
                    const companyEl = document.getElementById('ddlFilterCompany');
                    const sectionEl = document.getElementById('ddlFilterSection');
                    const classEl = document.getElementById('ddlFilterClassID');
                    const sectionID = document.getElementById('ddlFilterSectionID');
                    if (sessionEl) document.getElementById('hdnSessionID').value = sessionEl.value;
                    if (companyEl) document.getElementById('hdnCompanyId').value = companyEl.value;
                    if (sectionEl) document.getElementById('hdnSectionID').value = sectionEl.value;
                    if (classEl) document.getElementById('hdnClassID').value = classEl.value;
                    if (sectionID) document.getElementById('hdnStaffID').value = sectionID.value;
                   // document.getElementById('frmSearch').submit();

                         const form = document.getElementById('frmSearch');
                const params = new URLSearchParams(new FormData(form)).toString();

                loadAssignClassTeacherPartial(params);
                }

                function applyFilters() {
                    const sessionEl = document.getElementById('ddlFilterSessions');
                    const companyEl = document.getElementById('ddlFilterCompany');
                    const sectionEl = document.getElementById('ddlFilterSection');
                    const classEl = document.getElementById('ddlFilterClassID');
                    const sectionID = document.getElementById('ddlFilterSectionID');
                    const searchEl = document.getElementById('txtSearchInput');

                    // Search
                    const searchVal = searchEl?.value.trim();
                    if (searchVal) appliedFilters['txtSearchInput'] = { label: 'Search', text: searchVal };
                    else delete appliedFilters['txtSearchInput'];

                    // Session
                    if (sessionEl?.value && sessionEl.value !== '') {
                        appliedFilters['ddlFilterSessions'] = {
                            label: 'Session',
                            text: sessionEl.options[sessionEl.selectedIndex]?.text || sessionEl.value
                        };
                    } else delete appliedFilters['ddlFilterSessions'];

                    // Company
                    if (companyEl?.value && companyEl.value !== '') {
                        appliedFilters['ddlFilterCompany'] = {
                            label: 'Company',
                            text: companyEl.options[companyEl.selectedIndex]?.text || companyEl.value
                        };
                    } else delete appliedFilters['ddlFilterCompany'];

                    // Section
                    if (sectionEl?.value && sectionEl.value !== '') {
                        appliedFilters['ddlFilterSection'] = {
                            label: 'Section',
                            text: sectionEl.options[sectionEl.selectedIndex]?.text || sectionEl.value
                        };
                    } else delete appliedFilters['ddlFilterSection'];
                    if (classEl?.value && classEl.value !== '') {
                        appliedFilters['ddlFilterClassID'] = {
                            label: 'Section',
                            text: classEl.options[classEl.selectedIndex]?.text || classEl.value
                        };
                    } else delete appliedFilters['ddlFilterClassID'];

                    if (sectionID?.value && sectionID.value !== '') {
                        appliedFilters['ddlFilterSectionID'] = {
                            label: 'Section',
                            text: sectionID.options[sectionID.selectedIndex]?.text || sectionID.value
                        };
                    } else delete appliedFilters['ddlFilterSectionID'];

                    saveAppliedFilters();
                }

                function renderFilterBadges() {
                    const container = document.getElementById('badgeContainer');
                    const mainContainer = document.getElementById('activeFilterBadges');
                    if (!container || !mainContainer) return;

                    container.innerHTML = '';
                    const activeCount = Object.keys(appliedFilters).length;

                    Object.entries(appliedFilters).forEach(([id, { label, text }]) => {
                        const badge = document.createElement('span');
                        badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center gap-1 fw-medium px-2 py-1';
                        badge.innerHTML = `${label}: ${text} <i class="ti ti-x ms-1 cursor-pointer" onclick="removeFilter('${id}')" style="font-size:10px;"></i>`;
                        container.appendChild(badge);
                    });

                    mainContainer.style.display = activeCount > 0 ? 'block' : 'none';
                }

                        function removeFilter(filterId) {
                    const el = document.getElementById(filterId);
                    if (el) {
                        el.value = '';
                        if (window.jQuery && jQuery(el).data('select2')) {
                            jQuery(el).val('').trigger('change');
                        }
                    }
                    if (filterId === 'txtSearchInput') {
                        const hdn = document.getElementById('hdnSearch');
                        if (hdn) hdn.value = '';
                    }

                    delete appliedFilters[filterId];
                    saveAppliedFilters();
                    renderFilterBadges();   // ← added, so badge disappears immediately
                    document.getElementById('hdnPageIndex').value = 1;
                    submitForm();
                }

                       function resetAllFilters() {
                    document.getElementById('txtSearchInput').value = '';
                    document.getElementById('hdnSearch').value = '';

                    ['ddlFilterSessions', 'ddlFilterCompany', 'ddlFilterSection', 'ddlFilterClassID', 'ddlFilterSectionID'].forEach(id => {
                        const el = document.getElementById(id);
                        if (!el) return;
                        el.value = '';
                        if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
                    });

                    clearAppliedFilters();
                    renderFilterBadges();   // ← added
                    document.getElementById('hdnPageIndex').value = 1;
                    submitForm();
                }

                // ========================================
                // DOMContentLoaded — init DataTable + UI
                // ========================================
                document.addEventListener('DOMContentLoaded', () => {
                   
                        document.getElementById('btnApplyFilters')?.addEventListener('click', () => {
            document.getElementById('hdnPageIndex').value = 1;
            document.getElementById('hdnSearch').value = document.getElementById('txtSearchInput').value;
            applyFilters();
            submitForm();
        });
                    var companyname = localStorage.getItem("comName");
                    // ── DataTable (export only) ───────────────────────────────────────
                    if ($.fn.DataTable.isDataTable('#assignmentsTable')) {
                        $('#assignmentsTable').DataTable().destroy();
                    }
                    $.fn.dataTable.ext.errMode = 'none';
                    window.exportTable = $('#assignmentsTable').DataTable({
                        dom: 'Bfrtip',
                        buttons: [
                            { extend: 'copy', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4] } },
                            { extend: 'csv', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4] } },
                            { extend: 'excel', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4] } },
                            { extend: 'pdf', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4] } },
                            { extend: 'print', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3, 4] } }
                        ],
                        searching: false,
                        paging: false,
                        info: false,
                        ordering: false
                    });

                    // ── Select2 ───────────────────────────────────────────────────────
                    try {
                        if (window.jQuery && typeof jQuery.fn.select2 === 'function') {
                                    jQuery('#ddlFilterSessions, #ddlFilterCompany, #ddlFilterSection, #ddlFilterClassID, #ddlFilterSectionID').select2({
                                    width: '100%',
                                    dropdownParent: jQuery('#filter-dropdown'),
                                    allowClear: true,
                                    placeholder: function () { return jQuery(this).data('placeholder') || 'Select'; }
                                });
                        }
                    } catch (e) {
                        console.warn('Select2 init skipped:', e);
                    }

                    // ── Keep filter dropdown open while interacting inside ────────────
                    document.getElementById('filter-dropdown')?.addEventListener('click', e => e.stopPropagation());

                    // ── Apply Filters ─────────────────────────────────────────────────
                            document.getElementById('btnApplyFilters')?.addEventListener('click', () => {
                    document.getElementById('hdnPageIndex').value = 1;
                    document.getElementById('hdnSearch').value = document.getElementById('txtSearchInput').value;
                    applyFilters();
                    renderFilterBadges();   // ← added
                    submitForm();
                });

                    // ── Reset Filters ─────────────────────────────────────────────────
                    document.getElementById('btnResetFilters')?.addEventListener('click', () => {
                        document.getElementById('txtSearchInput').value = '';
                        document.getElementById('hdnSearch').value = '';
                        ['ddlFilterSessions', 'ddlFilterCompany','ddlFilterSection','ddlFilterClassID','ddlFilterSection'].forEach(id => {
                            const el = document.getElementById(id);
                            if (!el) return;
                            el.value = '';
                            if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
                        });
                        clearAppliedFilters();
                        document.getElementById('hdnPageIndex').value = 1;
                        submitForm();
                    });

                    // ── Render badges on load ─────────────────────────────────────────
                    renderFilterBadges();
                });


               let searchTimer = null;

              document.getElementById('txtSearchInput')?.addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                document.getElementById('hdnSearch').value = this.value;
                document.getElementById('hdnPageIndex').value = 1;

                const val = this.value.trim();
                if (val) appliedFilters['txtSearchInput'] = { label: 'Search', text: val };
                else delete appliedFilters['txtSearchInput'];
                saveAppliedFilters();
                renderFilterBadges(); // ✅ NEW

                submitForm();
            }, 500);
        });

                let teacherChoices;
                let selectedRow = null;
                var companyname = localStorage.getItem("comName");
                $(document).ready(function () {
                    $('#assignmentsTable').DataTable({
                        dom: 'Bfrtip',
                        buttons: [
                            { extend: 'copy', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3] } },
                            { extend: 'csv', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3] } },
                            { extend: 'excel', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3] } },
                            { extend: 'pdf', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3] } },
                            { extend: 'print', title: `Assign Class Teacher - ${companyname}`, exportOptions: { columns: [1, 2, 3] } }
                        ],
                        searching: false,
                        paging: false,
                        info: false
                    });

                    // Initialize Choices manually
                    const element = document.querySelector('#choices-multiple-remove-button');
                    if (element) {
                        teacherChoices = new Choices(element, {
                            removeItemButton: true,
                            placeholderValue: 'Select Teachers',
                            searchPlaceholderValue: 'Search teachers...'
                        });
                    }

                    // Search functionality
                    $("#tableSearch").on("keyup", function() {
                        var value = $(this).val().toLowerCase();
                        $("#assignmentsTable tbody tr").filter(function() {
                            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                        });
                    });
                });

                function selectItem(row) {
                    selectedRow = $(row);
                    $(".item-row").removeClass("bg-light");
                    selectedRow.addClass("bg-light");


                    $("#btnEdit").prop("disabled", false);
                    $("#btnDelete").prop("disabled", false);
                    let checkedCount = $('.student-checkbox:checked').length;
                    $('#btnDelete').prop('disabled', checkedCount === 0);
                    // Edit sirf 1 record select hone par
                    $('#btnEdit').prop('disabled', checkedCount !== 1);
                           $('#btnActive').prop('disabled', checkedCount === 0);
        $('#btnInactive').prop('disabled', checkedCount === 0);
                }


                function editSelected() {
                    if (!selectedRow) return;

                    const classId = selectedRow.data("class-id");
                    const sectionId = selectedRow.data("section-id");
                    const staffIds = selectedRow.data("staff-ids");
                        try {

                            if (classId) {
                    const staffParam = Array.isArray(staffIds)
                        ? staffIds.join(',')
                        : (staffIds || '');

                    location.href = `/Academics/AddAssignClassTeacher/${classId}`
                                  + `?sectionId=${sectionId || ''}`
                                  + `&staffIds=${staffParam}`;
                }

                } catch (err) {
                    console.error(err);
                }
                }


                function deleteSelected() {

                         var classIds = [];
                         var sectionIds = [];
                        $('.student-checkbox:checked').each(function () {
                            classIds.push($(this).data('class-id'));
                            sectionIds.push($(this).data('section-id'));
                        });

                        if (classIds.length === 0) {
                            alert('Please select at least one record.');
                            return;
                        }

                         Swal.fire({
                        title: 'Are you sure?',
                        text: "You are about to delete this class teachers record. This action cannot be undone!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!',
                        customClass: {
                            confirmButton: 'btn btn-danger me-2',
                            cancelButton: 'btn btn-secondary'
                        },
                        buttonsStyling: false
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                 url: '/Academics/DeleteClassTeacherByClassSection',
                                type: 'POST',
                                traditional: true,
                                data: {
                                    classId: classIds,
                                    sectionId: sectionIds
                                },
                                success: function (res) {
                                    if (res.success) {
                                        Swal.fire('Deleted!', 'Class teachers record has been deleted.', 'success')
                                            .then(() => loadAssignClassTeacherPartial(new URLSearchParams(new FormData(document.getElementById('frmSearch'))).toString())); // ✅ CHANGED — was location.reload()
                                    } else {
                                        Swal.fire('Error!', res.message || 'Failed to delete class teachers.', 'error');
                                    }
                                },
                                error: function () {
                                    Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                                }
                            });
                        }
                    });

                }

                        // ========================================
        // Toggle Status
        // ========================================
        async function toggleStatus(id, isActive) {
            // if (!window.canEdit) {
            //     IV.setNotice('pageNotice', 'You do not have permission to change status.');
            //     loadAssignClassTeacherPartial(new URLSearchParams(new FormData(document.getElementById('frmSearch'))).toString()); // ✅ CHANGED — was location.reload()
            //     return;
            // }

            let sectionIds = [];
            $('.student-checkbox:checked').each(function () { sectionIds.push(parseInt($(this).val())); });
            if (sectionIds.length === 0) {
                if (id !== 0) { sectionIds.push(parseInt(id)); }
                else { showToast('Please select at least one subject', false); return; }
            }

            const request = { ids: sectionIds.join(','), isActive };

            const config = isActive
                ? { icon: 'question', title: 'Activate Record(s)?', text: 'Activating will make it visible across the system. Continue?', confirmText: 'Yes, Activate', confirmBtnClass: 'btn btn-success me-2' }
                : { icon: 'warning', title: 'Deactivate Record(s)?', text: 'Deactivating will hide it from the system. Continue?', confirmText: 'Yes, Deactivate', confirmBtnClass: 'btn btn-danger me-2' };

            try {
                Swal.fire({
                    icon: config.icon, title: config.title, text: config.text,
                    showCancelButton: true,
                    confirmButtonColor: '#d33', cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, proceed!',
                    customClass: { confirmButton: 'btn btn-danger me-2', cancelButton: 'btn btn-secondary' },
                    buttonsStyling: false
                }).then(result => {
                    if (!result.isConfirmed) return;
                    $.ajax({
                        url: '/Academics/ToggleAcademicsClassTeacherStatus',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(request),
                        success: res => res.success
                            ? Swal.fire('Updated!', res.message || 'Status updated successfully.', 'success')
                                .then(() => loadAssignClassTeacherPartial(new URLSearchParams(new FormData(document.getElementById('frmSearch'))).toString())) // ✅ CHANGED — was location.reload()
                            : Swal.fire('Error!', res.message || 'Failed to update status.', 'error'),
                        error: xhr => {
                            console.error('Status update error:', xhr.status, xhr.responseText);
                            Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                        }
                    });
                });
            } catch (err) {
                console.error(err);
                IV.setNotice('pageNotice', 'Could not update status.'); // ✅ FIXED — was 'sectionPageNotice' (wrong id, leftover copy-paste)
                loadAssignClassTeacherPartial(new URLSearchParams(new FormData(document.getElementById('frmSearch'))).toString()); // ✅ CHANGED — was location.reload()
            }
        }

    </script>
}
