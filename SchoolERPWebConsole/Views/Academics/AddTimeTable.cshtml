@model SchoolERPWebConsole.Domain.AddTimeTablePageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Add Class Timetable";
    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
    var p = Model.Permissions;
}

<style>
    /* Show field labels only on the first row of each day; keep inputs aligned */
    .slots-container .slot-row:not(:first-child) .form-label {
        display: none;
    }
    /* Make Time From / Time To match the height & style of the select dropdowns */
    .slot-row input[type="time"] {
        height: 38px;
        padding: 0.375rem 0.75rem;
        font-size: 0.875rem;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        color: #495057;
        background-color: #fff;
    }

        /* Normalize the native clock icon so it doesn't look oversized/misaligned */
        .slot-row input[type="time"]::-webkit-calendar-picker-indicator {
            opacity: 0.6;
            cursor: pointer;
            padding: 0;
            margin-left: 4px;
        }

            .slot-row input[type="time"]::-webkit-calendar-picker-indicator:hover {
                opacity: 1;
            }

    /* Make sure the select2-rendered dropdowns are the exact same height as time inputs */
    .slot-row .select2-container .select2-selection--single {
        height: 38px !important;
        display: flex;
        align-items: center;
    }
    /* Custom Select2 validation styling (no native tooltip) */
    .select2-container.is-invalid .select2-selection {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .15rem rgba(220, 53, 69, .15);
    }

    .select2-error-msg {
        display: none;
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .gen-error {
        color: #dc3545;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    #GenDuration.is-invalid, #GenInterval.is-invalid,
    #GenRoomNo.is-invalid, #GenStartTime.is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 .15rem rgba(220, 53, 69, .15);
    }
</style>
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Add Class Timetable</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1 ">
        @if(p.CanAdd)
        {
            <button onclick="saveAllTimeTable()" class="btn btn-success top-btn"><i class="ti ti-cloud me-1"></i> Save</button>
        }        
        <a href="/Academics/ClassTimeTable" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
   
</div>
<!-- End Page Header -->

<!-- start row -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body">
                <form id="filterForm" method="post" action="/Academics/AddTimeTable">
                    <div class="d-flex align-items-center justify-content-between">
                        <input type="text" id="tableSearch" class="form-control w-25 me-3 d-none" style="width:320px" placeholder="Search..." />
                        <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0">

                            <div class="dropdown">
                                <a href="#" id="btnFilterToggle"
                                   class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                                   data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                                </a>

                                <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown" style="max-width: calc(100vw - 2rem);">

                                    <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                        <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                        <div class="d-flex align-items-center justify-content-end">
                                            <button type="submit" class="btn btn-light btn-md me-2 fw-medium" onclick="resetAllFilters()" id="btnResetFilters">Reset</button>
                                           @*  <button type="button" class="btn text-primary fs-6 fw-medium" id="btnApplyFilters">
                                                <i class="ti ti-filter me-1"></i>Apply
                                            </button> *@
                                            <button type="button" class="btn text-primary fs-6 fw-medium" id="btnApplyFilters">
                                                <i class="ti ti-filter me-1"></i>Apply
                                            </button>
                                            <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none" id="btnCloseFilter" aria-label="Close">
                                                <i class="ti ti-x"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="filter-body pb-0">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label mb-1">Classes <span class="text-danger">*</span></label>
                                                <select name="classId" id="FilterClassID" class="form-select form-control select2">
                                                    <option value="">Select</option>
                                                    @foreach (var item in Model.Classes)
                                                    {
                                                        <option value="@item.ClassID" selected="@(Model.SelectedClassId == item.ClassID)">@item.ClassName</option>
                                                    }
                                                </select>
                                                <div class="select2-error-msg" id="err_FilterClassID">Please select a class</div>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label mb-1">Section <span class="text-danger">*</span></label>
                                                <select name="sectionId" id="FilterSectionID" class="form-select form-control select2">
                                                    <option value="">Select</option>
                                                </select>
                                                <div class="select2-error-msg" id="err_FilterSectionID">Please select a section</div>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <label class="form-label mb-1">Subject Groups <span class="text-danger">*</span></label>
                                                <select name="subjectGroupId" id="FilterSubjectGroupID" class="form-select form-control select2">
                                                    <option value="">Select Subject Groups</option>
                                                    @if(@Model.SubjectGroups !=null)
                                                    {
                                                        @foreach (var item in Model.SubjectGroups)
                                                        {
                                                            <option value="@item.SubjectGroupID" selected="@(Model.SelectedSubjectGroupId == item.SubjectGroupID)">@item.Name</option>
                                                        }
                                                    }
                                                    
                                                </select>
                                                <div class="select2-error-msg" id="err_FilterSubjectGroupID">Please select a subject group</div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                           
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2"><i class="ti ti-filter-check me-1"></i>Active Filters:</span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none" id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>
    <div class="col-xl-12">
        <!-- Parameter Generator Card -->
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-header">
                <h6 class="card-title">Select parameter to generate time table quickly</h6>
            </div>
            <div class="card-body">
                <div class="d-flex gap-2 align-items-end flex-wrap">
                    <div class="flex-grow-1">
                        <label class="form-label">Period Start Time <span class="text-danger">*</span></label>
                        <input type="time" id="GenStartTime" class="form-control">
                        <div class="gen-error d-none" id="err_GenStartTime">Start time is required</div>
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label">Duration (minute) <span class="text-danger">*</span></label>
                        <input type="number" id="GenDuration" class="form-control"
                               min="1" max="240" step="1" maxlength="3" placeholder="e.g. 40"
                               oninput="this.value = this.value.slice(0,3)">
                        <div class="gen-error d-none" id="err_GenDuration">Enter 1–240 minutes</div>
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label">Interval (minute) <span class="text-danger">*</span></label>
                        <input type="number" id="GenInterval" class="form-control"
                               min="0" max="60" step="1" maxlength="2" placeholder="e.g. 5"
                               oninput="this.value = this.value.slice(0,2)">
                        <div class="gen-error d-none" id="err_GenInterval">Enter 0–60 minutes</div>
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label">Room No <span class="text-danger">*</span></label>
                        <input type="text" id="GenRoomNo" class="form-control" maxlength="20" placeholder="e.g. R-101">
                        <div class="gen-error d-none" id="err_GenRoomNo">Room No is required</div>
                    </div>
                    <button type="button" onclick="applyGenParameters()" class="btn btn-teal mb-1 top-btn">Apply</button>
                </div>
            </div>
        </div>

        <!-- Time Table Tabs Card -->
        <div class="card shadow-tbl-outer">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap" id="tabsStickyBar">
                <div class="day-tabs-wrapper">
                <ul class="nav nav-pills gap-2 tab-scroll" id="dayTabs">
                    @for (int i = 0; i < days.Length; i++)
                    {
                        <li class="nav-item">
                            <a href="#day-@i" data-bs-toggle="pill" class="nav-link @(i == 0 ? "active" : "")">@days[i]</a>
                        </li>
                    }
                </ul>
                </div>
                @* <button type="button" onclick="addNewRow()" class="btn btn-primary top-btn me-1"><i class="ti ti-plus"></i> Add</button> *@
                
            </div>
            <div class="card-body">
                <div class="tab-content" id="tabContent">
                    @for (int i = 0; i < days.Length; i++)
                    {
                        var dayName = days[i];
                        var daySlots = Model.TimeTableSlots.Where(x => x.Day == dayName).ToList();
                        <div class="tab-pane @(i == 0 ? "active" : "")" id="day-@i" data-day="@dayName">
                            <div class="slots-container">
                                @if (daySlots.Any())
                                {
                                    foreach (var slot in daySlots)
                                    {
                                        <div class="slot-row d-flex gap-2 align-items-end mb-3">
                                            <div class="flex-grow-1">
                                                <input type="hidden" name="TimeTableID" value="@slot.TimeTableID">
                                                <label class="form-label">Subject</label>
                                                <select name="SubjectID" class="form-select form-control select2-dynamic">
                                                    <option value="">Select</option>
                                                    @foreach (var s in Model.Subjects) { 
                                                        <option value="@s.SubjectID" selected="@(slot.SubjectID == s.SubjectID)">@s.SubjectName</option> 
                                                    }
                                                </select>
                                            </div>
                                            <div class="flex-grow-1">
                                                <label class="form-label">Teacher</label>
                                                <select name="StaffID" class="form-select form-control select2-dynamic">
                                                    <option value="">Select</option>
                                                    @foreach (var st in Model.Staff) { 
                                                        <option value="@st.StaffID" selected="@(slot.StaffID == st.StaffID)">@st.FirstName @st.LastName</option> 
                                                    }
                                                </select>
                                            </div>
                                            <div class="flex-grow-1 mb-2">
                                                <label class="form-label">Time From <span class="text-danger">*</span></label>
                                                <input type="time" name="StartTime" class="form-control" value="@slot.StartTime">
                                            </div>
                                            <div class="flex-grow-1 mb-2">
                                                <label class="form-label">Time To <span class="text-danger">*</span></label>
                                                <input type="time" name="EndTime" class="form-control" value="@slot.EndTime">
                                            </div>
                                            <div class="flex-grow-2 mb-2">
                                                <label class="form-label">Room No <span class="text-danger">*</span></label>
                                                <input type="text" name="RoomNo" class="form-control" value="@slot.RoomNo">
                                            </div>
                                            <div class="d-flex gap-1 mb-2">
                                                <button type="button" class="btn btn-primary btn-add-row" style="width:38px;height:38px;padding:0;display:none;" onclick="addRow(this)">
                                                    <i class="ti ti-plus"></i>
                                                </button>
                                                <button type="button" class="btn btn-danger" style="width:38px;height:38px;padding:0;" onclick="deleteRow(this)">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </div>
                                            @* <button type="button" class="btn btn-danger mb-1 top-btn" onclick="deleteRow(this)"><i class="ti ti-trash me-1"></i> Delete</button> *@
                                        </div>
                                    }
                                }
                                else
                                {
                                    <!-- Initial row if none exist -->
                                    <div class="slot-row d-flex gap-2 align-items-end mb-3">
                                        <div class="flex-grow-1">
                                            <input type="hidden" name="TimeTableID" value="0">
                                            <label class="form-label">Subject</label>
                                            <select name="SubjectID" class="form-select form-control select2-dynamic">
                                                <option value="">Select</option>
                                                @foreach (var s in Model.Subjects) { <option value="@s.SubjectID">@s.SubjectName</option> }
                                            </select>
                                        </div>
                                        <div class="flex-grow-1">
                                            <label class="form-label">Teacher</label>
                                            <select name="StaffID" class="form-select form-control select2-dynamic">
                                                <option value="">Select</option>
                                                @foreach (var st in Model.Staff) { <option value="@st.StaffID">@st.FirstName @st.LastName</option> }
                                            </select>
                                        </div>
                                        <div class="flex-grow-1 mb-2">
                                            <label class="form-label">Time From <span class="text-danger">*</span></label>
                                            <input type="time" name="StartTime" class="form-control">
                                        </div>
                                        <div class="flex-grow-1 mb-2">
                                            <label class="form-label">Time To <span class="text-danger">*</span></label>
                                            <input type="time" name="EndTime" class="form-control">
                                        </div>
                                        <div class="flex-grow-2 mb-2">
                                            <label class="form-label">Room No <span class="text-danger">*</span></label>
                                            <input type="text" name="RoomNo" class="form-control">
                                        </div>
                                        <div class="d-flex gap-1 mb-2">
                                            <button type="button" class="btn btn-primary btn-add-row" style="width:38px;height:38px;padding:0;display:none;" onclick="addRow(this)">
                                                <i class="ti ti-plus"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger" style="width:38px;height:38px;padding:0;" onclick="deleteRow(this)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                        @* <button type="button" class="btn btn-danger py-2 top-btn" onclick="deleteRow(this)"><i class="ti ti-trash me-1"></i> Delete</button> *@
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<template id="slotTemplate">
    <div class="slot-row d-flex gap-2 align-items-end mb-3">
        <div class="flex-grow-1">
            <input type="hidden" name="TimeTableID" value="0">
            <label class="form-label">Subject</label>
            <select name="SubjectID" class="form-select form-control">
                <option value="">Select</option>
                @foreach (var s in Model.Subjects) { <option value="@s.SubjectID">@s.SubjectName</option> }
            </select>
        </div>
        <div class="flex-grow-1">
            <label class="form-label">Teacher</label>
            <select name="StaffID" class="form-select form-control">
                <option value="">Select</option>
                @foreach (var st in Model.Staff) { <option value="@st.StaffID">@st.FirstName @st.LastName</option> }
            </select>
        </div>
        <div class="flex-grow-1 mb-2">
            <label class="form-label">Time From <span class="text-danger">*</span></label>
            <input type="time" name="StartTime" class="form-control">
        </div>
        <div class="flex-grow-1 mb-2">
            <label class="form-label">Time To <span class="text-danger">*</span></label>
            <input type="time" name="EndTime" class="form-control">
        </div>
        <div class="flex-grow-2 mb-2">
            <label class="form-label">Room No <span class="text-danger">*</span></label>
            <input type="text" name="RoomNo" class="form-control">
        </div>
        <div class="d-flex gap-1 mb-2">
            <button type="button" class="btn btn-primary btn-add-row" style="width:38px;height:38px;padding:0;display:none;" onclick="addRow(this)">
                <i class="ti ti-plus"></i>
            </button>
            <button type="button" class="btn btn-danger" style="width:38px;height:38px;padding:0;" onclick="deleteRow(this)">
                <i class="ti ti-trash"></i>
            </button>
        </div>
        @* <button type="button" class="btn btn-danger py-2 top-btn" onclick="deleteRow(this)"><i class="ti ti-trash me-1"></i> Delete</button> *@
    </div>
</template>

@section Scripts {
    <script>
        window.TimeTableFilters = {
            selectedClassId: @Html.Raw(Model.SelectedClassId.ToString() ?? "0"),
            selectedSectionId: @Html.Raw(Model.SelectedSectionId.ToString() ?? "0"),
            selectedSubjectGroupId: @Html.Raw(Model.SelectedSubjectGroupId.ToString() ?? "0")
        };
    </script>
    <script src="~/assets/js/AddClassTimetable.js"></script>
}