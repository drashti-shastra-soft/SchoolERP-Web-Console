@model SchoolERPWebConsole.Domain.VoucherFieldOptionAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Voucher Field Option";
    var p = Model.Permissions;
    var o = Model.EditVoucherFieldOption;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(o == null ? "Add Voucher Field Option" : "Edit Voucher Field Option")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button type="button" onclick="resetForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <a href="/VoucherFieldOption/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div id="voucherFieldOptionPageNotice"></div>

<form id="accountHeadForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>Voucher Type Field Option</strong>
                </div>
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@o?.OptionID">

                    <div class="row row-gap-3">

                        <div class="col-md-6">
                            <label class="form-label">Voucher Type Field <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlField" style="width: 100%;">
                                <option value="0">--Select--</option>
                                @foreach (var fld in Model.Field)
                                {
                                    <option value="@fld.Id" selected="@(o?.FieldID == fld.Id)">@fld.Name</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errField">Please select a voucher type field.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Display Order</label>
                            <input type="text" class="form-control" id="txtDisplayOrder"
                                   value="@(o?.DisplayOrder ?? 0)">
                            <div class="text-danger small mt-1 d-none" id="errDisplayOrder">Display order must be a whole number.</div>
                        </div>

                        <div class="col-md-3 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="fldIsDefault"
                                @(o?.IsDefault ?? false ? "checked" : "")>
                                <label class="form-check-label" for="fldIsDefault">Default Option</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Option Label <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldOptionLabel" placeholder="e.g. Cheque"
                                   value="@o?.OptionLabel" oninput="autoFillOptionValue()">
                            <div class="text-danger small mt-1 d-none" id="errOptionLabel">Option label is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Option Value <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldOptionValue" placeholder="e.g. CHQ"
                                   value="@o?.OptionValue" style="font-family:Consolas,monospace;">
                            <div class="text-danger small mt-1 d-none" id="errOptionValue">Option value is required and must be unique for this field.</div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(o?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/VoucherFieldOption.js"></script>
}
