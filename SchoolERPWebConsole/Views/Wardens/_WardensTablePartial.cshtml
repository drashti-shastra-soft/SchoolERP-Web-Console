@*
    ======================================================================
    VIEW: Academics / Class.cshtml
    PURPOSE: User interface for managing Classes and their Section mappings.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.WardensPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{    
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
    var p = Model.Permissions;
}
    <div class="col-xl-12">
        <div class="card shadow-tbl">
            <div class="card-body">
                <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table" id="tblWarden">
                        <thead>
                                <tr class="bg-light">
                                <th class="ps-4" style="width: 50px;">Select</th>
                                <th>Hostel Name</th>
                                <th>Warden Name</th>
                                <th>Warden Contact</th>
                                <th>Warden Email</th>
                                <th>Address</th>
                                <th>Country Name</th>
                                <th>State Name</th>
                                <th>PinCode</th>
                                <th>Joining Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.WardensModel != null)
                            {
                                @foreach (var c in Model.WardensModel)
                                {
                                            <tr class="item-row" onclick="selectItem(@c.WardenId, this)" style="cursor: pointer;">
                                                <td class="ps-4 text-center">
                                                    <input type="checkbox" name="selectedClass"
                                                           class="form-check-input student-checkbox" onclick="selectItem(@c.WardenId, this)"
                                                           value="@c.WardenId">

                                                </td>
                                                <td>@c.HostelName</td>
                                                <td>@c.WardenName</td>
                                                <td>@c.WardenContact</td>
                                                <td>@c.WardenEmail</td>
                                                <td>@c.Address</td>
                                                <td>@c.CountryName</td>
                                                <td>@c.StateName</td>
                                                <td>@c.PinCode</td>
                                                <td>@c.JoiningDate?.ToString("dd MMM yyyy")</td>
                                                <td>
                                            @if (p.CanEdit)
                                            {
                                                            <div class="form-check form-switch" onclick="event.stopPropagation()">
                                                                <input class="form-check-input class-status-switch" type="checkbox" @(c.IsActive ? "checked" : "") onchange="toggleStatus(@c.WardenId, this.checked)">
                                                            </div>
                                            }
                                            else
                                            {
                                                            <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">@(c.IsActive ? "Active" : "Inactive")</span>
                                            }
                                                </td>

                                            </tr>
                                }

                            }
                            else
                            {
                                    <tr>
                                        <td colspan="11" class="text-center py-4">
                                            <span class="text-muted">No records found.</span>
                                        </td>
                                    </tr>
                            }
                        </tbody>
                    </table>

                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalPages > 1)
                    {
                            <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                                <!-- Record info -->
                                <div class="text-muted small">
                                    Showing
                                    <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                    –
                                    <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                    of
                                    <strong>@Model.TotalRecords</strong> users
                                </div>

                                <nav aria-label="Subject pagination">
                                    <ul class="pagination pagination-sm mb-0">

                                        <!-- First -->
                                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevrons-left"></i>
                                            </a>
                                        </li>

                                        <!-- Prev -->
                                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevron-left"></i>
                                            </a>
                                        </li>

                                        <!-- Page numbers — show 5 around current -->
                                    @{
                                        int start = Math.Max(1, Model.PageNumber - 2);
                                        int end = Math.Min(totalPages, start + 4);
                                        start = Math.Max(1, end - 4);
                                    }
                                    @for (int pg = start; pg <= end; pg++)
                                    {
                                                <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                                    <a class="page-link"
                                                       href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">@pg</a>
                                                </li>
                                    }

                                        <!-- Next -->
                                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevron-right"></i>
                                            </a>
                                        </li>

                                        <!-- Last -->
                                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevrons-right"></i>
                                            </a>
                                        </li>

                                    </ul>
                                </nav>

                            </div>
                    }
                </div>
            </div>
            </div>
        </div>
    </div>