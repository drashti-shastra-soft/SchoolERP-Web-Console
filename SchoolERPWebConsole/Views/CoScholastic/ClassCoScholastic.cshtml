@using System.Text.Json
@model SchoolERPWebConsole.Domain.ClassCoScholasticPageViewModel
@{
    ViewData["Title"] = "Co-Scholastic Tree View";
    var p = Model.Permissions;
}

<style>
    .tree-row td {
        vertical-align: middle;
    }

    .tree-row .toggle-icon {
        color: #6c757d;
    }

    .tree-checkbox {
        cursor: pointer;
    }
</style>
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Co-Scholastic Tree View</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button class="btn btn-success top-btn" onclick="saveTree()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">           
            <div class="card-body">
                <div id="pageNotice"></div>

                <div class="row mb-3 align-items-center">
                    <label class="col-auto col-form-label fw-semibold">Class :</label>
                    <div class="col-auto" style="min-width:220px;">
                        <select class="form-select" id="ddlClass">
                            <option value="">-- Top Level (no parent) --</option>
                            @foreach (var grp in Model.Classes)
                            {
                                <option value="@grp.ClassID">
                                     @grp.ClassName
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr class="bg-light">
                                <th style="width:60px;"></th>
                                <th>Co-Scholastic Tree View</th>
                            </tr>
                        </thead>
                        <tbody id="treeBody">
                            <!-- rows injected by JS -->
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.initialTreeData = @Html.Raw(JsonSerializer.Serialize(Model.Tree));
    </script>
    <script src="~/assets/js/ClassCoScholastic.js"></script>
}
