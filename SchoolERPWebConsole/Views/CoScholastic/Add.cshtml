@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.CoScholasticAddViewModel
@{
    ViewData["Title"] = "Add Co-Scholastic";
    var p = Model.Permissions;
    var edit = Model.EditCoScholastic;
}

<style>
    .dt-buttons {
    display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
    border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
    display: block !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(edit == null ? "Add Co-Scholastic" : "Edit Co-Scholastic")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }

        <a href="/CoScholastic/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <div id="modalNotice"></div>
                <form id="itemForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(edit?.CoScholasticID ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(edit?.CreatedBy ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Co-Scholastic (Parent) <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlParentID">
                                <option value="">-- Top Level (no parent) --</option>
                                @if(Model.ParentGroups !=null)
                                {
                                    @foreach (var grp in Model.ParentGroups)
                                    {
                                        <option value="@grp.CoScholasticID" selected="@(edit?.ParentID == grp.CoScholasticID)">
                                            [@grp.CoScholasticID] @grp.Title
                                        </option>
                                    }
                                }
                                
                            </select>
                            <div class="invalid-feedback" id="errDdlParentID"></div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Sr No. <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" value="@edit?.SrNo" id="txtSrNo" placeholder="e.g. 1" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtSrNo"></div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" id="isGroup" style="cursor:pointer"
                                @(edit?.IsGroup == true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isGroup">Is Group (folder)</label>
                            </div>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="3" id="txtTitle" placeholder="e.g. PUNCTUALITY">@edit?.Title</textarea>
                            <div class="invalid-feedback" id="errTxtTitle"></div>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(edit?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/CoScholastic.js"></script>
}
