    <!-- ROW 1: Homework Submissions and Homework -->
    <div class="col-md-6 d-flex align-items-stretch">
        <div class="card mb-2 shadow-tbl-outer w-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Homework Submissions</h6>
                <span class="badge bg-primary fs-11" id="hw-submission-count">0</span>
            </div>
            <!-- Added max-height and overflow-y for scrolling -->
            <div class="card-body p-0" id="hw-submission-container" style="max-height: 400px; overflow-y: auto;">

                <!-- Skeleton loader -->
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <div class="flex-shrink-0">
                            <span class="avatar avatar-sm bg-light rounded-circle placeholder"></span>
                        </div>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                        <div>
                            <span class="placeholder col-12 rounded" style="width:60px"></span>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <div class="col-md-6 d-flex align-items-stretch">
        <div class="card mb-2 shadow-tbl-outer w-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Homework</h6>
                <span class="badge bg-primary fs-11" id="hw-count">0</span>
            </div>
            <!-- Added max-height and overflow-y for scrolling -->
            <div class="card-body p-0" id="hw-container" style="max-height: 400px; overflow-y: auto;">
                <!-- Skeleton -->
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <div class="flex-grow-1">
                            <span class="placeholder col-7 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                        <div>
                            <span class="placeholder rounded" style="width:60px;display:block"></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ROW 2: Teacher List and Visitor List -->
    <div class="col-md-6 d-flex align-items-stretch">
        <div class="card shadow-tbl-outer mb-2 w-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Teacher List</h6>
                <span class="badge bg-primary fs-11" id="staff-count">0</span>
            </div>
            <!-- Added max-height and overflow-y for scrolling -->
            <div class="card-body" id="staff-container" style="max-height: 400px; overflow-y: auto;">
                <!-- Skeleton -->
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex gap-2 mb-3 align-items-center">
                        <span class="placeholder rounded-circle" style="width:50px;height:50px;display:block;"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 d-flex align-items-stretch">
        <div class="card mb-2 shadow-tbl-outer w-100">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Visitor List</h6>
                <span class="badge bg-primary fs-11" id="visitor-count">0</span>
            </div>
            <!-- Added max-height and overflow-y for scrolling -->
            <div class="card-body p-0" id="visitor-container" style="max-height: 400px; overflow-y: auto;">
                <!-- Skeleton -->
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <div class="flex-shrink-0">
                            <span class="avatar avatar-sm bg-light rounded-circle placeholder" style="width:36px;height:36px;display:block;"></span>
                        </div>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                        <div>
                            <span class="placeholder rounded" style="width:55px;display:block;"></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

