                    <div class="row align-items-center mb-3">
                        <div class="col-md-3">
                            <span class="placeholder col-8 rounded"></span>
                        </div>
                        <div class="col-md-7">
                            <div class="progress rounded-pill placeholder-glow" style="height:10px">
                                <div class="progress-bar placeholder w-75"></div>
                            </div>
                        </div>
                        <div class="col-md-2 text-end">
                            <span class="placeholder col-6 rounded"></span>
                        </div>
                    </div>
                }

            </div>
        </div>
