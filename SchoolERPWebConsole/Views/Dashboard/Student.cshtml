        <a href="doctor-schedule.html" class="btn btn-outline-white bg-white d-inline-flex align-items-center"><i class="ti ti-calendar-time me-1"></i>Schedule Availability</a>
    </div> -->
</div>
<!-- End Page Header -->

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="@(string.IsNullOrEmpty(studentPhoto)
                                                             ? Url.Content("~/assets/img/users/user-01.jpg")
                                                             : Url.Content(@studentPhoto))"
                         width="32"
                         class="rounded-circle me-2"
                         alt="user-image">
                    <b class="text-dark">Welcome, @User.Identity.Name</b>
                </div>
                @* <span class="badge bg-teal rounded-pill p-2 px-3">Student</span> *@
                <span class="badge bg-teal rounded-pill p-2 px-3">@userTypeName</span>
            </div>
        </div>
    </div>
