@using SchoolERPWebConsole.Services
@using System.Security.Claims
@inject ILocalizationService Localizer;
@{
    ViewData["Title"] = "Admin Dashboard";
    var userPhoto    = User.FindFirst("StudentPhoto")?.Value;
    var userTypeName = User.FindFirst("UserTypeName")?.Value;
    var isSuperAdmin = userTypeName?.ToLower() == "superadmin";
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@userTypeName Dashboard</h6>
    </div>
</div>

<!-- Welcome Card -->
<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="@(string.IsNullOrEmpty(userPhoto)
                                    ? Url.Content("~/assets/img/users/user-01.jpg")
                                    : Url.Content(@userPhoto))"
                         width="32" class="rounded-circle me-2" alt="user-image">
                    <b class="text-dark">Welcome, @User.Identity.Name</b>
                </div>
                <span class="badge bg-teal rounded-pill p-2 px-3">@userTypeName</span>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="col-md-3">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="avatar avatar-lg bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                    <i class="ti ti-users fs-4"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 fs-12">Total Students</p>
                    <h5 class="fw-bold mb-0" id="total-students">--</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="avatar avatar-lg bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                    <i class="ti ti-user-check fs-4"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 fs-12">Present Today</p>
                    <h5 class="fw-bold mb-0" id="present-today">--</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="avatar avatar-lg bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                    <i class="ti ti-chalkboard fs-4"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 fs-12">Total Staff</p>
                    <h5 class="fw-bold mb-0" id="total-staff">--</h5>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="avatar avatar-lg bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width:50px;height:50px;">
                    <i class="ti ti-door-enter fs-4"></i>
                </div>
                <div>
                    <p class="text-muted mb-0 fs-12">Today Visitors</p>
                    <h5 class="fw-bold mb-0" id="total-visitors">--</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- SuperAdmin only: Company list -->
    @if (isSuperAdmin)
    {
        <div class="col-md-12">
            <div class="card shadow-tbl-outer mb-2">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h6 class="card-title mb-0">All Companies</h6>
                    <span class="badge bg-primary fs-11" id="company-count">0</span>
                </div>
                <div class="card-body p-0" id="company-container">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                            <div class="flex-grow-1">
                                <span class="placeholder col-5 d-block mb-1 rounded"></span>
                                <span class="placeholder col-3 rounded"></span>
                            </div>
                            <span class="placeholder rounded" style="width:60px;display:block;"></span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Staff List — visible to both Admin and SuperAdmin -->
    <div class="col-md-6">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Staff List</h6>
                <span class="badge bg-primary fs-11" id="admin-staff-count">0</span>
            </div>
            <div class="card-body" id="admin-staff-container" style="height:300px;overflow-y:auto;">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex gap-2 mb-3 align-items-center">
                        <span class="placeholder rounded-circle" style="width:45px;height:45px;display:block;"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Visitor List — visible to both Admin and SuperAdmin -->
    <div class="col-md-6">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Visitor List</h6>
                <span class="badge bg-primary fs-11" id="admin-visitor-count">0</span>
            </div>
            <div class="card-body p-0" id="admin-visitor-container" style="height:300px;overflow-y:auto;">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <span class="placeholder rounded-circle" style="width:36px;height:36px;display:block;"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                        <span class="placeholder rounded" style="width:55px;display:block;"></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Homework Submissions -->
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0">Recent Homework Submissions</h6>
                <span class="badge bg-primary fs-11" id="admin-hw-count">0</span>
            </div>
            <div class="card-body p-0" id="admin-hw-container">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <span class="placeholder rounded-circle" style="width:36px;height:36px;display:block;"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-6 d-block mb-1 rounded"></span>
                            <span class="placeholder col-4 rounded"></span>
                        </div>
                        <span class="placeholder rounded" style="width:60px;display:block;"></span>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<script src="@Url.Content("~/assets/js/jquery-3.7.1.min.js")"></script>
<script src="@Url.Content("~/assets/js/adminDashboard.js")"></script>