@*
    ======================================================================
    VIEW: BackDateSetting / Add.cshtml
    PURPOSE: Add / Edit a staff's back-date attendance setting.
    - Add mode: pick a staff member, set Back Days Allowed or mark Unlimited.
    - Edit mode: staff is bound and locked (cannot reassign), only the
      allowed-days / unlimited values can change.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.BackDateSettingAddViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    var isEdit = Model.EditBackDateSetting != null;
    ViewData["Title"] = isEdit ? "Edit Back Date Setting" : "Add Back Date Setting";
    var p = Model.Permissions;
}

<style>
    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }
</style>


<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit" : "Add") Back Date Setting</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveBackDateSetting()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/BackDateSetting/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>



<div id="pageNotice"></div>

<div class="card shadow-tbl-outer">
    <div class="card-body p-3">
        <form id="frmBackDateSetting" onsubmit="return false;">
            <input type="hidden" id="txtSettingId" value="@(isEdit ? Model.EditBackDateSetting.SettingID : 0)" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    
                    <label class="form-label">Staff <span class="text-danger">*</span></label>

                    <input type="hidden" id="hdnUserID" value="@Model.EditBackDateSetting.UserID" />
                    <input type="hidden" id="hdnStaffId" value="@Model.EditBackDateSetting.StaffID" />
                    <select class="form-select form-control select2" onchange="loadRoleByStaff(this.value,'ddlRole')" id="ddlStaff" data-placeholder="Select staff">
                        <option value="">Select staff</option>
                        @foreach (var s in Model.StaffList ?? new())
                        {
                            <option value="@s.StaffID" selected="@(@s.StaffID == Model.EditBackDateSetting?.StaffID)">@s.FirstName</option>
                        }
                    </select>
                    <div class="invalid-feedback" id="errDdlStaff"></div>
                </div>
                <div class="col-md-4 mb-3 d-none">
                    <label class="form-label mb-1">Role</label>
                    <select id="ddlRole" class="form-select select2">
                        <option value="">All Role</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3 d-none">
                    <label class="form-label">Back Days Allowed <span class="text-danger">*</span></label>
                    <input type="number" min="0" class="form-control" id="txtBackDaysAllowed"
                           value="@(isEdit ? Model.EditBackDateSetting.BackDaysAllowed : 0)"
                    @(isEdit && Model.EditBackDateSetting.IsUnlimited ? "disabled" : "") />
                    <div class="invalid-feedback" id="errTxtBackDaysAllowed"></div>
                </div>

                <div class="col-md-3 mb-3 d-flex align-items-center d-none">
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="chkIsUnlimited"
                        @(isEdit && Model.EditBackDateSetting.IsUnlimited ? "checked" : "") />
                        <label class="form-check-label" for="chkIsUnlimited">Unlimited</label>
                    </div>
                </div>
            </div>
        </form>

        <table class="table" id="roleRowsTable">
            <thead>
                <tr><th>Role</th><th>Back Days Allowed</th><th>Unlimited</th></tr>
            </thead>
            <tbody id="roleRowsBody"></tbody>
        </table>
        @* <button type="button" class="btn btn-sm btn-outline-primary" onclick="addRoleRow()">
            <i class="ti ti-plus"></i> Add Role
        </button> *@
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd     = @JsonSerializer.Serialize(Model.Permissions.CanAdd);
        window.canEdit    = @JsonSerializer.Serialize(Model.Permissions.CanEdit);
        window.isEditMode = @JsonSerializer.Serialize(isEdit);
        // ✅ was commented out — this is what renderRoleRowsForStaff() merges
        // against to pre-fill BackDaysAllowed / IsUnlimited for existing rows.
        // CamelCase policy so keys match what the JS reads (s.roleID, not s.RoleID).
        window.existingRoleSettings = @Html.Raw(
        JsonSerializer.Serialize(
            Model.ExistingRoleSettings,
            new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }
        )
    );
        window.allRoles  = [];
    </script>
    <script src="~/assets/js/BackDateSetting.js"></script>
}
