    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model SchoolERPWebConsole.Domain.BackDateSettingPageViewModel
@{
    int totalPages = Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
        : 0;
}

<div class="row">
    <!-- Data table -->
    <div class="col-xl-12">
        <div class="card shadow-tbl border-0 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table" id="backDateSettingsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width:36px;"><input type="checkbox" id="chkSelectAll" /></th>
                                <th>#</th>
                                <th>User Name</th>
                                <th>Staff Code</th>
                                <th>Email</th>
                                <th>Mobile No</th>
                                <th>Back Days Allowed</th>
                                <th>Unlimited</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.StaffAttendanceSettings != null && Model.StaffAttendanceSettings.Any())
                            {
                                int i = (Model.PageNumber - 1) * Model.PageSize + 1;
                                foreach (var item in Model.StaffAttendanceSettings)
                                {
                                    <tr class="item-row" onclick="selectItem(@item.SettingID,@item.StaffID,@item.UserID, this)">
                                        <td class="ps-4 text-center">
                                            <input type="checkbox" class="student-checkbox" value="@item.SettingID" />
                                        </td>
                                        <td>@i</td>
                                        <td>@item.StaffName</td>
                                        <td>@item.StaffCode</td>
                                        <td>@item.Email</td>
                                        <td>@item.MobileNo</td>
                                        <td>
                                            @foreach (var r in item.RoleSettings)
                                            {
                                                <span class="badge bg-light text-dark me-1">
                                                    @r.RoleName: @(r.IsUnlimited ? "Unlimited" : r.BackDaysAllowed + " days")
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsUnlimited)
                                            {
                                                <span class="badge bg-info-subtle text-info">Unlimited</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-dark">Limited</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                        <!-- Record info -->
                        <div class="text-muted small">
                            Showing
                            <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                            –
                            <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                            of
                            <strong>@Model.TotalRecords</strong> users
                        </div>

                        <nav aria-label="Subject pagination">
                            <ul class="pagination pagination-sm mb-0">

                                <!-- First -->
                                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevrons-left"></i>
                                    </a>
                                </li>

                                <!-- Prev -->
                                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Page numbers — show 5 around current -->
                                @{
                                    int start = Math.Max(1, Model.PageNumber - 2);
                                    int end = Math.Min(totalPages, start + 4);
                                    start = Math.Max(1, end - 4);
                                }
                                @for (int pg = start; pg <= end; pg++)
                                {
                                    <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">@pg</a>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevron-right"></i>
                                    </a>
                                </li>

                                <!-- Last -->
                                <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                        <i class="ti ti-chevrons-right"></i>
                                    </a>
                                </li>

                            </ul>
                        </nav>

                    </div>
                }

            </div>
        </div>
    </div>
</div>
