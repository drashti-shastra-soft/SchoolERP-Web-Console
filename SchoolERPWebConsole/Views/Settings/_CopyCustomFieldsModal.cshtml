@*
    ======================================================================
    PARTIAL: Shared / _CopyPurposeModal.cshtml
    PURPOSE: "Copy Purpose to another Session/Company" modal.
             Company + Session scoped. No row selection — the table is a
             preview only; Copy always copies every row shown for the
             chosen source company/session. This is a separate modal +
             separate JS/model from _CopySessionModal.cshtml — do not
             merge them.

             Paired 1:1 with wwwroot/js/copyPurposeModal.js.

             Do NOT rename these element IDs without also updating
             copyPurposeModal.js — they are wired together by ID/onclick,
             not by any shared config object:
               fromAccountBudget, fromSessionBudget,
               toAccountBudget, toSessionBudget,
               validationBoxBudget, tableSectionBudget,
               tblBudgetCopy, budgetTbody, btnCopyBudget
    ======================================================================
*@
<style>
    span.select2 {
        margin-bottom: .5rem !important;
    }
</style>
<!-- start copy Purpose modal -->
<div class="modal fade" id="copyPurposeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-xl">

            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="ti ti-copy"></i> Copy Purpose to Session
                </h5>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnCopyBudget" onclick="handleCopyBudget()" disabled>
                        <i class="ti ti-copy me-1"></i>Copy
                    </button>
                </div>
            </div>

            <div class="modal-body p-4">

                <!-- ── Dropdowns Row ── -->
                <div class="row align-items-start g-3">

                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Source (From)</p>
                        <!-- NOTE: intentionally NOT disabled — copyPurposeModal.js
                             pre-selects the user's current company/session here but
                             the user must still be able to change either one. -->
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromAccountBudget" disabled onchange="validateCopyBudget()">
                            <option value="">From company</option>
                        </select>
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromSessionBudget" disabled onchange="validateCopyBudget()">
                            <option value="">Loading...</option>
                        </select>
                    </div>

                    <div class="col-2 d-flex justify-content-center" style="padding-top:42px">
                        <div class="d-flex align-items-center text-primary">
                            <i class="ti ti-arrow-left fs-18"></i>
                            <div style="width:20px;height:2px;background:currentColor"></div>
                            <i class="ti ti-arrow-right fs-18"></i>
                        </div>
                    </div>

                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Destination (To)</p>
                        <!-- "To" has no default — user must actively choose it.
                             Changing either select here re-runs validateCopyBudget(),
                             which is what flips the Copy button on/off. -->
                        <select class="form-select form-select-sm mb-2 mt-2" id="toAccountBudget" style="cursor: pointer;" onchange="validateCopyBudget()">
                            <option value="">To company</option>
                        </select>
                        <select class="form-select form-select-sm mb-2 mt-2" id="toSessionBudget" style="cursor: pointer;" onchange="validateCopyBudget()">
                            <option value="">Loading...</option>
                        </select>
                    </div>
                </div>

                <!-- Validation Message (shown when From == To on BOTH company and session) -->
                <div id="validationBoxBudget" class="d-none border-top mt-4 pt-3 text-center">
                    <i class="ti ti-alert-triangle text-danger" style="font-size:40px"></i>
                    <p class="text-danger fw-semibold mt-1 mb-0">Cannot Copy to the Same Company &amp; Session</p>
                </div>

                <!-- ── Purpose Table (preview only — no selection column) ── -->
                <div id="tableSectionBudget" class="d-none border-top mt-3 pt-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small">
                            <i class="ti ti-list me-1"></i>Purpose to copy
                        </span>
                    </div>

                    <!-- Scrollable table container -->
                    <div class="border rounded" style="max-height:220px;overflow-y:auto">
                        <table class="table table-sm table-hover mb-0" id="tblBudgetCopy">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <!-- header cells (#, Purpose Name, ...) are built dynamically by copyPurposeModal.js -->
                                </tr>
                            </thead>
                            <tbody id="budgetTbody">
                            </tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-1 mb-0">
                        <i class="ti ti-info-circle me-1"></i>
                        All records shown above will be copied to the destination session/company.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- end copy Purpose modal -->
