@*
    ======================================================================
    VIEW: Academics / Class.cshtml
    PURPOSE: User interface for managing Classes and their Section mappings.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.MstCompanyPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
    var p = Model.Permissions;
}
<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body">
            <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table" id="companyTable">
                        <thead class="bg-light">
                            <tr class="bg-light item-row">
                                <th style="width: 50px;">#</th>
                                <th>Company Name</th>
                                <th>Code</th>
                                <th>Parent</th>
                                <th>Email/Phone</th>
                                @* <th>Session</th> *@
                                <th>Currency</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Companies)
                            {
                                <tr class="item-row level-@item.Level"
                                    data-id="@item.CompanyId"
                                    data-parent="@(item.ParentCompanyId ?? 0)"
                                    onclick="selectItem(@item.CompanyId, this)"
                                    style="cursor: pointer;">
                                    <td class="">
                                        <input type="checkbox" name="selectedCompany"
                                               class="form-check-input student-checkbox"
                                               value="@item.CompanyId">

                                    </td>
                                    <td class="school-name-cell">
                                        <div class="d-flex align-items-center" style="margin-left: @(item.Level * 2.5)rem;">
                                            @if (item.HasChildren)
                                            {
                                                <div class="tree-toggle" onclick="toggleHierarchy(@item.CompanyId, event)">
                                                    <i class="ti ti-minus"></i>
                                                </div>
                                            }
                                            else if (item.Level > 0)
                                            {
                                                <div style="width: 30px;"></div>
                                            }

                                            @* <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px;">
                                            <i class="ti ti-building fs-5"></i>
                                        </div> *@
                                            <div>
                                                <span class="text-dark d-block">@item.SchoolName</span>
                                                <small class="text-muted">ID: @item.CompanyId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-soft-primary px-2 py-1">@item.SchoolCode</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ParentName))
                                        {
                                            <span class="text-muted small"><i class="ti ti-arrow-forward-up me-1"></i>@item.ParentName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div class="text-muted mb-1"><i class="ti ti-mail me-1"></i>@item.Email</div>
                                            <div class="text-muted"><i class="ti ti-phone me-1"></i>@item.Phone</div>
                                        </div>
                                    </td>
                                    @* <td><span class="text-dark small fw-medium">@item.SessionTitle</span></td> *@
                                    <td><span class="badge bg-light text-dark border">@item.CurrencyCode</span></td>
                                    <td class="text-center">
                                        @if (p.CanEdit)
                                        {
                                            <div class="form-check form-switch d-flex justify-content-center" onclick="event.stopPropagation()">
                                                <input class="form-check-input" type="checkbox" checked="@item.IsActive" onchange="toggleStatus(@item.CompanyId, this.checked, this)">
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Active" : "Inactive")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                            <!-- Record info -->
                            <div class="text-muted small">
                                Showing
                                <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                –
                                <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                of
                                <strong>@Model.TotalRecords</strong> users
                            </div>

                            <nav aria-label="Subject pagination">
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- First -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevrons-left"></i>
                                        </a>
                                    </li>

                                    <!-- Prev -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Page numbers — show 5 around current -->
                                    @{
                                        int start = Math.Max(1, Model.PageNumber - 2);
                                        int end = Math.Min(totalPages, start + 4);
                                        start = Math.Max(1, end - 4);
                                    }
                                    @for (int pg = start; pg <= end; pg++)
                                    {
                                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm">@pg</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Last -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevrons-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>