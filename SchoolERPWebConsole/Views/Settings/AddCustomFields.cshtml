@model SchoolERPWebConsole.Domain.FieldAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Custom Fields";
    var p = Model.Permissions;

}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditField == null ? "Add Custom Fields" : "Edit Custom Fields")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveField()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Settings/CustomFields" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>


    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                <form id="fieldForm">
                    <input type="hidden" id="FieldId" value="@Model.EditField?.FieldId" />
                    <input type="hidden" id="IsSystemField" value="false" />
                    <input type="hidden" id="CompanyID" value="@Model.EditField?.CompanyID" />
                    <input type="hidden" id="SessionID" value="@Model.EditField?.SessionID" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Field Belongs To <small class="text-danger">*</small></label>
                            <select id="BelongsTo" class="form-select" required>
                                <option value="">Select</option>
                                <option value="students" selected="@(Model.EditField?.BelongsTo == "students")">Student</option>
                                <option value="staff" selected="@(Model.EditField?.BelongsTo == "staff")">Staff</option>
                            </select>
                            <div class="invalid-feedback" id="errBelongsTo"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Field Type <small class="text-danger">*</small></label>
                            <select id="FieldType" class="form-select" required onchange="handleTypeChange()">
                                <option value="">Select</option>
                                <option value="input" selected="@(Model.EditField?.FieldType == "input")">Input</option>
                                <option value="number" selected="@(Model.EditField?.FieldType == "number")">Number</option>
                                <option value="textarea" selected="@(Model.EditField?.FieldType == "textarea")">Textarea</option>
                                <option value="select" selected="@(Model.EditField?.FieldType == "select")">Dropdown</option>
                                <option value="multiselect" selected="@(Model.EditField?.FieldType == "multiselect")">Multi Select</option>
                                <option value="checkbox" selected="@(Model.EditField?.FieldType == "checkbox")">Checkbox</option>
                                <option value="date_picker" selected="@(Model.EditField?.FieldType == "date_picker")">Date Picker</option>
                                <option value="date_picker_time" selected="@(Model.EditField?.FieldType == "date_picker_time")">Datetime Picker</option>
                                <option value="colorpicker" selected="@(Model.EditField?.FieldType == "colorpicker")">Color Picker</option>
                                <option value="link" selected="@(Model.EditField?.FieldType == "link")">Hyperlink</option>
                            </select>
                            <div class="invalid-feedback" id="errFieldType"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Field Name <small class="text-danger">*</small></label>
                            <input type="text" id="FieldName" class="form-control" placeholder="Enter label name" required value="@Model.EditField?.FieldName" />
                            <div class="invalid-feedback" id="errFieldName"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Grid (Bootstrap Column eg. 6) - Max is 12</label>
                            <div class="input-group">
                                <span class="input-group-text">col-md-</span>
                                <input type="number" id="GridColumn" class="form-control" value="@(Model.EditField?.GridColumn ?? 12)" min="1" max="12" />
                                <div class="invalid-feedback" id="errGridColumn"></div>
                            </div>
                        </div>
                        <div class="col-6 @(Model.EditField != null && (Model.EditField.FieldType == "select" || Model.EditField.FieldType == "multiselect") ? "" : "d-none")" id="divValues">
                            <label class="form-label fw-semibold">Field Values (Separate By Comma)</label>
                            <textarea id="FieldValues" class="form-control" rows="3" placeholder="Option1, Option2, Option3">@Model.EditField?.FieldValues</textarea>
                            <div class="invalid-feedback" id="errFieldValues"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Display Order</label>
                            <input type="number" id="DisplayOrder" class="form-control" value="@(Model.EditField?.DisplayOrder ?? 0)" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Validation</label>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="IsRequired" @(Model.EditField?.IsRequired == true ? "checked" : "")>
                                <label class="form-check-label" for="IsRequired">Required</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Visibility</label>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="OnTable" @(Model.EditField?.OnTable == true ? "checked" : "")>
                                <label class="form-check-label" for="OnTable">On Table</label>
                            </div>
                        </div>
                        
                       @*  <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="IsActive" @(Model.EditField?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="IsActive">Is Active?</label>
                            </div>
                        </div> *@
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="IsActive"
                                       checked="(@Model.EditField == null || @Model.EditField?.IsActive)">
                                <label class="form-check-label" for="IsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </div>
<div id="fieldModalNotice"></div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/CustomFields.js"></script>
}
