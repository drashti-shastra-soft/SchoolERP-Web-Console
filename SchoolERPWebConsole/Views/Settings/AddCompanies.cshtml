                                        <option value="d/m/Y" selected="@(dateFormat == "d/m/Y")">dd/mm/yyyy</option>
                                        <option value="d.m.Y" selected="@(dateFormat == "d.m.Y")">dd.mm.yyyy</option>
                                        <option value="m-d-Y" selected="@(dateFormat == "m-d-Y")">mm-dd-yyyy</option>
