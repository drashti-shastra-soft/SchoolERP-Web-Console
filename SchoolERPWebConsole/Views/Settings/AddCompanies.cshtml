                                                <label class="form-check-label" for="chkAllowSession">Allow Session</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-check-label">Status</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" id="chkIsActive" checked="@(e?.IsActive ?? true)">
                                        <label class="form-check-label" for="chkIsActive">Active</label>
                                    </div>
                                </div>

                            </div>
                        </form>
