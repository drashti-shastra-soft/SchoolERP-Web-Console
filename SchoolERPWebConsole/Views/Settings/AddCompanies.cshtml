                                                             style="max-height:100%; max-width:100%; @(string.IsNullOrEmpty(e?.AdminSmallLogo) ? "display:none;" : "")" />
                                                    </div>
                                                    <div id="errAdminSmallLogo" class="text-danger small"></div>
                                                    @if (canEdit)
                                                    {
                                                        <div class='file mt-2'>
                                                            <label for='txtAdminSmallLogo'><i class="ti ti-cloud-upload"></i> Update</label>
                                                            <input id='txtAdminSmallLogo' type='file' class="d-none" accept="image/*" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-xl-3">
                                                <div class="card p-3">
                                                    <h6>Water Mark <span class="text-primary small">(290 <i class="ti ti-x"></i> 51)</span></h6>
