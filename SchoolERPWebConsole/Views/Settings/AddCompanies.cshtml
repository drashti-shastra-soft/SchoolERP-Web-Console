                                                            <input id='txtAdminLogo' type='file' class="d-none" accept="image/*" />
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-xl-3">
                                                <div class="card p-3">
                                                    <h6>Admin Small Logo <span class="text-primary small">(32 <i class="ti ti-x"></i> 32)</span></h6>
                                                    <div class="bg-light img-size mb-2" style="height: 100px;">
