@model SchoolERPWebConsole.Domain.CompaniesAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Companies";
    var p = Model.Permissions;

}

@inject PermissionHelper PermHelper
@{
    Layout = "_Layout";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    if (currentUserId > 0) PermHelper.LoadPermissions(currentUserId).GetAwaiter().GetResult();

    var canEdit = PermHelper.HasPermissionByUrl("/Settings", "Edit");
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditCompanies == null ? "Add Companies" : "Edit Companies")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" onclick="saveCompany()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Settings/Companies" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>

</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                @{
                    var e = Model.EditCompanies; // null when adding a new company
                }
                <!-- Nav pills -->
                <ul class="nav nav-pills custom-pill-tabs mb-3" id="companySettingsTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="company-tab" data-bs-toggle="tab"
                                data-bs-target="#company-tab-pane" type="button" role="tab"
                                aria-controls="company-tab-pane" aria-selected="true">
                            Company Details
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="logo-tab" data-bs-toggle="tab"
                                data-bs-target="#logo-tab-pane" type="button" role="tab"
                                aria-controls="logo-tab-pane" aria-selected="false">
                            Logo
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="loginbg-tab" data-bs-toggle="tab"
                                data-bs-target="#loginbg-tab-pane" type="button" role="tab"
                                aria-controls="loginbg-tab-pane" aria-selected="false">
                            Login Page Background
                        </button>
                    </li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content pt-3" id="companySettingsTabContent">

                    <!-- ============ Company Details (Add/Edit form) ============ -->
                    <div class="tab-pane fade show active" id="company-tab-pane" role="tabpanel"
                         aria-labelledby="company-tab" tabindex="0">
                        <form id="companyForm">
                            <input type="hidden" id="txtCompanyId" value="@(e?.CompanyId ?? 0)" />

                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">School Name <span class="text-danger">*</span></label>
                                    <input type="text" id="txtSchoolName" class="form-control" value="@e?.SchoolName" placeholder="" required>
                                    <div class="invalid-feedback" id="errSchoolName"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">School Code <span class="text-danger">*</span></label>
                                    <input type="text" id="txtSchoolCode" class="form-control" value="@e?.SchoolCode" placeholder="" required>
                                    <div class="invalid-feedback" id="errSchoolCode"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Parent Company</label>
                                    <select id="ddlParentCompany" class="form-select form-control select2">
                                        <option value="">Select Parent</option>
                                        @foreach (var p in Model.ParentCompanies)
                                        {
                                            <option value="@p.CompanyId" selected="@(e != null && e.ParentCompanyId == p.CompanyId)">
                                                @p.SchoolName
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Head Office address</label>
                                    <textarea id="txtHeadOfficeAddress" class="form-control" rows="2" placeholder="">@e?.HeadOfficeAddress</textarea>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">Register Office address</label>
                                    <textarea id="txtAddress" class="form-control" rows="2" placeholder="">@e?.Address</textarea>
                                </div>

                                <div class="col-md-3 position-relative">
                                    <label class="form-label fw-bold">Pin Code</label>
                                    <input type="text" value="@e?.PostalCode" class="form-control" id="txtPinCode" autocomplete="off" />
                                    <ul id="pinCodeSuggestions" class="pincode-dropdown list-group"></ul>
                                </div>

                                <div class="d-block col-md-3 mb-3">
                                    <label class="form-label fw-bold">Country Name</label>
                                    <select class="form-select select2" id="ddlCountry" style="width: 100%;">
                                        <option value="">-- Select --</option>
                                        @if (Model.Country != null)
                                        {
                                            @foreach (var rt in Model.Country)
                                            {
                                                <option value="@rt.CountryId" selected="@(e?.CountryId == rt.CountryId)">@rt.CountryName</option>
                                            }
                                        }

                                    </select>
                                </div>

                                <div class="d-block col-md-3 mb-3">
                                    <input type="hidden" id="hdnSelectedStateId" value="@e?.StateId" />
                                    <input type="hidden" id="hdnSelectedCityId" value="@e?.CityId" />
                                    <label class="form-label fw-bold">State Name</label>
                                    <select class="form-select select2" id="ddlState" style="width: 100%;">
                                        <option value="">-- Select Country First --</option>
                                    </select>
                                </div>

                                <div class="d-block col-md-3 mb-3">
                                    <label class="form-label fw-bold">City Name</label>
                                    <select class="form-select select2" id="ddlCity" style="width: 100%;">
                                        <option value="">-- Select Country First --</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Phone <span class="text-danger">*</span></label>
                                    <input type="text" id="txtPhone" class="form-control" value="@e?.Phone" placeholder="" required>
                                    <div class="invalid-feedback" id="errPhone"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Email <span class="text-danger">*</span></label>
                                    <input type="email" id="txtEmail" class="form-control" value="@e?.Email" placeholder="" required>
                                    <div class="invalid-feedback" id="errEmail"></div>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Default Currency <span class="text-danger">*</span></label>
                                    <select id="ddlCurrency" class="form-select form-control select2" required>
                                        <option value="">Select</option>
                                        @foreach (var c in Model.Currencies)
                                        {
                                            <option value="@c.CurrencyId" selected="@(e != null && e.CurrencyId == c.CurrencyId)">
                                                @c.CurrencyTitle
                                            </option>
                                        }
                                    </select>
                                    <div class="invalid-feedback" id="errCurrency"></div>
                                </div>

                                <!--Start-->
                                <div class="col-md-3">
                                    <label class="form-label">Admission No</label>
                                    <input type="text" id="txtAdmissionNo" class="form-control" value="@e?.AdmissionNo" placeholder="">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Board Name</label>
                                    <input type="text" id="txtBoardName" class="form-control" value="@e?.BoardName" placeholder="">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">School Status</label>
                                    <select id="ddlSchoolStatus" class="form-select form-control select2">
                                        <option value="">Select</option>
                                        <option value="Active" selected="@(e?.SchoolStatus == "Active")">Active</option>
                                        <option value="Inactive" selected="@(e?.SchoolStatus == "Inactive")">Inactive</option>
                                        <option value="Suspended" selected="@(e?.SchoolStatus == "Suspended")">Suspended</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Late Fine Per Day</label>
                                    <input type="number" step="0.01" min="0" id="txtLateFinePerDay" class="form-control" value="@e?.LateFinePerDay" placeholder="0.00">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Library Fine Per Day</label>
                                    <input type="number" step="0.01" min="0" id="txtLibraryFinePerDay" class="form-control" value="@e?.LibraryFinePerDay" placeholder="0.00">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Late Fine Max Per Book</label>
                                    <input type="number" step="0.01" min="0" id="txtLateFineMaxPerBook" class="form-control" value="@e?.LateFineMaxPerBook" placeholder="0.00">
                                </div>
                                <!--End-->
                                <div class="col-md-3">
                                    <label class="form-label">Currency Format</label>
                                    <select id="ddlCurrencyFormat" class="form-select form-control select2">
