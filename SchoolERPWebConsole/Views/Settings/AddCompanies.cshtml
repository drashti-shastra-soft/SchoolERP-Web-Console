                                        <option value="####.##" selected="@(e?.CurrencyFormat == "####.##")">12345678.00</option>
                                        <option value="#,###.##" selected="@(e?.CurrencyFormat == "#,###.##")">12,345,678.00</option>
                                        <option value="#,##,###.##" selected="@(e?.CurrencyFormat == "#,##,###.##")">1,23,45,678.00</option>
                                        <option value="#.###.##" selected="@(e?.CurrencyFormat == "#.###.##")">12.345.678.00</option>
                                        <option value="#.###,##" selected="@(e?.CurrencyFormat == "#.###,##")">12.345.678,00</option>
                                        <option value="# ###.##" selected="@(e?.CurrencyFormat == "# ###.##")">12 345 678.00 (Not For RTL)</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Session Start Month</label>
