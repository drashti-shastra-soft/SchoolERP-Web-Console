@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.ClassSubSubjectAddViewModel
@{
    ViewData["Title"] = "Add Class Sub Subject";
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditClassSubSubject == null ? "Add Class Sub Subject" : "Edit Class Sub Subject")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/ClassSubSubject/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">

            <div class="card-body">
                <form id="itemForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditClassSubSubject?.ClassSubSubjectID ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(Model.EditClassSubSubject?.CreatedBy ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditClassSubSubject?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditClassSubSubject?.SessionID ?? 0)">
                    @* <input type="hidden" id="txtItemId" value="0"> *@
                    <div class="row">

                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Class <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlClass" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.Classes != null)
                                {
                                    @foreach (var rt in Model.Classes)
                                    {
                                        <option value="@rt.ClassID" selected="@(Model.EditClassSubSubject?.ClassID == rt.ClassID)">@rt.ClassName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errDdlClass">
                                Class is required.
                            </div>
                        </div>
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Subjects <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlSubjects" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.Subjects != null)
                                {
                                    @foreach (var rt in Model.Subjects)
                                    {
                                        <option value="@rt.SubjectID" selected="@(Model.EditClassSubSubject?.SubjectID == rt.SubjectID)">@rt.SubjectName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errddlSubjects">
                                Subjects is required.
                            </div>
                        </div>
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Sub Subject <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlSubSubjects" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.SubSubjects != null)
                                {
                                    @foreach (var rt in Model.SubSubjects)
                                    {
                                        <option value="@rt.Id" selected="@(Model.EditClassSubSubject?.SubSubjectID == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback" id="errddlSubSubjects">
                                Sub subject is required.
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Sequence <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" value="@Model.EditClassSubSubject?.Sequence" id="txtSequence" placeholder="e.g. 1" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtSequence"></div>
                        </div>

                        <div class="col-md-6 mt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(Model.EditClassSubSubject?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/ClassSubSubject.js"></script>
}