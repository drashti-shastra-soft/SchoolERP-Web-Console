@model SchoolERPWebConsole.Domain.FeeTypeAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Fee Type";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditFeeType == null ? "Add Fee Type" : "Edit Fee Type")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/FeeType/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="callLogForm" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditFeeType?.FeeTypeId">
                    <input type="hidden" id="hdnCompanyID" value="@Model.EditFeeType?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.EditFeeType?.SessionID">

                    <div class="row row-gap-3">

                        <!-- Fee Type Name -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="txtName">Fee Type Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtName" maxlength="200"
                                   value="@Model.EditFeeType?.FeeTypeName" placeholder="Enter fee type name">
                            <div class="text-danger small mt-1 d-none" id="nameError"></div>
                        </div>

                        <!-- Fee Type Code -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="txtCode">Fee Type Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtCode" maxlength="20"
                                   value="@Model.EditFeeType?.FeeTypeCode" placeholder="Enter code">
                            <div class="text-danger small mt-1 d-none" id="codeError"></div>
                        </div>

                        <!-- Fee Head -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="ddlFeeHead">Fee Head</label>
                            <select class="form-select select2" id="ddlFeeHead" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.FeeHead != null)
                                {
                                    @foreach (var rt in Model.FeeHead)
                                    {
                                        <option value="@rt.Id" selected="@(Model.EditFeeType?.FeeHeadId == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="ErrorddlFeeHead"></div>
                        </div>

                        <!-- Display Name / Label -->
                        <div class="col-md-4">
                            <label class="form-label fw-bold" for="txtDisplayName">Display Name</label>
                            <input type="text" class="form-control" id="txtDisplayName" maxlength="200"
                                   value="@Model.EditFeeType?.DisplayLabel" placeholder="Enter display name">
                            <div class="text-danger small mt-1 d-none" id="displayNameError"></div>
                        </div>

                        <!-- Is Refund -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold d-block">Is Refund</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsRefund"
                                       checked="@(Model.EditFeeType?.IsRefund == true)">
                                <label class="form-check-label" for="chkIsRefund">Yes</label>
                            </div>
                        </div>

                        <!-- Is Discount -->
                        <div class="col-md-2">
                            <label class="form-label fw-bold d-block">Is Discount</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsDiscount"
                                       checked="@(Model.EditFeeType?.IsDiscount == true)">
                                <label class="form-check-label" for="chkIsDiscount">Yes</label>
                            </div>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                       checked="@(Model.EditFeeType?.IsActive ?? true)">
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/FeeType.js"></script>
}
