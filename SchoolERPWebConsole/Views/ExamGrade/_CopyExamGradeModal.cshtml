@*
    ======================================================================
    PARTIAL: Shared/_CopyExamGradeModal.cshtml
    PURPOSE: "Copy Exam Grade" modal. Scoped by SubjectType + Class,
             NOT Company/Session — Company/Session are taken from the
             current logged-in context and sent as-is with every request.
             No row selection — the table is a preview only; Copy always
             copies every row currently shown for the source combo.

             Paired 1:1 with wwwroot/js/copyExamGradeModal.js.

             Do NOT rename these element IDs without also updating
             copyExamGradeModal.js:
               fromSubjectTypeGrade, fromClassGrade,
               toSubjectTypeGrade, toClassGrade,
               validationBoxGrade, tableSectionGrade,
               tblGradeCopy, gradeTbody, btnCopyGrade
    ======================================================================
*@
<div class="modal fade" id="copyExamGradeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow-xl">

            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="ti ti-copy"></i> Copy Exam Grade Configuration
                </h5>
                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnCopyGrade" onclick="handleCopyExamGrade()" disabled>
                        <i class="ti ti-copy me-1"></i>Copy
                    </button>
                </div>
            </div>

            <div class="modal-body p-4">

                <div class="row align-items-start g-3">

                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Source (From)</p>
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromSubjectTypeGrade" onchange="onFromComboChangeGrade()">
                            <option value="">From Subject Type</option>
                        </select>
                        <select class="form-select form-select-sm mb-2 mt-2" id="fromClassGrade" onchange="onFromComboChangeGrade()">
                            <option value="">From Class</option>
                        </select>
                    </div>

                    <div class="col-2 d-flex justify-content-center" style="padding-top:42px">
                        <div class="d-flex align-items-center text-primary">
                            <i class="ti ti-arrow-left fs-18"></i>
                            <div style="width:20px;height:2px;background:currentColor"></div>
                            <i class="ti ti-arrow-right fs-18"></i>
                        </div>
                    </div>

                    <div class="col-5 text-center">
                        <p class="fw-semibold text-primary small mb-2">Destination (To)</p>
                        <select class="form-select form-select-sm mb-2 mt-2" id="toSubjectTypeGrade" onchange="validateCopyExamGrade()">
                            <option value="">To Subject Type</option>
                        </select>
                        <select class="form-select form-select-sm mb-2 mt-2" id="toClassGrade" onchange="validateCopyExamGrade()">
                            <option value="">To Class</option>
                        </select>
                    </div>
                </div>

                <!-- Shown when From combo == To combo (same SubjectType AND same Class) -->
                <div id="validationBoxGrade" class="d-none border-top mt-4 pt-3 text-center">
                    <i class="ti ti-alert-triangle text-danger" style="font-size:40px"></i>
                    <p class="text-danger fw-semibold mt-1 mb-0">Source and destination cannot be the same Subject Type &amp; Class</p>
                </div>

                <div id="tableSectionGrade" class="d-none border-top mt-3 pt-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-semibold small">
                            <i class="ti ti-list me-1"></i>Grade rows to copy
                        </span>
                    </div>

                    <div class="border rounded" style="max-height:220px;overflow-y:auto">
                        <table class="table table-sm table-hover mb-0" id="tblGradeCopy">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width:40px">#</th>
                                    <th>Min Range</th>
                                    <th>Max Range</th>
                                    <th>Exam Grade</th>
                                    <th>Grade Pointer</th>
                                    <th>Remark</th>
                                </tr>
                            </thead>
                            <tbody id="gradeTbody"></tbody>
                        </table>
                    </div>
                    <p class="text-muted small mt-1 mb-0">
                        <i class="ti ti-info-circle me-1"></i>
                        All rows shown above will be copied to the destination Subject Type / Class.
                        If the destination already has rows, they will be replaced.
                    </p>
                </div>

            </div>
        </div>
    </div>
</div>