@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.ExamGradeAddViewModel
@{
    ViewData["Title"] = "Add Exam Grade";
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }

    #gradeGridBody input.form-control {
        min-width: 90px;
    }
</style>

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Exam Grade Configuration</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button class="btn btn-secondary top-btn d-none" onclick="resetGrid()">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <button class="btn btn-danger top-btn" onclick="openCopyModal()">
            <i class="ti ti-copy me-1"></i> Copy
        </button>
        <a href="/exam/Index" class="btn btn-secondary top-btn  d-none">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="itemForm" class="needs-validation" novalidate>

                    <!-- ExamGradeID is NOT a real single-row id here; kept only for
                         legacy compatibility with the request DTO. The combo of
                         SubjectTypeID + ClassID is the real key. -->
                    <input type="hidden" id="txtItemId" value="0">
                    <input type="hidden" id="hdnUserID" value="@(Model.CurrentUserId)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.CompanyID)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.SessionID)">

                    <div class="row">
                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Subject Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlSubjectType" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.SubjectType != null)
                                {
                                    @foreach (var rt in Model.SubjectType)
                                    {
                                        <option value="@rt.Id" selected="@(Model.SelectedSubjectTypeID == rt.Id)">@rt.Name</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Subject Type is required.</div>
                        </div>

                        <div class="d-block col-md-4">
                            <label class="form-label fw-bold">Class <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlClass" style="width: 100%;">
                                <option value="">Select</option>
                                @if (Model.Classes != null)
                                {
                                    @foreach (var rt in Model.Classes)
                                    {
                                        <option value="@rt.ClassID" selected="@(Model.SelectedClassID == rt.ClassID)">@rt.ClassName</option>
                                    }
                                }
                            </select>
                            <div class="invalid-feedback">Class is required.</div>
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- Grid appears only once both dropdowns above are selected -->
                    <div id="gradeGridWrapper" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle" id="gradeGridTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:50px;">S.No</th>
                                        <th>Min Range</th>
                                        <th>Max Range</th>
                                        <th>Exam Grade</th>
                                        <th>Grade Pointer</th>
                                        <th>Remark</th>
                                        <th style="width:60px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="gradeGridBody">
                                    <!-- rows injected by JS -->
                                </tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addGridRow()">
                            <i class="ti ti-plus"></i> Add Row
                        </button>
                    </div>

                    <div id="gradeGridEmptyMsg" class="text-muted mt-3">
                        Select a Subject Type and Class to configure grades.
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<div id="ExamGradeCopyModalContainer">
    @await Html.PartialAsync("_CopyExamGradeModal")
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.getByFilterUrl = '/ExamGrade/GetByFilter';
        window.saveUrl = '/ExamGrade/Save';
    </script>
    <script src="~/assets/js/ExamGrade.js"></script>
}