@model SchoolERPWebConsole.Domain.PaymentTypeFieldAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Payment Type Field";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditPaymentTypeField == null ? "Add Payment Type Field" : "Edit Payment Type Field")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button type="button" onclick="resetForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <a href="/PaymentTypeField/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="accountHeadForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>Payment Type</strong>
                </div>
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditPaymentTypeField?.FieldID">

                    <div class="row row-gap-3">
                        <div class="col-md-4">
                            <label class="form-label">Payment Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlPaymentType" style="width: 100%;">
                                @foreach (var rt in Model.PaymentType)
                                {
                                    <option value="@rt.Id" selected="@(Model.EditPaymentTypeField?.PaymentTypeId == rt.Id)">@rt.Name</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errPaymentType">Please select a payment type.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Field Label <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldLabel" placeholder="e.g. Paypal Username"
                                   value="@Model.EditPaymentTypeField?.FieldLabel" oninput="autoFillKey()">
                            <div class="text-danger small mt-1 d-none" id="errLabel">Field label is required.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Field Key <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fldKey" placeholder="e.g. USERNAME"
                                   value="@Model.EditPaymentTypeField?.FieldKey" style="font-family:Consolas,monospace;">
                            <div class="text-danger small mt-1 d-none" id="errKey">Field key is required and must be unique for this payment type.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Input Type</label>
                            <select id="fldType" class="form-select select2">
                                <option value="TEXT" selected="@(Model.EditPaymentTypeField == null || Model.EditPaymentTypeField.FieldType == "TEXT")">Text</option>
                                <option value="PASSWORD" selected="@(Model.EditPaymentTypeField?.FieldType == "PASSWORD")">Password (masked)</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Display Order:</label>
                            <input type="text" class="form-control" id="txtDisplayOrder"
                                   value="@Model.EditPaymentTypeField?.DisplayOrder">
                            <div class="text-danger small mt-1 d-none" id="errDisplayOrder">Display order must be a whole number.</div>
                        </div>




                        <div class="col-md-3 mt-4">
                            <div class="form-check form-switch">

                                <input class="form-check-input" type="checkbox" id="fldRequired" @(Model.EditPaymentTypeField?.IsRequired ?? true ? "checked" : "")>
                                <span class="slider"></span>

                                Required
                            </div>
                        </div>
                        <div class="col-md-3 mt-4">
                            <div class="form-check form-switch">

                                <input class="form-check-input" type="checkbox" id="fldSecret" @(Model.EditPaymentTypeField?.IsSecret ?? false ? "checked" : "")>
                                <span class="slider"></span>

                                Secret (encrypt &amp; mask)
                            </div>
                        </div>
                        <!-- Active -->
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditPaymentTypeField?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/PaymentTypeField.js"></script>
}
