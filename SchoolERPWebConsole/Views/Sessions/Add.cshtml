@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.SessionAddPageViewModel
@{
    ViewData["Title"] = "Add Session";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditSession == null ? "Add Session" : "Edit Session")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Sessions/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">                
                <form id="itemForm">
                    <input type="hidden" id="txtItemId" value="@(Model.EditSession?.SessionId ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditSession?.CompanyID ?? 0)">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Session Title <span class="text-danger">*</span></label>
                        <input type="text"
                               class="form-control"
                               id="txtSessionTitle"
                               value="@Model.EditSession?.SessionTitle"
                               placeholder="e.g. 2026-27"
                               maxlength="7"
                               autocomplete="off">
                        <div class="form-text">Format: YYYY-YY (e.g. 2026-27)</div>
                        <div class="invalid-feedback" id="errTxtSessionTitle"></div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="isActive" @(Model.EditSession?.IsActive ?? true ? "checked" : "")>
                        <label class="form-check-label fw-bold" for="isActive">Active</label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/Sessions.js"></script>
}