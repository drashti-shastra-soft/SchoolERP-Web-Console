@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.RemarkGroupAddViewModel
@{
    ViewData["Title"] = "Add Remark Group";
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditRemarkGroup == null ? "Add Remark Group" : "Edit Remark Group")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/RemarkGroup/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">

            <div class="card-body">
                <form id="itemForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditRemarkGroup?.RemarkGroupID ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(Model.EditRemarkGroup?.CreatedBy ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditRemarkGroup?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditRemarkGroup?.SessionID ?? 0)">
                    @* <input type="hidden" id="txtItemId" value="0"> *@
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Remark Group Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.EditRemarkGroup?.RemarkGroupName" id="txtRemarkGroupName" placeholder="e.g. Student" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtSubjectName"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Display Order</label>
                            <input type="number" class="form-control" value="@Model.EditRemarkGroup?.DisplayOrder" id="txtDisplayOrder" placeholder="e.g. 1" autocomplete="off">
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(Model.EditRemarkGroup?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/RemarkGroup.js"></script>
}