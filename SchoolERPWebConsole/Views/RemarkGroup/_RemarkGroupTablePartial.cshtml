@*
    ======================================================================
    VIEW: Academics / Subject.cshtml
    PURPOSE: User interface for managing Subjects.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.RemarkGroupPageViewModel
@{
    var p = Model.Permissions;
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
}

<div class="row">
    <!-- Data table -->
    <div class="col-xl-12">
        <div class="card shadow-tbl border-0 overflow-hidden">
            <div class="card-body p-0">
                <div class="sticky-table">
                    <div class="table-responsive">
                        <table class="table" id="RemarkGroupTable">
                            <thead>
                                <tr class="bg-light">
                                    <th class="ps-4" style="width: 50px;">Select</th>
                                    <th>Remark Group Name</th>
                                    <th>Display Order</th>
                                    <th>Created On</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RemarkGroup != null && Model.RemarkGroup.Any())
                                {
                                    foreach (var s in Model.RemarkGroup)
                                    {
                                        <tr class="item-row" onclick="selectItem(@s.RemarkGroupID, this)">
                                            @*  <td class="ps-4 text-center">
                                            <input type="checkbox" name="selectedSubject"
                                                   class="form-check-input student-checkbox"
                                                   value="@s.SubjectID" />
                                        </td> *@
                                            <td class="ps-4 text-center" style="cursor: pointer; vertical-align: middle;">
                                                <div class="d-flex align-items-center justify-content-center" onclick="event.stopPropagation()">
                                                    <input type="checkbox" name="selectedClass"
                                                           class="form-check-input student-checkbox" onclick="selectItem(@s.RemarkGroupID, this)"
                                                           value="@s.RemarkGroupID">
                                                </div>
                                            </td>
                                            <td>@s.RemarkGroupName</td>
                                            <td>@s.DisplayOrder</td>
                                            <td>@s.CreatedOn.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (p.CanEdit)
                                                {
                                                    <div class="form-check form-switch" onclick="event.stopPropagation()">
                                                        <input class="form-check-input status-switch" style="cursor: pointer;" type="checkbox"
                                                        @(s.IsActive ? "checked" : "")
                                                               onchange="toggleStatus(@s.RemarkGroupID, this.checked, this)" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">
                                                        @(s.IsActive ? "Active" : "Inactive")
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted text-danger">No subjects found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- ── Pagination ─────────────────────────────────────────────── -->
                        @if (totalPages > 1)
                        {
                            <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                                <!-- Record info -->
                                <div class="text-muted small">
                                    Showing
                                    <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                    –
                                    <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                    of
                                    <strong>@Model.TotalRecords</strong> users
                                </div>

                                <nav aria-label="Subject pagination">
                                    <ul class="pagination pagination-sm mb-0">

                                        <!-- First -->
                                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevrons-left"></i>
                                            </a>
                                        </li>

                                        <!-- Prev -->
                                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevron-left"></i>
                                            </a>
                                        </li>

                                        <!-- Page numbers — show 5 around current -->
                                        @{
                                            int start = Math.Max(1, Model.PageNumber - 2);
                                            int end = Math.Min(totalPages, start + 4);
                                            start = Math.Max(1, end - 4);
                                        }
                                        @for (int pg = start; pg <= end; pg++)
                                        {
                                            <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                                <a class="page-link"
                                                   href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">@pg</a>
                                            </li>
                                        }

                                        <!-- Next -->
                                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevron-right"></i>
                                            </a>
                                        </li>

                                        <!-- Last -->
                                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                                <i class="ti ti-chevrons-right"></i>
                                            </a>
                                        </li>

                                    </ul>
                                </nav>

                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>