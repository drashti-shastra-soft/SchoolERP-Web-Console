@{
    ViewData["Title"] = "Fee Discount";
}
<style>
    .table-scroll {
        max-height: 320px;
        overflow: auto;
    }

    .info-val {
        font-weight: 600;
        color: #2e6f86;
    }

    .disc-input {
        text-align: right;
        background: #eceae7;
    }

    .row-paid td {
        opacity: .65;
    }
</style>

<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div><h6 class="fw-bold mb-0">Fee Discount</h6></div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        <button type="button" class="btn btn-success top-btn" id="btnSaveDiscount">
            <i class="ti ti-device-floppy me-1"></i> Save
        </button>
        <button type="button" class="btn btn-secondary top-btn" id="btnClearDiscount">
            <i class="ti ti-refresh me-1"></i> Clear
        </button>
    </div>
</div>

<!-- Student Info + concession form -->
<div class="card shadow-tbl-outer">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-lg-10">
                <div class="row g-3">
                    <div class="col-md-4" style="position:relative;">
                        <label class="form-label fw-semibold">Student ID <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtStudentID" placeholder="Search student id / name" autocomplete="off">
                        <ul id="pinStudentSuggestions" class="pincode-dropdown list-group"></ul>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">SR Code / House No</label>
                        <input type="text" class="form-control" id="txtSrCode" disabled>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Class</label>
                        <div class="info-val pt-1" id="lblClass">-</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Name</label>
                        <div class="info-val" id="lblName">-</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Gender</label>
                        <div class="info-val" id="lblGender">-</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Admission Type</label>
                        <div class="info-val" id="lblAdmType">-</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Father Name</label>
                        <div class="info-val" id="lblFather">-</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mother Name</label>
                        <div class="info-val" id="lblMother">-</div>
                    </div>
                    <div class="col-md-4"></div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Fee Concession <span class="text-danger">*</span></label>
                        <select class="form-select" id="ddlConcession"><option value="">--Select--</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Concession From Month/Inst.</label>
                        <select class="form-select" id="ddlFromInst"><option value="">--Select--</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Discount By</label>
                        <select class="form-select" id="ddlDiscountBy"><option value="">Select</option></select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Concession Head <span class="text-danger">*</span></label>
                        <select class="form-select" id="ddlHead"><option value="">--Select--</option></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Discount</label>
                        <div class="input-group">
                            <select class="form-select" id="ddlDiscType" style="max-width:140px;">
                                <option value="P">Percentage</option>
                                <option value="A">Amount</option>
                            </select>
                            <input type="number" step="0.01" min="0" class="form-control text-end" id="txtDiscValue" value="0.00">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Attach a file</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="file" class="form-control" id="fileAttach" accept=".pdf,.jpg,.jpeg,.png">
                            <a href="#" id="lnkViewFile" target="_blank" class="d-none">View</a>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">Remark <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtRemark" maxlength="500">
                    </div>
                </div>
            </div>

            <div class="col-lg-2 text-center">
                <img id="imgStudent" src="/assets/img/doctors/doctor-01.jpg" class="rounded"
                     style="width:110px;height:130px;object-fit:cover;" alt="">
            </div>
        </div>
    </div>
</div>

<!-- Discount grid -->
<div class="card shadow-tbl-outer mt-2">
    <div class="card-body p-0">
        <div class="table-scroll table-responsive">
            <table class="table mb-0" id="tblDiscount">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px">S. No.</th>
                        <th>Month</th>
                        <th>Fee Head</th>
                        <th class="text-end">Actual Amount</th>
                        <th class="text-end" style="width:200px">Discount</th>
                    </tr>
                </thead>
                <tbody id="discBody">
                    <tr><td colspan="5" class="text-center text-muted py-3">Search and select a student to load fee details</td></tr>
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td></td>
                        <td id="footCount">0</td>
                        <td></td>
                        <td class="text-end" id="footActual">0.00</td>
                        <td class="text-end" id="footDiscount">0.00</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/FeeDiscount.js"></script>
}
