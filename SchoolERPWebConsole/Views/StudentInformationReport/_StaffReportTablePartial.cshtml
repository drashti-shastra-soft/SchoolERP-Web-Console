@model SchoolERPWebConsole.Domain.HRStaffReportPageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>Staff ID</th>
                        <th>Staff Code</th>
                        <th>Role </th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Gender</th>
                        <th>Date Of Birth</th>
                        <th>Date Of Join</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StaffList != null && Model.StaffList.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.StaffList.Count; i++)
                        {
                            var s = Model.StaffList[i];
                            
                            <tr class="student-row" data-id="@s.STAFFID">
                                <td>@s.STAFFID</td>
                                <td>@s.STAFFCODE</td>
                                <td>@s.ROLENAME</td>
                                <td>@s.DESIGNATIONNAME</td>
                                <td>@s.DEPARTMENTNAME</td>
                                <td>@s.FIRSTNAME  @s.LASTNAME</td>
                                <td>@s.EMAIL</td>
                                <td>@s.GENDER</td>
                                <td>@s.DOB</td>
                                <td>@s.DOJ</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("StaffReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>