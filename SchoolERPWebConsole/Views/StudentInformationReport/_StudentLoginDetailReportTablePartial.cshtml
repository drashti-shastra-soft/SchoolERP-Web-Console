@model SchoolERPWebConsole.Domain.LoginCredentialReportPageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>S.No.</th>
                        <th>
                            Admission No
                        </th>
                        <th>Student Name</th>
                        <th>Username</th>
                        <th>Password</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LoginCredentialReport != null && Model.LoginCredentialReport.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.LoginCredentialReport.Count; i++)
                        {
                            var s = Model.LoginCredentialReport[i];
                            <tr class="student-row" data-id="@s.StudentId">
                                <td>@(startIndex + i + 1)</td>
                                <td>@s.AdmissionNo</td>
                                <td>@s.FullName</td>
                                <td>@s.Username</td>
                                <td>@s.Password</td>
                                
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("LoginDetailReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId, classId = Model.ClassId, sectionId = Model.SectionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>