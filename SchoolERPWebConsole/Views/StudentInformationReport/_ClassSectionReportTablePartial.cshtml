@model SchoolERPWebConsole.Domain.StudentCountReportPageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>S.No.</th>
                        <th>Class</th>
                        <th>Students</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StudentReports != null && Model.StudentReports.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.StudentReports.Count; i++)
                        {
                            var s = Model.StudentReports[i];
                            <tr class="student-row" data-id="@s.ClassID">
                                <td>@(startIndex + i + 1)</td>
                                <td>@s.ClassName (@s.SectionName)</td>
                                <td>@s.StudentCount</td>
                                <td>
                                    @if (p.CanView)
                                    {
                                        <a href="/StudentInformation/Students?pageSize=10&page=1&viewType=list&search=&classId=@s.ClassID&sectionId=@s.SectionID"
                                           class="btn btn-sm btn-white border px-2 py-1 btn-view-attachment"
                                           title="View Details">
                                            <i class="ti ti-eye fs-5"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">No student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("ClassSectionReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId, classId = Model.ClassId, sectionId = Model.SectionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>