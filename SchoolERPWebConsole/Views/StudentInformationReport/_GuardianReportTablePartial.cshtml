@model SchoolERPWebConsole.Domain.GuardianReportResponsePageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>S.No.</th>
                        <th>Class (Section)</th>
                        <th>Admission No</th>
                        <th>Student Name</th>
                        <th>Mobile Number</th>
                        <th>Guardian Name</th>
                        <th>Guardian Relation</th>
                        <th>Guardian Phone</th>
                        <th>Father Name</th>
                        <th>Father Phone</th>
                        <th>Mother Name</th>
                        <th>Mother Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.GuardianReport != null && Model.GuardianReport.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.GuardianReport.Count; i++)
                        {
                            var s = Model.GuardianReport[i];
                            <tr class="student-row" data-id="@s.StudentId">
                                <td>@(startIndex + i + 1)</td>
                                <td>@s.ClassName (@s.SectionName)</td>
                                <td>@s.AdmissionNo</td>
                                <td>@s.SectionName</td>
                                <td>@s.MobileNo</td>
                                <td>@s.GuardianName</td>
                                <td>@s.GuardianRelation</td>
                                <td>@s.GuardianPhone</td>
                                <td>@s.FatherName</td>
                                <td>@s.FatherPhone</td>
                                <td>@s.MotherName</td>
                                <td>@s.MotherPhone</td>                                
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">No student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("ClassSectionReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId, classId = Model.ClassId, sectionId = Model.SectionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>