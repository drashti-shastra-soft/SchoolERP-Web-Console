@model SchoolERPWebConsole.Domain.ItemStockReportPageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Supplier </th>
                        <th>Store</th>
                        <th>Available Quantity</th>
                        <th>Total Quantity</th>
                        <th>Total Issued</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StockList != null && Model.StockList.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.StockList.Count; i++)
                        {
                            var s = Model.StockList[i];

                            <tr class="student-row" data-id="@s.ITEMSTOREID">
                                <td>@s.NAME</td>
                                <td>@s.CATEGORY</td>
                                <td>@s.SUPPLIER</td>
                                <td>@s.STORE</td>
                                <td>@s.AVAILABLEQUANTITY</td>
                                <td>@s.TOTALQUANTITY</td>
                                <td>@s.TOTALISSUED</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("StockReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>