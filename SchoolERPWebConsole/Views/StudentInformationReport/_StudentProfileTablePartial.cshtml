@model SchoolERPWebConsole.Domain.AdmissionReportPageViewModel
@{
    var p = Model.Permissions;
}

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>S.No.</th>
                        <th>Admission No</th>
                        <th>Student Name</th>
                        <th>Class</th>
                        <th>Father Name</th>
                        <th>Date Of Birth</th>
                        <th>Admission Date</th>
                        <th>Gender</th>
                        <th>Category</th>
                        <th>Mobile Number</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StudentLists != null && Model.StudentLists.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.StudentLists.Count; i++)
                        {
                            var s = Model.StudentLists[i];
                            <tr class="student-row" data-id="@s.SectionId">
                                <td>@(startIndex + i + 1)</td>
                                <td>@s.AdmissionNo</td>
                                <td>@s.FullName</td>
                                <td>@s.ClassName (@s.SectionName)</td>
                                <td>@s.FatherName</td>
                                <td>@s.DOB?.ToString("dd-MMM-yyyy")</td>
                                <td>@s.AdmissionDate?.ToString("dd-MMM-yyyy")</td>
                                <td>@s.Gender</td>
                                <td>@s.StudentCategoryName</td>
                                <td>@s.MobileNo</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">No student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("ClassSectionReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId, classId = Model.ClassId, sectionId = Model.SectionId })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>