@model SchoolERPWebConsole.Domain.StudentInformationReportPageViewModel

<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="StudentReportTable">
                <thead class="table-light">
                    <tr>
                        <th>S.No.</th>
                        <th>Admission No</th>
                        <th>Roll No</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Class</th>
                        <th>Section</th>
                        <th>Category</th>
                        <th>RTE</th>
                        <th>Father Name</th>
                        <th>Mobile No</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StudentReports != null && Model.StudentReports.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.StudentReports.Count; i++)
                        {
                            var s = Model.StudentReports[i];
                            <tr class="student-row" data-id="@s.StudentId">
                                <td>@(startIndex + i + 1)</td>
                                <td>@s.AdmissionNo</td>
                                <td>@s.RollNo</td>
                                <td>@s.FullName</td>
                                <td>@s.Gender</td>
                                <td>
                                    @s.ClassName
                                    @if (!string.IsNullOrEmpty(s.MultiClassNames) && s.MultiClassNames != s.ClassName)
                                    {
                                        <br />

                                        <small class="text-muted">Also: @s.MultiClassNames</small>
                                    }
                                </td>
                                <td>@s.SectionName</td>
                                <td>@s.StudentCategoryName</td>
                                <td>
                                    @if (s.RTE == "Yes")
                                    {
                                        <span class="badge bg-success-subtle text-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">No</span>
                                    }
                                </td>
                                <td>@s.FatherName</td>
                                <td>@s.MobileNo</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">No student records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("StudentReport", new { pageNumber = pg, pageSize = Model.PageSize, searchTerm = Model.SearchTerm, companyId = Model.CompanyId, sessionId = Model.SessionId, classId = Model.ClassId, sectionId = Model.SectionId, gender = Model.Gender, categoryId = Model.CategoryId, rte = Model.RTE })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>