@model SchoolERPWebConsole.Domain.HRApplyLeavePageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Add Apply Leave";
    var p = Model.Permissions;
    var edit = Model.EditApplyLeave;
    bool isEditMode = edit != null;
    bool isLocked = isEditMode && !string.Equals(edit.Status, "Pending", StringComparison.OrdinalIgnoreCase);
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(isEditMode ? "Edit Apply Leave" : "Add Apply Leave")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">
        @if ((p.CanAdd || p.CanEdit) && !isLocked)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveLeave()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/HumanResource/ApplyLeave" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">

                @if (isLocked)
                {
                    <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                        <i class="ti ti-lock me-2 fs-5"></i>
                        <span>
                            This leave application has already been <strong>@edit.Status</strong> and can no longer be edited.
                            Only leave requests with <strong>Pending</strong> status can be modified.
                        </span>
                    </div>
                }

                <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)" />
                <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)" />
                <input type="hidden" id="hdnCurrentStatus" value="@(edit?.Status ?? "Pending")" />

                <form id="leaveForm" class="needs-validation" novalidate>
                    <fieldset disabled="@isLocked">
                        <div class="modal-body">
                            <div id="divError" class="alert alert-danger d-none mb-3" role="alert">
                                <i class="ti ti-alert-triangle me-2"></i>
                                <span id="spnErrorMessage"></span>
                            </div>
                            <input type="hidden" id="hdnApplyLeaveID" value="@(edit?.ApplyLeaveID ?? 0)" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    @if (Model.StaffList.Any())
                                    {
                                        <input type="hidden" id="hdnStaff" value="" />
                                        <label class="form-label fw-semibold">Staff <span class="text-danger">*</span></label>
                                        <select id="ddlStaff" class="form-select select2" required>
                                            <option value="">Select Type</option>
                                            @foreach (var lt in Model.StaffList)
                                            {
                                                <option value="@lt.StaffID" selected="@(edit != null && edit.StaffID == lt.StaffID)">
                                                    @($"{lt.FirstName} {lt.LastName}")
                                                </option>
                                            }
                                        </select>
                                        <div class="invalid-feedback">Please select a staff.</div>
                                    }
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Leave Type <span class="text-danger">*</span></label>
                                    <select id="ddlLeaveType" class="form-select select2" required onchange="loadLeaveBalance()">
                                        <option value="">Select Type</option>
                                        @foreach (var lt in Model.LeaveTypes)
                                        {
                                            <option value="@lt.LeaveTypeID" selected="@(edit?.LeaveTypeID == lt.LeaveTypeID)">
                                                @lt.LeaveTypeName
                                            </option>
                                        }
                                    </select>

                                    <div class="invalid-feedback">Please select a leave type.</div>
                                </div>
                                <div class="col-md-12" id="divBalance" style="display:none;">
                                    <div class="alert alert-info py-2 px-3 mb-0 d-flex align-items-center">
                                        <i class="ti ti-info-circle me-2 fs-5"></i>
                                        <span>Remaining Balance: <strong id="spnBalance">0</strong> Days</span>
                                        <span class="ms-auto small text-muted">Total Quota: <span id="spnTotalQuota">0</span> | Used: <span id="spnUsed">0</span></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">From Date <span class="text-danger">*</span></label>
                                    <input type="date" id="txtFromDate" class="form-control" required onchange="clearError()"
                                           value="@(edit?.FromDate.ToString("yyyy-MM-dd"))">
                                    <div class="invalid-feedback">Required.</div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold">To Date <span class="text-danger">*</span></label>
                                    <input type="date" id="txtToDate" class="form-control" required onchange="clearError()"
                                           value="@(edit?.ToDate.ToString("yyyy-MM-dd"))">
                                    <div class="invalid-feedback">Required.</div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Attachment</label>
                                    <input type="file" id="fileAttachment" class="form-control" />
                                    @if (isEditMode && !string.IsNullOrEmpty(edit.AttachmentDocName))
                                    {
                                        <small class="text-muted d-block mt-1">
                                            <i class="ti ti-paperclip me-1"></i>Current: @edit.AttachmentDocName
                                            <span class="text-secondary">(choose a new file to replace it)</span>
                                        </small>
                                    }
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold">Reason</label>
                                    <textarea id="txtReason" class="form-control" rows="3" placeholder="Enter reason for leave...">@(edit?.Reason)</textarea>
                                </div>
                                <div class="col-md-6 d-none">
                                    <label class="form-label fw-semibold">Status</label>
                                    <select id="ddlStatus" class="form-select">
                                        <option value="Pending" selected="@(edit == null || edit.Status == "Pending")">Pending</option>
                                        <option value="Approved" selected="@(edit != null && edit.Status == "Approved")">Approved</option>
                                        <option value="Disapproved" selected="@(edit != null && edit.Status == "Disapproved")">Disapproved</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/ApplyLeave.js"></script>
    @if (isEditMode)
    {
        <script>
            // Ensure select2 reflects the server-selected options once initialized
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    $('#ddlStaff').trigger('change');
                    $('#ddlLeaveType').trigger('change');
                }, 0);
            });
        </script>
    }
}