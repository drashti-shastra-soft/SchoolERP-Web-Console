</form>


@section Scripts {
    <script>

        /* =====================================================================
           1. VALIDATION HELPERS (pure functions — no DOM/jQuery dependency)
           ===================================================================== */

        function isValidDOB(dob) {
            const dobDate = new Date(dob);
            if (isNaN(dobDate.getTime())) return false;

            const today = new Date();
            if (dobDate > today) return false; // can't be in the future

            let age = today.getFullYear() - dobDate.getFullYear();
            const m = today.getMonth() - dobDate.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dobDate.getDate())) age--;

            return age >= 18 && age <= 100;
        }

        function isValidDOJ(doj, dob) {
            const dojDate = new Date(doj);
            if (isNaN(dojDate.getTime())) return false;

            const today = new Date();
            if (dojDate > today) return false; // can't join in the future

            if (dob) {
                const dobDate = new Date(dob);
                if (!isNaN(dobDate.getTime()) && dojDate < dobDate) return false; // can't join before being born
            }

            return true;
        }

        function isValidPhone(phone) {
            const digits = phone.replace(/\D/g, '');
            return /^[6-9]\d{9}$/.test(digits.slice(-10));
        }

        function isValidEmail(email) {
            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email);
        }


        /* =====================================================================
           2. PAGE INIT (runs on document ready)
           ===================================================================== */

        function setDefaultDates() {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            const todayStr = `${yyyy}-${mm}-${dd}`;

            if (!$('#txtDOJ').val()) {
                $('#txtDOJ').val(todayStr);
            }

            if (!$('#txtDOB').val()) {
                $('#txtDOB').val(todayStr);
            }
        }

        function initSelect2() {
            $('.form-select').select2({
                width: '100%',
                placeholder: "Select",
                allowClear: true
            });
        }

        function initRoleChangeHandler() {
            $('#ddlRole').on('change', function () {
                var $defaultRole = $('#ddlDefaultRole');
                $defaultRole.empty().append($('<option>', { value: '', text: 'Select Default Role' }));

                $('#ddlRole option:selected').each(function () {
                    $defaultRole.append($('<option>', { value: $(this).val(), text: $(this).text() }));
                });
            });
        }

        function initInputMasks() {
            // Letters-only fields
            $('#txtFirstName, #txtLastName, #txtFatherName, #txtMotherName').on('input', function () {
                this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
            });

            $('#txtQualification').on('input', function () {
                this.value = this.value.replace(/[^a-zA-Z\s.,()-]/g, '');
            });
        }

        $(document).ready(function () {
            initSelect2();
            setDefaultDates();
            initRoleChangeHandler();
            initInputMasks();
        });


        /* =====================================================================
           3. DEFAULT ROLE → DASHBOARD LOOKUP
           ===================================================================== */

        function onDefaultRoleChange() {
            const roleId = parseInt($('#ddlDefaultRole').val()) || 0;
            const ddlDashboard = document.getElementById('ddlDefaultDashboard');

            ddlDashboard.innerHTML = '<option value="">-- Select Default Role First --</option>';
            if (roleId <= 0) return;

            ddlDashboard.innerHTML = '<option value="">Loading...</option>';

            fetch(`/Role/GetByRoleId?roleId=${roleId}`)
                .then(r => r.json())
                .then(res => {
                    ddlDashboard.innerHTML = '<option value="">-- Select Dashboard --</option>';

                    if (res && res.dashboardID > 0) {
                        const opt = document.createElement('option');
                        opt.value = res.dashboardID;
                        opt.textContent = res.dashboardTital || res.dashboardURL || `Dashboard #${res.dashboardID}`;
                        ddlDashboard.appendChild(opt);
                        ddlDashboard.value = res.dashboardID; // auto-select: one dashboard per role
                    } else {
                        ddlDashboard.innerHTML = '<option value="">No dashboard found for this role</option>';
                    }
                })
                .catch(err => {
                    console.error('Dashboard load failed:', err);
                    ddlDashboard.innerHTML = '<option value="">Failed to load dashboards</option>';
                });
        }


        /* =====================================================================
           4. FILE HELPERS
           ===================================================================== */

        function fileToBase64(file) {
            if (!file) return Promise.resolve(null);
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }


        /* =====================================================================
           5. FORM VALIDATION
           ===================================================================== */

        function setFieldError(inputSel, errorSel, message, useSelect2 = false) {
            const $input = $(inputSel);
            const $error = $(errorSel);
            $error.text(message || '');

            if (useSelect2) {
                $input.next('.select2').find('.select2-selection')
                    .toggleClass('border-danger', !!message);
            } else {
                $input.toggleClass('is-invalid', !!message);
            }
        }

        function fnValidation() {
            let isValid = true;

            // Role
            const roleIds = $('#ddlRole').val();
            if (!roleIds || roleIds.length === 0) {
                setFieldError('#ddlRole', '#roleError', 'Role is required!', true);
                isValid = false;
            } else {
                setFieldError('#ddlRole', '#roleError', '', true);
            }

            // Staff ID
            const staffId = $.trim($('#txtStaffCode').val());
            if (!staffId) {
                setFieldError('#txtStaffCode', '#staffIdError', 'Staff ID is required!');
                isValid = false;
            } else {
                setFieldError('#txtStaffCode', '#staffIdError', '');
            }

            // Designation
            const designationId = $('#ddlDesig').val();
            if (!designationId) {
                setFieldError('#ddlDesig', '#designationError', 'Designation is required!', true);
                isValid = false;
            } else {
                setFieldError('#ddlDesig', '#designationError', '', true);
            }

            // Department (independent of designation — previously nested/buggy)
            const departmentId = $('#ddlDept').val();
            if (!departmentId) {
                setFieldError('#ddlDept', '#departmentError', 'Department is required!', true);
                isValid = false;
            } else {
                setFieldError('#ddlDept', '#departmentError', '', true);
            }

            // First Name
            const firstName = $('#txtFirstName').val();
            if (!firstName) {
                setFieldError('#txtFirstName', '#firstNameError', 'First Name is required!', true);
                isValid = false;
            } else {
                setFieldError('#txtFirstName', '#firstNameError', '', true);
            }

            // Last Name
            const lastName = $('#txtLastName').val();
            if (!lastName) {
                setFieldError('#txtLastName', '#lastNameError', 'Last Name is required!', true);
                isValid = false;
            } else {
                setFieldError('#txtLastName', '#lastNameError', '', true);
            }

            // Email
            const email = $.trim($('#txtUsername').val());
            if (!email) {
                setFieldError('#txtUsername', '#usernameError', 'Email is required!');
                isValid = false;
            } else if (!isValidEmail(email)) {
                setFieldError('#txtUsername', '#usernameError', 'Enter a valid email address!');
                isValid = false;
            } else {
                setFieldError('#txtUsername', '#usernameError', '');
            }

            // Mother Name
            const motherName = $('#txtMotherName').val();
            if (!motherName) {
                setFieldError('#txtMotherName', '#motherNameError', 'Mother Name is required!', true);
                isValid = false;
            } else {
                setFieldError('#txtMotherName', '#motherNameError', '', true);
            }

            // Father Name
            const fatherName = $('#txtFatherName').val();
            if (!fatherName) {
                setFieldError('#txtFatherName', '#fatherNameError', 'Father Name is required!', true);
                isValid = false;
            } else {
                setFieldError('#txtFatherName', '#fatherNameError', '', true);
            }

            // Address
            const address = $('#txtAddress').val();
            if (!address) {
                setFieldError('#txtAddress', '#addressError', 'Current Address is required!', true);
                isValid = false;
            } else {
                setFieldError('#txtAddress', '#addressError', '', true);
            }

            // Gender
            const gender = $('#ddlGender').val();
            if (!gender) {
                setFieldError('#ddlGender', '#genderError', 'Gender is required!');
                isValid = false;
            } else {
                setFieldError('#ddlGender', '#genderError', '');
            }

            // Marital Status
            const marital = $('#ddlMaritalStatus').val();
            if (!marital) {
                setFieldError('#ddlMaritalStatus', '#maritalError', 'Marital Status is required!');
                isValid = false;
            } else {
                setFieldError('#ddlMaritalStatus', '#maritalError', '');
            }

            // Phone Number
            const phone = $.trim($('#txtPhone').val());
            if (!phone) {
                setFieldError('#txtPhone', '#phoneError', 'Phone Number is required!');
                isValid = false;
            } else if (!isValidPhone(phone)) {
                setFieldError('#txtPhone', '#phoneError', 'Enter a valid 10-digit phone number!');
                isValid = false;
            } else {
                setFieldError('#txtPhone', '#phoneError', '');
            }

            // Emergency Number
            const emergencyPhone = $.trim($('#txtEmergencyPhone').val());
            if (!emergencyPhone) {
                setFieldError('#txtEmergencyPhone', '#emergencyPhoneError', 'Emergency Number is required!');
                isValid = false;
            } else if (!isValidPhone(emergencyPhone)) {
                setFieldError('#txtEmergencyPhone', '#emergencyPhoneError', 'Enter a valid 10-digit Emergency Number!');
                isValid = false;
            } else {
                setFieldError('#txtEmergencyPhone', '#emergencyPhoneError', '');
            }

            // Date of Birth
            const dob = $.trim($('#txtDOB').val());
            if (!dob) {
                setFieldError('#txtDOB', '#dobError', 'Date of Birth is required!');
                isValid = false;
            } else if (!isValidDOB(dob)) {
                setFieldError('#txtDOB', '#dobError', 'Enter a valid Date of Birth (age must be 18–100)!');
                isValid = false;
            } else {
                setFieldError('#txtDOB', '#dobError', '');
            }

            // Date of Joining
            const doj = $.trim($('#txtDOJ').val());
            if (!doj) {
                setFieldError('#txtDOJ', '#dojError', 'Date of Joining is required!');
                isValid = false;
            } else if (!isValidDOJ(doj, dob)) {
                setFieldError('#txtDOJ', '#dojError', 'Enter a valid Date of Joining (cannot be before DOB or in the future)!');
                isValid = false;
            } else {
                setFieldError('#txtDOJ', '#dojError', '');
            }

            // Pin Code (optional, but must be 6 digits if entered)
            const pin = $.trim($('#txtPinCode').val());
            if (pin && !/^[1-9][0-9]{5}$/.test(pin)) {
                setFieldError('#txtPinCode', '#pinCodeError', 'Enter a valid 6-digit pin code!');
                isValid = false;
            } else {
                setFieldError('#txtPinCode', '#pinCodeError', '');
            }

            return isValid;
        }


        /* =====================================================================
           6. SAVE / SUBMIT
           ===================================================================== */

        let isSaving = false;

        function collectRoleIDs() {
            const roleEl = document.getElementById('ddlRole');
            let roleIDs = roleEl.multiple
                ? Array.from(roleEl.selectedOptions).map(o => parseInt(o.value)).filter(v => !isNaN(v))
                : (roleEl.value ? [parseInt(roleEl.value)] : []);

            if (roleIDs.length === 0) {
                roleIDs = Array.from(document.querySelectorAll('input[type="hidden"][name="RoleIDs"]')).map(i => parseInt(i.value));
            }
            return roleIDs;
        }

        function collectCompanyIDs() {
            let companyIDs = Array.from(document.querySelectorAll('input[name="compCheck"]:checked')).map(c => parseInt(c.value));
            if (companyIDs.length === 0) {
                companyIDs = Array.from(document.querySelectorAll('input[type="hidden"][name="compCheck"]')).map(i => parseInt(i.value));
            }
            return companyIDs;
        }

        async function buildStaffPayload() {
            const getVal = (id) => document.getElementById(id)?.value?.trim() ?? '';
            const getInt = (id) => parseInt(document.getElementById(id)?.value) || 0;
            const getFloat = (id) => parseFloat(document.getElementById(id)?.value) || 0;

            const username = getVal('txtUsername');
            const phone = getVal('txtPhone');
            const emergencyPhone = getVal('txtEmergencyPhone');

            const photoFile = document.getElementById('filePhoto')?.files?.[0];
            const resumeFile = document.getElementById('fileResume')?.files?.[0];
            const joiningFile = document.getElementById('fileJoining')?.files?.[0];
            const resignFile = document.getElementById('fileResign')?.files?.[0];
            const otherFile = document.getElementById('fileOther')?.files?.[0];

            const [photoBase64, resumeBase64, joiningLetterBase64, resignationLetterBase64, otherDocBase64] =
                await Promise.all([
                    fileToBase64(photoFile),
                    fileToBase64(resumeFile),
                    fileToBase64(joiningFile),
                    fileToBase64(resignFile),
                    fileToBase64(otherFile)
                ]);
                const getIdOrNull = (id) => parseInt(document.getElementById(id)?.value) || null;
            return {
                staffID: getInt('hdnStaffID'),
                userID: getInt('hdnUserID'),
                staffCode: getVal('txtStaffCode'),
                firstName: getVal('txtFirstName'),
                lastName: getVal('txtLastName'),
                fatherName: getVal('txtFatherName'),
                motherName: getVal('txtMotherName'),
                username,
                email: username,
                gender: getVal('ddlGender'),
                dob: getVal('txtDOB') || null,
                doj: getVal('txtDOJ') || null,
                mobileNo: phone,
                emergencyMobileNo: emergencyPhone,
                maritalStatus: getVal('ddlMaritalStatus'),
                currentAddress: getVal('txtAddress'),
                permanentAddress: getVal('txtPermanentAddress'),
                designationID: getInt('ddlDesig'),
                departmentID: getInt('ddlDept'),
                qualification: getVal('txtQualification'),
                workExperience: getVal('txtExperience'),
                note: getVal('txtNote'),

                epfNo: getVal('txtEPFNo'),
                basicSalary: getFloat('txtSalary'),
                contractType: getVal('ddlContractType'),
                workShift: getVal('txtWorkShift'),
                workLocation: getVal('txtWorkLocation'),
                defaultRoleID: getInt('ddlDefaultRole'),
                dashboardID: getInt('ddlDefaultDashboard'),

                leaveQuotas: $('.leave-quota-input').map(function () {
                    return {
                        leaveTypeID: parseInt($(this).data('typeid')),
                        maxDays: parseFloat($(this).val()) || 0
                    };
                }).get(),

                accountTitle: getVal('txtAccTitle'),
                bankAccountNo: getVal('txtAccNo'),
                bankName: getVal('txtBankName'),
                ifscCode: getVal('txtIFSC'),
                bankBranchName: getVal('txtBranch'),

                facebookURL: getVal('txtFacebook'),
                twitterURL: getVal('txtTwitter'),
                linkedinURL: getVal('txtLinkedin'),
                instagramURL: getVal('txtInstagram'),

                photoBase64, photoDocType: photoFile?.type, photoDocName: photoFile?.name,
                resumeBase64, resumeDocType: resumeFile?.type, resumeDocName: resumeFile?.name,
                joiningLetterBase64, joiningLetterDocType: joiningFile?.type, joiningLetterDocName: joiningFile?.name,
                resignationLetterBase64, resignationLetterDocType: resignFile?.type, resignationLetterDocName: resignFile?.name,
                otherDocBase64, otherDocType: otherFile?.type, otherDocName: otherFile?.name,

                userTypeID: getInt('ddlUserType'),
                roleIDs: collectRoleIDs(),
                companyIDs: collectCompanyIDs(),
                isActive: true,
                postalCode: getVal('txtPinCode') || null,
                countryId: getIdOrNull('ddlCountry'),
                stateId: getIdOrNull('ddlState'),
                cityId: getIdOrNull('ddlCity'),
                fieldValues: $('.staff-custom-field-input').map(function () {
                    return { key: $(this).attr('name'), value: $(this).val() || '' };
                }).get().reduce((acc, item) => { if (item.key) acc[item.key] = item.value; return acc; }, {})
            };
        }

        function setSaveButtonLoading(isLoading) {
            const $saveBtn = $('.top-btn.btn-success');
            if (isLoading) {
                $saveBtn.prop('disabled', true).data('orig-html', $saveBtn.html())
                    .html('<i class="ti ti-loader-2 me-1"></i>Saving...');
            } else {
                $saveBtn.prop('disabled', false).html($saveBtn.data('orig-html'));
            }
            return $saveBtn;
        }

        function showSaveSuccess(message) {
            Swal.fire({
                title: 'Saved!',
                text: message,
                icon: 'success',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-success' },
                buttonsStyling: false
            }).then(function () {
                window.location.href = '/HumanResource/Staffs';
            });
        }

        function showSaveError(message) {
            Swal.fire({
                title: 'Error!',
                text: message || 'Failed to save Staff.',
                icon: 'error',
                confirmButtonText: 'OK',
                customClass: { confirmButton: 'btn btn-danger' },
                buttonsStyling: false
            });
        }

        async function saveStaff() {
            if (isSaving) return;
            if (!fnValidation()) return;

            isSaving = true;
            setSaveButtonLoading(true);

            try {
                const data = await buildStaffPayload();

                const res = await fetch('/UpsertStaff', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                }).then(r => r.json());

                if (res.success) {
                    showSaveSuccess(res.message);
                } else {
                    showSaveError(res.message);
                }
            } catch (err) {
                console.error('Save staff failed:', err);
                showSaveError('Something went wrong while saving. Please try again.');
            } finally {
                isSaving = false;
                setSaveButtonLoading(false);
            }
        }


        /* =====================================================================
           7. TOAST
           ===================================================================== */

        function showToast(msg, type = 'success') {
            const wrapper = document.createElement('div');
            wrapper.innerHTML = `<div class="toast align-items-center text-bg-${type} border-0 show position-fixed bottom-0 end-0 m-3" role="alert" style="z-index:9999">
                        <div class="d-flex"><div class="toast-body">${msg}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                        </div></div>`;
            document.body.appendChild(wrapper);
            setTimeout(() => wrapper.remove(), 4000);
        }


                /* =====================================================================
           PIN CODE -> COUNTRY / STATE / CITY
           ===================================================================== */
        const GeoAddress = (function () {
            const norm = s => String(s ?? '').trim().toLowerCase();
            const pick = (o, ...keys) => {
                if (!o) return null;
                for (const k of keys) {
                    const hit = Object.keys(o).find(x => x.toLowerCase() === k.toLowerCase());
                    if (hit && o[hit] != null && o[hit] !== '') return o[hit];
                }
                return null;
            };
            // refresh the select2 UI without firing the 'change' event handlers
            const refresh = el => { if (jQuery(el).data('select2')) jQuery(el).trigger('change.select2'); };

            const pinEl = document.getElementById('txtPinCode');
            const listEl = document.getElementById('pinCodeSuggestions');
            const countryEl = document.getElementById('ddlCountry');
            const stateEl = document.getElementById('ddlState');
            const cityEl = document.getElementById('ddlCity');

            async function fill(select, url, idKey, nameKey, preId, placeholder, preName) {
                const token = (select._token = (select._token || 0) + 1);
                select.innerHTML = `<option value="">${placeholder}</option>`;
                refresh(select);
                if (!url) return false;
                try {
                    const res = await fetch(url);
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const json = await res.json();
                    if (token !== select._token) return false;              // stale response
                    (json.data || json.Data || []).forEach(x => {
                        const id = pick(x, idKey), name = pick(x, nameKey);
                        if (id == null || name == null) return;
                        select.add(new Option(name, id));
                    });

                    let matched = false;
                    if (preId != null && preId !== '') {                    // 1) by id
                        select.value = String(preId);
                        matched = select.value === String(preId);
                    }
                    if (!matched && preName) {                              // 2) by name
                        const opt = [...select.options].find(o => o.value && norm(o.text) === norm(preName));
                        if (opt) { select.value = opt.value; matched = true; }
                    }
                    refresh(select);
                    return matched;
                } catch (err) {
                    console.error('Failed to load', url, err);
                    return false;
                }
            }

            const loadStates = (countryId, preId, preName) => fill(stateEl,
                countryId ? `/PostalCode/GetStatesByCountry?countryID=${countryId}` : null,
                'stateId', 'stateName', preId, '-- Select State --', preName);

            const loadCities = (stateId, preId, preName) => fill(cityEl,
                stateId ? `/PostalCode/GetCitiesByState?stateID=${stateId}` : null,
                'cityId', 'cityName', preId, '-- Select City --', preName);

            /* ---- pin suggestions ---- */
            let timer, items = [];

            function hideList() { listEl.style.display = 'none'; listEl.innerHTML = ''; }

            function renderList() {
                listEl.innerHTML = '';
                items.forEach(it => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    const city = pick(it, 'cityName');
                    li.textContent = pick(it, 'postalCode', 'pinCode') + (city ? ' - ' + city : '');
                    li.addEventListener('click', () => selectItem(it));
                    listEl.appendChild(li);
                });
                listEl.style.display = 'block';
            }

            async function fetchPins(term) {
                try {
                    const res = await fetch(`/Hostel/SearchPostalCode?term=${encodeURIComponent(term)}`);
                    const result = await res.json();
                    if (pinEl.value.trim() !== term) return;                // user kept typing
                    const data = result.data || result.Data;
                    if (!(result.success && data && data.length)) return hideList();
                    items = data;
                    if (term.length === 6 && items.length === 1) return selectItem(items[0]);
                    renderList();
                } catch (err) {
                    console.error('SearchPostalCode error:', err);
                    hideList();
                }
            }

            async function selectItem(it) {
                const countryId = pick(it, 'countryId'), countryName = pick(it, 'countryName');
                const stateId = pick(it, 'stateId'), stateName = pick(it, 'stateName');
                const cityId = pick(it, 'cityId'), cityName = pick(it, 'cityName');

                pinEl.value = pick(it, 'postalCode', 'pinCode') ?? pinEl.value;
                hideList();
                document.getElementById('pinCodeError').textContent = '';
                pinEl.classList.remove('is-invalid');

                // country: by id -> by name -> India
                if (countryId != null) countryEl.value = String(countryId);
                if (!countryEl.value && countryName) {
                    const o = [...countryEl.options].find(o => o.value && norm(o.text) === norm(countryName));
                    if (o) countryEl.value = o.value;
                }
                if (!countryEl.value) {
                    const o = [...countryEl.options].find(o => o.value && norm(o.text) === 'india');
                    if (o) countryEl.value = o.value;
                }
                refresh(countryEl);
                if (!countryEl.value) return;

                await loadStates(countryEl.value, stateId, stateName);
                await loadCities(stateEl.value, cityId, cityName);
            }

            function init() {
                if (!pinEl || !listEl || !countryEl || !stateEl || !cityEl) return;

                pinEl.addEventListener('input', function () {
                    this.value = this.value.replace(/\D/g, '').slice(0, 6);
                    clearTimeout(timer);
                    if (this.value.length < 2) return hideList();
                    timer = setTimeout(() => fetchPins(this.value), 300);
                });

                document.addEventListener('click', ev => {
                    if (!pinEl.contains(ev.target) && !listEl.contains(ev.target)) hideList();
                });

                // manual cascade (jQuery so select2's change event is caught)
                jQuery(countryEl).on('change', () => { loadStates(countryEl.value); loadCities(null); });
                jQuery(stateEl).on('change', () => loadCities(stateEl.value));

                // edit mode: restore saved state / city
                if (countryEl.value) {
                    const preState = document.getElementById('hdnSelectedStateId')?.value;
                    const preCity = document.getElementById('hdnSelectedCityId')?.value;
                    loadStates(countryEl.value, preState).then(() => {
                        if (stateEl.value) loadCities(stateEl.value, preCity);
                    });
                }
            }

            return { init };
        })();

        $(document).ready(function () { GeoAddress.init(); });
    </script>
}

