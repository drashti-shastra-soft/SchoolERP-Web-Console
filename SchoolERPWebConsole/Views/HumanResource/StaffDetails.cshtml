@model SchoolERPWebConsole.Domain.HRStaddDetailsViewModel
@using System.Linq
@using SchoolERPWebConsole.Helpers
@using System.Text.Json
@inject PermissionHelper PermHelper
@{
    ViewData["Title"] = "Staff Profile - " + Model.StaffViewModel?.FirstName + " " + Model.StaffViewModel?.LastName;

    bool IsFieldActive(string fieldName)
    {
        var field = Model.StaffViewModel?.SystemFields.FirstOrDefault(f =>
            f.FieldName.Replace(" ", "").Equals(fieldName.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
        return field == null || field.IsActive; // Default to active if not found
    }
    var p = @Model.Permissions;
}

<style>
    /* Remove validation icons */
    .was-validated .form-control:valid, .was-validated .form-control:invalid,
    .was-validated .form-select:valid, .was-validated .form-select:invalid {
        background-image: none !important;
        padding-right: 0.75rem !important;
    }
</style>
<style>
    .shadow-tbl {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        border: 1px solid #e9ecef;
    }

    .bg-light-success {
        background-color: #e6fffa;
        color: #008767;
    }

    .bg-light-danger {
        background-color: #fff5f5;
        color: #e53e3e;
    }

    .bg-light-warning {
        background-color: #fffaf0;
        color: #dd6b20;
    }

</style>
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Staff Profile</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (Model.StaffViewModel.IsActive)
        {
            <a asp-action="AddStaff" asp-route-id="@Model.StaffViewModel?.StaffID" class="btn btn-warning d-inline-flex align-items-center me-1 top-btn" asp-permission="Edit" asp-permission-url="/HumanResource/StaffDetails">
                <i class="ti ti-edit me-1"></i> Edit
            </a>
        }

        @if (Model.StaffViewModel.IsActive && Model.StaffViewModel.UserID.HasValue && Model.StaffViewModel.UserID > 0)
        {
            <button type="button" class="btn btn-info d-inline-flex align-items-center me-1 top-btn" onclick="showChangePasswordModal()" asp-permission="Edit" asp-permission-url="/HumanResource/StaffDetails">
                <i class="ti ti-key me-1"></i> Change Password
            </button>
        }
        @if (Model.StaffViewModel.IsActive)
        {
            <a href="@Url.Action("ToggleStaffStatus", new { id = Model.StaffViewModel?.StaffID, isActive = false })" class="btn btn-danger d-inline-flex align-items-center me-1 top-btn" asp-permission="Edit" asp-permission-url="/HumanResource/StaffDetails">
                <i class="ti ti-user-x me-1"></i> Disable
            </a>
        }
        else
        {
            <a href="@Url.Action("ToggleStaffStatus", new { id = Model.StaffViewModel?.StaffID, isActive = true })" class="btn btn-success d-inline-flex align-items-center me-1 top-btn" asp-permission="Edit" asp-permission-url="/HumanResource/StaffDetails">
                <i class="ti ti-user-check me-1"></i> Enable
            </a>
        }

        <button type="button" class="btn btn-primary d-inline-flex align-items-center top-btn" data-bs-toggle="offcanvas" data-bs-target="#offcanvasStaff"><i class="ti ti-list me-1"></i> Staff</button>
        <a href="/HumanResource/Staffs" class="btn btn-secondary d-inline-flex align-items-center top-btn"><i class="ti ti-arrow-left me-1"></i> Back</a>
    </div>
</div>
<!-- End Page Header -->
<!-- start row -->
<div class="row">
    <div class="col-xl-4">
        <div class="card position-sticky" style="top: 70px;">
            <div class="card-body d-flex align-items-center flex-sm-nowrap flex-wrap row-gap-3">
                <div class="me-3 doctor-profile-img">
                    @if (Model.StaffViewModel?.PhotoDoc != null && Model.StaffViewModel?.PhotoDoc.Length > 0)
                    {
                        var base64 = Model.StaffViewModel?.PhotoDoc;// Convert.ToBase64String(Model.PhotoDoc);
                        var imgSrc = $"data:{Model.StaffViewModel?.PhotoDocType};base64,{base64}";
                        <img src="@base64" class="rounded" alt="Staff Photo" style="width: 100px; height: 100px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="~/assets/img/profiles/avatar-01.jpg" class="rounded" alt="Default Photo" style="width: 100px; height: 100px; object-fit: cover;">
                    }
                </div>
                <div class="flex-fill">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <h6 class="mb-2 fw-semibold">
                            <a href="#">@Model.StaffViewModel?.FirstName @Model.StaffViewModel?.LastName</a>
                            @if (Model.StaffViewModel.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success ms-1">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger ms-1">Inactive</span>
                            }
                        </h6>
                    </div>
                    <p class="mb-2 fs-13">
                        <span class="text-dark">Staff ID</span> : @(string.IsNullOrEmpty(Model.StaffViewModel?.StaffCode) ? "-" : Model.StaffViewModel?.StaffCode)
                    </p>
                    <p class="mb-2 fs-13">
                        <span class="text-dark">Role</span> : @Model.StaffViewModel?.RoleName
                    </p>
                    <p class="mb-2 fs-13">
                        <span class="text-dark">Designation</span> : @(string.IsNullOrEmpty(Model.StaffViewModel.DesignationName) ? "-" : Model.StaffViewModel.DesignationName)
                    </p>
                </div>
            </div>
            <!-- end card body -->
            <ul class="list-group list-group-flush">
                @if (IsFieldActive("Department"))
                {
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Department :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.DepartmentName) ? "-" : Model.StaffViewModel.DepartmentName)</li>
                }
                @if (IsFieldActive("Payroll"))
                {
                    <li class="list-group-item list-group-item-action"><span class="text-dark">EPF No. :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.EPFNo) ? "-" : Model.StaffViewModel.EPFNo)</li>
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Basic Salary :</span> Rs. @Model.StaffViewModel?.BasicSalary.ToString("N0")</li>
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Contract Type :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.ContractType) ? "-" : Model.StaffViewModel.ContractType)</li>
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Work Shift :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.WorkShift) ? "-" : Model.StaffViewModel.WorkShift)</li>
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Work Location :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.WorkLocation) ? "-" : Model.StaffViewModel.WorkLocation)</li>
                }
                @if (IsFieldActive("DateOfJoining"))
                {
                    <li class="list-group-item list-group-item-action"><span class="text-dark">Date Of Joining :</span> @(Model.StaffViewModel.DOJ?.ToString("dd MMM yyyy") ?? "-")</li>
                }
                <li class="list-group-item list-group-item-action"><span class="text-dark">Barcode :</span> -</li>
                <li class="list-group-item list-group-item-action"><span class="text-dark">QR Code :</span> -</li>
            </ul>
        </div>
        <!-- end card -->
    </div>
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-pills mb-4 gap-1">
                    <li class="nav-item"><a href="#profile" data-bs-toggle="pill" class="nav-link active">Profile</a></li>
                    @if (IsFieldActive("Payroll"))
                    {
                        <li class="nav-item"><a href="#payroll" data-bs-toggle="pill" class="nav-link">Payroll</a></li>
                    }
                    @if (IsFieldActive("Leaves"))
                    {
                        <li class="nav-item"><a href="#leave" data-bs-toggle="pill" class="nav-link">Leaves</a></li>
                    }
                    <li class="nav-item"><a href="#attendance" data-bs-toggle="pill" class="nav-link">Attendance</a></li>
                    <li class="nav-item"><a href="#docs" data-bs-toggle="pill" class="nav-link">Documents</a></li>
                    <li class="nav-item"><a href="#timeline" data-bs-toggle="pill" class="nav-link">Timeline</a></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane active" id="profile">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <div>
                                    <ul class="list-group">
                                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Phone :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.MobileNo) ? "-" : Model.StaffViewModel.MobileNo)</li>
                                        @if (IsFieldActive("EmergencyContact"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Emergency Contact Number :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.EmergencyMobileNo) ? "-" : Model.StaffViewModel.EmergencyMobileNo)</li>
                                        }
                                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Email :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.Email) ? "-" : Model.StaffViewModel.Email)</li>
                                        @if (IsFieldActive("Gender"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Gender :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.Gender) ? "-" : Model.StaffViewModel.Gender)</li>
                                        }
                                        @if (IsFieldActive("DateOfBirth"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Date Of Birth :</span> @(Model.StaffViewModel.DOB?.ToString("dd MMM yyyy") ?? "-")</li>
                                        }
                                        @if (IsFieldActive("MaritalStatus"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Marital Status :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.MaritalStatus) ? "-" : Model.StaffViewModel.MaritalStatus)</li>
                                        }
                                        @if (IsFieldActive("FatherName"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Father Name :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.FatherName) ? "-" : Model.StaffViewModel.FatherName)</li>
                                        }
                                        @if (IsFieldActive("MotherName"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Mother Name :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.MotherName) ? "-" : Model.StaffViewModel.MotherName)</li>
                                        }
                                        @if (IsFieldActive("Qualification"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Qualification :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.Qualification) ? "-" : Model.StaffViewModel.Qualification)</li>
                                        }
                                        @if (IsFieldActive("WorkExperience"))
                                        {
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Work Experience :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.WorkExperience) ? "-" : Model.StaffViewModel.WorkExperience)</li>
                                        }
                                        <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Note :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.Note) ? "-" : Model.StaffViewModel.Note)</li>
                                    </ul>
                                </div>
                            </div>
                            @if (IsFieldActive("Address") || IsFieldActive("PermanentAddress"))
                            {
                                <div class="col-md-12 mb-3">
                                    <div>
                                        <ul class="list-group">
                                            <li class="list-group-item"><b>Address Details</b></li>
                                            @if (IsFieldActive("Address"))
                                            {
                                                <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Current Address :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.CurrentAddress) ? "-" : Model.StaffViewModel.CurrentAddress)</li>
                                            }
                                            @if (IsFieldActive("PermanentAddress"))
                                            {
                                                <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Permanent Address :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.PermanentAddress) ? "-" : Model.StaffViewModel.PermanentAddress)</li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (IsFieldActive("BankDetails"))
                            {
                                <div class="col-md-12 mb-3">
                                    <div>
                                        <ul class="list-group">
                                            <li class="list-group-item"><b>Bank Account Details</b></li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Account Title :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.AccountTitle) ? "-" : Model.StaffViewModel.AccountTitle)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Bank Name :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.BankName) ? "-" : Model.StaffViewModel.BankName)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Bank Branch Name :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.BankBranchName) ? "-" : Model.StaffViewModel.BankBranchName)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Bank Account Number :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.BankAccountNo) ? "-" : Model.StaffViewModel.BankAccountNo)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">IFSC Code :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.IFSCCode) ? "-" : Model.StaffViewModel.IFSCCode)</li>
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (IsFieldActive("SocialMedia"))
                            {
                                <div class="col-md-12">
                                    <div>
                                        <ul class="list-group">
                                            <li class="list-group-item"><b>Social Media Link</b></li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Facebook URL :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.FacebookURL) ? "-" : Model.StaffViewModel.FacebookURL)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Twitter URL :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.TwitterURL) ? "-" : Model.StaffViewModel.TwitterURL)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Linkedin URL :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.LinkedinURL) ? "-" : Model.StaffViewModel.LinkedinURL)</li>
                                            <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"><span class="text-dark">Instagram URL :</span> @(string.IsNullOrEmpty(Model.StaffViewModel.InstagramURL) ? "-" : Model.StaffViewModel.InstagramURL)</li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="tab-pane" id="payroll">
                        <div class="row">
                            <div class="col-xl-6 d-flex">
                                <div class="card shadow-sm flex-fill w-100 mb-3">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <p class="mb-2">Total Net Salary Paid</p>
                                                <div class="d-flex align-items-center gap-1">
                                                    <h5 class="fw-bold mb-0" id="pay_totalNet">0</h5>
                                                    <span class="badge fw-medium bg-success flex-shrink-0" id="pay_totalNetBadge">+0%</span>
                                                </div>
                                            </div>
                                            <span class="avatar border border-primary text-primary rounded-2 flex-shrink-0"><i class="ti ti-coin-rupee fs-20"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6 d-flex">
                                <div class="card shadow-sm flex-fill w-100 mb-3">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <p class="mb-2">Total Gross Salary</p>
                                                <div class="d-flex align-items-center gap-1">
                                                    <h5 class="fw-bold mb-0" id="pay_totalGross">0</h5>
                                                    <span class="badge fw-medium bg-success flex-shrink-0" id="pay_totalGrossBadge">+0%</span>
                                                </div>
                                            </div>
                                            <span class="avatar border border-primary text-primary rounded-2 flex-shrink-0"><i class="ti ti-coin-rupee-filled fs-20"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6 d-flex">
                                <div class="card shadow-sm flex-fill w-100">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <p class="mb-2">Total Earning</p>
                                                <div class="d-flex align-items-center gap-1">
                                                    <h5 class="fw-bold mb-0" id="pay_totalEarning">0</h5>
                                                    <span class="badge fw-medium bg-success flex-shrink-0" id="pay_totalEarningBadge">+0%</span>
                                                </div>
                                            </div>
                                            <span class="avatar border border-primary text-primary rounded-2 flex-shrink-0"><i class="ti ti-users fs-20"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6 d-flex">
                                <div class="card shadow-sm flex-fill w-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div>
                                                <p class="mb-2">Total Deduction</p>
                                                <div class="d-flex align-items-center gap-1">
                                                    <h5 class="fw-bold mb-0" id="pay_totalDeduction">0</h5>
                                                    <span class="badge fw-medium bg-success flex-shrink-0" id="pay_totalDeductionBadge">+0%</span>
                                                </div>
                                            </div>
                                            <span class="avatar border border-primary text-primary rounded-2 flex-shrink-0"><i class="ti ti-coin-rupee fs-20"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex align-items-center">
                                            <input type="text" class="form-control flex-fill me-3" placeholder="Search...">
                                            <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0">
                                                <button class="btn btn-icon btn-outline-primary" title="Copy" asp-permission="Export" asp-permission-url="/HumanResource/StaffDetails">
                                                    <i class="ti ti-copy fs-5"></i>
                                                </button>
                                                <button class="btn btn-icon btn-outline-secondary" title="Excel" asp-permission="Export" asp-permission-url="/HumanResource/StaffDetails">
                                                    <i class="ti ti-file-excel fs-5"></i>
                                                </button>
                                                <button class="btn btn-icon btn-outline-info" title="CSV" asp-permission="Export" asp-permission-url="/HumanResource/StaffDetails">
                                                    <i class="ti ti-file-barcode fs-5"></i>
                                                </button>
                                                <button class="btn btn-icon btn-outline-danger" title="Pdf" asp-permission="Export" asp-permission-url="/HumanResource/StaffDetails">
                                                    <i class="ti ti-file-type-pdf fs-5"></i>
                                                </button>
                                                <button class="btn btn-icon btn-outline-success" title="Print" asp-permission="Print" asp-permission-url="/HumanResource/StaffDetails">
                                                    <i class="ti ti-printer fs-5"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">

                                        <div class="table-responsive">
                                            <table class="table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Payslip #</th>
                                                        <th>Month-Year</th>
                                                        <th>Date</th>
                                                        <th>Mode</th>
                                                        <th>Status</th>
                                                        <th>Net Salary</th>
                                                        <th class="text-end">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="payrollTableBody">
                                                    <tr>
                                                        <td colspan="7" class="text-center text-danger">No Data Found</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>
                                    <!-- end card-body -->
                                </div>
                                <!-- end card -->
                            </div>

                        </div>
                    </div>
                    <div class="tab-pane" id="leave">
                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex align-items-center">
                                            <input type="text" id="leaveSearchInput" class="form-control flex-fill me-3" placeholder="Search...">
                                            <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0">
                                                <button type="button" id="btnLeaveCopy" class="btn btn-icon btn-outline-primary" title="Copy">
                                                    <i class="ti ti-copy fs-5"></i>
                                                </button>
                                                <button type="button" id="btnLeaveExcel" class="btn btn-icon btn-outline-secondary" title="Excel">
                                                    <i class="ti ti-file-excel fs-5"></i>
                                                </button>

                                                <button type="button" id="btnLeaveCsv" class="btn btn-icon btn-outline-info" title="CSV">
                                                    <i class="ti ti-file-barcode fs-5"></i>
                                                </button>
                                                <button type="button" id="btnLeavePdf" class="btn btn-icon btn-outline-danger" title="Pdf">
                                                    <i class="ti ti-file-type-pdf fs-5"></i>
                                                </button>
                                                <button type="button" id="btnLeavePrint" class="btn btn-icon btn-outline-success" title="Print">
                                                    <i class="ti ti-printer fs-5"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="leaveTableContainer"></div>

                                    <!-- end card-body -->
                                </div>
                                <!-- end card -->
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="attendance">
                        <div class="row">
                            <div class="col-xl-4">
                                <div class="card shadow-sm flex-fill w-100 mb-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="mb-0">Total Present</p>
                                        <h6 class="fw-bold mb-0 badge bg-primary rounded-pill" id="badgeTotalPresent">0</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="card shadow-sm flex-fill w-100 mb-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="mb-0">Total Late</p>
                                        <h6 class="fw-bold mb-0 badge bg-primary rounded-pill" id="badgeTotalLate">0</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="card shadow-sm flex-fill w-100 mb-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="mb-0">Total Absent</p>
                                        <h6 class="fw-bold mb-0 badge bg-primary rounded-pill" id="badgeTotalAbsent">0</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="card shadow-sm flex-fill w-100 mb-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="mb-0">Total Half Day</p>
                                        <h6 class="fw-bold mb-0 badge bg-primary rounded-pill" id="badgeTotalHalfDay">0</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-4">
                                <div class="card shadow-sm flex-fill w-100 mb-3 p-3">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <p class="mb-0">Total Holiday</p>
                                        <h6 class="fw-bold mb-0 badge bg-primary rounded-pill" id="badgeTotalHoliday">0</h6>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="d-flex align-items-center">
                                            <select id="ddlAttendanceYear" class="form-select form-control flex-fill me-3">
                                                <option value="">Select Year</option>
                                                <option value="2024">2024</option>
                                                <option value="2025">2025</option>
                                                <option value="2026">2026</option>
                                            </select>
                                            <div class="d-flex align-items-center flex-wrap gap-2 flex-shrink-0" id="attendanceFilterBtns">
                                                <button type="button" class="btn btn-icon status-filter-btn" data-status="1" title="Present" style="border:1.5px solid #4361ee; color:#4361ee;">P</button>
                                                <button type="button" class="btn btn-icon status-filter-btn" data-status="2" title="Late" style="border:1.5px solid #4cc9f0; color:#4cc9f0;">L</button>
                                                <button type="button" class="btn btn-icon status-filter-btn" data-status="3" title="Absent" style="border:1.5px solid #4895ef; color:#4895ef;">A</button>
                                                <button type="button" class="btn btn-icon status-filter-btn" data-status="4" title="Half Day" style="border:1.5px solid #f72585; color:#f72585;">F</button>
                                                <button type="button" class="btn btn-icon status-filter-btn" data-status="5" title="Holiday" style="border:1.5px solid #2ec4b6; color:#2ec4b6;">H</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body d-none">
                                        <div class="table-responsive">
                                            <table class="table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Date</th>
                                                        <th>Jan</th>
                                                        <th>Feb</th>
                                                        <th>March</th>
                                                        <th>April</th>
                                                        <th>May</th>
                                                        <th>June</th>
                                                        <th>July</th>
                                                        <th>Aug</th>
                                                        <th>Sept</th>
                                                        <th>Oct</th>
                                                        <th>Nov</th>
                                                        <th>Dec</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="attendanceGridBody">
                                                    <tr><td colspan="13" class="text-center text-danger">No Data Found</td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mini calendar panel (per third screenshot) -->
                            <div class="col-xl-12 mt-3">
                                <div class="card p-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <button type="button" class="btn btn-icon btn-sm" id="btnPrevMonth"><i class="ti ti-chevron-left"></i></button>
                                        <h6 class="fw-bold mb-0" id="calMonthLabel">July 2026</h6>
                                        <button type="button" class="btn btn-icon btn-sm" id="btnNextMonth"><i class="ti ti-chevron-right"></i></button>
                                    </div>
                                    <table class="table table-borderless text-center mb-0" id="calGrid">
                                        <thead>
                                            <tr>
                                                <th>Su</th>
                                                <th>Mo</th>
                                                <th>Tu</th>
                                                <th>We</th>
                                                <th>Th</th>
                                                <th>Fr</th>
                                                <th>Sa</th>
                                            </tr>
                                        </thead>
                                        <tbody id="calGridBody"></tbody>
                                    </table>
                                    <div id="calSelectedDayInfo" class="text-center text-muted small mt-2"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="docs">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrEmpty(Model.StaffViewModel.ResumeDocName))
                            {
                                <a href="@Url.Action("DownloadStaffDocument", new { id = Model.StaffViewModel.StaffID, type = "Resume" })" class="btn btn-outline-primary d-inline-flex align-items-center">
                                    <i class="ti ti-file-text me-2 fs-5"></i>
                                    <span>Resume</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.StaffViewModel.JoiningLetterDocName))
                            {
                                <a href="@Url.Action("DownloadStaffDocument", new { id = Model.StaffViewModel.StaffID, type = "JoiningLetter" })" class="btn btn-outline-info d-inline-flex align-items-center">
                                    <i class="ti ti-mail-opened me-2 fs-5"></i>
                                    <span>Joining Letter</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.StaffViewModel.ResignationLetterDocName))
                            {
                                <a href="@Url.Action("DownloadStaffDocument", new { id = Model.StaffViewModel.StaffID, type = "ResignationLetter" })" class="btn btn-outline-danger d-inline-flex align-items-center">
                                    <i class="ti ti-file-off me-2 fs-5"></i>
                                    <span>Resignation Letter</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(Model.StaffViewModel.OtherDocName))
                            {
                                <a href="@Url.Action("DownloadStaffDocument", new { id = Model.StaffViewModel.StaffID, type = "Other" })" class="btn btn-outline-secondary d-inline-flex align-items-center">
                                    <i class="ti ti-files me-2 fs-5"></i>
                                    <span>Other Documents</span>
                                </a>
                            }
                        </div>

                        @if (string.IsNullOrEmpty(Model.StaffViewModel.ResumeDocName) && string.IsNullOrEmpty(Model.StaffViewModel.JoiningLetterDocName) && string.IsNullOrEmpty(Model.StaffViewModel.ResignationLetterDocName) && string.IsNullOrEmpty(Model.StaffViewModel.OtherDocName))
                        {
                            <div class="text-center py-5">
                                <i class="ti ti-file-x text-muted fs-1 mb-3"></i>
                                <h6 class="text-muted">No documents have been uploaded for this staff member.</h6>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-soft-primary d-flex align-items-center" role="alert">
                                <i class="ti ti-info-circle me-2 fs-5"></i>
                                <div>Click on the buttons above to download the respective documents.</div>
                            </div>
                        }
                    </div>
                    <div class="tab-pane" id="timeline">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h5 class="fw-bold mb-0">Staff Timeline</h5>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (p.CanAdd)
                                        {
                                            <a href="/HumanResource/AddStaffTimeline?id=0&staffId=@Model.StaffViewModel?.StaffID" class="btn btn-primary btn-sm d-inline-flex align-items-center">
                                                <i class="ti ti-plus me-1"></i> Add
                                            </a>
                                        }

                                    </div>
                                </div>
                                <div id="timelineContainer">
                                    @await Html.PartialAsync("_StaffTimelinePartial", Model)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- end col -->
</div>
<!-- end row -->
<!-- Timeline Modal -->
<div class="modal fade" id="timelineModal" tabindex="-1" aria-labelledby="timelineModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="timelineModalTitle">Add Timeline</h5>
                <div>
                    <button type="button" class="btn btn-success btn-sm" onclick="saveTimeline()">
                        <i class="ti ti-device-floppy me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i> Close
                    </button>
                </div>
            </div>
            <form id="timelineForm" class="needs-validation" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="hdnTimelineID" value="0" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input type="text" id="txtTimelineTitle" class="form-control" placeholder="Enter title" required />
                            <div class="invalid-feedback">Please enter a title.</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                            <input type="date" id="txtTimelineDate" class="form-control" required />
                            <div class="invalid-feedback">Please select a date.</div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea id="txtTimelineDescription" class="form-control" rows="3" placeholder="Enter description"></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Attach Document</label>
                            <input type="file" id="fileTimelineDoc" class="form-control" />
                            <small class="text-muted">Max size 2MB (PDF, JPG, PNG)</small>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkTimelineVisible" checked />
                                <label class="form-check-label fw-semibold" for="chkTimelineVisible">
                                    Visible to this person
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

