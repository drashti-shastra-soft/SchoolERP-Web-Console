<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <h5 class="modal-title fw-bold" id="changePasswordModalTitle">Change Password</h5>
                <div>
                    <button type="button" class="btn btn-success btn-sm" onclick="saveChangePassword()">
                        <i class="ti ti-device-floppy me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                        <i class="ti ti-x me-1"></i> Close
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div id="changePasswordError" class="alert alert-danger d-none py-2 px-3 mb-3 small" role="alert"></div>
                <form id="changePasswordForm" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input type="password" id="txtNewPassword" class="form-control" placeholder="Enter new password" required minlength="6" />
                        <div class="invalid-feedback">Please enter a new password (min. 6 characters).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                        <input type="password" id="txtConfirmPassword" class="form-control" placeholder="Confirm new password" required />
                        <div class="invalid-feedback">Passwords must match.</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Staff Sidebar Offcanvas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasStaff" aria-labelledby="offcanvasStaffLabel">
    <div class="offcanvas-header border-bottom py-2">
        <h6 class="offcanvas-title fw-bold" id="offcanvasStaffLabel">Staff Directory</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="p-2 border-bottom bg-light">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0"><i class="ti ti-search"></i></span>
                <input type="text" id="txtSidebarSearch" class="form-control border-start-0" placeholder="Search staff..." onkeyup="filterSidebarStaff()">
            </div>
        </div>
        <div id="sidebarStaffList" class="list-group list-group-flush" style="max-height: calc(100vh - 120px); overflow-y: auto;">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        window.StaffID =@JsonSerializer.Serialize(Model.StaffViewModel.StaffID)

    </script>
    <script src="~/assets/js/StaffDetails.js"></script>
}
