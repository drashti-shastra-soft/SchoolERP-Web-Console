@model SchoolERPWebConsole.Domain.HRLeaveTypeAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Add Leave Type";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions ?? new PagePermissions();
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditItems == null ? "Add Leave Type" : "Edit Leave Type")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveRecord()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }


        <a href="/HumanResource/LeaveType" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="entryForm">
                    <input type="hidden" id="hdnLeaveTypeID" value="@(Model.EditItems?.LeaveTypeID ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditItems?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditItems?.SessionID ?? 0)">
                    <div class="row row-gap-3">

                        

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Leave Type <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.EditItems?.LeaveTypeName" id="txtLeaveTypeField" maxlength="20" placeholder="e.g. Casual, Sick" autocomplete="off">
                            <span id="leaveTypeFieldError" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Leave Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.EditItems?.LeaveCode" id="txtLeaveCode" maxlength="20" placeholder="e.g. CL, SL, EL" autocomplete="off">
                            <span id="leaveCodeError" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Display Label </label>
                            <input type="text" class="form-control" value="@Model.EditItems?.DisplayLabel" id="txtDisplayLabel" maxlength="10">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold d-block">Leave Frequency <span class="text-danger">*</span></label>
                            <div class="d-flex gap-4 mt-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="leaveFrequency" id="radMonthly" value="Monthly"
                                    @((Model.EditItems?.LeaveType == "Monthly") ? "checked" : "")>
                                    <label class="form-check-label" for="radMonthly">Monthly</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="leaveFrequency" id="radYearly" value="Yearly"
                                    @((Model.EditItems?.LeaveType == "Yearly") ? "checked" : "")>
                                    <label class="form-check-label" for="radYearly">Yearly</label>
                                </div>
                            </div>
                            <span id="leaveFrequencyError" class="text-danger d-block"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">From Month <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlFromMonth">
                                <option value="">Select Month</option>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                                    <option value="@m" selected="@(Model.EditItems?.FromMonth == m)">@monthName</option>
                                }
                            </select>
                            <span id="fromMonthError" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">To Month <span class="text-danger">*</span></label>
                            <select class="form-select" id="ddlToMonth">
                                <option value="">Select Month</option>
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                                    <option value="@m" selected="@(Model.EditItems?.ToMonth == m)">@monthName</option>
                                }
                            </select>
                            <span id="toMonthError" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Max Leave Per Month <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" value="@Model.EditItems?.MaxLeavePerMonth" id="txtMaxLeavePerMonth" step="0.01" min="0" max="999.99" placeholder="e.g. 1.5">
                            <span id="maxLeaveError" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkIsPaid" @((Model.EditItems?.IsPaid ?? false) ? "checked" : "")>
                                <label class="form-check-label" for="chkIsPaid">Paid Leave</label>
                            </div>
                        </div>                        
                        <div class="col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkActive" @((Model.EditItems?.IsActive ?? true) ? "checked" : "")>
                                <label class="form-check-label" for="chkActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
                  window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
                        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
                        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    <script src="~/assets/js/LeaveType.js"> </script>
}