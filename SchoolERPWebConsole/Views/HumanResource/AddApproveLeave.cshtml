@model SchoolERPWebConsole.Domain.HRApplyLeavePageViewModel
@using SchoolERPWebConsole.Helpers
@using System.Text.Json
@{
    ViewData["Title"] = "Add Approve Leave";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions ?? new PagePermissions();
    var edit = Model.EditApproveLeave;
    bool isEditMode = edit != null;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEditMode ? "Edit Approve Leave" : "Add Approve Leave")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveLeave()"><i class="ti ti-device-floppy me-1"></i> Save</button>
        }

        <a href="/HumanResource/ApproveLeave" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="applyForm" class="needs-validation" novalidate>
                    <div class="modal-body p-4">
                        <div id="divError" class="alert alert-danger d-none mb-3" role="alert">
                            <i class="ti ti-alert-triangle me-2"></i>
                            <span id="spnErrorMessage"></span>
                        </div>
                        <input type="hidden" id="hdnApplyLeaveID" value="@(edit?.ApplyLeaveID ?? 0)" />
                        <input type="hidden" id="hdnStaffID" value="@(edit?.StaffID ?? 0)" />
                        <input type="hidden" id="hdnLeaveTypeID" value="@(edit?.LeaveTypeID ?? 0)" />
                        <input type="hidden" id="hdnCompanyID" value="@(edit?.CompanyID ?? 0)">
                        <input type="hidden" id="hdnSessionID" value="@(edit?.SessionID ?? 0)">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Staff <span class="text-danger">*</span></label>
                                <select id="ddlStaff" class="form-select select2" required onchange="loadLeaveBalance()">
                                    <option value="">Select Staff</option>
                                    @foreach (var s in Model.StaffList)
                                    {
                                        <option value="@s.StaffID" selected="@(edit != null && edit.StaffID == s.StaffID)">
                                            @s.FirstName @s.LastName (@s.StaffCode)
                                        </option>
                                    }
                                </select>
                                <div class="invalid-feedback">Please select a staff member.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Leave Type <span class="text-danger">*</span></label>
                                <select id="ddlLeaveType" class="form-select select2" required onchange="loadLeaveBalance()">
                                    <option value="">Select Type</option>
                                    @foreach (var lt in Model.LeaveTypes)
                                    {
                                        <option value="@lt.LeaveTypeID" selected="@(edit != null && edit.LeaveTypeID == lt.LeaveTypeID)">
                                            @lt.LeaveTypeName
                                        </option>
                                    }
                                </select>
                                <div class="invalid-feedback">Please select a leave type.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">From Date <span class="text-danger">*</span></label>
                                <input type="date" id="txtFromDate" class="form-control" required onchange="clearError()"
                                       value="@(edit != null ? edit.FromDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" />
                                <div class="invalid-feedback">Required.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">To Date <span class="text-danger">*</span></label>
                                <input type="date" id="txtToDate" class="form-control" required onchange="clearError()"
                                       value="@(edit != null ? edit.ToDate.ToString("yyyy-MM-dd") : DateTime.Today.ToString("yyyy-MM-dd"))" />
                                <div class="invalid-feedback">Required.</div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Reason</label>
                                <textarea id="txtReason" class="form-control" rows="2" placeholder="Enter reason for leave...">@(edit?.Reason)</textarea>
                            </div>
                            <div class="col-md-6" id="divStatus">
                                <label class="form-label fw-semibold">Status <span class="text-danger">*</span></label>
                                <select id="ddlStatus" class="form-select">
                                    <option value="Pending" selected="@(edit == null || edit.Status == "Pending")">Pending</option>
                                    <option value="Approved" selected="@(edit != null && edit.Status == "Approved")">Approved</option>
                                    <option value="Disapproved" selected="@(edit != null && edit.Status == "Disapproved")">Disapproved</option>
                                </select>
                            </div>
                            <div class="col-md-6" id="divAttachment">
                                <label class="form-label fw-semibold">Attachment</label>
                                <input type="file" id="fileAttachment" class="form-control" />
                                @if (isEditMode && !string.IsNullOrEmpty(edit?.AttachmentDocName))
                                {
                                    <div class="mt-1">
                                        <a id="lnkAttachment" href="/HumanResource/DownloadApplyLeaveDocument/@edit.ApplyLeaveID" target="_blank" class="btn btn-sm btn-outline-info">
                                            <i class="ti ti-download me-1"></i>View Current Attachment
                                        </a>
                                    </div>
                                }
                            </div>
                            <div class="col-md-12" id="divAdminNote">
                                <label class="form-label fw-semibold">Admin Remarks</label>
                                <textarea id="txtAdminNote" class="form-control" rows="2" placeholder="Admin remarks...">@(edit?.Note)</textarea>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 d-none">
                        <button type="button" class="btn btn-secondary shadow-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary px-4 shadow-sm" onclick="saveLeave()">
                            <i class="ti ti-device-floppy me-1"></i>Save Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/StaffApproveLeave.js"></script>
    @if (isEditMode)
    {
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    $('#ddlStaff').trigger('change');
                    $('#ddlLeaveType').trigger('change');
                }, 0);
            });
        </script>
    }
}