@using System.Security.Claims
@model SchoolERPWebConsole.Domain.AddStaffTimelineTimelineViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Add Staff Timeline ";
    var p = Model.Permissions;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditStaffTimeline == null ? "Add Staff Timeline " : "Edit Staff Timeline ")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveTimeline()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/HumanResource/StaffDetails/@Model.StaffID" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-header">
            </div>
            <div class="card-body">
                <form id="timelineForm">
                    <div class="modal-body">
                        <input type="hidden" id="hdnTimelineID" value="@Model.EditStaffTimeline?.TimelineID" />
                        <input type="hidden" id="hdnStudentID" value="@Model.StaffID" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                                <input type="text" id="txtTimelineTitle" value="@Model.EditStaffTimeline?.TimelineTitle" class="form-control" placeholder="Enter title">
                                <div id="errTimelineTitle" class="field-error text-danger small mt-1"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                                <input type="date" id="txtTimelineDate" class="form-control"
                                       value="@(Model.EditStaffTimeline?.TimelineDate.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                                       max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                <div id="errTimelineDate" class="field-error text-danger small mt-1"></div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea id="txtTimelineDescription" class="form-control" rows="3" placeholder="Enter description">@Model.EditStaffTimeline?.TimelineDescription</textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold">Attach Document</label>
                                <input type="file" id="fileTimelineDoc" class="form-control">
                                <small class="text-muted" id="fileTimelineInfo">Max size 2MB (PDF, JPG, PNG)</small>

                                @if (!string.IsNullOrEmpty(Model.EditStaffTimeline?.TimelineAttachDoc))
                                {
                                    <div id="existingTimelineFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                        <a href="@Model.EditStaffTimeline?.TimelineAttachDoc" target="_blank" class="small">
                                            <i class="ti ti-paperclip me-1"></i>@Model.EditStaffTimeline?.TimelineAttachDocName
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingTimelineFile()">
                                            <i class="ti ti-x"></i>
                                        </button>
                                    </div>
                                }
                                <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                                <input type="hidden" id="hdnExistingTimelineFile" value="@Model.EditStaffTimeline?.TimelineAttachDocName">
                                <input type="hidden" id="hdnRemoveTimelineFile" value="false">
                            </div>
                            <div class="col-md-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkTimelineVisible"
                                    @(Model.EditStaffTimeline?.TimelineVisible ?? true ? "checked" : "")>
                                    <label class="form-check-label fw-semibold" for="chkTimelineVisible">
                                        Visible to this person
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .field-error {
        display: none;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }
</style>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.StaffID =@JsonSerializer.Serialize(Model.StaffID)
    </script>
    <script src="~/assets/js/StaffDetails.js"></script>
}