                    <div>
                        <p class="mb-2">Students</p>
                        <div class="d-flex align-items-center gap-1">
                            <h5 class="fw-bold mb-0">28</h5>
                        </div>
                    </div>
                    <span class="avatar border border-primary text-primary rounded-2 flex-shrink-0">
                        <i class="ti ti-users fs-20"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

