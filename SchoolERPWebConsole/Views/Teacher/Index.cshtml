                    </div> -->
                    <p class="mb-1">0/28</p>
                </div>
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <!-- <p class="mb-1">0/0</p> -->
                        <h6 class="fs-14 mb-0">Student Present Today</h6>
                    </div>
                    <!-- <div>
                        <div id="s-col" class="chart-set"></div>
                    </div> -->
                </div>
            </div>
        </div>
    </div>

    <!-- end col -->
</div>
<!-- end row -->
<!-- start row -->
<div class="row">
    <div class="col-md-3">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-header">
                <h6 class="mb-0 small fs-14">Student Today Attendance</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <p class="mb-1">Present</p>
                    <div class="progress" style="height: 7px;">
                        <div class="progress-bar" style="width: 100%;"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <p class="mb-1">Late</p>
                    <div class="progress" style="height: 7px;">
                        <div class="progress-bar"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <p class="mb-1">Absent</p>
                    <div class="progress" style="height: 7px;">
                        <div class="progress-bar"></div>
                    </div>
                </div>
                <div class="mb-2">
                    <p class="mb-1">Half Day</p>
                    <div class="progress" style="height: 7px;">
                        <div class="progress-bar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end row -->
<!-- start row -->
<div class="row">
    <div class="col-xl-3 d-flex">
        <div class="card shadow-tbl-outer mb-2 flex-fill w-100">
