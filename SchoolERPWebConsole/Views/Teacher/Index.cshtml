    </div> -->
</div>
<!-- End Page Header -->

<div class="alert alert-info alert-dismissible fade show mb-2 border" role="alert">
    <a href="notice-board.html" class="text-primary">Study Parents</a>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

<!-- start row -->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="position-relative border card rounded-2 overflow-hidden shadow-sm mb-2">
            <img src="~/assets/img/bg/bg-04.svg" alt="img" class="position-absolute start-0 top-0">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2 justify-content-between mb-3">
                    <span class="avatar bg-success rounded-circle">
                        <i class="ti ti-calendar-week fs-24"></i>
                    </span>
                    <!-- <div class="text-end">
                        <span class="badge px-2 py-1 fs-12 fw-medium d-inline-flex mb-1 bg-success">+95%</span>
