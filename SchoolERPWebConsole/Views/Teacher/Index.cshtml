
@using SchoolERPWebConsole.Services
@using System.Security.Claims
@inject ILocalizationService Localizer;
@{
    ViewData["Title"] = Localizer.GetString("dashboard");
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Teacher Dashboard @User.Identity.Name</h6>
    </div>
