@model SchoolERPWebConsole.Domain.AccountEntryAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Income";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    var edit = Model.EditItems;
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(edit == null ? "Add Income Head" : "Edit Income Head")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/ComplaintType/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<form id="callLogForm">

    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <div id="entryFormNotice"></div>
                    <form id="entryForm" novalidate>
                        <input type="hidden" id="hdnEntryType" value="Income">
                        <input type="hidden" id="hdnAccountEntryID" name="accountEntryID" value="@edit?.AccountEntryID">
                        <input type="hidden" id="hdnCompanyID" value="@edit?.CompanyID">
                        <input type="hidden" id="hdnSessionID" value="@edit?.SessionID">
                        <input type="hidden" id="hdnAttachDocName" value="@edit?.AttachDocName">
                        <input type="hidden" id="hdnAttachDocType" value="@edit?.AttachDocType">
                        <div class="row row-gap-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Income Head <span class="text-danger">*</span></label>
                                <select class="form-select select2" id="ddlAccountHead" required>
                                    <option value="">-- Select --</option>
                                    @foreach (var head in Model.Heads)
                                    {
                                        <option value="@head.AccountHeadID" selected=@(edit != null && head.AccountHeadID == edit.AccountHeadID ? "selected" : "")>@head.HeadName</option>
                                    }
                                </select>
                                <div class="invalid-feedback" id="errDdlAccountHead">Please select an income head.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtName" value="@edit?.Name" required>
                                <div class="invalid-feedback" id="errTxtName">Please enter a name.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Invoice No</label>
                                <input type="text" class="form-control" id="txtInvoiceNo" value="@edit?.InvoiceNo">
                                <div class="invalid-feedback" id="errTxtInvoiceNo"></div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="txtDate" required
                                       value="@((edit?.Date ?? DateTime.Today).ToString("yyyy-MM-dd"))">
                                <div class="invalid-feedback" id="errTxtDate">Please select a date.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Amount <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0.01" class="form-control" id="txtAmount"
                                       value="@(edit != null ? edit.Amount.ToString("0.00") : "")" required>
                                <div class="invalid-feedback" id="errTxtAmount">Please enter a valid amount.</div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Description</label>
                                <textarea class="form-control" id="txtDescription" rows="2">@edit?.Description</textarea>
                                <div class="invalid-feedback" id="errTxtDescription"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Attachment</label>
                                <input type="file" class="form-control" id="attachmentFile" name="fileAttachment">
                                <small class="text-muted" id="fileInfo"></small>

                                @if (!string.IsNullOrEmpty(edit?.AttachDocName))
                                {
                                    <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                        <a href="@edit.AttachDoc" target="_blank" class="small">
                                            <i class="ti ti-paperclip me-1"></i>@edit.AttachDocName
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                            <i class="ti ti-x"></i>
                                        </button>
                                    </div>
                                }
                                <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                                <input type="hidden" id="hdnExistingFile" name="ExistingFileName" value="@edit?.AttachDocName">
                                <input type="hidden" id="hdnRemoveFile" name="RemoveAttachment" value="false">
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mt-4">
                                    <input class="form-check-input" type="checkbox" id="chkActive" @(edit == null || edit.IsActive ? "checked" : "")>
                                    <label class="form-check-label" for="chkActive">Active</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/AccountIncomeEntry.js"></script>
}
