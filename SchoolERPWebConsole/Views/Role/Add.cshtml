@model SchoolERPWebConsole.Domain.RoleAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Role";
    var p = Model.Permissions;
    var roleId = Model.EditRole?.RoleID ?? 0;
}
<link rel="stylesheet" href="~/css/treeview.css" />
<style>
    .role-form-panel {
        border-right: 1px solid #dee2e6;
        min-width: 300px;
        max-width: 340px;
        display: flex;
        flex-direction: column;
    }

    .perm-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .role-edit-split {
        display: flex;
        min-height: 70vh;
    }

    .perm-tree-scroll {
        flex: 1;
        overflow-y: auto;
        max-height: 65vh;
    }

    .perm-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .panel-section-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6c757d;
        margin-bottom: 0.5rem;
        padding-bottom: 0.3rem;
        border-bottom: 1px solid #dee2e6;
    }

    th.matrix-col.w-s-nowrap {
        text-align: center;
    }

    .tree-row.depth-0 {
        background-color: #f8f9fc;
    }

        .tree-row.depth-0 .tree-label {
            font-weight: 500;
            color: #32325d;
        }

    .dt-buttons {
        display: none !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(roleId == 0 ? "Add Role" : "Edit Role")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" id="btnSaveAll" onclick="saveAll()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Role/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body p-0">
                <form id="itemForm" class="role-edit-split">
                    <!-- ── LEFT: Role Details Panel ── -->
                    <div class="role-form-panel p-3">
                        <input type="hidden" id="txtRoleId" value="@roleId">
                        <div class="mb-3">
                            <label class="form-label small">Role Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtRoleName"
                                   placeholder="e.g. SuperAdmin" value="@Model.EditRole?.RoleName" required>
                            <div class="invalid-feedback" id="errTxtRoleName"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small">Description</label>
                            <textarea class="form-control" id="txtRoleDesc" rows="4"
                                      placeholder="Explain the role's scope...">@Model.EditRole?.RoleName</textarea>
                        </div>

                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="chkIsActive" @(Model.EditRole?.IsActive ?? true ? "checked" : "")>
                            <label class="form-check-label fw-semibold small" for="chkIsActive">Active</label>
                        </div>

                        <div id="roleSaveStatus" class="d-none mt-3">
                            <div class="alert alert-success py-2 px-3 small mb-0" id="roleSaveOk">
                                <i class="fas fa-check-circle me-1"></i><span id="roleSaveOkMsg">Role saved.</span>
                            </div>
                            <div class="alert alert-danger py-2 px-3 small mb-0 d-none" id="roleSaveErr">
                                <i class="fas fa-exclamation-circle me-1"></i><span id="roleSaveErrMsg"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ── RIGHT: Permissions Panel ── -->
                    <div class="perm-panel">
                        <div class="perm-tree-scroll p-3">
                            <div class="tree-grid-container">
                                <table class="tree-grid">
                                    <thead>
                                        <tr id="treeHeaderRow">
                                            <th class="id-column">ID</th>
                                            <th>Menu Name</th>
                                            @* Dynamic permission columns injected by JS *@
                                        </tr>
                                    </thead>
                                    <tbody id="treeGridBody">
                                        <tr>
                                            <td colspan="10" class="text-center py-5 text-muted">
                                                <i class="fas fa-spinner fa-spin fa-lg me-2"></i>Loading permissions...
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div id="permSaveStatus" class="d-none px-3 py-2 border-top small">
                            <span class="text-success d-none" id="permSaveOk"><i class="fas fa-check-circle me-1"></i>Permissions saved.</span>
                            <span class="text-danger d-none" id="permSaveErr"><i class="fas fa-exclamation-circle me-1"></i><span id="permSaveErrMsg"></span></span>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/Role.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', initRoleForm);
    </script>
}