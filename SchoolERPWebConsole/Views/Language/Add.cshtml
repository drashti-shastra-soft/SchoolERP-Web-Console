@model SchoolERPWebConsole.Domain.LanguageAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Language";
    var p = Model.Permissions;

}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditLanguages == null ? "Add Languages" : "Edit Languages")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="button" onclick="saveItem()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Language/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>


    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <form id="itemForm">
                        <input type="hidden" id="txtItemId" value="@Model.EditLanguages?.LanguageId">
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label fw-semibold">Language Title</label>
                                <input type="text" class="form-control" value="@Model.EditLanguages?.LanguageTitle" id="txtLanguageTitle" placeholder="e.g. English" autocomplete="off">
                                <div class="invalid-feedback" id="errTxtLanguageTitle"></div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Language Code</label>
                                <input type="text" class="form-control" value="@Model.EditLanguages?.LanguageCode" id="txtLanguageCode" placeholder="e.g. en-US" autocomplete="off">
                                <div class="invalid-feedback" id="errTxtLanguageCode"></div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Language Icon</label>
                                <input type="text" class="form-control" value="@Model.EditLanguages?.LanguageIcon" id="txtLanguageIcon" placeholder="e.g. 🇺🇸" autocomplete="off">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" value="@Model.EditLanguages?.LanguageIsRtl" type="checkbox" id="chkLanguageIsRtl">
                                    <label class="form-check-label fw-bold" for="chkLanguageIsRtl">RTL</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" @(Model.EditLanguages?.LanguageBase ?? true ? "checked" : "") type="checkbox" id="chkLanguageBase">
                                    <label class="form-check-label fw-bold" for="chkLanguageBase">Base</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="chkIsActive" @(Model.EditLanguages?.IsActive ?? true ? "checked" : "")>
                                    <label class="form-check-label fw-bold" for="chkIsActive">Active</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-text mt-2 text-info">
                            <i class="fas fa-info-circle me-1"></i>Setting a language as <strong>Base</strong> will unset existing base language.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/Language.js"></script>
}
