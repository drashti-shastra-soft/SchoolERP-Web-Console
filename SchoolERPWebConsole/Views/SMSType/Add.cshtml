@model SchoolERPWebConsole.Domain.SMSTypeAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "SMS Type";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditSMSType == null ? "Add SMS Type" : "Edit SMS Type")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <button type="button" onclick="resetForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>
        <a href="/SMSType/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form id="accountHeadForm">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>SMS Type</strong>
                </div>
                <div class="card-body">
                    <input type="hidden" id="recordId" value="@Model.EditSMSType?.SMSTypeId">

                    <div class="row row-gap-3">

                        <!-- Account Name -->
                        <div class="col-md-4">
                            <label class="form-label">SMS Type <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="txtPaymentType"
                                   value="@Model.EditSMSType?.SMSType" placeholder="Enter payment type name">
                            <div class="text-danger small mt-1 d-none" id="nameError">Payment name is required.</div>
                        </div>

                        <!-- Account No -->
                        <div class="col-md-4">
                            <label class="form-label">Website Url:</label>
                            <input type="text" class="form-control" id="txtWebsiteUrl"
                                   value="@Model.EditSMSType?.WebsiteUrl" placeholder="https:example.com">
                        </div>

                        <!-- Display Order -->
                        <div class="col-md-4">
                            <label class="form-label">Display Order:</label>
                            <input type="text" class="form-control" id="txtDisplayOrder"
                                   value="@Model.EditSMSType?.DisplayOrder">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Attachment</label>
                            <input type="file" class="form-control" id="attachmentFile" name="fileAttachment">
                            <small class="text-muted" id="fileInfo"></small>

                            @if (!string.IsNullOrEmpty(@Model.EditSMSType?.LogoUrl))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@Model.EditSMSType?.LogoUrl" target="_blank" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@Model.EditSMSType?.LogoUrl
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                            <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                            <input type="hidden" id="hdnExistingFile" name="ExistingFileName" value="@Model.EditSMSType?.LogoUrl">
                            <input type="hidden" id="hdnRemoveFile" name="RemoveAttachment" value="false">
                        </div>
                        <!-- Active -->
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditSMSType?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/assets/js/SMSType.js"></script>
}
