@model SchoolERPWebConsole.Domain.BankClearingAddViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bank Clearing";
    var p = Model.Permissions;
}
<style>
    .bank-clearing-filter-row {
        row-gap: 1rem;
    }

    .cheques-filter-panel {
        border: 1px solid #dee2e6;
        border-radius: 6px;
        overflow: hidden;
        min-width: 480px;
    }

    .cheques-filter-header {
        background-color: #2b3990; /* matches the blue bar in the screenshot */
        color: #fff;
        font-weight: 600;
        padding: 8px 14px;
    }

    .cheques-filter-body {
        padding: 12px 14px;
        background-color: #fff;
    }

    .bank-clearing-filter-row .form-check-input {
        width: 1.1em;
        height: 1.1em;
    }

        .bank-clearing-filter-row .form-check-input:checked {
            background-color: #2b3990;
            border-color: #2b3990;
        }
</style>
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div><h6 class="fw-bold mb-0">Bank Clearing</h6></div>

    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-outline-secondary top-btn" onclick="enableEditMode()">
                <i class="ti ti-edit me-1"></i>Edit
            </button>
            <button id="btnSave" class="btn btn-success top-btn" disabled onclick="saveClearing()">
                <i class="ti ti-device-floppy me-1"></i>Save
            </button>
        }
        <button id="btnReset" class="btn btn-dark top-btn" onclick="resetAllFilters()">
            <i class="ti ti-refresh me-1"></i>Reset
        </button>
    </div>
</div>

<div id="clearingPageNotice"></div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-tbl-outer mb-2">
    <div class="card-header bg-primary text-white py-2"><strong>Bank Clearing</strong></div>

    <div class="card-body">
        <form method="get" id="frmClearingFilter">
            <div class="d-flex flex-wrap align-items-end gap-4 bank-clearing-filter-row">

                <!-- Cleared / UnCleared -->
                <div class="d-flex align-items-center gap-3 pb-2">
                    <div class="form-check d-flex align-items-center gap-1 mb-0">
                        <input class="form-check-input mt-0" type="radio" name="Cleared" id="rdCleared" value="true" @(Model.Cleared ? "checked" : "")>
                        <label class="form-check-label mb-0" for="rdCleared">Cleared</label>
                    </div>
                    <div class="form-check d-flex align-items-center gap-1 mb-0">
                        <input class="form-check-input mt-0" type="radio" name="Cleared" id="rdUnCleared" value="false" @(!Model.Cleared ? "checked" : "")>
                        <label class="form-check-label mb-0" for="rdUnCleared">UnCleared</label>
                    </div>
                </div>

                <!-- Bank -->
                <div style="min-width:260px;">
                    <label class="form-label mb-1">Bank <span class="text-danger">*</span></label>
                    <select class="form-select select2" id="ddlClearingBank" name="BankFieldValue" style="width:100%;">
                        <option value="0">Select</option>
                        @foreach (var b in Model.Banks)
                        {
                            <option value="@b.Id" selected="@(Model.BankFieldValue == b.Id)">@b.Name</option>
                        }
                    </select>
                    <div class="text-danger small mt-1 d-none" id="errClearingBank">Please select a bank.</div>
                </div>

                <!-- Cheques panel -->
                <div class="cheques-filter-panel">
                    <div class="cheques-filter-header">Cheques</div>
                    <div class="cheques-filter-body d-flex align-items-end gap-3">
                        <div>
                            <label class="form-label mb-1">Date From:</label>
                            <input type="date" class="form-control form-control-sm" id="txtClearingDateFrom" name="DateFrom"
                                   value="@Model.DateFrom?.ToString("yyyy-MM-dd")">
                        </div>
                        <div>
                            <label class="form-label mb-1">Date To:</label>
                            <input type="date" class="form-control form-control-sm" id="txtClearingDateTo" name="DateTo"
                                   value="@Model.DateTo?.ToString("yyyy-MM-dd")">
                        </div>
                        <div>
                            <button type="button" class="btn btn-primary btn-sm px-3" onclick="searchClearingList()">
                                <i class="ti ti-search me-1"></i> Search
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>
<div id="ClearingTableContainer">
    @await Html.PartialAsync("_AccountBankClearingTablePartial", Model)
</div>

@section Scripts {
    <script>
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
    </script>
    <script src="~/assets/js/BankClearing.js"></script>
}