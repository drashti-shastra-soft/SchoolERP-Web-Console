@model SchoolERPWebConsole.Domain.VoucherHeaderAddViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Voucher Header";
    var p = Model.Permissions;
    var o = Model.EditVoucherHeader?.Header;
    var d = Model.EditVoucherHeader?.Details;
    var dv = Model.EditVoucherHeader?.DetailValues;
}
<style>
   .table > :not(caption) > .table-secondary > * {
    background-color: none;
    border-color: rgb(var(--secondary-rgb), 0.1);
    color: #fff;
}
</style>
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(o == null || o.VoucherHeaderID == 0 ? "Add Voucher" : "Edit Voucher")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" onclick="saveVoucher()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }

        <button type="button" onclick="resetVoucherForm()" class="btn btn-dark top-btn">
            <i class="ti ti-refresh me-1"></i> Reset
        </button>

        <a href="/VoucherHeader/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div id="voucherHeaderPageNotice"></div>

<form id="voucherHeaderForm">
    <input type="hidden"
           id="recordId"
           value="@(o?.VoucherHeaderID ?? 0)" />

    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-header bg-primary text-white py-2">
                    <strong>Voucher Header</strong>
                </div>

                <div class="card-body">
                    <div class="row row-gap-3">

                        <div class="col-md-4">
                            <label class="form-label">
                                Voucher Type <span class="text-danger">*</span>
                            </label>

                            <select class="form-select select2"
                                    id="ddlVoucherType"
                                    style="width:100%;"
                                    onchange="loadVoucherDynamicFields()">
                                <option value="0">--Select Voucher Type--</option>

                                @foreach (var item in Model.VoucherTypes)
                                {
                                    <option value="@item.Id"
                                            selected="@(o?.VoucherId == item.Id)">
                                        @item.Name
                                    </option>
                                }
                            </select>

                            <div class="text-danger small mt-1 d-none" id="errVoucherType">
                                Please select voucher type.
                            </div>
                        </div>

                        <div class="col-md-4 @(Model.EditVoucherHeader?.Header == null ? "d-none" : "")">
                            <label class="form-label">
                                Voucher No
                                @if (Model.EditVoucherHeader?.Header == null)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtVoucherNo"
                                   value="@Model.EditVoucherHeader?.Header?.VoucherNo"
                            @(Model.EditVoucherHeader?.Header != null ? "disabled" : "") />

                            <div class="text-danger small mt-1 d-none" id="errVoucherNo">
                                Voucher number is required.
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Voucher Date <span class="text-danger">*</span>
                            </label>
                            <input type="date"
                                   class="form-control"
                                   id="txtVoucherDate"
                                   value="@(o?.VoucherDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))" />
                            <div class="text-danger small mt-1 d-none" id="errVoucherDate">
                                Voucher date is required.
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">VNo</label>
                            <input type="text"
                                   class="form-control"
                                   id="txtVNo"
                                   value="@o?.VNo" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Cost Center</label>
                            <select class="form-select select2"
                                    id="ddlCostCenter"
                                    style="width:100%;">
                                <option value="0">--Select--</option>

                                @foreach (var item in Model.CostCenters)
                                {
                                    <option value="@item.Id"
                                            selected="@(o?.CostCenterID == item.Id)">
                                        @item.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4 d-none">
                            <label class="form-label">Total Amount</label>
                            <input type="text"
                                   class="form-control"
                                   id="txtTotalAmount"
                                   value="@(o?.TotalAmount ?? 0)"
                                   readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">For</label>
                            <select class="form-select select2" id="ddlForType" name="ForType" onchange="handleMeetingWith(this.value)">
                                <option value="">Select</option>
                                <option value="Student" selected="@(o?.ForType == "Student")">Student</option>
                                <option value="Staff" selected="@(o?.ForType == "Staff")">Staff</option>
                            </select>                            
                        </div>

                        <!-- Student Selection Section -->
                        <div class="col-md-4 d-none" id="studentSelection">
                            <label class="form-label">Student</label>
                            <select class="form-select select2" id="ddlStudent" name="StudentID">
                            <option value="">Select Student</option>
                            @foreach (var s in Model.Students)
                            {
                                <option value="@s.Id" selected="@(o?.ForRefId == s.Id)">@s.Name</option>
                            }
                            
                            </select>
                            <div id="errStudent" class="invalid-feedback" style="display: none;">Student is required.</div>
                        </div>
                        <div class="col-md-4 d-none" id="staffSelection">
                            <label class="form-label">Staff</label>
                            <select class="form-select select2" id="ddlStaff" name="StaffID">
                                <option value="">Select Staff</option>
                                @foreach (var s in Model.Staffs)
                                {
                                    <option value="@s.Id" selected="@(o?.ForRefId == s.Id)">@s.Name</option>
                                }

                            </select>
                            <div id="errStaff" class="invalid-feedback" style="display: none;">Staff is required.</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Attachment</label>
                            <input type="file" class="form-control" id="voucherAttachmentFile" />
                            @if (!string.IsNullOrEmpty(o?.Attachment))
                            {
                                <div class="small text-muted mt-1">
                                    Current file: <a href="@o.Attachment" target="_blank">@o.FileName</a>
                                </div>
                            }
                        </div>
                    </div>

                   

                    <div class="d-flex justify-content-between align-items-center mb-3 d-none">
                        <h6 class="fw-bold mb-0">Dynamic Fields</h6>
                        <span class="badge bg-primary-subtle text-primary" id="dynamicFieldCount">
                            0 Fields
                        </span>
                    </div>

                    <div id="dynamicFieldsLoader" class="text-center py-3 d-none">
                        <div class="spinner-border spinner-border-sm"></div>
                        <span class="ms-2">Loading fields...</span>
                    </div>

                    <!--
                        Any DROPDOWN field configured with a linkedChildFieldCode
                        (e.g. "Expense For" -> Student/Staff) renders here like any
                        other dynamic field. VoucherHeader.js (wireLinkedTypeFields)
                        automatically finds the linked sibling field by its FieldCode
                        and rebinds it from SP_VoucherFieldOption_GetLinkedOptions
                        whenever the type dropdown changes. No markup changes are
                        needed here to support it - it's entirely data-driven from
                        the GetDynamicFields API response.
                    -->
                    <div id="dynamicFieldsContainer" class="row row-gap-3">
                        <div class="col-12 text-muted" id="dynamicFieldsEmpty">
                            Select a voucher type to load dynamic fields.
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0">Voucher Details</h6>
                    </div>

                    <!--
                        Populated entirely by VoucherHeader.js (renderVoucherDetailsSection):
                        an always-editable entry row for adding/editing a line, plus the
                        rows already added. Any voucher-type field configured with
                        Section = 'DETAIL' shows up here as an extra column automatically,
                        including a linked Student/Staff type-selector if configured
                        at the DETAIL level.
                    -->
                    <div id="voucherDetailsSection"></div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
                window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
                window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
                    window.editHeader   = @Html.Raw(JsonSerializer.Serialize(o ?? new VoucherHeaderModel()));
                window.dynamicFieldValues = @Html.Raw(
        JsonSerializer.Serialize(Model.DynamicFieldValues ?? new Dictionary<int, string>())
    );
               window.voucherDetailRows   = @Html.Raw(JsonSerializer.Serialize(d ?? new List<VoucherDetailDto>()));
                window.voucherDetailValues = @Html.Raw(JsonSerializer.Serialize(dv ?? new List<VoucherDetailValueDto>()));

                
    </script>

    <script src="~/assets/js/VoucherHeader.js"></script>
}
