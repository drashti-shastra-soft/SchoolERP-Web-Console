@model SchoolERPWebConsole.Domain.ItemSupplierAddViewModel
@using System.Security.Claims
@using System.Text.Json

@{
    ViewData["Title"] = "Item Supplier";

    int currentUserId = 0;

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier)
                    ?? User.FindFirst("UserId");

        if (idClaim != null)
        {
            int.TryParse(idClaim.Value, out currentUserId);
        }
    }

    var p = Model.Permissions;
    var isEdit = Model.EditItemSupplier != null;
}

<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(isEdit ? "Edit Item Supplier" : "Add Item Supplier")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">
        @if ((isEdit && p.CanEdit) || (!isEdit && p.CanAdd))
        {
            <button type="button"
                    id="btnSave"
                    class="btn btn-success top-btn"
                    onclick="saveRecord()">
                <i class="ti ti-device-floppy me-1"></i>
                Save
            </button>
        }

        <a href="/ItemSupplier/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i>
            Back
        </a>
    </div>
</div>

<div id="pageNotice"></div>

<form id="itemSupplierForm" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">

                    <input type="hidden"
                           id="recordId"
                           value="@(Model.EditItemSupplier?.ItemSupplierId ?? 0)" />

                    <input type="hidden"
                           id="hdnCompanyID"
                           value="@(Model.EditItemSupplier?.CompanyID ?? 0)" />

                    <input type="hidden"
                           id="hdnSessionID"
                           value="@(Model.EditItemSupplier?.SessionID ?? 0)" />

                    <div class="row row-gap-3">

                        <!-- Supplier Name -->
                        <div class="col-md-6">
                            <label class="form-label">
                                Supplier Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="txtName"
                                   maxlength="150"
                                   value="@Model.EditItemSupplier?.Name"
                                   placeholder="Enter supplier name" />

                            <div class="text-danger small mt-1 d-none"
                                 id="nameError">
                                Supplier name is required.
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>

                            <input type="text"
                                   class="form-control"
                                   id="txtPhone"
                                   maxlength="20"
                                   value="@Model.EditItemSupplier?.Phone"
                                   placeholder="Enter phone number" />

                            <div class="text-danger small mt-1 d-none"
                                 id="phoneError">
                                Enter a valid phone number.
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label">Email</label>

                            <input type="email"
                                   class="form-control"
                                   id="txtEmail"
                                   maxlength="150"
                                   value="@Model.EditItemSupplier?.Email"
                                   placeholder="Enter email address" />

                            <div class="text-danger small mt-1 d-none"
                                 id="emailError">
                                Enter a valid email address.
                            </div>
                        </div>

                        <!-- Contact Person Name -->
                        <div class="col-md-6">
                            <label class="form-label">Contact Person Name</label>

                            <input type="text"
                                   class="form-control"
                                   id="txtContactPersonName"
                                   maxlength="150"
                                   value="@Model.EditItemSupplier?.ContactPersonName"
                                   placeholder="Enter contact person name" />
                        </div>

                        <!-- Contact Person Phone -->
                        <div class="col-md-6">
                            <label class="form-label">Contact Person Phone</label>

                            <input type="text"
                                   class="form-control"
                                   id="txtContactPersonPhone"
                                   maxlength="20"
                                   value="@Model.EditItemSupplier?.ContactPersonPhone"
                                   placeholder="Enter contact person phone" />

                            <div class="text-danger small mt-1 d-none"
                                 id="contactPersonPhoneError">
                                Enter a valid contact phone number.
                            </div>
                        </div>

                        <!-- Contact Person Email -->
                        <div class="col-md-6">
                            <label class="form-label">Contact Person Email</label>

                            <input type="email"
                                   class="form-control"
                                   id="txtContactPersonEmail"
                                   maxlength="150"
                                   value="@Model.EditItemSupplier?.ContactPersonEmail"
                                   placeholder="Enter contact person email" />

                            <div class="text-danger small mt-1 d-none"
                                 id="contactPersonEmailError">
                                Enter a valid contact email address.
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="col-md-12">
                            <label class="form-label">Address</label>

                            <textarea class="form-control"
                                      id="txtAddress"
                                      maxlength="500"
                                      rows="2"
                                      placeholder="Enter supplier address">@Model.EditItemSupplier?.Address</textarea>
                        </div>

                        <!-- Pin Code -->
                        <div class="col-md-4 position-relative">
                            <label class="form-label">Pin Code</label>

                            <input type="text"
                                   class="form-control"
                                   id="txtPinCode"
                                   maxlength="10"
                                   autocomplete="off"
                                   value="@Model.EditItemSupplier?.PostalCode"
                                   placeholder="Enter pin code" />

                            <ul id="pinCodeSuggestions"
                                class="pincode-dropdown list-group">
                            </ul>
                        </div>

                        <!-- Country -->
                        <div class="col-md-4">
                            <label class="form-label">Country</label>

                            <select class="form-select select2"
                                    id="ddlCountry"
                                    style="width:100%;">
                                <option value="">-- Select Country --</option>

                                @if (Model.Country != null)
                                {
                                    foreach (var country in Model.Country)
                                    {
                                        if (Model.EditItemSupplier?.CountryId == country.CountryId)
                                        {
                                            <option value="@country.CountryId" selected>
                                                @country.CountryName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@country.CountryId">
                                                @country.CountryName
                                            </option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- State -->
                        <div class="col-md-4">
                            <input type="hidden"
                                   id="hdnSelectedStateId"
                                   value="@(Model.EditItemSupplier?.StateId ?? 0)" />

                            <label class="form-label">State</label>

                            <select class="form-select select2"
                                    id="ddlState"
                                    style="width:100%;">
                                <option value="">-- Select Country First --</option>
                            </select>
                        </div>

                        <!-- City -->
                        <div class="col-md-4">
                            <input type="hidden"
                                   id="hdnSelectedCityId"
                                   value="@(Model.EditItemSupplier?.CityId ?? 0)" />

                            <label class="form-label">City</label>

                            <select class="form-select select2"
                                    id="ddlCity"
                                    style="width:100%;">
                                <option value="">-- Select State First --</option>
                            </select>
                        </div>

                        <!-- Description -->
                        <div class="col-md-12">
                            <label class="form-label">Description</label>

                            <textarea class="form-control"
                                      id="txtDescription"
                                      maxlength="1000"
                                      rows="3"
                                      placeholder="Enter description">@Model.EditItemSupplier?.Description</textarea>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="chkIsActive"
                                @(Model.EditItemSupplier == null ||
                                    Model.EditItemSupplier.IsActive
                                    ? "checked"
                                    : "") />

                                <label class="form-check-label"
                                       for="chkIsActive">
                                    Active
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        window.currentUserId = @currentUserId;
    </script>

    <script src="~/assets/js/ItemSupplier.js"></script>
}