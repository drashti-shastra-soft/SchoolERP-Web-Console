@*
    ======================================================================
    VIEW: Academics / Class.cshtml
    PURPOSE: User interface for managing Classes and their Section mappings.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.SMSTypeFieldPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    var p = Model.Permissions;
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
}
<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body">
            <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table" id="PaymentTypeTable">
                        <thead>
                            <tr class="bg-light">
                                <th style="width:26px;"></th>
                                <th>Field Label</th>
                                <th>Field Key</th>
                                <th>Input Type</th>
                                <th>Required</th>
                                <th>Secret</th>
                                <th style="width:90px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SMSTypeField != null)
                            {
                                @foreach (var item in Model.SMSTypeField)
                                {
                                    <tr class="item-row" onclick="selectItem(@item.FieldID, this)" style="cursor: pointer;">
                                        <td class="ps-3">
                                            <input type="checkbox" name="selectedComplaintType"
                                                   class="form-check-input student-checkbox"
                                                   value="@item.FieldID">

                                        </td>
                                        <td>@item.FieldLabel</td>
                                        <td>@item.FieldKey</td>
                                        <td>@item.FieldType</td>
                                        <td>@item.IsRequired</td>
                                        <td>@item.IsSecret</td>
                                        <td>
                                            <div class="form-check form-switch" onclick="event.stopPropagation()">
                                                <input class="form-check-input" type="checkbox"
                                                       onchange="toggleStatus(@item.FieldID,this.checked,this);"
                                                @(item.IsActive ? "checked" : "")
                                                @(p.CanEdit ? "" : "disabled")>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <span class="text-muted">No records found.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                            <!-- Record info -->
                            <div class="text-muted small">
                                Showing
                                <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                –
                                <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                of
                                <strong>@Model.TotalRecords</strong> users
                            </div>

                            <nav aria-label="Subject pagination">
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- First -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevrons-left"></i>
                                        </a>
                                    </li>

                                    <!-- Prev -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Page numbers — show 5 around current -->
                                    @{
                                        int start = Math.Max(1, Model.PageNumber - 2);
                                        int end = Math.Min(totalPages, start + 4);
                                        start = Math.Max(1, end - 4);
                                    }
                                    @for (int pg = start; pg <= end; pg++)
                                    {
                                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm">@pg</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Last -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm">
                                            <i class="ti ti-chevrons-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>

                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>