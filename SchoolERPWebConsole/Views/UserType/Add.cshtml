@model SchoolERPWebConsole.Domain.MstUserTypeAddViewModel
@using System.Text.Json
@using SchoolERPWebConsole.Helpers
@inject PermissionHelper PermHelper
@{
    Layout = "_Layout";
    var isEdit = Model.EditUserType != null;
    ViewData["Title"] = isEdit ? "Edit User Type" : "Add User Type";

    var canAdd = PermHelper.HasPermissionByUrl("/UserType", "Add");
    var canEdit = PermHelper.HasPermissionByUrl("/UserType", "Edit");
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit User Type" : "Add User Type")</h6>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-success top-btn" id="btnSave" onclick="saveItem()">
            <i class="ti ti-cloud me-1"></i>Save
        </button>
        <a href="/UserType/Index" class="btn btn-sm btn-info d-inline-flex align-items-center top-btn">
            <i class="ti ti-arrow-narrow-left me-1"></i>Back
        </a>
    </div>
</div>
<!-- End Page Header -->

<form id="itemForm" onsubmit="return false;">
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">
                    <div class="row">
                        <input type="hidden" id="txtItemId" value="@(Model.EditUserType?.UserTypeID ?? 0)">

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Type Code (System Code) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtTypeCode" placeholder="e.g. TEACHER"
                                       value="@Model.EditUserType?.TypeCode" autocomplete="off">
                                <div class="invalid-feedback" id="errTxtTypeCode"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Type Name (Display Name) <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="txtTypeName" placeholder="e.g. Teacher"
                                       value="@Model.EditUserType?.TypeName" autocomplete="off">
                                <div class="invalid-feedback" id="errTxtTypeName"></div>
                            </div>
                        </div>
                        <div class="col-md-4 mt-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor: pointer;"
                                @((Model.EditUserType?.IsActive ?? true) ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @Html.Raw(JsonSerializer.Serialize(canAdd));
        window.canEdit = @Html.Raw(JsonSerializer.Serialize(canEdit));
    </script>
    <script src="~/assets/js/UserType.js"></script>
}
