@model SchoolERPWebConsole.Domain.ItemIssueAddViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Item Issue";

    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    var isEdit = Model.EditItemIssue != null;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(isEdit ? "Edit Item Issue" : "Issue Item")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if ((isEdit && p.CanEdit) || (!isEdit && p.CanAdd))
        {
            <button type="button" id="btnSave" onclick="saveRecord()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/IssueItem/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div id="pageNotice"></div>

<form id="itemIssueForm" novalidate>
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">

                    <input type="hidden" id="recordId" value="@(Model.EditItemIssue?.ItemIssueId ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditItemIssue?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditItemIssue?.SessionID ?? 0)">

                    <div class="row row-gap-3">

                        <!-- User Type (Role) -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">User Type<span class="text-danger">*</span></label>
                            <select id="ddlRole" class="form-select form-control">
                                <option value="">Select User Type</option>
                                @foreach (var c in Model.RoleList)
                                {
                                    <option value="@c.RoleID" selected="@(Model.EditItemIssue?.RoleId == c.RoleID)">@c.RoleName</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlRole">User Type is required.</div>
                        </div>

                        <!-- Issue To (cascades from User Type via UsersByRole) -->
                        <div class="col-md-4 mb-3">
                            <input type="hidden" id="hdnIssueToId" value="@(Model.EditItemIssue?.IssueTo ?? 0)" />
                            <label class="form-label">Issue To<span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlIssueTo" style="width:100%;" disabled>
                                <option value="">-- Select User Type First --</option>
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlIssueTo">Issue To is required.</div>
                        </div>

                        <!-- Issue By -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Issue By<span class="text-danger">*</span></label>
                            <select id="ddlIssueBy" class="form-select form-control">
                                <option value="">Select Issue By</option>
                                @foreach (var c in Model.Staff)
                                {
                                    <option value="@c.StaffID" selected="@(Model.EditItemIssue?.IssueBy == c.StaffID)">@c.Username</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlIssueBy">Issue By is required.</div>
                        </div>

                        <!-- Issue Date -->
                        <div class="col-md-4">
                            <label class="form-label">Issue Date<span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtIssueDate" required
                                   value="@(Model.EditItemIssue?.IssueDate?.ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div class="text-danger small mt-1 d-none" id="errIssueDate">Issue Date is required.</div>
                        </div>

                        <!-- Return Date (optional — expected return, can be in the future) -->
                        <div class="col-md-4">
                            <label class="form-label">Return Date</label>
                            <input type="date" class="form-control" id="txtReturnDate"
                                   value="@(Model.EditItemIssue?.ReturnDate?.ToString("yyyy-MM-dd") ?? "")"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div class="text-danger small mt-1 d-none" id="errReturnDate"></div>
                        </div>

                        <!-- Note -->
                        <div class="col-md-4">
                            <label class="form-label">Note</label>
                            <input type="text" class="form-control" id="txtNote"
                                   value="@Model.EditItemIssue?.Note" placeholder="Enter note">
                        </div>

                        <div class="col-md-12"><hr /></div>

                        <!-- Item Category -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Item Category<span class="text-danger">*</span></label>
                            <select id="ddlItemCategory" class="form-select form-control">
                                <option value="">Select Item Category</option>
                                @foreach (var c in Model.ItemCategory)
                                {
                                    <option value="@c.Id" selected="@(Model.EditItemIssue?.ItemCategoryId == c.Id)">@c.Name</option>
                                }
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlItemCategory">Item Category is required.</div>
                        </div>

                        <!-- Item (cascades from Category) -->
                        <div class="col-md-4 mb-3">
                            <input type="hidden" id="hdnItemId" value="@(Model.EditItemIssue?.ItemId ?? 0)" />
                            <label class="form-label">Item<span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlItem" style="width:100%;" disabled>
                                <option value="">-- Select Item Category First --</option>
                            </select>
                            <div class="text-danger small mt-1 d-none" id="errDdlItem">Item is required.</div>
                        </div>

                        <!-- Quantity + Available Quantity hint -->
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Quantity<span class="text-danger">*</span></label>
                            <input type="number" min="1" step="1" class="form-control" id="txtQuantity"
                                   value="@(Model.EditItemIssue?.Quantity)" placeholder="Enter quantity">
                            <small class="text-muted d-block mt-1" id="availableQtyHint">Available Quantity: —</small>
                            <div class="text-danger small mt-1 d-none" id="errQuantity">Quantity is required.</div>
                        </div>

                        <!-- Active -->
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chkIsActive"
                                @(Model.EditItemIssue == null || Model.EditItemIssue.IsActive ? "checked" : "")>
                                <label class="form-check-label" for="chkIsActive">Active</label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
        // Pre-selected values for edit mode, used to re-select after each cascade loads
        window.editItemId = @(Model.EditItemIssue?.ItemId ?? 0);
        window.editIssueToId = @(Model.EditItemIssue?.IssueTo ?? 0);
    </script>

    <script src="~/assets/js/ItemIssue.js"></script>
}
