@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout"; // or a minimal error layout
}

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height: 70vh;">
    <i class="ti ti-lock fs-1 text-danger mb-3"></i>
    <h2 class="fw-bold mb-2">404 - Access Denied</h2>
    <p class="text-muted mb-4">@ViewBag.Message</p>
    <a href="/" class="btn btn-primary">Go to Home</a>
</div>