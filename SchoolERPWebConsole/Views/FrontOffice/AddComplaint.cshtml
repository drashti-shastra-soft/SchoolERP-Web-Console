@model SchoolERPWebConsole.Domain.FOComplaintAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Complaint Type";
    var p = Model.Permissions;

}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditComplaints == null ? "Add Complaint Type" : "Edit Complaint Type")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button type="submit" onclick="saveComplaint()" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/FrontOffice/Complaint" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="complaintForm">
                    <input type="hidden" id="hdnComplaintID" value="@Model.Complaints?.ComplaintID">
                    <input type="hidden" id="hdnCompanyID" value="@Model.Complaints?.CompanyID">
                    <input type="hidden" id="hdnSessionID" value="@Model.Complaints?.SessionID">
                    <div class="row row-gap-3">
                        <div class="col-md-6">
                            <label class="form-label">Complaint Type <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlComplaintType" required>
                                <option value="">Select</option>
                                @foreach (var t in Model.ComplaintTypes)
                                {
                                    <option value="@t.Id" selected="@(Model.Complaints?.ComplaintTypeID == t.Id)">@t.Name</option>
                                }
                            </select>
                            <div id="errComplaintType" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Source <span class="text-danger">*</span></label>
                            <select class="form-select select2" id="ddlSource" required>
                                <option value="">Select</option>
                                @foreach (var s in Model.Sources)
                                {
                                    <option value="@s.Id" selected="@(Model.Complaints?.SourceID == s.Id)">@s.Name</option>
                                }
                            </select>
                            <div id="errSource" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Complaint By <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.Complaints?.ComplaintBy" id="txtComplaintBy" placeholder="Name" required>
                            <div id="errComplaintBy" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" id="txtPhone" value="@Model.Complaints?.Phone" placeholder="Phone number" maxlength="10">
                            <div id="errPhone" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" id="txtEmail" value="@Model.Complaints?.Email" placeholder="Email address">
                            <div id="errEmail" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="txtDate" required value="@(Model.Complaints != null &&
                              Model.Complaints.ComplaintDate != DateTime.MinValue
                                ? Model.Complaints.ComplaintDate.ToString("yyyy-MM-dd")
                                : DateTime.Now.ToString("yyyy-MM-dd"))"
                                   max="@DateTime.Now.ToString("yyyy-MM-dd")">
                            <div id="errDate" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Assigned To</label>
                            <input type="text" class="form-control" id="txtAssignedTo" value="@Model.Complaints?.AssignedTo" placeholder="Name of staff">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Action Taken</label>
                            <input type="text" class="form-control" value="@Model.Complaints?.ActionTaken" id="txtActionTaken">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <textarea class="form-control" id="txtDescription" rows="2">@Model.Complaints?.Description</textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Note</label>
                            <textarea class="form-control" id="txtNote" rows="2">@Model.Complaints?.Note</textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Attachment</label>
                            <input type="file" class="form-control" id="attachmentFile" name="attachmentFile">
                            <small class="text-muted" id="fileInfo"></small>

                            @if (!string.IsNullOrEmpty(Model.Complaints?.FileName))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@Model.Complaints?.Attachment" target="_blank" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@Model.Complaints?.FileName
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                            <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                            <input type="hidden" id="hdnExistingFile" name="ExistingFileName" value="@Model.Complaints?.FileName">
                            <input type="hidden" id="hdnRemoveFile" name="RemoveAttachment" value="false">
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkActive" @(Model.Complaints?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label" for="chkActive">Active</label>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="col-md-12 text-right">
                    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
                        @if (p.CanAdd || p.CanEdit)
                        {
                            <button class="btn btn-success top-btn" onclick="saveComplaint()">
                                <i class="ti ti-device-floppy me-1"></i> Save
                            </button>
                        }

                        <a href="/FrontOffice/Complaint" class="btn btn-secondary top-btn">
                            <i class="ti ti-arrow-left me-1"></i> Back
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Show the message + red border for plain inputs/textareas */
    .field-error {
        display: none;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    /* Select2 hides the real <select>, so highlight its rendered box instead */
    .select2-selection.is-invalid-select2 {
        border-color: #dc3545 !important;
        border-radius: .375rem;
    }
</style>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);

    </script>
    <script src="~/js/inline-form-validation.js"></script>
    <script src="~/assets/js/Complaint.js"></script>

}
