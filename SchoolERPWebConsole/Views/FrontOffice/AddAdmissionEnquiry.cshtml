@model SchoolERPWebConsole.Domain.AddAdmissionInquiryPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Admission Enquiry";

    // Permission loading for the view
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}
<form id="inquiryForm">
    <!-- Page Header -->
    <div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
        <div>
            <h6 class="fw-bold mb-0">@(Model.EditInquiries == null ? "Add Admission Inquiry" : "Edit Admission Inquiry")</h6>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-1">
            @if (p.CanAdd)
            {
                <button type="button" onclick="saveRecord()" class="btn btn-success top-btn">
                    <i class="ti ti-device-floppy me-1"></i> Save
                </button>
            }
            <a href="/FrontOffice/AdmissionInquiry" class="btn btn-secondary top-btn">
                <i class="ti ti-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-tbl-outer">
                <div class="card-body">

                    <input type="hidden" name="InquiryID" id="InquiryID" value="@Model.Inquiries.InquiryID" />
                    <input type="hidden" name="CompanyID" id="CompanyID" value="@Model.Inquiries.CompanyID" />
                    <input type="hidden" name="SessionID" id="SessionID" value="@Model.Inquiries.SessionID" />


                    <div class="row row-gap-3">
                        <div class="col-md-6">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" name="Name" value="@Model.Inquiries.Name" id="InqName" class="form-control" required>
                            <div id="errName" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Phone <span class="text-danger">*</span></label>
                            <input type="text" name="Phone" value="@Model.Inquiries.Phone" id="InqPhone" class="form-control" required maxlength="10">
                            <div id="errPhone" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="text" name="Email" value="@Model.Inquiries.Email" id="InqEmail" class="form-control" required>
                            <div id="errEmail" class="field-error text-danger small mt-1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Address</label>
                            <textarea name="Address" id="InqAddress" value="@Model.Inquiries.Address" class="form-control"></textarea>
                        </div>
                        <div class="col-md-3 position-relative">
                            <label class="form-label fw-bold">Pin Code</label>
                            <input type="text" value="@Model.Inquiries?.PostalCode" class="form-control" id="txtPinCode" autocomplete="off" />
                            <ul id="pinCodeSuggestions" class="pincode-dropdown list-group">
                            </ul>
                        </div>
                        <div class="d-block col-md-3 mb-3">
                            <label class="form-label fw-bold">Country Name</label>
                            <select class="form-select select2" id="ddlCountry" style="width: 100%;">
                                <option value="">-- Select --</option>
                                @if (Model.Country != null)
                                {
                                    @foreach (var rt in Model.Country)
                                    {
                                        <option value="@rt.CountryId" selected="@(Model.Inquiries?.CountryId == rt.CountryId)">@rt.CountryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="d-block col-md-3 mb-3">
                            <input type="hidden" id="hdnSelectedStateId" value="@Model.Inquiries?.StateId" />
                            <input type="hidden" id="hdnSelectedCityId" value="@Model.Inquiries?.CityId" />
                            <label class="form-label fw-bold">State Name</label>
                            <select class="form-select select2" id="ddlState" style="width: 100%;">
                                <option value="">-- Select Country First --</option>
                            </select>
                        </div>

                        <div class="d-block col-md-3 mb-3">
                            <label class="form-label fw-bold">City Name</label>
                            <select class="form-select select2" id="ddlCity" style="width: 100%;">
                                <option value="">-- Select Country First --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Description</label>
                            <textarea name="Description" id="InqDescription" class="form-control">@Model.Inquiries.Description</textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Note</label>
                            <textarea name="Note" id="InqNote" class="form-control">@Model.Inquiries.Note</textarea>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Inquiry Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="InqDate" name="Date"
                                   value="@(Model.Inquiries != null && Model.Inquiries.Date != default
                        ? Model.Inquiries.Date.ToString("yyyy-MM-dd")
                        : DateTime.Now.ToString("yyyy-MM-dd"))">
                            <div id="errDate" class="field-error text-danger small mt-1"></div>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">Next Follow Up Date</label>
                            <input type="date" name="NextFollowUpDate"
                                   value="@(Model.Inquiries.NextFollowUpDate.HasValue ? Model.Inquiries.NextFollowUpDate.Value.ToString("yyyy-MM-dd") : "")"
                                   id="InqNextFollowUpDate" class="form-control">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Assign To</label>
                            <select name="AssignedTo" id="InqAssignedTo" class="form-select select2">
                                <option value="">Select</option>
                                @foreach (var st in Model.Staff)
                                {
                                    <option value="@st.StaffID" selected="@(Model.Inquiries?.AssignedTo == st.StaffID)">
                                        @($"{st.FirstName} {st.LastName} ({st.StaffID})")
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Reference</label>
                            <select name="ReferenceID" id="InqReferenceID" class="form-select select2">
                                <option value="">Select</option>
                                @foreach (var r in Model.References)
                                {
                                    <option value="@r.Id" selected="@(Model.Inquiries?.ReferenceID == r.Id)">@r.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Source</label>
                            <select name="SourceID" id="InqSourceID" class="form-select select2">
                                <option value="">Select</option>
                                @foreach (var s in Model.Sources)
                                {
                                    <option value="@s.Id" selected="@(Model.Inquiries?.SourceID == s.Id)">@s.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Class</label>
                            <select name="ClassID" id="InqClassID" class="form-select select2">
                                <option value="">Select</option>
                                @foreach (var c in Model.Classes)
                                {
                                    <option value="@c.ClassID" selected="@(Model.Inquiries?.ClassID == c.ClassID)">@c.ClassName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Number Of Child </label>
                            <input type="number" name="NoOfChild" value="@Model.Inquiries?.NoOfChild" id="InqNoOfChild" class="form-control" value="1">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="Status" id="InqStatus" class="form-select select2">
                                <option value="Active" selected="@(Model.Inquiries?.Status == "Active")">Active</option>
                                <option value="Passive" selected="@(Model.Inquiries?.Status == "Passive")">Passive</option>
                                <option value="Dead" selected="@(Model.Inquiries?.Status == "Dead")">Dead</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-12 text-right">
                        <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
                            @if (p.CanAdd || p.CanEdit)
                            {
                                <button class="btn btn-success top-btn" type="button" onclick="saveRecord()">
                                    <i class="ti ti-device-floppy me-1"></i> Save
                                </button>
                            }

                            <a href="/FrontOffice/AdmissionInquiry" class="btn btn-secondary top-btn">
                                <i class="ti ti-arrow-left me-1"></i> Back
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .field-error {
        display: none;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }
</style>

@section Scripts {
    <script>
        window.currentUserId = @JsonSerializer.Serialize(currentUserId);
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/js/inline-form-validation.js"></script>
    <script src="~/assets/js/AdmissionInquiry.js"></script>
}
