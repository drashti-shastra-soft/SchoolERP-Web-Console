@model SchoolERPWebConsole.Domain.FOPostalReceivePageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    var p = Model.Permissions;
    var pageSize = Model.PageSize > 0 ? Model.PageSize : 10;
    var requestedPage = 1;
    if (int.TryParse(Context.Request.Query["pageIndex"], out var queryPage)) { requestedPage = queryPage; }
    var currentPage = requestedPage < 1 ? 1 : requestedPage;
    var totalRecords = Math.Max(Model.TotalRecords, 0);
    var totalPages = totalRecords == 0 ? 1 : (int)Math.Ceiling((double)totalRecords / pageSize);
    if (currentPage > totalPages) { currentPage = totalPages; }
    var firstRecord = totalRecords == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    var lastRecord = totalRecords == 0 ? 0 : Math.Min(currentPage * pageSize, totalRecords);
    var searchTerm = Model.SearchTerm ?? "";
}

<style>
    .sidebar {
        overflow-y: auto !important;
    }

    #disableReasonTableContainer {
        overflow: hidden;
    }

    .sticky-table {
        overflow-x: auto;
        overflow-y: visible;
    }

        .sticky-table table {
            width: 100%;
        }

    .modal-body.text-center {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body p-0">
            <div class="sticky-table">
                @* <div class="table-responsive"> *@
                <table class="table mb-0" id="tblPostalReceive">
                    <thead>
                        <tr class="bg-light">
                            <th style="width: 50px;">Select</th>
                            <th>From Title</th>
                            <th>Reference No</th>
                            <th>To Title</th>
                            <th>Date</th>
                            <th>Doc</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null)
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr class="item-row" onclick="selectItem(@item.PostalReceiveID, this)" style="cursor: pointer;">
                                    <td class="ps-3">
                                        <input type="checkbox" name="selectedItem"
                                               class="form-check-input student-checkbox"
                                               value="@item.PostalReceiveID">

                                    </td>
                                    <td>@item.FromTitle</td>
                                    <td>@item.ReferenceNo</td>
                                    <td>@item.ToTitle</td>
                                    <td>@item.Date.ToString("dd-MM-yyyy")</td>
                                    <td>
                                        @if (item.Attachment != null && item.Attachment.Length > 0)
                                        {
                                            var attachmentFileName = System.IO.Path.GetFileName(item.Attachment);
                                            <a href="javascript:void(0)"
                                               class="btn btn-sm btn-white border px-2 py-1 btn-view-attachment"
                                               title="View Attachment"
                                               onclick="event.stopPropagation(); viewAttachment(@item.PostalReceiveID, '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(item.ReferenceNo ?? item.FromTitle ?? "Attachment"))', '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(attachmentFileName))', '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(item.Attachment))')">
                                                <i class="ti ti-paperclip fs-5"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-7">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (p.CanEdit)
                                        {


                                            <div class="form-check form-switch d-inline-block ms-2" onclick="event.stopPropagation()">
                                                <input class="form-check-input" type="checkbox"
                                                       onchange="toggleStatus(@item.PostalReceiveID, this.checked,this)"
                                                       @(item.IsActive ? "checked" : "")
                                                       @(p.CanEdit ? "" : "disabled")>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (p.CanView)
                                        {
                                            <a href="/FrontOffice/viewPostalReceive/@item.PostalReceiveID"
                                               class="btn btn-sm btn-white border px-2 py-1 btn-view-attachment"
                                               title="View Details">
                                                <i class="ti ti-eye fs-5"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No records found.</td></tr>
                        }
                    </tbody>
                </table>
                <!-- ── Pagination ─────────────────────────────────────────────── -->
                @if (totalRecords > 0)
                {
                    <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3 px-3">

                        <div class="text-muted small">
                            Showing
                            <strong>@firstRecord</strong>
                            –
                            <strong>@lastRecord</strong>
                            of
                            <strong>@totalRecords</strong>
                            main menus
                        </div>

                        @if (totalPages > 1)
                        {
                            <nav aria-label="Menu pagination">
                                <ul class="pagination pagination-sm mb-0">

                                    @{
                                        var firstUrl =
                                        $"?pageIndex=1&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";

                                        var previousPage = Math.Max(1, currentPage - 1);

                                        var previousUrl =
                                        $"?pageIndex={previousPage}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";
                                    }

                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="@firstUrl"
                                           aria-label="First page">
                                            <i class="ti ti-chevrons-left"></i>
                                        </a>
                                    </li>

                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="@previousUrl"
                                           aria-label="Previous page">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    @{
                                        var startPage = Math.Max(1, currentPage - 2);
                                        var endPage = Math.Min(totalPages, startPage + 4);

                                        if (endPage - startPage < 4)
                                        {
                                            startPage = Math.Max(1, endPage - 4);
                                        }
                                    }

                                    @for (var pg = startPage; pg <= endPage; pg++)
                                    {
                                        var pageUrl =
                                        $"?pageIndex={pg}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";

                                        <li class="page-item @(pg == currentPage ? "active" : "")">
                                            <a class="page-link"
                                               href="@pageUrl"
                                               aria-current="@(pg == currentPage ? "page" : null)">
                                                @pg
                                            </a>
                                        </li>
                                    }

                                    @{
                                        var nextPage = Math.Min(totalPages, currentPage + 1);

                                        var nextUrl =
                                        $"?pageIndex={nextPage}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}";

                                        var lastUrl =
                                        $"?pageIndex={totalPages}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}";
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="@nextUrl"
                                           aria-label="Next page">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="@lastUrl"
                                           aria-label="Last page">
                                            <i class="ti ti-chevrons-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        }
                    </div>
                }

                @* </div> *@
            </div>
        </div>
    </div>
</div>

<!-- Attachment Preview Popup -->
<div class="modal fade" id="modalAttachment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title mb-0" id="modalAttachmentTitle">Attachment</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center" style="min-height:300px;">
                <img id="imgAttachment" src="" style="display:none; max-width:100%; max-height:70vh;" />
                <iframe id="frmAttachment" src="" style="display:none; width:100%; height:70vh; border:0;"></iframe>
                <div id="attachmentUnsupported" class="d-none flex-column align-items-center justify-content-center text-muted py-5">
                    <i class="ti ti-file-unknown mb-2" style="font-size:2rem;"></i>
                    <div>Preview isn't available for this file type.</div>
                    <div class="fs-13">Use the Download button above to open it.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnDownloadAttachment" class="btn btn-sm btn-primary" title="Download">
                    <i class="ti ti-download me-1"></i>
                    <span id="btnDownloadAttachmentLabel">Download</span>
                </button>
            </div>
        </div>
    </div>
</div>

