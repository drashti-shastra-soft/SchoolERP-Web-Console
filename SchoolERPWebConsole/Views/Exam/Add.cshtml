@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.ExamAddViewModel
@{
    ViewData["Title"] = "Add Exam";
    var p = Model.Permissions;
}

<style>
    .dt-buttons {
        display: none !important;
    }

    .is-invalid + .select2-container .select2-selection {
        border-color: #dc3545 !important;
    }

    .is-invalid ~ .invalid-feedback {
        display: block !important;
    }
</style>

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(Model.EditExam == null ? "Add Exam" : "Edit Exam")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveItem()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/exam/Index" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">

            <div class="card-body">
                <form id="itemForm" class="needs-validation" novalidate>
                    <input type="hidden" id="txtItemId" value="@(Model.EditExam?.ExamId ?? 0)">
                    <input type="hidden" id="hdnUserID" value="@(Model.EditExam?.CreatedBy ?? 0)">
                    <input type="hidden" id="hdnCompanyID" value="@(Model.EditExam?.CompanyID ?? 0)">
                    <input type="hidden" id="hdnSessionID" value="@(Model.EditExam?.SessionID ?? 0)">
                    @* <input type="hidden" id="txtItemId" value="0"> *@
                    <div class="row">

                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Exam Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.EditExam?.ExamName" id="txtExamName" placeholder="e.g. PT 1" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtExamName"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Exam Short Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" value="@Model.EditExam?.ExamShortCode" id="txtExamShortCode" placeholder="e.g. PT-1" autocomplete="off">
                            <div class="invalid-feedback" id="errTxtExamShortCode"></div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Display Label</label>
                            <input type="text" class="form-control" value="@Model.EditExam?.DisplayLabel" id="txtDisplayLabel" placeholder="e.g. PT" autocomplete="off">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" rows="3" id="txtDescription">@Model.EditExam?.Description</textarea>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" style="cursor:pointer"
                                @(Model.EditExam?.IsActive ?? true ? "checked" : "")>
                                <label class="form-check-label fw-bold" for="isActive">Active</label>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>

    <script src="~/assets/js/Exam.js"></script>
}