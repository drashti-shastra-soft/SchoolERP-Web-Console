@model SchoolERPWebConsole.Domain.StaffIDCardPageViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Staff ID Card";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
}
<style>
    .dt-buttons {
    display: none !important;
    }
</style>
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Staff ID Card Management</h6>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-1">
        @if(p.CanAdd)
        {
            <a href="/Certificate/AddStaffIdCard" class="btn btn-primary top-btn"><i class="ti ti-plus me-1"></i>Add</a>
        }   
        @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="editSelected()"><i class="ti ti-pencil me-1"></i>Edit</button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()"><i class="ti ti-trash me-1"></i>Delete</button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
        
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-tbl-outer mb-2">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 ">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" class="form-control border-0 ps-2" id="txtSearchInput"
                               placeholder="Search by Staff Name..." style="min-width: 220px;">
                    </div>

                    <!-- Filters dropdown -->
                    <div class="dropdown">
                        <a href="Javascript:Void(0);" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>
                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown">
                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn btn-light btn-md me-2 fw-medium" onclick="resetAllFilters()" id="btnResetFilters">Reset</button>
                                    <button type="button" class="btn text-primary fs-6 fw-medium" id="btnApplyFilters">Apply</button>
                                </div>
                            </div>

                            <div class="filter-body pb-0">
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label mb-1">Status</label>
                                        <select class="form-select form-control" id="ddlFilterStatus">
                                            <option value="">All</option>
                                            <option value="active">Active</option>
                                            <option value="inactive">Inactive</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>
    <div class="col-xl-12">
        <div class="card shadow-tbl">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table" id="staffIdCardTable">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Select</th>
                                <th>ID Card Title</th>
                                <th>Background Image</th>
                                <th>Design Type</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in (Model.IDCards ?? new List<StaffIDCardViewModel>()))
                            {
                                <tr class="item-row" data-status="@(item.IsActive ? "active" : "inactive")" onclick="selectItem(@item.IDCardID, this)" style="cursor: pointer;">
                                    <td class="text-center">
                                        <input type="checkbox" name="selectedIDCard" class="form-check-input student-checkbox" value="@item.IDCardID">
                                    </td>
                                    <td>@item.IDCardTitle</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.BackgroundImageBase64))
                                        {
                                            <img src="@item.BackgroundImageBase64" style="width:50px;height:50px;" class="rounded border" alt="Background" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Image</span>
                                        }
                                    </td>
                                    <td>@(item.DesignType == 1 ? "Horizontal" : "Vertical")</td>
                                    <td class="text-center" onclick="event.stopPropagation()">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <input class="form-check-input" type="checkbox" @(item.IsActive ? "checked" : "") onclick="toggleStatus(@item.IDCardID, this.checked)">
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {
    <script>
        var currentUserId = @currentUserId;
        var selectedIDCardId = 0;
        let table;

        function triggerExport(index) {
            if ($.fn.DataTable.isDataTable('#staffIdCardTable')) {
                const dt = $('#staffIdCardTable').DataTable();
                dt.button(index).trigger();
            }
        }

                $(document).ready(function () {
            try {
                table = $('#staffIdCardTable').DataTable({
                    dom: 'Bfrtip',
                    buttons: [
                        { extend: 'copy', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'csv', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'excel', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'pdf', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'print', exportOptions: { columns: [1, 2, 3] } }
                    ],
                    searching: false,
                    paging: false,
                    info: false,
                    language: {
                        emptyTable: "No ID card templates found.",
                        zeroRecords: "No ID card templates found."
                    }
                });
            } catch (e) {
                console.error('DataTable init failed:', e);
            }

            // Restore filters from sessionStorage on load
            if (appliedFilters['txtSearchInput']) {
                document.getElementById('txtSearchInput').value = appliedFilters['txtSearchInput'].text;
            }
            if (appliedFilters['ddlFilterStatus']) {
                const statusEl = document.getElementById('ddlFilterStatus');
                if (statusEl) {
                    const match = [...statusEl.options].find(o => o.text === appliedFilters['ddlFilterStatus'].text);
                    if (match) statusEl.value = match.value;
                }
            }
            renderFilterBadges();
            applyRowFilters();

            // Search box — live filter as you type
            document.getElementById('txtSearchInput').addEventListener('keyup', function () {
                applyFilters();
            });

            // Keep dropdown open while interacting inside it
            document.getElementById('filter-dropdown')?.addEventListener('click', e => e.stopPropagation());

            // Apply / Reset buttons inside dropdown
            document.getElementById('btnApplyFilters')?.addEventListener('click', applyFilters);
            document.getElementById('btnResetFilters')?.addEventListener('click', resetAllFilters);
        });

        // ========================================
        // Filter badges — sessionStorage persistence
        // ========================================
        const FILTER_KEY = 'appliedFilters_staffidcard';
        let appliedFilters = {};
        try {
            const stored = sessionStorage.getItem(FILTER_KEY);
            if (stored) appliedFilters = JSON.parse(stored);
        } catch (e) { appliedFilters = {}; }

        function saveAppliedFilters() {
            try { sessionStorage.setItem(FILTER_KEY, JSON.stringify(appliedFilters)); }
            catch (e) { console.warn('sessionStorage unavailable'); }
        }

        function clearAppliedFilters() {
            appliedFilters = {};
            try { sessionStorage.removeItem(FILTER_KEY); } catch (e) { }
        }

        function renderFilterBadges() {
            const container = document.getElementById('badgeContainer');
            const mainContainer = document.getElementById('activeFilterBadges');
            if (!container || !mainContainer) return;

            container.innerHTML = '';
            Object.entries(appliedFilters).forEach(([id, { label, text }]) => {
                const badge = document.createElement('span');
                badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center gap-1 fw-medium px-2 py-1';
                badge.innerHTML = `${label}: ${text} <i class="ti ti-x ms-1 cursor-pointer" onclick="removeFilter('${id}')" style="font-size:10px;"></i>`;
                container.appendChild(badge);
            });

            mainContainer.style.display = Object.keys(appliedFilters).length > 0 ? 'block' : 'none';
        }

        // ========================================
        // Applies search text + status filter to table rows (client-side)
        // ========================================
        function applyRowFilters() {
            const q = (document.getElementById('txtSearchInput')?.value || '').toLowerCase();
            const statusVal = document.getElementById('ddlFilterStatus')?.value || '';

            document.querySelectorAll('#staffIdCardTable tbody tr').forEach(row => {
                if (!row.classList.contains('item-row')) return;

                const matchesText = row.textContent.toLowerCase().includes(q);
                const matchesStatus = !statusVal || row.getAttribute('data-status') === statusVal;

                row.style.display = (matchesText && matchesStatus) ? '' : 'none';
            });
        }

        function applyFilters() {
            const searchEl = document.getElementById('txtSearchInput');
            const statusEl = document.getElementById('ddlFilterStatus');

            const searchVal = searchEl?.value.trim();
            if (searchVal) appliedFilters['txtSearchInput'] = { label: 'Search', text: searchVal };
            else delete appliedFilters['txtSearchInput'];

            if (statusEl?.value) {
                appliedFilters['ddlFilterStatus'] = {
                    label: 'Status',
                    text: statusEl.options[statusEl.selectedIndex]?.text || statusEl.value
                };
            } else delete appliedFilters['ddlFilterStatus'];

            saveAppliedFilters();
            renderFilterBadges();
            applyRowFilters();
        }

        function removeFilter(filterId) {
            if (filterId === 'ddlFilterStatus') {
                const el = document.getElementById('ddlFilterStatus');
                if (el) el.value = '';
            } else if (filterId === 'txtSearchInput') {
                const el = document.getElementById('txtSearchInput');
                if (el) el.value = '';
            }
            delete appliedFilters[filterId];
            saveAppliedFilters();
            renderFilterBadges();
            applyRowFilters();
        }

        function resetAllFilters() {
            document.getElementById('txtSearchInput').value = '';
            const statusEl = document.getElementById('ddlFilterStatus');
            if (statusEl) statusEl.value = '';

            clearAppliedFilters();
            renderFilterBadges();
            applyRowFilters();
        }

        function updateActionButtons() {
            let checkedCount = $('.student-checkbox:checked').length;
            $('#btnDelete').prop('disabled', checkedCount === 0);
            $('#btnActive').prop('disabled', checkedCount === 0);
            $('#btnInactive').prop('disabled', checkedCount === 0);
            $('#btnEdit').prop('disabled', checkedCount !== 1);

            selectedIDCardId = (checkedCount === 1)
                ? parseInt($('.student-checkbox:checked').val())
                : 0;
        }

        $(document).on('change', '.student-checkbox', function () {
            updateActionButtons();
        });

        window.selectItem = function (id, row) {
            if (event.target.type === "checkbox") return;
            let chk = $(row).find('.student-checkbox');
            chk.prop('checked', !chk.prop('checked'));

            $('.item-row').removeClass('bg-light');
            $('.student-checkbox:checked').each(function () {
                $(this).closest('tr').addClass('bg-light');
            });

            updateActionButtons();
        };

        window.getSelectedIDCardIds = function () {
            let ids = [];
            $('.student-checkbox:checked').each(function () {
                ids.push(parseInt($(this).val()));
            });
            return ids;
        };

        window.openAddModal = function () {
            $('#upsertForm')[0].reset();
            $('#IDCardID').val(0);
            $('#modalTitle').text('Add Staff ID Card');

            ['BackgroundImage', 'LogoImage', 'SignatureImage'].forEach(field => {
                $('#preview_' + field).addClass('d-none').find('img').attr('src', '');
                $('#' + field).val('');
                $('#' + field + 'Type').val('');
                $('#' + field + 'Name').val('');
            });

            $('#upsertModal').modal('show');
        };

        window.editSelected = function () {
            if (selectedIDCardId === 0) return;
            location.href = "/Certificate/AddStaffIdCard/" + selectedIDCardId;
        };

        window.deleteSelected = function () {
            if (selectedIDCardId === 0) return;
            deleteIDCard(selectedIDCardId);
        };

        window.handleImageUpload = function (input, prefix) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function (e) {
                    const base64 = e.target.result;
                    const parts = base64.split(',');
                    $('#' + prefix).val(parts[1]);
                    $('#' + prefix + 'Type').val(parts[0].split(':')[1].split(';')[0]);
                    $('#' + prefix + 'Name').val(file.name);
                    $('#preview_' + prefix).removeClass('d-none').find('img').attr('src', base64);
                };
                reader.readAsDataURL(file);
            }
        };

        window.deleteIDCard = function (id) {
            let selectedIds = getSelectedIDCardIds();
            if (selectedIds.length === 0 && id) selectedIds.push(parseInt(id));

            if (selectedIds.length === 0) {
                Swal.fire('Oops!', 'Please select at least one ID Card.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete the selected Staff ID Card(s). This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                customClass: {
                    confirmButton: 'btn btn-danger me-2',
                    cancelButton: 'btn btn-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Certificate/DeleteStaffIDCard',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(selectedIds),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', 'Staff ID Card(s) have been deleted.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error!', res.message || 'Failed to delete.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        };

        // id: pass a specific id to force single-row toggle (used by the per-row switch),
        // or 0 to use the current bulk checkbox selection (used by the top Active/Inactive buttons)
        window.toggleStatus = async function (id, isActive) {
            let ids = (id && id !== 0) ? [parseInt(id)] : getSelectedIDCardIds();

            if (ids.length === 0) {
                Swal.fire('Oops!', 'Please select at least one ID Card.', 'warning');
                return;
            }

            const request = {
                ids: ids.join(','),
                isActive: isActive,
                doneBy: currentUserId
            };

            const config = isActive
                ? {
                    icon: 'question',
                    title: 'Activate Record(s)?',
                    text: 'Activating will make the selected record(s) visible and available for use across the system. Continue?',
                    confirmButtonText: 'Yes, Activate',
                    confirmButtonColor: '#198754',
                    confirmButtonClass: 'btn btn-success me-2',
                    successTitle: 'Activated!',
                    successText: 'The selected record(s) have been activated.'
                }
                : {
                    icon: 'warning',
                    title: 'Deactivate Record(s)?',
                    text: 'Deactivating will hide the selected record(s) and prevent them from being used. Continue?',
                    confirmButtonText: 'Yes, Deactivate',
                    confirmButtonColor: '#d33',
                    confirmButtonClass: 'btn btn-danger me-2',
                    successTitle: 'Deactivated!',
                    successText: 'The selected record(s) have been deactivated.'
                };

            try {
                const result = await Swal.fire({
                    icon: config.icon,
                    title: config.title,
                    text: config.text,
                    showCancelButton: true,
                    confirmButtonColor: config.confirmButtonColor,
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: config.confirmButtonText,
                    customClass: {
                        confirmButton: config.confirmButtonClass,
                        cancelButton: 'btn btn-secondary'
                    },
                    buttonsStyling: false
                });

                if (!result.isConfirmed) {
                    if (id && id !== 0) location.reload();
                    return;
                }

                $.ajax({
                    url: '/Certificate/ToggleStaffIDCardStatus',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(request),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire(config.successTitle, res.message || config.successText, 'success')
                                .then(() => location.reload());
                        } else {
                            Swal.fire('Error!', res.message || 'Failed to update status.', 'error');
                        }
                    },
                    error: function (xhr) {
                        console.error('Status update error:', xhr.status, xhr.responseText);
                        Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                    }
                });
            } catch (err) {
                console.error(err);
                Swal.fire('Error!', 'Could not update status.', 'error');
            }
        };
    </script>
}

