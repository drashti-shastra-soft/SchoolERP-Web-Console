@using System.Security.Claims
@using System.Text.Json
@model SchoolERPWebConsole.Domain.StudentCertificatePageViewModel
@{
    ViewData["Title"] = "Add Student Certificate";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">

    <div>
        <h6 class="fw-bold mb-0">
            @(Model.EditStudentCertificate.CertificateID > 0 ? "Edit Student Certificate" : "Add Student Certificate")
        </h6>

    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveCertificate()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Certificate/StudentCertificate" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="upsertForm" class="row g-3">
                    <input type="hidden" id="CertificateID" name="CertificateID" value="0" />
                    <input type="hidden" id="CompanyID" name="CompanyID" value="0" />
                    <input type="hidden" id="SessionID" name="SessionID" value="0" />

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Certificate Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="CertificateName" value="@Model.EditStudentCertificate?.CertificateName" name="CertificateName" required>
                        <div class="invalid-feedback" id="errCertificationTitle"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Header Left Text</label>
                        <input type="text" class="form-control" id="HeaderLeftText" name="HeaderLeftText" value="@Model.EditStudentCertificate?.HeaderLeftText">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Header Center Text</label>
                        <input type="text" class="form-control" id="HeaderCenterText" name="HeaderCenterText" value="@Model.EditStudentCertificate?.HeaderCenterText">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Header Right Text</label>
                        <input type="text" class="form-control" id="HeaderRightText" name="HeaderRightText" value="@Model.EditStudentCertificate?.HeaderRightText">
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold"> Body Text <span class="text-danger">*</span> </label>
                        <textarea id="BodyText" name="BodyText" class="form-control">@Model.EditStudentCertificate?.BodyText</textarea>
                        <div class="invalid-feedback" id="errCertificationAddressPhoneEmail"></div>
                        <div class="mt-2 p-2 bg-light rounded border small text-muted">
                            <strong>Available Placeholders:</strong> [name], [dob], [present_address], [guardian], [created_at], [admission_no], [roll_no], [class], [section], [gender], [admission_date], [category], [cast], [father_name], [mother_name], [religion], [email], [phone], [student_photo]
                        </div>

                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Footer Left Text</label>
                        <input type="text" class="form-control" id="FooterLeftText" name="FooterLeftText" value="@Model.EditStudentCertificate?.FooterLeftText">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Footer Center Text</label>
                        <input type="text" class="form-control" id="FooterCenterText" name="FooterCenterText" value="@Model.EditStudentCertificate?.FooterCenterText">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Footer Right Text</label>
                        <input type="text" class="form-control" id="FooterRightText" name="FooterRightText" value="@Model.EditStudentCertificate?.FooterRightText">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Header Height (px)</label>
                        <input type="number" step="0.01" class="form-control" id="HeaderHeight" name="HeaderHeight" value="@Model.EditStudentCertificate?.HeaderHeight">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Footer Height (px)</label>
                        <input type="number" step="0.01" class="form-control" id="FooterHeight" name="FooterHeight" value="@Model.EditStudentCertificate?.FooterHeight">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Body Height (px)</label>
                        <input type="number" step="0.01" class="form-control" id="BodyHeight" name="BodyHeight" value="@Model.EditStudentCertificate?.BodyHeight">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Body Width (px)</label>
                        <input type="number" step="0.01" class="form-control" id="BodyWidth" name="BodyWidth" value="@Model.EditStudentCertificate?.BodyWidth">
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" id="EnableStudentPhoto" name="EnableStudentPhoto" @(Model.EditStudentCertificate?.EnableStudentPhoto == true ? "checked" : "") />
                            <label class="form-check-label fw-bold" for="EnableStudentPhoto" value="@Model.EditStudentCertificate?.EnableStudentPhoto">Enable Student Photo</label>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Background Image</label>
                        <input type="file" class="form-control" id="BackgroundImageFile" name="BackgroundImageFile" accept="image/*">
                        <small class="text-muted" id="fileInfo"></small>

                        @if (!string.IsNullOrEmpty(Model.EditStudentCertificate?.BackgroundImageName))
                        {
                            <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                <a href="@Model.EditStudentCertificate.BackgroundImage" target="_blank" class="small">
                                    <i class="ti ti-paperclip me-1"></i>@Model.EditStudentCertificate.BackgroundImageName
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingBackgroundImage()">
                                    <i class="ti ti-x"></i>
                                </button>
                            </div>
                        }

                        <!-- Tells the backend whether to keep, replace, or delete the existing image -->
                        <input type="hidden" id="hdnExistingBackgroundImage" name="ExistingBackgroundImageName" value="@Model.EditStudentCertificate?.BackgroundImageName">
                        <input type="hidden" id="hdnRemoveBackgroundImage" name="RemoveBackgroundImage" value="false">
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>

        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);

        window.handleImageUpload = function (input) {

            if (input.files && input.files[0]) {

                const file = input.files[0];
                const reader = new FileReader();

                reader.onload = function (e) {

                    const base64 = e.target.result;
                    const parts = base64.split(',');

                    $('#BackgroundImage').val(parts[1]);
                    $('#BackgroundImageType').val(parts[0].split(':')[1].split(';')[0]);
                    $('#BackgroundImageName').val(file.name);

                    $('#imagePreview').removeClass('d-none');
                    $('#imagePreview img').attr('src', base64);
                };

                reader.readAsDataURL(file);
            }
        };

        const IV = {

            setFieldError: function (fieldId, errorId, message) {
                $('#' + fieldId).addClass('is-invalid');
                $('#' + errorId).text(message);
            },

            clearFieldError: function (fieldId, errorId) {
                $('#' + fieldId).removeClass('is-invalid');
                $('#' + errorId).text('');
            }
        };

        function saveCertificate() {

            IV.clearFieldError('CertificateName', 'errCertificationTitle');
            IV.clearFieldError('BodyText', 'errCertificationAddressPhoneEmail');

            var isValid = true;

            const certificateName = $('#CertificateName').val().trim();
            const bodyText = $('#BodyText').val().trim();

            if (!certificateName) {

                IV.setFieldError(
                    'CertificateName',
                    'errCertificationTitle',
                    'Certification Name is required.'
                );

                isValid = false;
            }

            if (!bodyText) {

                IV.setFieldError(
                    'BodyText',
                    'errCertificationAddressPhoneEmail',
                    'Body Text is required.'
                );

                isValid = false;
            }

            if (!isValid)
                return;

            const formData = new FormData();

            formData.append("CertificateID", $("#CertificateID").val() || 0);
            formData.append("CompanyId", $("#CompanyID").val() || 0);
            formData.append("SessionId", $("#SessionID").val() || 0);
            formData.append("CertificateName", certificateName);
            formData.append("HeaderLeftText", $("#HeaderLeftText").val() || "");
            formData.append("HeaderCenterText", $("#HeaderCenterText").val() || "");
            formData.append("HeaderRightText", $("#HeaderRightText").val() || "");
            formData.append("BodyText", bodyText);
            formData.append("FooterLeftText", $("#FooterLeftText").val() || "");
            formData.append("FooterCenterText", $("#FooterCenterText").val() || "");
            formData.append("FooterRightText", $("#FooterRightText").val() || "");
            formData.append("HeaderHeight", $("#HeaderHeight").val() || "");
            formData.append("FooterHeight", $("#FooterHeight").val() || "");
            formData.append("BodyHeight", $("#BodyHeight").val() || "");
            formData.append("BodyWidth", $("#BodyWidth").val() || "");
            formData.append("EnableStudentPhoto", $("#EnableStudentPhoto").is(":checked"));
            formData.append("IsActive", true);

            formData.append("ExistingBackgroundImageName",
                $("#hdnExistingBackgroundImage").val() || "");

            formData.append("RemoveBackgroundImage",
                $("#hdnRemoveBackgroundImage").val() || "false");

            const fileInput = document.getElementById("BackgroundImageFile");

            if (fileInput.files.length > 0) {
                formData.append("backgroundImageFile", fileInput.files[0]);
            }

            $.ajax({

                url: "/Certificate/UpsertStudentCertificate",
                type: "POST",
                data: formData, 
                processData: false,
                contentType: false,

                success: function (resp) {

                    if (resp.success) {

                        Swal.fire({
                            icon: "success",
                            title: "Saved",
                            text: resp.message,
                            confirmButtonText: "OK"
                        }).then(function () {

                            window.location.href = "/Certificate/StudentCertificate";

                        });

                    } else {

                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: resp.message
                        });

                    }
                },

                error: function () {

                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "Error saving certificate."
                    });

                }

            });

        }

        const maxFileSizeMB = 1;
        const maxFileSizeBytes = maxFileSizeMB * 1024 * 1024;
        const allowedImageTypes = ["image/jpeg", "image/png", "image/gif", "image/webp"];

        document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("BackgroundImageFile").addEventListener("change", function () {

                    const fileInfo = document.getElementById("fileInfo");
                    const file = this.files[0];

                    if (!file) {

                        fileInfo.textContent = "";
                        return;
                    }

                    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                    if (!allowedImageTypes.includes(file.type)) {

                        fileInfo.textContent = "Only JPG, PNG, GIF and WEBP are allowed.";

                        fileInfo.classList.remove("text-muted");
                        fileInfo.classList.add("text-danger");

                        this.value = "";

                        return;
                    }

                    if (file.size > maxFileSizeBytes) {

                        fileInfo.textContent = "Maximum allowed size is 1 MB.";

                        fileInfo.classList.remove("text-muted");
                        fileInfo.classList.add("text-danger");

                        this.value = "";

                        return;
                    }

                    fileInfo.textContent = "Selected file size : " + sizeMB + " MB";

                    fileInfo.classList.remove("text-danger");
                    fileInfo.classList.add("text-muted");

                    document.getElementById("hdnRemoveBackgroundImage").value = "false";

                    document.getElementById("existingFileInfo")?.remove();

                });
        });
    </script>

    <script src="~/js/inline-form-validation.js"></script>
}