@using System.Text.Json
@model SchoolERPWebConsole.Domain.StudentIDCardAddViewModel

@{
    ViewData["Title"] = "Add Student ID Card";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(Model.EditStudentIDCard == null ? "Add Student ID Card" : "Edit Student ID Card")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">

        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveIDCard()">
                <i class="ti ti-device-floppy me-1"></i>
                Save
            </button>
        }

        <a href="/Certificate/StudentIdCard" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i>
            Back
        </a>

    </div>
</div>


<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="upsertForm" class="row g-3">
                    @* <input type="hidden" id="IDCardID" name="IDCardID" value="0" /> *@
                    <input type="hidden" id="IDCardID" name="IDCardID" value="@(Model.EditStudentIDCard?.IDCardID ?? 0)" />
                    <input type="hidden" id="CompanyID" name="CompanyID" value="@(Model.EditStudentIDCard?.CompanyID ?? 0)" />
                    <input type="hidden" id="SessionID" name="SessionID" value="@(Model.EditStudentIDCard?.SessionID ?? 0)" />

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ID Card Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="IDCardTitle" name="IDCardTitle" value="@Model.EditStudentIDCard?.IDCardTitle">
                        <div class="invalid-feedback" id="errstudentIDCardTitle"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">School Name</label>
                        <input type="text" class="form-control" id="SchoolName" name="SchoolName" value="@Model.EditStudentIDCard?.SchoolName">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Header Color</label>
                        <input type="color" class="form-control" id="HeaderColor" name="HeaderColor" value="#000000" value="@(Model.EditStudentIDCard?.HeaderColor ?? "#000000")">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Design Type</label>
                        <select class="form-select" id="DesignType" name="DesignType">
                            <option value="1" selected="@(Model.EditStudentIDCard?.DesignType == 1)">Horizontal</option>
                            <option value="2" selected="@(Model.EditStudentIDCard?.DesignType == 2)">Vertical</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Address / Phone / Email <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="AddressPhoneEmail" name="AddressPhoneEmail" rows="2">@Model.EditStudentIDCard?.AddressPhoneEmail</textarea>
                        <div class="invalid-feedback" id="errstudentAddressPhoneEmail"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Background Image</label>
                        <input type="file" class="form-control" id="BackgroundImageFile" onchange="handleImageUpload(this, 'BackgroundImage')">
                        <input type="hidden" id="BackgroundImage" name="BackgroundImage">
                        <input type="hidden" id="BackgroundImageType" name="BackgroundImageType">
                        <input type="hidden" id="BackgroundImageName" name="BackgroundImageName">
                        <div id="preview_BackgroundImage" class="mt-2 d-none text-center">
                            <img src="" width="100" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Logo</label>
                        <input type="file" class="form-control" id="LogoImageFile" onchange="handleImageUpload(this, 'LogoImage')">
                        <input type="hidden" id="LogoImage" name="LogoImage">
                        <input type="hidden" id="LogoImageType" name="LogoImageType">
                        <input type="hidden" id="LogoImageName" name="LogoImageName">
                        <div id="preview_LogoImage" class="mt-2 d-none text-center">
                            <img src="" width="60" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Signature</label>
                        <input type="file" class="form-control" id="SignatureImageFile" onchange="handleImageUpload(this, 'SignatureImage')">
                        <input type="hidden" id="SignatureImage" name="SignatureImage">
                        <input type="hidden" id="SignatureImageType" name="SignatureImageType">
                        <input type="hidden" id="SignatureImageName" name="SignatureImageName">
                        <div id="preview_SignatureImage" class="mt-2 d-none text-center">
                            <img src="" width="100" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-12 mt-4">
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Visibility Toggles</h6>
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffName" name="ShowStaffName" checked>
                                    <label class="form-check-label" for="ShowStaffName">Staff Name</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDesignation" name="ShowDesignation" checked>
                                    <label class="form-check-label" for="ShowDesignation">Designation</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffID" name="ShowStaffID" checked>
                                    <label class="form-check-label" for="ShowStaffID">Staff ID</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDepartment" name="ShowDepartment" checked>
                                    <label class="form-check-label" for="ShowDepartment">Department</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDOJ" name="ShowDOJ" checked>
                                    <label class="form-check-label" for="ShowDOJ">Date of Joining</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowPhone" name="ShowPhone" checked>
                                    <label class="form-check-label" for="ShowPhone">Phone</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowBloodGroup" name="ShowBloodGroup" checked>
                                    <label class="form-check-label" for="ShowBloodGroup">Blood Group</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffAddress" name="ShowStaffAddress" checked>
                                    <label class="form-check-label" for="ShowStaffAddress">Staff Address</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowBarcode" name="ShowBarcode" checked>
                                    <label class="form-check-label" for="ShowBarcode">Bar Code</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
         const IV = {
            setFieldError: function (fieldId, errorId, message) {
                $('#' + fieldId).addClass('is-invalid');
                $('#' + errorId).text(message);
            },
            clearFieldError: function (fieldId, errorId) {
                $('#' + fieldId).removeClass('is-invalid');
                $('#' + errorId).text('');
            }
        };
        var selectedIDCardId = 0;

        window.selectItem = function(id, row) { /* ...unchanged... */ };
        window.openAddModal = function() { /* ...unchanged... */ };
        window.editSelected = function() { /* ...unchanged... */ };
        window.deleteSelected = function() { /* ...unchanged... */ };
        window.handleImageUpload = function(input, prefix) { /* ...unchanged... */ };

        window.saveIDCard = function () {

            IV.clearFieldError('IDCardTitle', 'errstudentIDCardTitle');
            IV.clearFieldError('AddressPhoneEmail', 'errstudentAddressPhoneEmail');

            var isValid = true;

            if (!$('#IDCardTitle').val().trim()) {
                IV.setFieldError('IDCardTitle', 'errstudentIDCardTitle', 'ID Card Title is required.');
                isValid = false;
            }

            if (!$('#AddressPhoneEmail').val().trim()) {
                IV.setFieldError('AddressPhoneEmail', 'errstudentAddressPhoneEmail', 'Address / Phone / Email is required.');
                isValid = false;
            }

            if (!isValid)
                return;

            const formData = new FormData();

            formData.append("IDCardID", $('#IDCardID').val() || 0);
            formData.append("IDCardTitle", $('#IDCardTitle').val());
            formData.append("SchoolName", $('#SchoolName').val());
            formData.append("HeaderColor", $('#HeaderColor').val());
            formData.append("AddressPhoneEmail", $('#AddressPhoneEmail').val());

            formData.append("ShowAdmissionNo", $('#ShowAdmissionNo').is(':checked'));
            formData.append("ShowStudentName", $('#ShowStudentName').is(':checked'));
            formData.append("ShowClass", $('#ShowClass').is(':checked'));
            formData.append("ShowFatherName", $('#ShowFatherName').is(':checked'));
            formData.append("ShowMotherName", $('#ShowMotherName').is(':checked'));
            formData.append("ShowStudentAddress", $('#ShowStudentAddress').is(':checked'));
            formData.append("ShowPhone", $('#ShowPhone').is(':checked'));
            formData.append("ShowDOB", $('#ShowDOB').is(':checked'));
            formData.append("ShowBloodGroup", $('#ShowBloodGroup').is(':checked'));
            formData.append("DesignType", $('#DesignType').val());
            formData.append("ShowBarcode", $('#ShowBarcode').is(':checked'));
            formData.append("IsActive", true);
            formData.append("CompanyID", $('#CompanyID').val() || 0);
            formData.append("SessionID", $('#SessionID').val() || 0);
            // Background
            const bgFile = document.getElementById("BackgroundImageFile");
            if (bgFile && bgFile.files.length > 0) {
                formData.append("BackgroundImageFile", bgFile.files[0]);
            }

            // Logo
            const logoFile = document.getElementById("LogoImageFile");
            if (logoFile && logoFile.files.length > 0) {
                formData.append("LogoImageFile", logoFile.files[0]);
            }

            // Signature
            const signFile = document.getElementById("SignatureImageFile");
            if (signFile && signFile.files.length > 0) {
                formData.append("SignatureImageFile", signFile.files[0]);
            }

            $.ajax({
                url: '/Certificate/UpsertStudentIDCard',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (resp) {

                    if (resp.success) {

                        Swal.fire({
                            icon: 'success',
                            title: 'Saved!',
                            text: 'Student ID Card has been saved successfully.'
                        }).then(function () {
                            window.location.href = '/Certificate/StudentIdCard';
                        });

                    } else {

                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: resp.message
                        });

                    }

                },
                error: function () {

                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Unexpected error occurred.'
                    });

                }
            });

        };

        window.editIDCard = function(id) { /* ...unchanged... */ };
        window.toggleStatus = function(id, isActive) { /* ...unchanged... */ };
        window.deleteIDCard = function(id) { /* ...unchanged... */ };

        function triggerExport(index) {
           if ($.fn.DataTable.isDataTable('#idCardTable')) {
                const table = $('#idCardTable').DataTable();
                table.button(index).trigger();
           }
        }

        // DataTable init isolated LAST, wrapped so it can't break anything above
        let table;
        $(document).ready(function () {
            try {
                table = $('#idCardTable').DataTable({
                    dom: 'Bfrtip',
                    buttons: [
                        { extend: 'copy', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'csv', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'excel', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'pdf', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'print', exportOptions: { columns: [1, 2, 3] } }
                    ],
                    searching: false,
                    paging: false,
                    info: false
                });
            } catch (e) {
                console.error('DataTable init failed:', e);
            }
        });

    </script>
}