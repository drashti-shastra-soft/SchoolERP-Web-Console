@using System.Text.Json
@model SchoolERPWebConsole.Domain.StaffIDCardAddViewModel

@{
    ViewData["Title"] = "Add Staff ID Card";
    var p = Model.Permissions;
}

<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">
            @(Model.EditStaffIDCard == null ? "Add Staff ID Card" : "Edit Staff ID Card")
        </h6>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1">

        @if (p.CanAdd || p.CanEdit)
        {
            <button type="button" class="btn btn-success top-btn" onclick="saveIDCard()"><i class="ti ti-device-floppy me-1"></i>Save</button>
        }
        <a href="/Certificate/StaffIdCard" class="btn btn-secondary top-btn"><i class="ti ti-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="upsertForm" class="row g-3">
                    @* <input type="hidden" id="IDCardID" name="IDCardID" value="0" /> *@

                    <input type="hidden" id="IDCardID" name="IDCardID" value="@(Model.EditStaffIDCard?.IDCardID ?? 0)" />
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">ID Card Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="IDCardTitle" name="IDCardTitle" value="@Model.EditStaffIDCard?.IDCardTitle" required>
                        <div class="invalid-feedback" id="errIDCardTitle"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">School Name</label>
                        <input type="text" class="form-control" id="SchoolName" name="SchoolName" value="@Model.EditStaffIDCard?.SchoolName">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Header Color</label>
                        <input type="color" class="form-control" id="HeaderColor" name="HeaderColor" value="#000000" value="@(Model.EditStaffIDCard?.HeaderColor ?? "#000000")>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Design Type</label>
                        <select class="form-select" id="DesignType" name="DesignType">
                            <option value="1" selected="@(Model.EditStaffIDCard?.DesignType == 1)">Horizontal</option>
                            <option value="2" selected="@(Model.EditStaffIDCard?.DesignType == 2)">Vertical</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-semibold">Address / Phone / Email <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="AddressPhoneEmail" name="AddressPhoneEmail" rows="2">@Model.EditStaffIDCard?.AddressPhoneEmail</textarea>
                        <div class="invalid-feedback" id="errAddressPhoneEmail"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Background Image</label>
                        <input type="file" class="form-control" id="BackgroundImageFile" onchange="handleImageUpload(this, 'BackgroundImage')">
                        <input type="hidden" id="BackgroundImage" name="BackgroundImage">
                        <input type="hidden" id="BackgroundImageType" name="BackgroundImageType">
                        <input type="hidden" id="BackgroundImageName" name="BackgroundImageName">
                        <div id="preview_BackgroundImage" class="mt-2 d-none text-center">
                            <img src="" width="100" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Logo</label>
                        <input type="file" class="form-control" id="LogoImageFile" onchange="handleImageUpload(this, 'LogoImage')">
                        <input type="hidden" id="LogoImage" name="LogoImage">
                        <input type="hidden" id="LogoImageType" name="LogoImageType">
                        <input type="hidden" id="LogoImageName" name="LogoImageName">
                        <div id="preview_LogoImage" class="mt-2 d-none text-center">
                            <img src="" width="60" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Signature</label>
                        <input type="file" class="form-control" id="SignatureImageFile" onchange="handleImageUpload(this, 'SignatureImage')">
                        <input type="hidden" id="SignatureImage" name="SignatureImage">
                        <input type="hidden" id="SignatureImageType" name="SignatureImageType">
                        <input type="hidden" id="SignatureImageName" name="SignatureImageName">
                        <div id="preview_SignatureImage" class="mt-2 d-none text-center">
                            <img src="" width="100" class="rounded border shadow-sm" />
                        </div>
                    </div>

                    <div class="col-md-12 mt-4">
                        <h6 class="fw-bold border-bottom pb-2 mb-3">Visibility Toggles</h6>
                        <div class="row">
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffName" name="ShowStaffName" checked>
                                    <label class="form-check-label" for="ShowStaffName">Staff Name</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDesignation" name="ShowDesignation" checked>
                                    <label class="form-check-label" for="ShowDesignation">Designation</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffID" name="ShowStaffID" checked>
                                    <label class="form-check-label" for="ShowStaffID">Staff ID</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDepartment" name="ShowDepartment" checked>
                                    <label class="form-check-label" for="ShowDepartment">Department</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowDOJ" name="ShowDOJ" checked>
                                    <label class="form-check-label" for="ShowDOJ">Date of Joining</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowPhone" name="ShowPhone" checked>
                                    <label class="form-check-label" for="ShowPhone">Phone</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowBloodGroup" name="ShowBloodGroup" checked>
                                    <label class="form-check-label" for="ShowBloodGroup">Blood Group</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowStaffAddress" name="ShowStaffAddress" checked>
                                    <label class="form-check-label" for="ShowStaffAddress">Staff Address</label>
                                </div>
                            </div>
                            <div class="col-md-3 mb-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ShowBarcode" name="ShowBarcode" checked>
                                    <label class="form-check-label" for="ShowBarcode">Bar Code</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function triggerExport(index) {
           if ($.fn.DataTable.isDataTable('#idCardTable')) {
                const table = $('#idCardTable').DataTable();
                table.button(index).trigger();
           }
        }

        let table;
        $(document).ready(function () {
            try {
                table = $('#idCardTable').DataTable({
                    dom: 'Bfrtip',
                    buttons: [
                        { extend: 'copy', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'csv', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'excel', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'pdf', exportOptions: { columns: [1, 2, 3] } },
                        { extend: 'print', exportOptions: { columns: [1, 2, 3] } }
                    ],
                    searching: false,
                    paging: false,
                    info: false
                });
            } catch (e) {
                console.error('DataTable init failed:', e);
            }
        });

        var selectedIDCardId = 0;

        window.selectItem = function(id, row) {
            selectedIDCardId = id;
            document.querySelectorAll('#idCardTable tbody .item-row').forEach(r => r.classList.remove('bg-light'));
            row.classList.add('bg-light');

            document.getElementById('btnEdit').disabled = false;
            document.getElementById('btnDelete').disabled = false;
        };

        window.openAddModal = function() {
            $('#upsertForm')[0].reset();
            $('#IDCardID').val(0);
            $('#modalTitle').text('Add Staff ID Card');

            ['BackgroundImage', 'LogoImage', 'SignatureImage'].forEach(field => {
                $('#preview_' + field).addClass('d-none').find('img').attr('src', '');
                $('#' + field).val('');
                $('#' + field + 'Type').val('');
                $('#' + field + 'Name').val('');
            });

            $('#upsertModal').modal('show');
        };

        window.editSelected = function() {
            if (selectedIDCardId === 0) return;
            editIDCard(selectedIDCardId);
        };

        window.deleteSelected = function() {
            if (selectedIDCardId === 0) return;
            deleteIDCard(selectedIDCardId);
        };

        window.handleImageUpload = function(input, prefix) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = function (e) {
                    const base64 = e.target.result;
                    const parts = base64.split(',');
                    $('#' + prefix).val(parts[1]);
                    $('#' + prefix + 'Type').val(parts[0].split(':')[1].split(';')[0]);
                    $('#' + prefix + 'Name').val(file.name);

                    $('#preview_' + prefix).removeClass('d-none').find('img').attr('src', base64);
                };
                reader.readAsDataURL(file);
            }
        };
        const IV = {
            setFieldError: function (fieldId, errorId, message) {
                $('#' + fieldId).addClass('is-invalid');
                $('#' + errorId).text(message);
            },
            clearFieldError: function (fieldId, errorId) {
                $('#' + fieldId).removeClass('is-invalid');
                $('#' + errorId).text('');
            }
        };
        window.saveIDCard = function() {

            IV.clearFieldError('IDCardTitle', 'errIDCardTitle');
            IV.clearFieldError('AddressPhoneEmail', 'errAddressPhoneEmail');

            var data = {
                IDCardID: parseInt($('#IDCardID').val()) || 0,
                IDCardTitle: $('#IDCardTitle').val(),
                SchoolName: $('#SchoolName').val(),
                HeaderColor: $('#HeaderColor').val(),
                DesignType: parseInt($('#DesignType').val()) || 1,
                AddressPhoneEmail: $('#AddressPhoneEmail').val(),

                BackgroundImage: $('#BackgroundImage').val(),
                BackgroundImageType: $('#BackgroundImageType').val(),
                BackgroundImageName: $('#BackgroundImageName').val(),

                LogoImage: $('#LogoImage').val(),
                LogoImageType: $('#LogoImageType').val(),
                LogoImageName: $('#LogoImageName').val(),

                SignatureImage: $('#SignatureImage').val(),
                SignatureImageType: $('#SignatureImageType').val(),
                SignatureImageName: $('#SignatureImageName').val(),

                ShowStaffName: $('#ShowStaffName').is(':checked'),
                ShowDesignation: $('#ShowDesignation').is(':checked'),
                ShowStaffID: $('#ShowStaffID').is(':checked'),
                ShowDepartment: $('#ShowDepartment').is(':checked'),
                ShowDOJ: $('#ShowDOJ').is(':checked'),
                ShowPhone: $('#ShowPhone').is(':checked'),
                ShowBloodGroup: $('#ShowBloodGroup').is(':checked'),
                ShowStaffAddress: $('#ShowStaffAddress').is(':checked'),
                ShowBarcode: $('#ShowBarcode').is(':checked'),

                IsActive: true
            };

            var isValid = true;

                if (!data.IDCardTitle || !data.IDCardTitle.trim()) {
                    IV.setFieldError('IDCardTitle', 'errIDCardTitle', 'ID Card Title is required.');
                    isValid = false;
                }

                if (!data.AddressPhoneEmail || !data.AddressPhoneEmail.trim()) {
                    IV.setFieldError('AddressPhoneEmail', 'errAddressPhoneEmail', 'Address / Phone / Email is required.');
                    isValid = false;
                }

            if (!isValid) return;

            var missing = [];
            if (!data.IDCardTitle || !data.IDCardTitle.trim()) missing.push('ID Card Title');
            if (!data.AddressPhoneEmail || !data.AddressPhoneEmail.trim()) missing.push('Address / Phone / Email');

            if (missing.length > 0) {
                Swal.fire({
                    title: 'Missing Information',
                    html: 'Please fill the following mandatory field(s):<br><br>' +
                          '<ul style="text-align:left; display:inline-block; margin:0;">' +
                          missing.map(function (f) { return '<li>' + f + '</li>'; }).join('') +
                          '</ul>',
                    icon: 'warning',
                    confirmButtonText: 'OK',
                    customClass: {
                        confirmButton: 'btn btn-primary'
                    },
                    buttonsStyling: false
                });
                return;
            }

               $.ajax({
                url: '/Certificate/UpsertStaffIDCard',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (resp) {
                    if (resp.success) {
                        Swal.fire({
                            title: 'Saved!',
                            text: 'Staff ID Card has been saved successfully.',
                            icon: 'success',
                            confirmButtonText: 'OK',
                            customClass: {
                                confirmButton: 'btn btn-success'
                            },
                            buttonsStyling: false
                        }).then(() => {
                            window.location.href = '/Certificate/StaffIdCard';
                        });
                    } else {
                        Swal.fire({
                            title: 'Error!',
                            text: resp.message || 'Failed to save ID Card.',
                            icon: 'error',
                            confirmButtonText: 'OK',
                            customClass: {
                                confirmButton: 'btn btn-danger'
                            },
                            buttonsStyling: false
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        title: 'Error!',
                        text: 'An unexpected error occurred while saving.',
                        icon: 'error',
                        confirmButtonText: 'OK',
                        customClass: {
                            confirmButton: 'btn btn-danger'
                        },
                        buttonsStyling: false
                    });
                }
            });
        };

        window.editIDCard = function(id) {
            $.get('/Certificate/GetStaffIDCardByID?id=' + id, function (resp) {
                if (resp.success) {
                    var data = resp.data;
                    $('#IDCardID').val(data.idCardID);
                    $('#IDCardTitle').val(data.idCardTitle);
                    $('#SchoolName').val(data.schoolName);
                    $('#HeaderColor').val(data.headerColor || '#000000');
                    $('#DesignType').val(data.designType);
                    $('#AddressPhoneEmail').val(data.addressPhoneEmail);

                    $('#ShowStaffName').prop('checked', data.showStaffName);
                    $('#ShowDesignation').prop('checked', data.showDesignation);
                    $('#ShowStaffID').prop('checked', data.showStaffID);
                    $('#ShowDepartment').prop('checked', data.showDepartment);
                    $('#ShowDOJ').prop('checked', data.showDOJ);
                    $('#ShowPhone').prop('checked', data.showPhone);
                    $('#ShowBloodGroup').prop('checked', data.showBloodGroup);
                    $('#ShowStaffAddress').prop('checked', data.showStaffAddress);
                    $('#ShowBarcode').prop('checked', data.showBarcode);

                    if (data.backgroundImageBase64) {
                        $('#preview_BackgroundImage').removeClass('d-none').find('img').attr('src', data.backgroundImageBase64);
                    } else {
                        $('#preview_BackgroundImage').addClass('d-none');
                    }
                    if (data.logoImageBase64) {
                        $('#preview_LogoImage').removeClass('d-none').find('img').attr('src', data.logoImageBase64);
                    } else {
                        $('#preview_LogoImage').addClass('d-none');
                    }
                    if (data.signatureImageBase64) {
                        $('#preview_SignatureImage').removeClass('d-none').find('img').attr('src', data.signatureImageBase64);
                    } else {
                        $('#preview_SignatureImage').addClass('d-none');
                    }

                    $('#modalTitle').text('Edit Staff ID Card');
                    $('#upsertModal').modal('show');
                }
            });
        };

        window.toggleStatus = function(id, isActive) {
            $.post('/Certificate/ToggleStaffIDCardStatus?id=' + id + '&isActive=' + isActive, function (resp) {
                if (!resp.success) alert(resp.message);
            });
        };

        window.deleteIDCard = function(id) {
            if (!id) {
                Swal.fire('Oops!', 'No ID Card selected to delete.', 'warning');
                return;
            }

            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete this Staff ID Card. This action cannot be undone!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                customClass: {
                    confirmButton: 'btn btn-danger me-2',
                    cancelButton: 'btn btn-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Certificate/DeleteStaffIDCard',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify([id]),
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', 'Staff ID Card has been deleted.', 'success')
                                    .then(() => location.reload());
                            } else {
                                Swal.fire('Error!', res.message || 'Failed to delete ID Card.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'An unexpected error occurred.', 'error');
                        }
                    });
                }
            });
        };

    </script>
}
