@*
    ======================================================================
    VIEW: Academics / Class.cshtml
    PURPOSE: User interface for managing Classes and their Section mappings.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.StudentFeePageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Student Fee";
    var p = Model.Permissions;
}

<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Student Fee</h6>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">

        <button id="btnEdit" class="btn btn-primary top-btn" disabled>
            <i class="ti ti-pencil me-1"></i>Collect Fees
        </button>
        
       
    </div>
</div>

<div id="classPageNotice"></div>

<div class="row">

    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <!-- ── Search box (name="search" so form submits it) ── -->
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text"
                               name="search"
                               id="txtSearchInput"
                               value="@Model.SearchTerm"
                               class="form-control border-0 ps-2 search-input-responsive"
                               placeholder="Search by Name..." />
                    </div>

                    <!-- Hidden form for filter submission — outside Bootstrap dropdown -->
                    <form method="get" asp-action="Index" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                        <input type="hidden" name="sessionID" id="hdnSessionID" value="@Model.SessionId" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value="@Model.CompanyId" />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                    </form>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl"
                             id="filter-dropdown">

                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn text-primary"
                                            onclick="resetAllFilters()" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="submit" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                            id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="filter-body pb-0">
                                <div class="row">
                                    @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                               {
                                   Companies = Model.Companies,
                                   Sessions = Model.Sessions,
                                   CompanyId = Model.CompanyId,
                                   SessionId = Model.SessionId
                               })
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label mb-1">
                                        Class<span class="text-danger">*</span>
                                    </label>
                                    <select id="classSelect" class="form-select form-control select2" required>
                                        <option value="">Select Class</option>
                                        @if (Model.ClassList != null)
                                        {
                                            foreach (var c in Model.ClassList)
                                            {
                                                <option value="@c.ClassID">@c.ClassName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label mb-1">
                                        Section<span class="text-danger">*</span>
                                    </label>
                                    <select id="sectionSelect" class="form-select form-control select2" required>
                                        <option value="">Select Section</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <div id="StudentFeeTableContainer">
        @await Html.PartialAsync("_StudentFeeTablePartial", Model)
    </div>


</div>



@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }
        /* Select2 Bootstrap 5 Integration */
        .select2-container--default .select2-selection--multiple {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            min-height: 38px;
            padding: 2px 5px;
        }

        .select2-container--default.select2-container--focus .select2-selection--multiple {
            border-color: #86b7fe;
            outline: 0;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #0d6efd;
            border: none;
            color: #fff;
            border-radius: 4px;
            padding: 2px 8px;
            margin-top: 4px;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: #fff;
            margin-right: 5px;
            border: none;
            background: none;
        }

            .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
                color: #ffc107;
                background: none;
            }

        .select2-container {
            width: 100% !important;
        }

        .select2-dropdown {
            z-index: 1060; /* Higher than bootstrap modal */
        }
    </style>
}

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);

        // ========================================
        // Filter badges — sessionStorage persistence
        // ========================================
        const FILTER_KEY = 'appliedFilters_studentFees';
        let appliedFilters = {};

        // On every fresh full-page load, clear stale filters from a previous visit.
        (function resetFiltersOnFreshLoad() {
            try { sessionStorage.removeItem(FILTER_KEY); }
            catch (e) { console.warn('sessionStorage unavailable'); }
            appliedFilters = {};
        })();

        function saveAppliedFilters() {
            try { sessionStorage.setItem(FILTER_KEY, JSON.stringify(appliedFilters)); }
            catch (e) { console.warn('sessionStorage unavailable'); }
        }

        function clearAppliedFilters() {
            appliedFilters = {};
            try { sessionStorage.removeItem(FILTER_KEY); } catch (e) { }
        }

        function setFieldInvalid(fieldId, message) {
            const el = document.getElementById(fieldId);
            if (!el) return;
            const $el = $(el);
            const $s2 = $el.next('.select2-container').find('.select2-selection');
            if ($s2.length) {
                $s2.css({ 'border-color': '#dc3545', 'border-width': '1px', 'border-style': 'solid' });
            } else {
                $el.addClass('is-invalid').css('border-color', '#dc3545');
            }
            let $feedback = $(`#${fieldId}-error`);
            if ($feedback.length === 0) {
                $feedback = $(`<div id="${fieldId}-error" class="text-danger small mt-1"></div>`);
                $el.closest('.col-md-6, .col-md-12, .mb-3').append($feedback);
            }
            $feedback.text(message).show();
        }

        function clearFieldInvalid(fieldId) {
            const el = document.getElementById(fieldId);
            if (!el) return;
            const $el = $(el);
            const $s2 = $el.next('.select2-container').find('.select2-selection');
            if ($s2.length) {
                $s2.css({ 'border-color': '', 'border-width': '', 'border-style': '' });
            } else {
                $el.removeClass('is-invalid').css('border-color', '');
            }
            $(`#${fieldId}-error`).hide();
        }

        $(document).ready(function () {
            $('.select2').select2({ dropdownParent: $('#filter-dropdown') });

            // Stop dropdown from closing when clicking inside
            $('#filter-dropdown').on('click', function (e) {
                e.stopPropagation();
            });

            $('#classSelect').on('change', function () {
                loadSections($(this).val(), '#sectionSelect');
                if ($(this).val()) clearFieldInvalid('classSelect');
            });

            $('#sectionSelect').on('change', function () {
                if ($(this).val()) clearFieldInvalid('sectionSelect');
            });

            // Enter key in the search box submits the same form
            $('#txtSearchInput').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    $('#hdnSearch').val($(this).val());
                    $('#hdnPageIndex').val(1);
                    $('#frmSearch').submit();
                }
            });

            // ── Row checkbox selection (radio-like: only one at a time) ───────
            // Delegated on document because the table body gets replaced on
            // every filter/search/pagination reload.
            $(document).on('change', '.student-checkbox', function () {
                if ($(this).is(':checked')) {
                    $('.student-checkbox').not(this).prop('checked', false);
                }
                updateButtonStates();
            });
        });

        function loadSections(classId, targetSelector) {
            if (classId) {
                return $.get('/Attendance/GetSectionsByClass', { classId: classId }, function (res) {
                    if (res.success) {
                        let html = `<option value="">Select Section</option>`;
                        res.data.forEach(s => {
                            html += `<option value="${s.sectionID}">${s.sectionName}</option>`;
                        });
                        $(targetSelector).html(html).trigger('change');
                        renderFilterBadges();
                    }
                });
            } else {
                $(targetSelector).html('<option value="">Select Section</option>').trigger('change');
                return $.Deferred().resolve().promise();
            }
        }

        function submitForm() {
            const classEL = document.getElementById('classSelect');
            const sectionEl = document.getElementById('sectionSelect');
            const companyEl = document.getElementById('ddlFilterCompany');

            const classId = classEL?.value || '';
            const sectionId = sectionEl?.value || '';
            const companyId = companyEl?.value || '';
            const search = document.getElementById('hdnSearch')?.value || '';
            const pageIndex = document.getElementById('hdnPageIndex')?.value || 1;

            const params = new URLSearchParams({
                classId,
                sectionId,
                companyId,
                search,
                pageIndex
            }).toString();

            loadStudentFeePartial(params);
        }

        function applyFilters() {
            const classEl = document.getElementById('classSelect');
            const companyEl = document.getElementById('ddlFilterCompany');
            const sectionEl = document.getElementById('sectionSelect');
            const searchEl = document.getElementById('txtSearchInput');

            const searchVal = searchEl?.value.trim();
            if (searchVal) appliedFilters['txtSearchInput'] = { label: 'Search', text: searchVal };
            else delete appliedFilters['txtSearchInput'];

            if (classEl?.value && classEl.value !== '') {
                appliedFilters['classSelect'] = {
                    label: 'Class',
                    text: classEl.options[classEl.selectedIndex]?.text || classEl.value
                };
            } else delete appliedFilters['classSelect'];

            if (companyEl?.value && companyEl.value !== '') {
                appliedFilters['ddlFilterCompany'] = {
                    label: 'Company',
                    text: companyEl.options[companyEl.selectedIndex]?.text || companyEl.value
                };
            } else delete appliedFilters['ddlFilterCompany'];

            if (sectionEl?.value && sectionEl.value !== '') {
                appliedFilters['ddlFilterSection'] = {
                    label: 'Section',
                    text: sectionEl.options[sectionEl.selectedIndex]?.text || sectionEl.value
                };
            } else delete appliedFilters['ddlFilterSection'];

            saveAppliedFilters();
            renderFilterBadges();
        }

        function renderFilterBadges() {
            const container = document.getElementById('badgeContainer');
            const mainContainer = document.getElementById('activeFilterBadges');
            if (!container || !mainContainer) return;

            container.innerHTML = '';
            const activeCount = Object.keys(appliedFilters).length;

            Object.entries(appliedFilters).forEach(([id, { label, text }]) => {
                const badge = document.createElement('span');
                badge.className = 'badge bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center gap-1 fw-medium px-2 py-1';
                badge.innerHTML = `${label}: ${text} <i class="ti ti-x ms-1 cursor-pointer" onclick="removeFilter('${id}')" style="font-size:10px;"></i>`;
                container.appendChild(badge);
            });

            mainContainer.style.display = activeCount > 0 ? 'block' : 'none';
        }

        function removeFilter(filterId) {
            if (filterId === 'classSelect') {
                const el = document.getElementById('classSelect');
                if (el) {
                    el.value = '';
                    if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
                }
            } else if (filterId === 'ddlFilterCompany') {
                const el = document.getElementById('ddlFilterCompany');
                if (el) {
                    el.value = '';
                    if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
                }
            } else if (filterId === 'txtSearchInput') {
                const el = document.getElementById('txtSearchInput');
                if (el) el.value = '';
                document.getElementById('hdnSearch').value = '';
            } else if (filterId === 'sectionSelect' || filterId === 'ddlFilterSection') {
                const el = document.getElementById('sectionSelect');
                if (el) {
                    el.value = '';
                    if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
                }
            }

            delete appliedFilters[filterId];
            saveAppliedFilters();
            renderFilterBadges();
            document.getElementById('hdnPageIndex').value = 1;
            submitForm();
        }

        function resetAllFilters() {
            document.getElementById('txtSearchInput').value = '';
            document.getElementById('hdnSearch').value = '';

            ['classSelect', 'ddlFilterCompany', 'ddlFilterSection', 'sectionSelect'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.value = '';
                if (window.jQuery && jQuery(el).data('select2')) jQuery(el).val('').trigger('change');
            });

            clearFieldInvalid('classSelect');
            clearFieldInvalid('sectionSelect');

            clearAppliedFilters();
            renderFilterBadges();
            document.getElementById('hdnPageIndex').value = 1;
            submitForm();
        }

        // Re-runs the currently applied filters — used after delete/toggle so
        // the table + badges stay in sync without a full page reload.
        function refreshCurrentPage() {
            const form = document.getElementById('frmSearch');
            const params = new URLSearchParams(new FormData(form)).toString();
            loadStudentFeePartial(params);
        }

        // ========================================
        // DOMContentLoaded — init DataTable + UI
        // ========================================
        document.addEventListener('DOMContentLoaded', () => {
            var companyname = localStorage.getItem("comName");

            $.fn.dataTable.ext.errMode = 'none';

            try {
                if (window.jQuery && typeof jQuery.fn.select2 === 'function') {
                    jQuery('#classSelect, #ddlFilterCompany, #ddlFilterSection, #sectionSelect').select2({
                        width: '100%',
                        dropdownParent: jQuery('#filter-dropdown'),
                        allowClear: true,
                        placeholder: function () { return jQuery(this).data('placeholder') || 'Select'; }
                    });
                }
            } catch (e) {
                console.warn('Select2 init skipped:', e);
            }

            document.getElementById('filter-dropdown')?.addEventListener('click', e => e.stopPropagation());

            // ── Apply Filters ─────────────────────────────────────────────────
            document.getElementById('btnApplyFilters')?.addEventListener('click', (e) => {
                const classId = document.getElementById('classSelect')?.value;
                const sectionId = document.getElementById('sectionSelect')?.value;
                const companyId = document.getElementById('ddlFilterCompany')?.value;

                let hasError = false;

                if (!companyId) {
                    setFieldInvalid('ddlFilterCompany', 'Company is required');
                    hasError = true;
                } else {
                    clearFieldInvalid('ddlFilterCompany');
                }

                if (!classId) {
                    setFieldInvalid('classSelect', 'Class is required');
                    hasError = true;
                } else {
                    clearFieldInvalid('classSelect');
                }

                if (hasError) {
                    e.preventDefault();
                    return;
                }

                document.getElementById('hdnPageIndex').value = 1;
                document.getElementById('hdnSearch').value = document.getElementById('txtSearchInput').value;
                applyFilters();
                submitForm();
            });

            document.getElementById('btnResetFilters')?.addEventListener('click', resetAllFilters);

            renderFilterBadges();
            updateButtonStates();
        });

        // ========================================
        // Search input — debounced server submit
        // ========================================
        let searchTimer = null;

        document.getElementById('txtSearchInput')?.addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(() => {
                document.getElementById('hdnSearch').value = this.value;
                document.getElementById('hdnPageIndex').value = 1;

                const val = this.value.trim();
                if (val) appliedFilters['txtSearchInput'] = { label: 'Search', text: val };
                else delete appliedFilters['txtSearchInput'];
                saveAppliedFilters();
                renderFilterBadges();

                submitForm();
            }, 500);
        });

        // ========================================
        // Partial reload — used by submitForm() for filter/search/pagination,
        // and by refreshCurrentPage() after delete/toggle actions
        // ========================================
        function loadStudentFeePartial(queryString) {
            const container = document.getElementById('StudentFeeTableContainer');
            if (!container) return;

            container.style.opacity = '0.5';

            fetch(`/StudentFees/GetStudentFeePartial?${queryString}`, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(res => {
                    if (!res.ok) throw new Error('Failed to load student fee list');
                    return res.text();
                })
                .then(html => {
                    container.innerHTML = html;
                    container.style.opacity = '1';
                    renderFilterBadges();
                    updateButtonStates();
                })
                .catch(err => {
                    console.error(err);
                    container.style.opacity = '1';
                    if (window.toast) window.toast.error('Could not refresh the list.');
                });
        }

        // Pagination click interception
        document.addEventListener('click', function (e) {
            const link = e.target.closest('#StudentFeeTableContainer .page-link');
            if (!link || link.closest('.disabled')) return;

            e.preventDefault();
            const href = link.getAttribute('href');
            if (!href || href === '#') return;

            const query = href.split('?')[1] || '';
            document.getElementById('hdnPageIndex').value = new URLSearchParams(query).get('PageIndex') || 1;
            loadStudentFeePartial(query);
            history.replaceState(null, '', href);
        });

        // ========================================
        // Button enable/disable + Add redirect
        // ========================================
        function updateButtonStates() {
            const checked = $('.student-checkbox:checked');
            const count = checked.length;

            // Enable Add/View/Edit only when exactly one row is checked
            $('#btnAddClass').prop('disabled', count !== 1)
                .toggleClass('disabled', count !== 1);

            $('#btnEdit').prop('disabled', count !== 1);
            $('#btnDelete').prop('disabled', count === 0);
            $('#btnActive').prop('disabled', count === 0);
            $('#btnInactive').prop('disabled', count === 0);
        }

        // Redirect to the student's fee details page.
        // Works whether btnAddClass is an <a> or a <button> — if it's an <a>,
        // set/clear its href instead of using an onclick redirect.
        
                // ========================================
        // Selected student tracking + Collect Fees redirect
        // ========================================
        let selectedStudentId = null;

        $(document).on('change', '.student-checkbox', function () {
            if ($(this).is(':checked')) {
                $('.student-checkbox').not(this).prop('checked', false);
                selectedStudentId = $(this).data('student-id');

                if (!selectedStudentId) {
                    console.warn('student-checkbox is missing data-student-id attribute:', this);
                }
            } else {
                selectedStudentId = null;
            }

            updateButtonStates();
        });

        $('#btnEdit').on('click', function () {
            if (!selectedStudentId) {
                Swal.fire('Error', 'Please select a student first.', 'error');
                return;
            }
            window.location.href = `/StudentFees/StudentFeesDetails/${selectedStudentId}`;
        });

        window.addEventListener('pagehide', function () {
            clearAppliedFilters();
        });
    </script>
}
