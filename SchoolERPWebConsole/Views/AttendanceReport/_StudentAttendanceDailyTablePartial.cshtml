@model SchoolERPWebConsole.Domain.AttendanceDailyReportPageViewModel
@{
    var p = Model.Permissions;
}
<div class="card shadow-tbl-outer">
    <div class="card-body p-2">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="AttendanceTypeTable">
                <thead class="table-light">
                    <tr>
                        <th>Class (Section)</th>
                        <th>Total Present</th>
                        <th>Total Absent </th>
                        <th>Present %</th>
                        <th>Absent %</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.AttendanceDaily != null && Model.AttendanceDaily.Any())
                    {
                        var startIndex = (Model.PageNumber - 1) * Model.PageSize;
                        for (int i = 0; i < Model.AttendanceDaily.Count; i++)
                        {
                            var s = Model.AttendanceDaily[i];
                            <tr class="student-row" data-id="@s.CLASSID">
                                <td>@s.CLASSNAME</td>
                                <td>@s.TOTALPRESENT</td>
                                <td>@s.TOTALABSENT</td>
                                <td>@s.PRESENTPERCENT</td>
                                <td>@s.ABSENTPERCENT</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="dataTables_empty text-center text-muted py-4">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @{
            var totalPages = Model.PageSize > 0 ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize) : 0;
        }
        @if (totalPages > 1)
        {
            <nav class="mt-2">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    @for (int pg = 1; pg <= totalPages; pg++)
                    {
                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("StudentAttendanceDailyReport", new {
                                        pageNumber = pg,
                                        pageSize = Model.PageSize,
                                        searchTerm = Model.SearchTerm,
                                        companyId = Model.CompanyId,
                                        sessionId = Model.SessionId,
                                        classId = Model.ClassId,
                                        sectionId = Model.SectionID,
                                        attendanceType = Model.AttendanceType,
                                        searchType = Model.SearchType,
                                        dateFrom = Model.DateFrom,
                                        dateTo = Model.DateTo
                                    })">
                                @pg
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
