@*
    ======================================================================
    VIEW: Reports / AttendanceMonthlyReport / Index.cshtml
    PURPOSE: Monthly, date-wise attendance grid (student x day) with
             Class/Section/Month/Year filters, holiday-shaded day columns,
             and export options. Mirrors StaffReport/Index.cshtml.
    ======================================================================
*@
@model SchoolERPWebConsole.Domain.AttendanceMonthlyReportPageViewModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Staff Attendance Report";
    var p = Model.Permissions;
    var months = Enumerable.Range(1, 12)
        .Select(m => new { Value = m, Text = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m) });
    var currentYear = DateTime.Today.Year;
    var years = Enumerable.Range(currentYear - 5, 7);
}

<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between gap-1 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Staff Attendance Report</h6>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }
    </div>
</div>

<div id="reportPageNotice"></div>

<div class="row">
    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text"
                               name="search"
                               id="txtSearchInput"
                               value="@Model.SearchKeyword"
                               class="form-control border-0 ps-2 search-input-responsive"
                               placeholder="Search by name, admission no, roll no..." />
                    </div>

                    <!-- Hidden form for filter submission -->
                    <form method="get" asp-action="AttendanceMonthlyReport" id="frmSearch" style="display:none;">
                        <input type="hidden" name="pageNumber" id="hdnPageIndex" value="1" />
                        <input type="hidden" name="searchKeyword" id="hdnSearch" value="@Model.SearchKeyword" />
                        <input type="hidden" name="sessionId" id="hdnSessionID" value="@Model.SessionId" />
                        <input type="hidden" name="companyId" id="hdnCompanyId" value="@Model.CompanyId" />
                        <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                        <input type="hidden" name="roleId" id="hdnRoleId" value="@Model.RoleID" />
                        <input type="hidden" name="month" id="hdnMonth" value="@Model.Month" />
                        <input type="hidden" name="year" id="hdnYear" value="@Model.Year" />
                    </form>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle"
                           class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>

                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown">

                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <button type="button" class="btn text-primary" onclick="resetAllFilters()" id="btnResetFilters">
                                        <i class="ti ti-refresh me-1"></i>Reset
                                    </button>
                                    <button type="button" class="btn text-primary" id="btnApplyFilters">
                                        <i class="ti ti-filter me-1"></i>Apply
                                    </button>
                                    <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none" id="btnCloseFilter" aria-label="Close">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="filter-body pb-2">
                                <div class="row g-2 p-2">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Role</label>
                                        <!-- TODO: bind ClassList once wired to your dropdown-source service -->
                                        <select class="form-select" name="ClassId" id="filter_role_id" required>
                                            <option value="">Select</option>
                                            @foreach (var c in Model.Roles)
                                            {
                                                <option value="@c.RoleID" selected="@(c.RoleID == Model.RoleID)">@c.RoleName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Month</label>
                                        <select class="form-select" name="Month" id="filter_month" required>
                                            @foreach (var m in months)
                                            {
                                                <option value="@m.Value" selected="@(m.Value == Model.Month)">@m.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label mb-1">Year</label>
                                        <select class="form-select" name="Year" id="filter_year" required>
                                            @foreach (var y in years)
                                            {
                                                <option value="@y" selected="@(y == Model.Year)">@y</option>
                                            }
                                        </select>

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Active filter badges -->
    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="col-xl-12 mb-2">
        <div class="d-flex flex-wrap gap-3 align-items-center small">
            <span><span class="att-dot att-p"></span> Present</span>
            <span><span class="att-dot att-l"></span> Late</span>
            <span><span class="att-dot att-a"></span> Absent</span>
            <span><span class="att-dot att-h"></span> Half Day</span>
            <span><span class="att-dot att-holiday"></span> Holiday</span>
        </div>
    </div>

    <div id="AttendanceReportTableContainer">
        @await Html.PartialAsync("_AttendanceStaffMonthlyReportTablePartial", Model)
    </div>
</div>

@section Styles {
    <style>
        .dt-buttons {
            display: none !important;
        }

        #AttendanceMonthlyTable {
            font-size: 12px;
        }

            #AttendanceMonthlyTable th.day-col,
            #AttendanceMonthlyTable td.day-col {
                text-align: center;
                min-width: 30px;
                padding: 4px 2px;
            }

                #AttendanceMonthlyTable th.day-col.holiday,
                #AttendanceMonthlyTable td.day-col.holiday {
                    background-color: #fdecea;
                }

        .att-badge {
            display: inline-block;
            width: 20px;
            height: 20px;
            line-height: 20px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 11px;
        }

            .att-badge.p {
                background-color: #d1f7dd;
                color: #14804a;
            }

            .att-badge.l {
                background-color: #fff2cc;
                color: #8a6d00;
            }

            .att-badge.a {
                background-color: #fddede;
                color: #b02a2a;
            }

            .att-badge.h {
                background-color: #dbe8ff;
                color: #1c4a9e;
            }

        .att-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            margin-right: 4px;
        }

            .att-dot.att-p {
                background-color: #14804a;
            }

            .att-dot.att-l {
                background-color: #8a6d00;
            }

            .att-dot.att-a {
                background-color: #b02a2a;
            }

            .att-dot.att-h {
                background-color: #1c4a9e;
            }

            .att-dot.att-holiday {
                background-color: #fdecea;
                border: 1px solid #f1b0a8;
            }
    </style>
}

@section Scripts {
    <script>
        window.canExport = @JsonSerializer.Serialize(p.CanExport);
        window.canPrint = @JsonSerializer.Serialize(p.CanPrint);
    </script>
    <script src="~/assets/js/AttendanceStaffMonthlyReport.js"></script>
}
