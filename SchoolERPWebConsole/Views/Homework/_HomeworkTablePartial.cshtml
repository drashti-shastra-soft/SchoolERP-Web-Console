@model SchoolERPWebConsole.Domain.HomeworkPageViewModel
@using System.Security.Claims
@using System.Text.Json

@{
   
    var p = Model.Permissions;
    int totalPages = Model.PageSize > 0
                   ? (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize)
                   : 0;
}

<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body p-0">
            <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table" id="homeworkTable">
                        <thead>
                             <tr class="bg-light">
                                @if (ViewBag.IsStudent == true)
                                {
                                    <th>Class (Section)</th>
                                    <th>Subject</th>
                                    <th>Homework Date</th>
                                    <th>Submission Date</th>
                                    <th>Evaluation Date</th>
                                    <th>Max Marks</th>
                                    <th>Marks Obtained</th>
                                    <th>Note</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                }
                                else
                                {

                                    <th>Select</th>
                                    <th>Class (Section)</th>
                                    <th style="width: 70px;">Subject Group</th>
                                    <th>Subject</th>
                                    <th>Homework Date</th>
                                    <th>Submission Date</th>
                                    <th>Created By</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Homeworks != null)
                            {
                                foreach (var h in Model.Homeworks)
                                {
                                    @if (ViewBag.IsStudent == true)
                                    {
                                        <tr>
                                            <td>
                                                <span>@h.ClassName</span> (@h.SectionName)
                                            </td>
                                            <td>@h.SubjectName</td>
                                            <td>@h.HomeworkDate.ToString("dd MMM yyyy")</td>
                                            <td>@h.SubmissionDate.ToString("dd MMM yyyy")</td>
                                            <td>@h.EvaluationDate?.ToString("dd MMM yyyy")</td>
                                            <td>@h.MaxMarks</td>
                                            <td>@h.MarkSobtained</td>
                                            <td>@h.Note</td>
                                            <td>
                                                @if (h.Status == 2)
                                                {
                                                    <span class="badge bg-secondary">Submitted</span>
                                                }
                                                else if (h.Status == 3)
                                                {
                                                    <span class="badge bg-success">Evaluated</span>
                                                }
                                                else if (h.Status == 4)
                                                {
                                                    <span class="badge bg-danger">Late</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pending</span>
                                                }
                                            </td>
                                            <td> <a href="/Homework/HomeworkDetails/@h.HomeworkID" title="View/Edit"><i class="fa fa-reorder"></i></a></td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="item-row" data-active="@h.IsActive" data-submission="@h.SubmissionDate.ToString("yyyy-MM-dd")" onclick="selectItem(@h.HomeworkID, this)" style="cursor: pointer;">

                                            <td>
                                                <input type="checkbox" name="selectedClass"
                                                       class="form-check-input student-checkbox" onclick="selectItem(@h.HomeworkID, this)"
                                                       value="@h.HomeworkID">

                                            </td>
                                            <td>
                                                <span>@h.ClassName</span> (@h.SectionName)
                                            </td>
                                            <td>@h.SubjectGroupName</td>
                                            <td>@h.SubjectName</td>
                                            <td>@h.HomeworkDate.ToString("dd MMM yyyy")</td>
                                            <td>@h.SubmissionDate.ToString("dd MMM yyyy")</td>
                                            <td>@h.CreatedByName</td>
                                            <td>

                                                @if (p.CanEdit)
                                                {
                                                    <div class="form-check form-switch" onclick="event.stopPropagation()">
                                                        <input class="form-check-input status-switch" type="checkbox" @(h.IsActive ? "checked" : "") onchange="toggleStatus(@h.HomeworkID, this.checked,this)">
                                                    </div>
                                                }
                                                @if (ViewBag.IsStudent == true)
                                                {
                                                    <a href="/Homework/HomeworkDetails/@h.HomeworkID" title="View/Edit"><i class="fa fa-reorder"></i></a>
                                                }

                                            </td>
                                            <td>

                                                <a href="/Homework/EvaluateHomework?homeWorkId=@h.HomeworkID" title="View/Edit"><i class="fa fa-reorder"></i></a>

                                            </td>
                                        </tr>
                                    }

                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center py-4 text-muted" colspan="8">No Homework Data Found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalPages > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">
                            <!-- Record info -->
                            <div class="text-muted small">
                                Showing
                                <strong>@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong>
                                –
                                <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong>
                                of
                                <strong>@Model.TotalRecords</strong> users
                            </div>

                            <nav aria-label="Subject pagination">
                                <ul class="pagination pagination-sm mb-0">

                                    <!-- First -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=1&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                            <i class="ti ti-chevrons-left"></i>
                                        </a>
                                    </li>

                                    <!-- Prev -->
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                            <i class="ti ti-chevron-left"></i>
                                        </a>
                                    </li>

                                    <!-- Page numbers — show 5 around current -->
                                    @{
                                        int start = Math.Max(1, Model.PageNumber - 2);
                                        int end = Math.Min(totalPages, start + 4);
                                        start = Math.Max(1, end - 4);
                                    }
                                    @for (int pg = start; pg <= end; pg++)
                                    {
                                        <li class="page-item @(pg == Model.PageNumber ? "active" : "")">
                                            <a class="page-link"
                                               href="?pageIndex=@pg&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">@pg</a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                            <i class="ti ti-chevron-right"></i>
                                        </a>
                                    </li>

                                    <!-- Last -->
                                    <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           href="?pageIndex=@totalPages&pageSize=@Model.PageSize&search=@Model.SearchTerm&companyId=@Model.CompanyId&sessionID=@Model.SessionId">
                                            <i class="ti ti-chevrons-right"></i>
                                        </a>
                                    </li>

                                </ul>
                            </nav>

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>