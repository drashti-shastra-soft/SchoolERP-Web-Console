@using System.Text.Json
@model SchoolERPWebConsole.Domain.FeeReceiptPageViewModel
@{
    ViewData["Title"] = "Fee Receipt";
    var p = Model.Permissions;
}
<style>
    .table-scroll {
        max-height: 200px;
        overflow-y: auto;
        overflow-x: auto;
    }

        .table-scroll table {
            width: 100%;
            margin-bottom: 0;
        }</style>
<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Fee Receipt</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1 responsive-btn-group">
        @if (p.CanAdd)
        {
            <button class="btn btn-success top-btn" onclick="saveIssue()">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
    </div>
</div>

<div class="row">
    <!-- ============================================================ -->
    <!-- LEFT: Voucher Details + Fee Head grid + Amount Receiving      -->
    <!-- ============================================================ -->
    <div class="col-xl-9">

        <!-- Voucher Details card -->
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Voucher No: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtVoucherNo" placeholder="Search voucher no" autocomplete="off">
                        <ul id="pinVoucherNo" class="pincode-dropdown list-group"></ul>
                    </div>

                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Receipt No <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtReceiptNo" placeholder="enter Receipt No" autocomplete="off">
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Date </label>
                        <input type="date" class="form-control" value="@Model.TodayDate" id="txtDate" autocomplete="off">
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Student ID:<span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="txtStudentID" placeholder="Search student id" autocomplete="off" >
                        <ul id="pinStudentSuggestions" class="pincode-dropdown list-group"></ul>
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Name</label>
                        <input type="text" class="form-control" id="txtName" autocomplete="off" disabled>
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Admision Type</label>
                        <input type="text" class="form-control" id="txtAdmisionType" autocomplete="off" disabled>
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Installment:</label>
                        <select class="form-select" id="ddlInstallment">
                            <option value="">—</option>
                        </select>
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Fathers's Name:</label>
                        <input type="text" class="form-control" id="txtFathersName" autocomplete="off" disabled>
                    </div>
                    <div class="col-md-4" style="position: relative;">
                        <label class="form-label fw-semibold">Remarks:</label>
                        <input type="text" class="form-control" id="txtRemarks" autocomplete="off">
                    </div>
                </div>
            </div>
        </div>

        <!-- Fee Head grid card -->
        <div class="card shadow-tbl-outer mt-2">
            <div class="card-body p-0">
                <div class="table-scroll table-responsive">
                    <table class="table mb-0" id="tblFeeHead">
                        <thead class="table-light">
                            <tr>
                                <th>Fee Head</th>
                                <th>Add/Less</th>
                                <th class="text-end">Actual Amount</th>
                                <th class="text-end">Submitted</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Received</th>
                            </tr>
                        </thead>
                        <tbody id="feeHeadBody">
                            <tr>
                                <td colspan="7" class="text-center text-muted py-3">
                                    Search and select a student above to load fee details
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Add extra Fee Head row -->
                <div class="d-flex align-items-center gap-2 px-3 py-2 border-top flex-wrap">
                    <select class="form-select form-select-sm" id="ddlExtraFeeHead" style="max-width:220px;">
                        <option value="">Select</option>
                        <!-- TODO: populated from a fee-head master endpoint — see loadExtraFeeHeadOptions() -->
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addExtraFeeHeadRow()">Fee Head</button>

                    <div class="ms-auto d-flex align-items-center gap-3 fw-bold">
                        <span>Total:</span>
                        <span id="totalActual">0.00</span>
                        <span id="totalSubmitted">0.00</span>
                        <span id="totalBalance">0.00</span>
                        <span id="totalDiscount">0.00</span>
                        <span id="totalReceived" class="text-primary">0.00</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 px-3 pb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="addLessMode" id="rdoAdd" value="Add" checked>
                        <label class="form-check-label" for="rdoAdd">Add</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="addLessMode" id="rdoLess" value="Less">
                        <label class="form-check-label" for="rdoLess">Less</label>
                    </div>
                </div>
            </div>
        </div>

        <!-- Amount Receiving Details card -->
        <div class="card shadow-tbl-outer mt-2">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Amount Receiving Details</h6>
                <div class="d-none row g-3">
                    <div class="col-md-2">
                        <div class="form-check mb-2">
                            <input class="form-check-input paymode-radio" type="radio" name="paymentMode" id="rdoCash" value="Cash" checked>
                            <label class="form-check-label" for="rdoCash">Cash</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input paymode-radio" type="radio" name="paymentMode" id="rdoCheque" value="Cheque/DD">
                            <label class="form-check-label" for="rdoCheque">Cheque/DD</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input paymode-radio" type="radio" name="paymentMode" id="rdoCard" value="Debit/Credit">
                            <label class="form-check-label" for="rdoCard">Debit/Credit</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input paymode-radio" type="radio" name="paymentMode" id="rdoMixed" value="Cash+Cheque/DD">
                            <label class="form-check-label" for="rdoMixed">Cash+Cheque/DD</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Cash Amount:</label>
                        <input type="number" step="0.01" class="form-control" id="txtCashAmount" value="0.00">
                        <label class="form-label fw-semibold mt-2">Chq. Amount:</label>
                        <input type="number" step="0.01" class="form-control" id="txtChqAmount" value="0.00" disabled>
                        <label class="form-label fw-semibold mt-2">*Chq/DD/Card No:</label>
                        <input type="text" class="form-control" id="txtChqNo" disabled>
                        <label class="form-label fw-semibold mt-2">Account:</label>
                        <select class="form-select select2" id="ddlAccount" style="width:100%;"><option value="">-- Select --</option></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Amount:</label>
                        <input type="number" step="0.01" class="form-control" id="txtReceivedAmount" readonly>
                        <label class="form-label fw-semibold mt-2">*Date:</label>
                        <input type="date" class="form-control" id="txtPaymentDate">
                        <label class="form-label fw-semibold mt-2">Drawn On:</label>
                        <input type="text" class="form-control" id="txtDrawnOn" disabled>
                        <label class="form-label fw-semibold mt-2">*Mode of Receipt:</label>
                        <select class="form-select select2" id="ddlModeOfReceipt" style="width:100%;">
                            <option value="">Select</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Narration:</label>
                        <textarea class="form-control" id="txtNarration" rows="9"></textarea>
                    </div>
                </div>

                <div id="dynamicFieldsContainer" class="row row-gap-3">
                    <div class="col-12 text-muted" id="dynamicFieldsEmpty">
                        Select a voucher type to load dynamic fields.
                    </div>
                    
                </div>
                <div id="voucherDetailsSection"></div>

                
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- RIGHT: Installment summary + payment totals side panels       -->
    <!-- ============================================================ -->
    <div class="col-xl-3">
        <div class="card shadow-tbl-outer">
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Instt.</th><th class="text-end">Act. Amt</th><th class="text-end">Subm.</th><th class="text-end">Balance</th></tr>
                    </thead>
                    <tbody id="installmentSummaryBody">
                        <tr><td colspan="4" class="text-center text-muted">—</td></tr>
                    </tbody>
                    <tfoot class="fw-bold table-light">
                        <tr>
                            <td>Total</td>
                            <td class="text-end" id="sideTotalActual">0</td>
                            <td class="text-end" id="sideTotalSubm">0</td>
                            <td class="text-end text-danger" id="sideTotalBalance">0</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card shadow-tbl-outer mt-2">
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr><th>Title</th><th class="text-end">Amount</th><th class="text-end">Count</th></tr>
                    </thead>
                    <tbody id="paymentTotalsBody">
                        <!-- populated by loadPaymentTotals() — TODO: needs its own endpoint -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
         window.FEE_RECEIPT_VOUCHER_ID = 11;
    <script src="~/assets/js/FeeReceipt.js"></script>
}