@using System.Security.Claims
@model SchoolERPWebConsole.Domain.AlumniEventPageViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Alumni Events";
    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;
    }
@section Styles {
    <link rel="stylesheet" href="~/calender/fullcalendar.min.css">
    <link rel="stylesheet" href="~/calender/fullcalendar.print.css" media="print">


    <style>

        #calendar {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        }

        .fc-event {
            background: #21b300 !important;
            border: none !important;
            color: white !important;
            border-radius: 3px !important;
            font-size: 12px !important;
            padding: 2px 6px !important;
        }

        .dt-buttons { display: none !important; }

        .tooltip-inner {
            max-width: 300px;
            text-align: left;
            padding: 10px;
            font-size: 13px;
        }

    </style>
}

<!-- Page Header -->
<div class="sticky-toolbar d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
    <div>        
        <h6 class="fw-bold mb-0">Alumni Events</h6>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-1 responsive-btn-group">
        @if (p.CanAdd)
        {
            <a href="/Alumni/Add" class="btn btn-primary d-inline-flex align-items-center top-btn">
                <i class="ti ti-plus me-1"></i> Add
            </a>
        }
            @if (p.CanEdit)
        {
            <button id="btnEdit" class="btn btn-info top-btn" disabled onclick="handleEditAction()">
                <i class="ti ti-pencil me-1"></i> Edit
            </button>
        }
        @if (p.CanDelete)
        {
            <button id="btnDelete" class="btn btn-danger top-btn" disabled onclick="deleteSelected()">
                <i class="ti ti-trash me-1"></i> Delete
            </button>
        }
        @if (p.CanEdit)
        {
            <button id="btnActive" class="btn btn-success top-btn" disabled onclick="toggleStatus(0,true)">
                <i class="ti ti-circle-check"></i> Active
            </button>
            <button id="btnInactive" class="btn btn-danger top-btn" disabled onclick="toggleStatus(0,false)">
                <i class="ti ti-circle-x"></i> Inactive
            </button>
        }
            @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center shadow-sm top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i> Print
            </button>
        }
        <button id="btnView" class="btn btn-teal top-btn" disabled onclick="handleViewAction()">
            <i class="ti ti-eye me-1"></i> View
        </button>
            @if (p.CanExport)
        {
            <div class="dropdown d-inline-block">
                <button class="btn btn-warning dropdown-toggle d-inline-flex align-items-center shadow-sm top-btn" type="button" data-bs-toggle="dropdown">
                    <i class="ti ti-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-2"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-2"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-2"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-2"></i>PDF</a></li>
                </ul>
            </div>
        }
       
        
    </div>
</div>

<div class="row">
    <!-- Left Side: Calendar -->
    <div class="col-md-6">
        <div id="calendar"></div>
    </div>

    <!-- Right Side: Event List -->
    <div class="col-md-6">
        <!-- Filters -->
        <div class="col-xl-12">
            <div class="card mb-2 shadow-tbl-outer">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 search-term">

                        <!-- ── Search box (name="search" so form submits it) ── -->
                        <div class="position-relative border d-flex align-items-center rounded-2 px-3 bg-white flex-grow-1 search-box-wrap" style="max-width:420px;">
                            <i class="fas fa-search search-icon-input"></i>
                            <input type="text"
                                   name="search"
                                   id="txtSearchInput"
                                   value="@Model.SearchTerm"
                                   class="form-control border-0 ps-2 search-input-responsive"
                                   placeholder="Search by class, section..." />
                        </div>

                        <!-- Hidden form for filter submission — outside Bootstrap dropdown -->
                        <form method="get" asp-action="Events" id="frmSearch" style="display:none;">
                            <input type="hidden" name="pageIndex" id="hdnPageIndex" value="1" />
                            <input type="hidden" name="search" id="hdnSearch" value="@Model.SearchTerm" />
                            <input type="hidden" name="sessionID" id="hdnSessionID" value=@Model.CompanyId />
                            <input type="hidden" name="companyId" id="hdnCompanyId" value=@Model.SessionId />
                            <input type="hidden" name="pageSize" id="hdnPageSize" value="@Model.PageSize" />
                        </form>

                        <div class="dropdown">
                            <a href="#" id="btnFilterToggle"
                               class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                               data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                            </a>

                            <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl"
                                 id="filter-dropdown">

                                <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                    <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                    <div class="d-flex align-items-center justify-content-end">
                                        <button type="button" class="btn text-primary"
                                                onclick="resetAllFilters()" id="btnResetFilters">
                                            <i class="ti ti-refresh me-1"></i>Reset
                                        </button>
                                        <button type="submit" class="btn text-primary" id="btnApplyFilters">
                                            <i class="ti ti-filter me-1"></i>Apply
                                        </button>
                                        <button type="button" class="btn btn-icon btn-sm ms-1 d-md-none"
                                                id="btnCloseFilter" aria-label="Close">
                                            <i class="ti ti-x"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="filter-body pb-0">
                                    <div class="row">
                                        @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                                   {
                                       Companies = Model.Companies,
                                       Sessions = Model.Sessions,
                                       CompanyId = Model.CompanyId,
                                       SessionId = Model.SessionId
                                   })
                                       
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- Active filter badges -->
        <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
            <div class="card shadow-tbl border-0 py-2 mb-2">
                <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                    <span class="text-muted small fw-bold ms-2 me-2">
                        <i class="ti ti-filter-check me-1"></i>Active Filters:
                    </span>
                    <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                    <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                            id="btnResetAllFilters" onclick="resetAllFilters()">
                        <i class="ti ti-trash me-1"></i>Clear All
                    </button>
                </div>
            </div>
        </div>


        <div id="alumniEventTableContainer">
            @await Html.PartialAsync("_AlumniEventTablePartial", Model)
        </div>

    </div>
</div>



<!-- View Detail Modal -->
<div class="modal fade" id="eventView" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header justify-content-between">
                <h5 class="modal-title">Event Description</h5>
                <button class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="ti ti-x me-1"></i> Close
                </button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <img id="viewImage" src="/assets/img/default-event.jpg" class="rounded object-fit-cover" width="80" height="80" alt="Event">
                    <div>
                        <h6 id="viewTitle" class="mb-1">Demo Event</h6>
                        <span id="viewDate" class="text-muted"><i class="ti ti-calendar"></i></span>
                    </div>
                </div>
                <hr>
                <div>
                    <h6 class="mb-1">Note :</h6>
                    <p id="viewDescription" class="text-muted mb-0"></p>
                </div>
                <hr>
                <div>
                    <h6 class="mb-1">Location :</h6>
                    <p id="viewLocation" class="text-muted mb-0">-</p>
                </div>
                <div id="viewAudienceContainer" class="d-none">
                    <hr>
                    <h6 class="mb-1">Target Audience :</h6>
                    <p class="text-muted mb-0">
                        <span id="viewAudienceSummary"></span><br/>
                        <small id="viewSections" class="text-primary"></small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/calender/fullcalendar.min.js"></script>
    <script src="~/calender/locale-all.js"></script>
    <script src="~/assets/js/AlumniEvents.js"></script>
}
