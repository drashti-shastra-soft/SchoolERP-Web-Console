@model SchoolERPWebConsole.Domain.AlumniEventPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    var p = Model.Permissions;
    var pageSize = Model.PageSize > 0
        ? Model.PageSize
        : 10;

    var requestedPage = 1;

    if (int.TryParse(
        Context.Request.Query["pageIndex"],
        out var queryPage))
    {
        requestedPage = queryPage;
    }

    var currentPage = requestedPage < 1
        ? 1
        : requestedPage;

    var totalRecords = Math.Max(Model.TotalRecords, 0);

    var totalPages = totalRecords == 0
        ? 1
        : (int)Math.Ceiling(
            (double)totalRecords / pageSize
          );

    if (currentPage > totalPages)
    {
        currentPage = totalPages;
    }

    var firstRecord = totalRecords == 0
        ? 0
        : ((currentPage - 1) * pageSize) + 1;

    var lastRecord = totalRecords == 0
        ? 0
        : Math.Min(currentPage * pageSize, totalRecords);

    var searchTerm = Model.SearchTerm ?? "";
}
<div class="col-xl-12">
    <div class="card shadow-tbl">
        <div class="card-body p-0">
            <div class="sticky-table">
                <div class="table-responsive">
                    <table class="table mb-0" id="tblEvents">
                        <thead>
                            <tr class="bg-light">
                                <th style="width: 50px;" class="ps-3">
                                    <input type="checkbox" class="form-check-input" onclick="selectAllAlumniEvents(this)">
                                </th>
                                <th>Event Title</th>
                                <th>Schedule</th>
                                <th>Doc</th>
                                <th>Location</th>
                                <th style="width: 80px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AlumniEvent != null)
                            {
                                @foreach (var item in Model.AlumniEvent)
                                {
                                    <tr class="item-row">
                                        <td class="ps-3">
                                            <input type="checkbox" onclick="selectItem(@item.EventID, this)" name="selectedItem"
                                                   class="form-check-input alumni-checkbox"
                                                   value="@item.EventID" style="cursor: pointer;"
                                                   onclick="event.stopPropagation()">

                                        </td>                                        
                                        <td>@item.EventTitle</td>
                                        <td>
                                            <small class="d-block text-muted">@item.FromDate.ToString("dd MMM yyyy")</small>
                                            <small class="text-primary">@item.FromDate.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (item.EventPhoto != null && item.EventPhoto.Length > 0)
                                            {
                                                var attachmentFileName = System.IO.Path.GetFileName(item.EventPhoto);
                                                
                                                <a href="javascript:void(0)"
                                                   class="btn btn-sm btn-white border px-2 py-1 btn-view-attachment"
                                                   title="View Attachment"
                                                   onclick="event.stopPropagation(); viewDispatchAttachment(@item.EventID, '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(item.EventTitle ?? item.EventPhoto ?? "Attachment"))', '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(attachmentFileName))', '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(item.EventPhoto))')">
                                                    <i class="ti ti-paperclip fs-5"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">-</span>
                                            }
                                        </td>
                                        <td>@item.Location</td>
                                        <td>
                                            <div class="form-check form-switch" onclick="event.stopPropagation()">
                                                <input class="form-check-input" type="checkbox"
                                                       onchange="toggleStatus(@item.EventID, this.checked,this)"
                                                @(item.IsActive ? "checked" : "")
                                                @(p.CanEdit ? "" : "disabled")>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="8" class="text-center text-muted py-4">No records found.</td></tr>
                            }
                        </tbody>
                    </table>

                    <!-- ── Pagination ─────────────────────────────────────────────── -->
                    @if (totalRecords > 0)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2 mb-3">

                            <div class="text-muted small">
                                Showing
                                <strong>@firstRecord</strong>
                                –
                                <strong>@lastRecord</strong>
                                of
                                <strong>@totalRecords</strong>
                                main menus
                            </div>

                            @if (totalPages > 1)
                            {
                                <nav aria-label="Menu pagination">
                                    <ul class="pagination pagination-sm mb-0">

                                        @{
                                            var firstUrl =
                                            $"?pageIndex=1&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";

                                            var previousPage = Math.Max(1, currentPage - 1);

                                            var previousUrl =
                                            $"?pageIndex={previousPage}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";
                                        }

                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="@firstUrl"
                                               aria-label="First page">
                                                <i class="ti ti-chevrons-left"></i>
                                            </a>
                                        </li>

                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <a class="page-link"
                                               href="@previousUrl"
                                               aria-label="Previous page">
                                                <i class="ti ti-chevron-left"></i>
                                            </a>
                                        </li>

                                        @{
                                            var startPage = Math.Max(1, currentPage - 2);
                                            var endPage = Math.Min(totalPages, startPage + 4);

                                            if (endPage - startPage < 4)
                                            {
                                                startPage = Math.Max(1, endPage - 4);
                                            }
                                        }

                                        @for (var pg = startPage; pg <= endPage; pg++)
                                        {
                                            var pageUrl =
                                            $"?pageIndex={pg}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}&companyId={@Model.CompanyId}&sessionID={@Model.SessionId}";

                                            <li class="page-item @(pg == currentPage ? "active" : "")">
                                                <a class="page-link"
                                                   href="@pageUrl"
                                                   aria-current="@(pg == currentPage ? "page" : null)">
                                                    @pg
                                                </a>
                                            </li>
                                        }

                                        @{
                                            var nextPage = Math.Min(totalPages, currentPage + 1);

                                            var nextUrl =
                                            $"?pageIndex={nextPage}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}";

                                            var lastUrl =
                                            $"?pageIndex={totalPages}&pageSize={pageSize}&search={Uri.EscapeDataString(searchTerm)}";
                                        }

                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="@nextUrl"
                                               aria-label="Next page">
                                                <i class="ti ti-chevron-right"></i>
                                            </a>
                                        </li>

                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <a class="page-link"
                                               href="@lastUrl"
                                               aria-label="Last page">
                                                <i class="ti ti-chevrons-right"></i>
                                            </a>
                                        </li>

                                    </ul>
                                </nav>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDispatchAttachment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="modalDispatchAttachmentTitle">Attachment</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center" style="min-height:300px;">
                <img id="imgDispatchAttachment" style="display:none; max-width:100%; max-height:70vh;" />
                <iframe id="frmDispatchAttachment" style="display:none; width:100%; height:70vh; border:0;"></iframe>
                <div id="dispatchAttachmentUnsupported" class="d-none flex-column align-items-center justify-content-center text-muted py-5">
                    <i class="ti ti-file-off" style="font-size:48px;"></i>
                    <p class="mb-0 mt-2">Preview not available for this file type.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnDownloadDispatchAttachment" class="btn btn-primary btn-sm">
                    <span id="btnDownloadDispatchAttachmentLabel">Download</span>
                </button>
            </div>
        </div>
    </div>
</div>