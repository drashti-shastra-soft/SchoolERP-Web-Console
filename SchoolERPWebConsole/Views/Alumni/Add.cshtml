@model SchoolERPWebConsole.Domain.AlumniEventAddPageViewModel
@using System.Security.Claims
@using System.Text.Json
@{
    ViewData["Title"] = "Alumni Event";
    var p = Model.Permissions;
    var e = Model.EditAlumniEvent;

    string FormatDt(DateTime dt) => dt.ToString("yyyy-MM-ddTHH:mm");
}
<!-- Page Header -->
<div class="d-flex align-items-sm-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">@(e == null ? "Add Event" : "Edit Event")</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanAdd)
        {
            <button id="btnSaveEvent" class="btn btn-success top-btn">
                <i class="ti ti-device-floppy me-1"></i> Save
            </button>
        }
        <a href="/Alumni/Events" class="btn btn-secondary top-btn">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-tbl-outer">
            <div class="card-body">
                <form id="eventForm" enctype="multipart/form-data" novalidate>
                    <input type="hidden" id="eventId" value="@(e?.EventID ?? 0)">
                    <div class="row g-3">

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Event Title <span class="text-danger">*</span></label>
                            <input type="text" id="eventTitle" class="form-control"
                                   placeholder="Enter event title" value="@(e?.EventTitle)" required>
                            <div class="invalid-feedback" id="err_eventTitle">Event Title is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">From Date <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="fromDate" class="form-control"
                                   value="@(e != null ? FormatDt(e.FromDate) : "")" required>
                            <div class="invalid-feedback" id="err_fromDate">From Date is required.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">To Date <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="toDate" class="form-control"
                                   value="@(e != null ? FormatDt(e.ToDate) : "")" required>
                            <div class="invalid-feedback" id="err_toDate">To Date is required and cannot be before From Date.</div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold d-block">Event For <span class="text-danger">*</span></label>
                            <div class="form-check form-check-inline">
                                <input type="radio" class="form-check-input" name="eventFor" id="allAlumni" value="1"
                                @((e == null || e.EventFor == 1) ? "checked" : "")>
                                <label for="allAlumni" class="form-check-label">All Alumni</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input type="radio" class="form-check-input" name="eventFor" id="specificClass" value="2"
                                @((e != null && e.EventFor == 2) ? "checked" : "")>
                                <label for="specificClass" class="form-check-label">Class</label>
                            </div>
                        </div>

                        <div id="classTargeting" class="col-md-12 @((e != null && e.EventFor == 2) ? "" : "d-none")"
                             data-selected-session="@(e?.SessionID ?? 0)"
                             data-selected-class="@(e?.ClassID ?? 0)"
                             data-selected-sections="@(e?.SectionIDs ?? "")">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Session</label>
                                    <select id="modalSessionSelect" class="form-select select2-modal">
                                        <option value="">Select Session</option>
                                        @if (Model.Sessions != null)
                                        {
                                            foreach (var s in Model.Sessions)
                                            {
                                                <option value="@s.SessionId" selected="@(e?.SessionID == s.SessionId)">@s.SessionTitle</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Class</label>
                                    <select id="modalClassSelect" onchange="loadSectionsByClass(this.value,'modalSectionSelect')" class="form-select select2-modal">
                                        <option value="">Select Class</option>
                                        @if (Model.ClassList != null)
                                        {
                                            foreach (var c in Model.ClassList)
                                            {
                                                <option value="@c.ClassID" selected="@(e?.ClassID == c.ClassID)">@c.ClassName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Section(s)</label>
                                    <select id="modalSectionSelect" class="form-select select2-modal" multiple>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Location</label>
                            <input type="text" id="location" class="form-control"
                                   placeholder="Event venue or location" value="@(e?.Location)">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Event Photo</label>
                            <input type="file" class="form-control" id="attachmentFile" name="EventPhoto">
                            <small class="text-muted" id="fileInfo"></small>

                            @if (!string.IsNullOrEmpty(Model.EditAlumniEvent?.EventPhotoName))
                            {
                                <div id="existingFileInfo" class="mt-1 d-flex align-items-center gap-2">
                                    <a href="@Model.EditAlumniEvent.EventPhoto" target="_blank" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@Model.EditAlumniEvent.EventPhotoName
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1" onclick="removeExistingFile()">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                            <!-- Tells the backend whether to keep, replace, or delete the existing file -->
                            <input type="hidden" id="hdnExistingFile" name="ExistingFileName" value="@Model.EditAlumniEvent?.EventPhotoName">
                            <input type="hidden" id="hdnRemoveFile" name="RemoveAttachment" value="false">
                        </div>
                       @*  <div class="col-md-12">
                            <label class="form-label fw-bold">Event Photo</label>
                            <input type="file" id="eventPhoto" class="form-control" accept="image/*">
                            <input type="hidden" id="removeEventPhoto" value="false">
                            @if (e != null && e.HasPhoto == 1)
                            {
                                <div class="existing-file-row d-flex align-items-center gap-2 mt-2" id="rowExistingPhoto">
                                    <a href="/Alumni/DownloadPhoto/@e.EventID" target="_blank" rel="noopener" class="small">
                                        <i class="ti ti-paperclip me-1"></i>@(e.EventPhotoName ?? "Current Photo")
                                    </a>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" id="btnRemoveExistingPhoto" title="Remove">
                                        <i class="ti ti-x"></i>
                                    </button>
                                </div>
                            }
                        </div> *@

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Description</label>
                            <textarea id="eventDescription" class="form-control" rows="4"
                                      placeholder="Brief details about the event">@(e?.EventDescription)</textarea>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .field-error {
        display: none;
    }

    .is-invalid {
        border-color: #dc3545 !important;
    }

    .invalid-feedback {
        display: none;
        color: #dc3545;
        font-size: 0.85em;
        margin-top: 4px;
    }

        .is-invalid ~ .invalid-feedback,
        .invalid-feedback.show {
            display: block;
        }
</style>

@section Scripts {
    <script>
        window.canAdd = @JsonSerializer.Serialize(p.CanAdd);
        window.canEdit = @JsonSerializer.Serialize(p.CanEdit);
        window.canDelete = @JsonSerializer.Serialize(p.CanDelete);
    </script>
    <script src="~/js/inline-form-validation.js"></script>
    <script src="~/assets/js/AlumniEvents.js"></script>
}