@model SchoolERPWebConsole.Domain.AccountEntrySearchViewModel
@{
    ViewData["Title"] = "Search " + Model.EntryType;
}
@{

    int currentUserId = 0;
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var idClaim = User.FindFirst(ClaimTypes.NameIdentifier) ?? User.FindFirst("UserId");
        if (idClaim != null) int.TryParse(idClaim.Value, out currentUserId);
    }
    var p = Model.Permissions;

}
<style>
    .dt-buttons {
        display: none !important;
    }
</style>
<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
    <div>
        <h6 class="fw-bold mb-0">Search @Model.EntryType</h6>
    </div>
    <div class="d-flex align-items-center flex-wrap gap-1">
        @if (p.CanPrint)
        {
            <button class="btn btn-secondary d-inline-flex align-items-center top-btn" onclick="triggerExport(4)">
                <i class="ti ti-printer me-1"></i>Print
            </button>
        }
        @if (p.CanExport)
        {
            <div class="dropdown d-inline-flex">
                <button class="btn btn-warning dropdown-toggle top-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ti ti-download me-1"></i>Export
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(0)"><i class="ti ti-copy me-1"></i>Copy</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(1)"><i class="ti ti-file-text me-1"></i>CSV</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(2)"><i class="ti ti-file-spreadsheet me-1"></i>Excel</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="triggerExport(3)"><i class="ti ti-file-description me-1"></i>PDF</a></li>
                </ul>
            </div>
        }

    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card mb-2 shadow-tbl-outer">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="position-relative border d-flex align-items-center rounded-2 px-3 ">
                        <i class="fas fa-search search-icon-input"></i>
                        <input type="text" class="form-control border-0 ps-2" id="txtSearchInput"
                               placeholder="Search results..." style="min-width: 220px;">
                    </div>

                    <div class="dropdown">
                        <a href="#" id="btnFilterToggle" class="btn btn-white border rounded btn-md text-dark fs-14 align-items-center d-flex fw-normal"
                           data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <i class="ti ti-filter text-gray-5 me-1"></i>Filters
                        </a>
                        <div class="dropdown-menu dropdown-lg dropdown-menu-end filter-dropdown p-0 shadow-tbl" id="filter-dropdown">
                            <div class="d-flex align-items-center justify-content-between border-bottom filter-header">
                                <h6 class="mb-0 fw-bold">Select Criteria</h6>
                                <div class="d-flex align-items-center justify-content-end">
                                    <!-- FIX: removed inline $('#searchForm').submit() — this now goes through
                                         the JS click handler below so the AJAX partial reload actually runs
                                         instead of doing a full page navigation. -->
                                    <button type="button" class="btn text-primary fs-6 fw-medium" id="btnApplyFilters">Filter</button>
                                </div>
                            </div>
                            <!-- FIX: method changed to "get" so query string mirrors what loadSearchEntryPartial builds,
                                 and id matches what the JS expects ("searchForm" — was previously mismatched with "frmSearch"). -->
                            <form id="searchForm" asp-action="Search" method="get">
                                <input type="hidden" name="EntryType" value="@Model.EntryType" />

                                <!-- FIX: added missing hidden fields the JS relies on for paging/search state -->
                                <input type="hidden" name="PageIndex" id="hdnPageIndex" value="@Model.PageNumber" />
                                <input type="hidden" name="PageSize" id="hdnPageSize" value="@Model.PageSize" />
                                <input type="hidden" name="Search" id="hdnSearch" value="@Model.SearchKeyword" />
                                
                                <div class="filter-body pb-0">
                                    <div class="row">
                                        <div class="col-md-12 mb-3 d-flex gap-1">
                                            @await Html.PartialAsync("_CompanySessionFilter", new CompanySessionFilterViewModel
                                       {
                                           Companies = Model.Companies,
                                           Sessions = Model.Sessions,
                                           CompanyId = Model.CompanyId,
                                           SessionId = Model.SessionId
                                       })
                                    </div>
                                        <div class="col-md-12 mb-3">

                                       

                                            <label class="form-label mb-1">Search Type</label>
                                            <select class="form-select" name="SearchType" id="search_type" onchange="showdate(this.value)" required>
                                                <option value="">Select</option>
                                                <option value="today" selected="@(Model.SearchType == "today")">Today</option>
                                                <option value="this_week" selected="@(Model.SearchType == "this_week")">This Week</option>
                                                <option value="last_week" selected="@(Model.SearchType == "last_week")">Last Week</option>
                                                <option value="this_month" selected="@(Model.SearchType == "this_month")">This Month</option>
                                                <option value="last_month" selected="@(Model.SearchType == "last_month")">Last Month</option>
                                                <option value="last_3_month" selected="@(Model.SearchType == "last_3_month")">Last 3 Months</option>
                                                <option value="last_6_month" selected="@(Model.SearchType == "last_6_month")">Last 6 Months</option>
                                                <option value="last_12_month" selected="@(Model.SearchType == "last_12_month")">Last 12 Months</option>
                                                <option value="this_year" selected="@(Model.SearchType == "this_year")">This Year</option>
                                                <option value="last_year" selected="@(Model.SearchType == "last_year")">Last Year</option>
                                                <option value="period" selected="@(Model.SearchType == "period")">Period</option>
                                            </select>
                                        </div>
                                        <div id="date_result" class="row p-0 m-0" style="display: @(Model.SearchType == "period" ? "flex" : "none")">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label mb-1">Date From</label>
                                                <div class="input-icon-start position-relative">
                                                    <span class="input-icon-addon">
                                                        <i class="ti ti-calendar"></i>
                                                    </span>
                                                    <input name="DateFrom" id="date_from" type="text" class="form-control datetimepicker" value="@Model.DateFrom">
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label mb-1">Date To</label>
                                                <div class="input-icon-start position-relative">
                                                    <span class="input-icon-addon">
                                                        <i class="ti ti-calendar"></i>
                                                    </span>
                                                    <input name="DateTo" id="date_to" type="text" class="form-control datetimepicker" value="@Model.DateTo">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-12" id="activeFilterBadges" style="display: none;">
        <div class="card shadow-tbl border-0 py-2 mb-2">
            <div class="card-body p-2 d-flex flex-wrap gap-2 align-items-center">
                <span class="text-muted small fw-bold ms-2 me-2">
                    <i class="ti ti-filter-check me-1"></i>Active Filters:
                </span>
                <div id="badgeContainer" class="d-flex flex-wrap gap-2"></div>
                <button class="btn btn-sm btn-link text-danger p-0 ms-auto me-2 fw-bold text-decoration-none"
                        id="btnResetAllFilters" onclick="resetAllFilters()">
                    <i class="ti ti-trash me-1"></i>Clear All
                </button>
            </div>
        </div>
    </div>

   


    <div id="searchEntryTableContainer">
        @await Html.PartialAsync("_SearchEntryTablePartial", Model)
    </div>


</div>

@section Scripts {
    <script src="~/assets/js/ExpenseSearch.js"></script>
}
